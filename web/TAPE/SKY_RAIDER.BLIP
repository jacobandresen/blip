10 PLAY_MUSIC "SKY_RAIDER_MAIN":CLEAR("BLIP_BLACK"):T=T+0.016
20 DRAW_TEXT("SKY RAIDER",160,28,5,"BLIP_CYAN","CENTER")
30 DRAW_TEXT("SCRAMBLE THE ENEMY FLEET",160,60,2,"BLIP_GRAY","CENTER")
40 DRAW_TEXT("ARROWS FLY  SPACE FIRES",160,88,2,"BLIP_WHITE","CENTER")
50 DRAW_TEXT("SPACE TO START",160,112,2,"BLIP_YELLOW","CENTER"):GOSUB 1300
60 IF KEY_PRESSED("SPACE")=1 THEN GOTO 800
70 WAIT 16:GOTO 10
100 CLEAR("BLIP_BLACK"):GOSUB 1600
105 IF HIT_WAIT>0 THEN HIT_WAIT=HIT_WAIT-1
110 SCROLL=SCROLL+1:IF SCROLL>180 THEN SCROLL=0
120 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/CLOUD_1.PNG",36,28+SCROLL,48,22)
130 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/ISLAND_SMALL.PNG",220,42+SCROLL,40,28)
140 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/CLOUD_2.PNG",183,15+SCROLL,56,26)
145 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/CLOUD_3.PNG",78,SCROLL-88,64,28)
146 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/ISLAND_MEDIUM.PNG",14,SCROLL-115,58,40)
147 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/ISLAND_LARGE.PNG",224,SCROLL-156,72,50)
150 DRAW_HUD(SCORE,LIVES):IF BOSS_DOWN>0 THEN BOSS_DOWN=BOSS_DOWN-1:DRAW_TEXT("BOSS DOWN",160,20,2,"BLIP_YELLOW","CENTER")
151 IF MAX_POWER>0 THEN MAX_POWER=MAX_POWER-1:DRAW_TEXT("MAX POWER",160,31,2,"#FFDA40","CENTER")
160 DIR=KEY_ACTIVE("RIGHT")-KEY_ACTIVE("LEFT")
161 IF DIR*VX<0 AND VX>0 THEN VX=VX-.63
162 IF DIR*VX<0 AND VX<0 THEN VX=VX+.63
163 IF DIR=0 AND VX>0 THEN VX=VX-.63
164 IF DIR=0 AND VX<0 THEN VX=VX+.63
165 IF ABS(VX)<.63 AND (DIR=0 OR DIR*VX<0) THEN VX=0
166 IF DIR<>0 AND DIR*VX>=0 THEN VX=VX+DIR*.48
167 IF VX>2.8 THEN VX=2.8
168 IF VX<0-2.8 THEN VX=0-2.8
169 PX=PX+VX
170 IF PX<2 THEN PX=2:VX=0
171 IF PX>276 THEN PX=276:VX=0
180 IF KEY_HELD("UP")=1 AND PY>72 THEN PY=PY-2.2
190 IF KEY_HELD("DOWN")=1 AND PY<167 THEN PY=PY+2.2
200 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/PLAYER_PLANE.PNG",PX,PY,33,29)
210 FIRE_WAIT=FIRE_WAIT-1
220 IF KEY_HELD("SPACE")=1 AND FIRE_WAIT<1 THEN GOSUB 900
230 FOR B=1 TO 12
240 IF SHOT(B)=1 THEN GOSUB 1000
250 NEXT B
260 SPAWN=SPAWN+1
270 IF SPAWN>80 AND BOSS_ACTIVE=0 THEN GOSUB 1100
275 IF KILLS>=60+15*(LEVEL-1) AND BOSS_ACTIVE=0 THEN GOSUB 1650
280 FOR E=1 TO 8
290 IF ENEMY(E)=1 THEN GOSUB 1200
300 NEXT E
305 FOR Q=1 TO 6
306 IF BSHOT(Q)=1 THEN GOSUB 1400
307 NEXT Q
308 IF BOSS_ACTIVE=1 THEN GOSUB 1700
309 GOSUB 1850
310 IF LIVES<1 THEN GOTO 700
320 WAIT 16:GOTO 100
700 CLEAR("BLIP_BLACK")
710 IF WON=1 THEN DRAW_TEXT("MISSION COMPLETE",160,54,4,"BLIP_CYAN","CENTER")
711 IF WON=0 THEN DRAW_TEXT("MISSION ENDED",160,54,4,"BLIP_RED","CENTER")
720 DRAW_TEXT("FINAL SCORE",160,91,2,"BLIP_GRAY","CENTER")
730 DRAW_NUMBER(SCORE,TEXT_CX(STR$(SCORE),3),119,3,"BLIP_YELLOW")
740 DRAW_TEXT("SPACE TO FLY AGAIN",160,158,2,"BLIP_WHITE","CENTER")
750 IF KEY_PRESSED("SPACE")=1 THEN GOTO 800
760 WAIT 16:GOTO 700
800 GAME_STATE=1:SCORE=0:LIVES=3:PX=143:PY=160:VX=0:SPAWN=0:SCROLL=0:FIRE_WAIT=0:SPAWN_SLOT=0:HIT_WAIT=0:LEVEL=1:KILLS=0:BOSS_ACTIVE=0:BOSS_DEFEATED=0:WON=0:WEAPON=1:POWER_ACTIVE=0:POWER_CAUGHT=0:MAX_POWER=0:PLAY_MUSIC "SKY_RAIDER_ALT"
810 FOR B=1 TO 12:SHOT(B)=0:NEXT B
815 FOR Q=1 TO 6:BSHOT(Q)=0:NEXT Q
820 FOR E=1 TO 8:ENEMY(E)=0:ESHOT(E)=0:NEXT E
830 GOTO 100
900 GUNS=2:IF WEAPON=2 THEN GUNS=3
901 IF WEAPON=3 THEN GUNS=5
902 IF WEAPON=4 THEN GUNS=6
903 IF WEAPON>=5 THEN GUNS=8
904 FOR F=1 TO GUNS
910 FIRE_SLOT=0
915 FOR B=1 TO 12
920 IF SHOT(B)=0 AND FIRE_SLOT=0 THEN FIRE_SLOT=B
930 NEXT B
940 IF FIRE_SLOT=0 THEN GOTO 955
945 B=FIRE_SLOT:SHOT(B)=1:BX(B)=PX+15+(F-(GUNS+1)/2)*4:BY(B)=PY:BT(B)=70:FIRE_WAIT=11-INT((WEAPON+1)/2)
955 NEXT F
960 IF WEAPON=1 THEN PLAY_SFX "SKY_RAIDER/BURST1_1"
961 IF WEAPON=2 THEN PLAY_SFX "SKY_RAIDER/BURST2_1"
962 IF WEAPON=3 THEN PLAY_SFX "SKY_RAIDER/BURST3_1"
963 IF WEAPON=4 THEN PLAY_SFX "SKY_RAIDER/BURST4_1"
964 IF WEAPON>=5 THEN PLAY_SFX "SKY_RAIDER/BURST5_1"
965 RETURN
1000 BY(B)=BY(B)-4:BT(B)=BT(B)-1
1010 IF BY(B)<25 OR BT(B)<1 THEN SHOT(B)=0:RETURN
1020 IF WEAPON<3 THEN FILL_RECT(BX(B),BY(B),2,6,"BLIP_YELLOW")
1021 IF WEAPON=3 THEN FILL_RECT(BX(B),BY(B),2,6,"BLIP_CYAN")
1022 IF WEAPON=4 THEN FILL_RECT(BX(B),BY(B),2,6,"BLIP_ORANGE")
1023 IF WEAPON>=5 THEN FILL_RECT(BX(B),BY(B),2,6,"#FFDA40")
1025 IF SHOT(B)=1 AND BOSS_ACTIVE=1 AND BX(B)>BOSS_X AND BX(B)<BOSS_X+BOSS_W AND BY(B)<BOSS_Y+BOSS_H AND BY(B)>BOSS_Y THEN SHOT(B)=0:BOSS_HP=BOSS_HP-1:PLAY_SFX "SKY_RAIDER/ENEMY_EXPLODE0"
1026 IF BOSS_HP<1 AND BOSS_ACTIVE=1 THEN BOSS_ACTIVE=0:BOSS_DEFEATED=1:SCORE=SCORE+500*LEVEL:BOSS_DOWN=100:PLAY_SFX "SKY_RAIDER/STAGE_CLEAR"
1027 IF BOSS_DEFEATED=1 AND LEVEL<7 THEN LEVEL=LEVEL+1:KILLS=0:SPAWN=0:BOSS_DEFEATED=0:GOTO 1060
1028 IF BOSS_DEFEATED=1 AND LEVEL>=7 THEN BOSS_DEFEATED=0:WON=1:GOTO 700
1030 FOR E=1 TO 8
1040 IF SHOT(B)=1 AND ENEMY(E)=1 AND BX(B)>EX(E) AND BX(B)<EX(E)+31 AND BY(B)<EY(E)+26 AND BY(B)>EY(E) THEN ENEMY(E)=0:SHOT(B)=0:SCORE=SCORE+60+ETYPE(E)*20:KILLS=KILLS+1:PLAY_SFX "SKY_RAIDER/ENEMY_EXPLODE0":IF ETYPE(E)=3 AND POWER_ACTIVE=0 THEN POWER_ACTIVE=1:POWER_X=EX(E)+8:POWER_Y=EY(E)+8
1050 NEXT E
1060 RETURN
1100 SPAWN=0:FORMATION_X=INT(RND(160))+80:WING=-1:FORMATION_DIR=INT(RND(2))*2-1:FORMATION_TYPE=INT(RND(3))+1
1110 SPAWN_SLOT=SPAWN_SLOT+1:IF SPAWN_SLOT>8 THEN SPAWN_SLOT=1
1120 E=SPAWN_SLOT:ENEMY(E)=1:EX(E)=FORMATION_X+WING*34:EY(E)=24-WING*8:EDIR(E)=FORMATION_DIR:ETYPE(E)=FORMATION_TYPE:ESHOT(E)=45+INT(RND(55))
1130 WING=1:SPAWN_SLOT=SPAWN_SLOT+1:IF SPAWN_SLOT>8 THEN SPAWN_SLOT=1
1140 E=SPAWN_SLOT:ENEMY(E)=1:EX(E)=FORMATION_X+WING*34:EY(E)=24-WING*8:EDIR(E)=FORMATION_DIR:ETYPE(E)=FORMATION_TYPE:ESHOT(E)=45+INT(RND(55)):RETURN
1200 EY(E)=EY(E)+1.1
1210 IF ETYPE(E)=1 THEN EX(E)=EX(E)+EDIR(E)*0.7
1215 IF ETYPE(E)=2 THEN EX(E)=EX(E)+SIN(EY(E)*0.06+E)*1.5
1216 IF ETYPE(E)=3 AND PX>EX(E) THEN EX(E)=EX(E)+0.85
1217 IF ETYPE(E)=3 AND PX<EX(E) THEN EX(E)=EX(E)-0.85
1218 IF EX(E)<8 OR EX(E)>289 THEN EDIR(E)=0-EDIR(E)
1220 IF ETYPE(E)=1 THEN DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/ENEMY_GRUNT.PNG",EX(E),EY(E),31,26)
1222 IF ETYPE(E)=2 THEN DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/ENEMY_WEAVER.PNG",EX(E),EY(E),31,26)
1224 IF ETYPE(E)=3 THEN DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/ENEMY_ACE.PNG",EX(E),EY(E),31,26)
1226 GOSUB 1500
1230 IF HIT_WAIT=0 AND EX(E)<PX+33 AND EX(E)+31>PX AND EY(E)<PY+29 AND EY(E)+26>PY THEN ENEMY(E)=0:LIVES=LIVES-1:HIT_WAIT=70:PLAY_SFX "SKY_RAIDER/PLAYER_HIT"
1240 IF EY(E)>194 THEN ENEMY(E)=0:IF LIVES>1 THEN LIVES=LIVES-1
1250 RETURN
1300 SCROLL=T*34-200*INT(T*34/200)
1310 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/CLOUD_1.PNG",28,SCROLL-45,48,22)
1320 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/CLOUD_2.PNG",210,SCROLL-138,56,26)
1330 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/ISLAND_SMALL.PNG",218,SCROLL-30,40,28)
1340 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/PLAYER_PLANE.PNG",143+SIN(T*0.8)*5,130,33,29)
1350 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/ENEMY_WEAVER.PNG",82+SIN(T*1.2)*24,159,31,26)
1360 RETURN
1400 EBX(Q)=EBX(Q)+EBVX(Q):EBY(Q)=EBY(Q)+EBVY(Q)
1410 IF EBY(Q)>202 THEN BSHOT(Q)=0:RETURN
1420 FILL_CIRCLE(EBX(Q),EBY(Q),2,"#FF755C")
1430 IF HIT_WAIT=0 AND EBX(Q)>PX+4 AND EBX(Q)<PX+29 AND EBY(Q)>PY+3 AND EBY(Q)<PY+29 THEN BSHOT(Q)=0:LIVES=LIVES-1:HIT_WAIT=48:PLAY_SFX "SKY_RAIDER/PLAYER_HIT":RETURN
1440 RETURN
1500 IF ESHOT(E)>0 THEN ESHOT(E)=ESHOT(E)-1:RETURN
1510 ESHOT(E)=68+INT(RND(46)):FIRE_BALL=0
1520 FOR Q=1 TO 6
1530 IF BSHOT(Q)=0 AND FIRE_BALL=0 THEN FIRE_BALL=Q
1540 NEXT Q
1550 IF FIRE_BALL=0 THEN RETURN
1560 Q=FIRE_BALL:DX=PX+12-(EX(E)+10):DY=PY-(EY(E)+13):DIST=SQR(DX*DX+DY*DY):IF DIST<1 THEN DIST=1
1570 EBX(Q)=EX(E)+10:EBY(Q)=EY(E)+13:EBVX(Q)=DX/DIST*1.8:EBVY(Q)=DY/DIST*1.8:BSHOT(Q)=1:PLAY_SFX "SKY_RAIDER/ENEMY_GUN":RETURN
1600 FOR W=0 TO 13:DEPTH=W/13:SEA=COLOR(0.10-0.07*DEPTH,0.24-0.13*DEPTH,0.46-0.16*DEPTH):FILL_RECT(0,W*15,320,16,SEA):NEXT W
1610 PHASE=SCROLL-30*INT(SCROLL/30)
1620 FOR W=0 TO 7:WY=W*30+PHASE:FOR X=0 TO 7:WX=X*40:WYA=WY+SIN(WX*0.045+WY*0.05)*2+SIN(WX*0.11-WY*0.14)*0.7:WYB=WY+SIN((WX+40)*0.045+WY*0.05)*2+SIN((WX+40)*0.11-WY*0.14)*0.7:DRAW_LINE(WX,WYA,WX+40,WYB,COLOR(0.6,0.8,1,0.35)):NEXT X:NEXT W
1630 FOR W=0 TO 12:WX=W*23:WY=(W*29+SCROLL)-200*INT((W*29+SCROLL)/200):FILL_CIRCLE(WX,WY,1.2,COLOR(0.85,0.94,1,0.55)):NEXT W
1640 RETURN
1650 BOSS_ACTIVE=1:BOSS_HP=24+LEVEL*6:BOSS_MAX=BOSS_HP:BOSS_W=64:BOSS_H=51:BOSS_TIME=0:BOSS_X=128:BOSS_Y=0-BOSS_H:BOSS_INTRO=80:BOSS_FIRE=35:BOSS_IMAGE$="/TAPE/GFX/SKY_RAIDER/BOSS_"+STR$(LEVEL)+".PNG"
1651 IF LEVEL=1 THEN BOSS_W=64:BOSS_H=51:BOSS_NAME$="KI-49 DONRYU"
1652 IF LEVEL=2 THEN BOSS_W=69:BOSS_H=56:BOSS_NAME$="KI-67 HIRYU"
1653 IF LEVEL=3 THEN BOSS_W=77:BOSS_H=61:BOSS_NAME$="G4M BETTY"
1654 IF LEVEL=4 THEN BOSS_W=100:BOSS_H=71:BOSS_NAME$="G8N RENZAN"
1655 IF LEVEL=5 THEN BOSS_W=109:BOSS_H=81:BOSS_NAME$="H8K EMILY"
1656 IF LEVEL=6 THEN BOSS_W=121:BOSS_H=89:BOSS_NAME$="G5N SHINZAN"
1657 IF LEVEL>=7 THEN BOSS_W=128:BOSS_H=101:BOSS_NAME$="FUGAKU"
1658 BOSS_Y=0-BOSS_H:PLAY_SFX "SKY_RAIDER/BOSS_WARNING":RETURN
1700 IF BOSS_INTRO>0 THEN BOSS_INTRO=BOSS_INTRO-1:DRAW_TEXT("WARNING",160,86,3,"BLIP_RED","CENTER"):DRAW_TEXT(BOSS_NAME$,160,108,2,"BLIP_WHITE","CENTER"):RETURN
1710 IF BOSS_Y<25 THEN BOSS_Y=BOSS_Y+1
1720 IF BOSS_Y>=25 THEN BOSS_TIME=BOSS_TIME+0.016:BOSS_X=(320-BOSS_W)/2+SIN(BOSS_TIME*0.45)*(160-BOSS_W/2-8):BOSS_Y=25+ABS(SIN(BOSS_TIME*0.5))*6
1730 DRAW_TEXTURE(BOSS_IMAGE$,BOSS_X,BOSS_Y,BOSS_W,BOSS_H)
1740 DRAW_RECT(BOSS_X,BOSS_Y-6,BOSS_W,4,"BLIP_GRAY"):FILL_RECT(BOSS_X,BOSS_Y-6,BOSS_W*BOSS_HP/BOSS_MAX,4,"BLIP_RED")
1750 IF HIT_WAIT=0 AND BOSS_X<PX+33 AND BOSS_X+BOSS_W>PX AND BOSS_Y<PY+29 AND BOSS_Y+BOSS_H>PY THEN LIVES=LIVES-1:HIT_WAIT=70:PLAY_SFX "SKY_RAIDER/PLAYER_HIT"
1755 BOSS_FIRE=BOSS_FIRE-1:IF BOSS_FIRE<1 THEN GOSUB 1760
1758 RETURN
1760 BOSS_FIRE=48:DX=PX+16-(BOSS_X+BOSS_W/2):DY=PY-(BOSS_Y+BOSS_H):DIST=SQR(DX*DX+DY*DY):IF DIST<1 THEN DIST=1
1770 FOR F=1 TO 3:FIRE_BALL=0
1780 FOR Q=1 TO 6
1790 IF BSHOT(Q)=0 AND FIRE_BALL=0 THEN FIRE_BALL=Q
1800 NEXT Q
1810 IF FIRE_BALL>0 THEN Q=FIRE_BALL:A=(F-2)*0.22:EBX(Q)=BOSS_X+BOSS_W/2:EBY(Q)=BOSS_Y+BOSS_H:EBVX(Q)=(DX*COS(A)-DY*SIN(A))/DIST*1.5:EBVY(Q)=(DX*SIN(A)+DY*COS(A))/DIST*1.5:BSHOT(Q)=1
1820 NEXT F
1830 PLAY_SFX "SKY_RAIDER/ENEMY_GUN":RETURN
1850 IF POWER_ACTIVE=0 THEN RETURN
1855 POWER_Y=POWER_Y+0.55
1860 IF POWER_Y>202 THEN POWER_ACTIVE=0:RETURN
1870 IF WEAPON<2 THEN DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/POWERUP.PNG",POWER_X,POWER_Y,14,14,"BLIP_YELLOW"):GOTO 1890
1871 IF WEAPON<4 THEN DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/POWERUP.PNG",POWER_X,POWER_Y,14,14,"BLIP_CYAN"):GOTO 1890
1872 IF WEAPON<5 THEN DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/POWERUP.PNG",POWER_X,POWER_Y,14,14,"BLIP_ORANGE"):GOTO 1890
1873 DRAW_TEXTURE("/TAPE/GFX/SKY_RAIDER/POWERUP.PNG",POWER_X,POWER_Y,14,14,"#FFDA40")
1890 IF PX<POWER_X+14 AND PX+33>POWER_X AND PY<POWER_Y+14 AND PY+29>POWER_Y THEN POWER_ACTIVE=0:WEAPON=WEAPON+1:POWER_CAUGHT=1
1891 IF POWER_CAUGHT=1 THEN GOSUB 1910
1892 POWER_CAUGHT=0
1900 RETURN
1910 IF WEAPON>5 THEN WEAPON=5:MAX_POWER=120:SCORE=SCORE+30*WEAPON:PLAY_SFX "SKY_RAIDER/POWERUP2":RETURN
1920 SCORE=SCORE+30*WEAPON
1930 IF WEAPON=2 THEN PLAY_SFX "SKY_RAIDER/POWERUP2"
1940 IF WEAPON=3 THEN PLAY_SFX "SKY_RAIDER/POWERUP3"
1950 IF WEAPON=4 THEN PLAY_SFX "SKY_RAIDER/POWERUP4"
1960 IF WEAPON=5 THEN MAX_POWER=120:PLAY_SFX "SKY_RAIDER/MAX_POWER"
1970 RETURN
