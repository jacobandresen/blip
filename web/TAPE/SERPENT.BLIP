1 REM FLOW: TITLE 10 -> NEW GAME 800 -> PLAY 110 -> LOST LIFE 550.
2 REM MODULES: TURNS 780; OBSTACLES 860; PICKUPS 400/910/980; ART 920.
3 REM STATE: BODY_X/BODY_Y HOLD THE SNAKE; TWO QUEUED TURNS BRIDGE STEPS.
5 REM GAME: SERPENT
10 REM SERPENT - TITLE AND WINDING ATTRACT SNAKE
11 CANVAS(480,508):PLAY_MUSIC "SERPENT_MAIN":CLEAR("BLIP_BLACK"):TT=TIME()
20 GAME_STATE=0
30 SCORE=0
40 DRAW_TEXT("SERPENT",240,127,6,"BLIP_GREEN","CENTER")
60 DRAW_TEXT(CONTROL_TEXT$("ARROW KEYS OR WASD","STEER WITH THE PAD","SWIPE TO STEER"),240,338,2,"BLIP_GRAY","CENTER")
70 DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE","PRESS FIRE","TAP TO START"),240,254,3,"BLIP_WHITE","CENTER"):GOSUB 1000
80 IF KEY_PRESSED("SPACE")=1 THEN GOTO 800
90 WAIT 16
100 GOTO 10
109 REM --- PLAY LOOP - FIELD, INPUT QUEUE, AND STEP TIMER ---
110 CANVAS(320,200):CLEAR("BLIP_BLACK")
115 GOSUB 920
116 IF BONUS_TIME>0 THEN BONUS_TIME=BONUS_TIME-0.016:IF BONUS_TIME<0 THEN BONUS_TIME=0
117 IF SHEARS_TIME>0 THEN SHEARS_TIME=SHEARS_TIME-0.016:IF SHEARS_TIME<0 THEN SHEARS_TIME=0
120 IF KEY_ACTIVE("UP")=1 OR KEY_ACTIVE("W")=1 THEN NDX=0:NDY=-1:GOSUB 780
130 IF KEY_ACTIVE("DOWN")=1 OR KEY_ACTIVE("S")=1 THEN NDX=0:NDY=1:GOSUB 780
140 IF KEY_ACTIVE("LEFT")=1 OR KEY_ACTIVE("A")=1 THEN NDX=-1:NDY=0:GOSUB 780
150 IF KEY_ACTIVE("RIGHT")=1 OR KEY_ACTIVE("D")=1 THEN NDX=1:NDY=0:GOSUB 780
160 FRAME_TIME=FRAME_TIME+0.016
170 IF FRAME_TIME<MOVE_DELAY THEN GOTO 300
179 REM --- SNAKE STEP - APPLY THE NEXT QUEUED TURN ---
180 FRAME_TIME=FRAME_TIME-MOVE_DELAY:IF QN>0 THEN DIR_X=QX(1):DIR_Y=QY(1):QX(1)=QX(2):QY(1)=QY(2):QN=QN-1
190 NX=HEAD_X+DIR_X
200 NY=HEAD_Y+DIR_Y
209 REM --- COLLISIONS - WALLS, BODY, AND LEVEL OBSTACLES ---
210 IF NX<1 OR NX>20 OR NY<1 OR NY>20 THEN GOTO 550
215 COLLIDED=0
220 FOR SEGMENT=2 TO BODY_LENGTH-1
230 IF BODY_X(SEGMENT)=NX AND BODY_Y(SEGMENT)=NY THEN COLLIDED=1
240 NEXT SEGMENT
242 FOR OB=1 TO OB_COUNT
243 IF OX(OB)>0 AND OX(OB)=NX AND OY(OB)=NY THEN COLLIDED=1
244 NEXT OB
245 IF COLLIDED=1 THEN GOTO 550
249 REM --- PICKUPS - FOOD, BONUS FRUIT, SHEARS, AND LEVEL PROGRESS ---
250 ATE_FOOD=0:STEPS_SINCE_FOOD=STEPS_SINCE_FOOD+1
255 IF BONUS_TIME>0 AND NX=BONUS_X AND NY=BONUS_Y THEN SCORE=SCORE+50*LEVEL:BONUS_TIME=0:PLAY_SFX "SERPENT/BONUS_EAT"
256 IF SHEARS_TIME>0 AND NX=SHEARS_X AND NY=SHEARS_Y THEN SHEARS_TIME=0:BODY_LENGTH=BODY_LENGTH-4:PLAY_SFX "SERPENT/BONUS_EAT"
257 IF BODY_LENGTH<3 THEN BODY_LENGTH=3
260 IF NX=FOOD_X AND NY=FOOD_Y THEN ATE_FOOD=1:FOODS=FOODS+1
262 IF ATE_FOOD=1 AND STEPS_SINCE_FOOD<=22 THEN STREAK=STREAK+1:IF STREAK>5 THEN STREAK=5
263 IF ATE_FOOD=1 AND STEPS_SINCE_FOOD>22 THEN STREAK=1
264 IF ATE_FOOD=1 THEN SCORE=SCORE+10*LEVEL*STREAK:STEPS_SINCE_FOOD=0:EVENLEVEL=INT(LEVEL/2)*2
265 IF ATE_FOOD=1 AND FOODS=1 AND LEVEL>=6 AND EVENLEVEL=LEVEL AND BODY_LENGTH>=25 AND SHEARS_TIME=0 THEN SHEARS_TRY=0:GOSUB 980
266 IF ATE_FOOD=1 AND FOODS=3 AND BONUS_TIME=0 THEN BONUS_TRY=0:GOSUB 910
267 IF ATE_FOOD=1 AND FOODS>=5 THEN FOODS=0:LEVEL=LEVEL+1:MOVE_DELAY=MOVE_DELAY-0.01
268 IF MOVE_DELAY<0.07 THEN MOVE_DELAY=0.07
269 IF ATE_FOOD=1 AND FOODS=0 THEN GOSUB 860
270 IF ATE_FOOD=1 THEN BODY_LENGTH=BODY_LENGTH+1
280 FOR SEGMENT=BODY_LENGTH TO 2 STEP -1
290 BODY_X(SEGMENT)=BODY_X(SEGMENT-1):BODY_Y(SEGMENT)=BODY_Y(SEGMENT-1)
295 NEXT SEGMENT
296 HEAD_X=NX:HEAD_Y=NY:BODY_X(1)=HEAD_X:BODY_Y(1)=HEAD_Y
297 IF ATE_FOOD=1 THEN GOTO 400
299 REM --- DRAW PICKUPS, OBSTACLES, AND THE INTERPOLATED BODY ---
300 DRAW_TEXTURE("/TAPE/GFX/SERPENT/FOOD.PNG",72+FOOD_X*8,20+FOOD_Y*8,8,8):IF BONUS_TIME>0 THEN GOSUB 950
301 IF SHEARS_TIME>0 THEN GOSUB 991
302 FOR OB=1 TO OB_COUNT
304 IF OX(OB)>0 THEN FILL_RECT(72+OX(OB)*8,20+OY(OB)*8,8,8,"BLIP_GRAY")
306 IF OX(OB)>0 THEN DRAW_LINE(72+OX(OB)*8,20+OY(OB)*8,80+OX(OB)*8,20+OY(OB)*8,"BLIP_WHITE")
308 NEXT OB
310 GLIDE=CLAMP(FRAME_TIME/MOVE_DELAY,0,1)
311 FOR SEGMENT=BODY_LENGTH TO 1 STEP -1
312 PREV_X=2*BODY_X(SEGMENT)-BODY_X(SEGMENT-1):PREV_Y=2*BODY_Y(SEGMENT)-BODY_Y(SEGMENT-1)
313 IF SEGMENT<BODY_LENGTH THEN PREV_X=BODY_X(SEGMENT+1):PREV_Y=BODY_Y(SEGMENT+1)
320 SEGMENT_X=76+(LERP(PREV_X,BODY_X(SEGMENT),GLIDE))*8:SEGMENT_Y=24+(LERP(PREV_Y,BODY_Y(SEGMENT),GLIDE))*8
325 SHADE=SEGMENT/BODY_LENGTH:BODY_COLOR=COLOR(0.36-0.20*SHADE,0.86-0.36*SHADE,0.36-0.16*SHADE)
326 IF SEGMENT<BODY_LENGTH THEN DRAW_LINE_EX(TAIL_X,TAIL_Y,SEGMENT_X,SEGMENT_Y,6,BODY_COLOR)
330 FILL_RECT(SEGMENT_X-3,SEGMENT_Y-3,6,6,BODY_COLOR):TAIL_X=SEGMENT_X:TAIL_Y=SEGMENT_Y
340 NEXT SEGMENT
350 SEGMENT_X=TAIL_X:SEGMENT_Y=TAIL_Y
360 FILL_RECT(SEGMENT_X-3.33,SEGMENT_Y-3.33,6.66,6.66,COLOR(0.45,0.95,0.45))
365 IF FRAME_TIME<0.03 THEN DRAW_LINE_EX(SEGMENT_X+DIR_X*3,SEGMENT_Y+DIR_Y*3,SEGMENT_X+DIR_X*5,SEGMENT_Y+DIR_Y*5,0.67,"BLIP_RED")
370 FOR SIDE=-1 TO 1 STEP 2:EX=SEGMENT_X+DIR_X*1.33-DIR_Y*SIDE*1.67:EY=SEGMENT_Y+DIR_Y*1.33+DIR_X*SIDE*1.67
380 FILL_CIRCLE(EX,EY,1.07,"BLIP_WHITE"):FILL_CIRCLE(EX+DIR_X*0.4,EY+DIR_Y*0.4,0.53,"BLIP_BLACK"):NEXT SIDE
390 DRAW_HUD(SCORE,LIVES):DRAW_TEXT("LEVEL "+STR$(LEVEL),160,191,1,"BLIP_CYAN","CENTER")
395 WAIT 16:GOTO 110
399 REM --- FOOD SPAWN - REJECT OCCUPIED CELLS ---
400 FOOD_X=INT(RND(20))+1:FOOD_Y=INT(RND(20))+1:FOOD_BLOCKED=0
410 FOR SEGMENT=1 TO BODY_LENGTH
420 IF BODY_X(SEGMENT)=FOOD_X AND BODY_Y(SEGMENT)=FOOD_Y THEN FOOD_BLOCKED=1
430 NEXT SEGMENT
435 FOR OB=1 TO OB_COUNT
436 IF OX(OB)>0 AND OX(OB)=FOOD_X AND OY(OB)=FOOD_Y THEN FOOD_BLOCKED=1
437 NEXT OB
440 IF FOOD_BLOCKED=1 THEN GOTO 400
470 PLAY_SFX "SERPENT/EAT"
471 IF LEVEL>=5 THEN PLAY_MUSIC "SERPENT_FRENZY"
480 GOTO 300
500 END
549 REM --- LOST LIFE - DELAY, RESET, OR GAME OVER ---
550 PLAY_SFX "SERPENT/GAME_OVER":LIVES=LIVES-1:BONUS_TIME=0:SHEARS_TIME=0:STREAK=0:STEPS_SINCE_FOOD=100:DEAD_TIME=90:GOTO 600
600 CLEAR("BLIP_BLACK"):DEAD_TIME=DEAD_TIME-1
610 IF INT(DEAD_TIME/6)*6=DEAD_TIME THEN GOTO 640
620 FOR SEGMENT=BODY_LENGTH TO 1 STEP -1
630 FILL_CIRCLE(76+BODY_X(SEGMENT)*8,24+BODY_Y(SEGMENT)*8,3.5,"BLIP_RED")
635 NEXT SEGMENT
640 DRAW_HUD(SCORE,LIVES)
650 IF DEAD_TIME>0 THEN WAIT 16:GOTO 600
660 IF LIVES<1 THEN GOTO 700
670 BODY_LENGTH=4:HEAD_X=10:HEAD_Y=10:DIR_X=1:DIR_Y=0:FRAME_TIME=0:QN=0
680 FOR SEGMENT=1 TO BODY_LENGTH
685 BODY_X(SEGMENT)=HEAD_X-SEGMENT+1:BODY_Y(SEGMENT)=HEAD_Y
687 NEXT SEGMENT
690 GOTO 110
699 REM --- GAME OVER AND RESTART ---
700 GAME_STATE=2
710 CLEAR("BLIP_BLACK")
720 DRAW_TEXT("GAME OVER",160,54,4,"BLIP_RED","CENTER")
730 DRAW_TEXT("FINAL SCORE",160,91,2,"BLIP_GRAY","CENTER")
740 DRAW_NUMBER(SCORE,TEXT_CX(STR$(SCORE),2)+32,119,2,"BLIP_YELLOW")
750 DRAW_TEXT("SPACE TO TRY AGAIN",160,158,2,"BLIP_WHITE","CENTER")
760 IF KEY_PRESSED("SPACE")=1 THEN GOTO 800
770 WAIT 16:GOTO 700
778 REM INPUT: NDX/NDY IS THE REQUESTED DIRECTION; QN COUNTS QUEUED TURNS.
779 REM --- TURN QUEUE - REJECT REVERSALS AND KEEP TWO VALID TURNS ---
780 LAST_X=DIR_X:LAST_Y=DIR_Y:IF QN>0 THEN LAST_X=QX(QN):LAST_Y=QY(QN)
781 IF QN>=2 OR (NDX=LAST_X AND NDY=LAST_Y) OR (NDX=0-LAST_X AND NDY=0-LAST_Y) THEN RETURN
782 QN=QN+1:QX(QN)=NDX:QY(QN)=NDY:RETURN
799 REM --- NEW GAME - RESET SCORE, BODY, AND TIMERS ---
800 GAME_STATE=1:SCORE=0:LIVES=3:LEVEL=1:FOODS=0:OB_COUNT=0:BODY_LENGTH=4:HEAD_X=10:HEAD_Y=10:DIR_X=1:DIR_Y=0:STEPS_SINCE_FOOD=100:STREAK=0:BONUS_TIME=0:SHEARS_TIME=0:QN=0
810 MOVE_DELAY=0.18:FRAME_TIME=0:FOOD_X=17:FOOD_Y=10
820 FOR SEGMENT=1 TO BODY_LENGTH
830 BODY_X(SEGMENT)=HEAD_X-SEGMENT+1:BODY_Y(SEGMENT)=HEAD_Y
840 NEXT SEGMENT:GOSUB 860
850 GOTO 110
859 REM --- LEVEL OBSTACLES - CYCLE THE FIVE RUST PATTERNS ---
860 OB_COUNT=0:IF LEVEL<2 THEN RETURN
865 PAT=LEVEL-2-INT((LEVEL-2)/5)*5
866 FOR OB=1 TO 16:OX(OB)=0:OY(OB)=0:NEXT OB
870 IF PAT=0 THEN OB_COUNT=5:OX(1)=9:OY(1)=10:OX(2)=10:OY(2)=10:OX(3)=11:OY(3)=10:OX(4)=10:OY(4)=9:OX(5)=10:OY(5)=11:GOSUB 890:RETURN
871 IF PAT=1 THEN OB_COUNT=8:OX(1)=9:OY(1)=9:OX(2)=10:OY(2)=9:OX(3)=11:OY(3)=9:OX(4)=9:OY(4)=10:OX(5)=11:OY(5)=10:OX(6)=9:OY(6)=11:OX(7)=10:OY(7)=11:OX(8)=11:OY(8)=11:GOSUB 890:RETURN
872 IF PAT=2 THEN OB_COUNT=8:OX(1)=6:OY(1)=7:OX(2)=6:OY(2)=9:OX(3)=6:OY(3)=11:OX(4)=6:OY(4)=13:OX(5)=14:OY(5)=7:OX(6)=14:OY(6)=9:OX(7)=14:OY(7)=11:OX(8)=14:OY(8)=13:GOSUB 890:RETURN
873 IF PAT=3 THEN OB_COUNT=16:OX(1)=3:OY(1)=3:OX(2)=4:OY(2)=3:OX(3)=3:OY(3)=4:OX(4)=4:OY(4)=4:OX(5)=16:OY(5)=3:OX(6)=17:OY(6)=3:OX(7)=16:OY(7)=4:OX(8)=17:OY(8)=4:OX(9)=3:OY(9)=16:OX(10)=4:OY(10)=16:OX(11)=3:OY(11)=17:OX(12)=4:OY(12)=17:OX(13)=16:OY(13)=16:OX(14)=17:OY(14)=16:OX(15)=16:OY(15)=17:OX(16)=17:OY(16)=17:GOSUB 890:RETURN
874 OB_COUNT=12:OX(1)=2:OY(1)=2:OX(2)=4:OY(2)=4:OX(3)=6:OY(3)=6:OX(4)=14:OY(4)=14:OX(5)=16:OY(5)=16:OX(6)=18:OY(6)=18:OX(7)=2:OY(7)=18:OX(8)=4:OY(8)=16:OX(9)=6:OY(9)=14:OX(10)=14:OY(10)=6:OX(11)=16:OY(11)=4:OX(12)=18:OY(12)=2:GOSUB 890:RETURN
889 REM --- OBSTACLE CLEANUP - LEAVE THE SNAKE A SAFE START ---
890 FOR OB=1 TO OB_COUNT
891 FOR SEGMENT=1 TO BODY_LENGTH
892 IF OX(OB)=BODY_X(SEGMENT) AND OY(OB)=BODY_Y(SEGMENT) THEN OX(OB)=0
893 IF OX(OB)=HEAD_X+DIR_X AND OY(OB)=HEAD_Y+DIR_Y THEN OX(OB)=0
894 IF OX(OB)=HEAD_X+DIR_X*2 AND OY(OB)=HEAD_Y+DIR_Y*2 THEN OX(OB)=0
895 IF OX(OB)=HEAD_X+DIR_X*3 AND OY(OB)=HEAD_Y+DIR_Y*3 THEN OX(OB)=0
896 NEXT SEGMENT
897 NEXT OB
898 RETURN
909 REM --- BONUS FRUIT SPAWN - FIND AN EMPTY CELL ---
910 BONUS_TRY=BONUS_TRY+1:IF BONUS_TRY>20 THEN BONUS_TIME=0:RETURN
911 BONUS_X=INT(RND(20))+1:BONUS_Y=INT(RND(20))+1:BONUS_BLOCKED=0
912 IF BONUS_X=FOOD_X AND BONUS_Y=FOOD_Y THEN BONUS_BLOCKED=1
913 FOR SEGMENT=1 TO BODY_LENGTH:IF BODY_X(SEGMENT)=BONUS_X AND BODY_Y(SEGMENT)=BONUS_Y THEN BONUS_BLOCKED=1
914 NEXT SEGMENT
915 FOR OB=1 TO OB_COUNT:IF OX(OB)=BONUS_X AND OY(OB)=BONUS_Y THEN BONUS_BLOCKED=1
916 NEXT OB
917 IF BONUS_BLOCKED=1 THEN GOTO 910
918 BONUS_TIME=6:BONUS_TRY=0:PLAY_SFX "SERPENT/BONUS":RETURN
919 REM --- BOARD ART - GRID AND WALLS ---
920 FOR GX=0 TO 160 STEP 8:DRAW_LINE(80+GX,28,80+GX,188,"#121212"):NEXT GX
930 FOR GY=0 TO 160 STEP 8:DRAW_LINE(80,28+GY,240,28+GY,"#121212"):NEXT GY
940 WALL_COLOR=COLOR(0.20,0.42,0.20):FILL_RECT(80,28,160,1,WALL_COLOR):FILL_RECT(80,187,160,1,WALL_COLOR):FILL_RECT(80,28,1,160,WALL_COLOR):FILL_RECT(239,28,1,160,WALL_COLOR):RETURN
949 REM --- BONUS FRUIT ART ---
950 BONUS_PX=76+BONUS_X*8:BONUS_PY=24+BONUS_Y*8:FILL_GLOW_CIRCLE(BONUS_PX,BONUS_PY,4,"NEON_YELLOW")
960 DRAW_LINE(BONUS_PX,BONUS_PY-3,BONUS_PX+3,BONUS_PY,"BLIP_YELLOW"):DRAW_LINE(BONUS_PX+3,BONUS_PY,BONUS_PX,BONUS_PY+3,"BLIP_YELLOW")
970 DRAW_LINE(BONUS_PX,BONUS_PY+3,BONUS_PX-3,BONUS_PY,"BLIP_YELLOW"):DRAW_LINE(BONUS_PX-3,BONUS_PY,BONUS_PX,BONUS_PY-3,"BLIP_YELLOW"):RETURN
979 REM --- SHEARS SPAWN - FIND AN EMPTY CELL ---
980 SHEARS_TRY=SHEARS_TRY+1:IF SHEARS_TRY>64 THEN RETURN
981 SHEARS_X=INT(RND(20))+1:SHEARS_Y=INT(RND(20))+1:SHEARS_BLOCKED=0
982 IF SHEARS_X=FOOD_X AND SHEARS_Y=FOOD_Y THEN SHEARS_BLOCKED=1
983 IF SHEARS_X=NX AND SHEARS_Y=NY THEN SHEARS_BLOCKED=1
984 FOR SEGMENT=1 TO BODY_LENGTH:IF BODY_X(SEGMENT)=SHEARS_X AND BODY_Y(SEGMENT)=SHEARS_Y THEN SHEARS_BLOCKED=1
985 NEXT SEGMENT
986 FOR OB=1 TO OB_COUNT:IF OX(OB)=SHEARS_X AND OY(OB)=SHEARS_Y THEN SHEARS_BLOCKED=1
987 NEXT OB
988 IF BONUS_TIME>0 AND SHEARS_X=BONUS_X AND SHEARS_Y=BONUS_Y THEN SHEARS_BLOCKED=1
989 IF SHEARS_BLOCKED=1 THEN GOTO 980
990 SHEARS_TIME=7:RETURN
991 SHEARS_PX=76+SHEARS_X*8:SHEARS_PY=24+SHEARS_Y*8:FILL_GLOW_CIRCLE(SHEARS_PX,SHEARS_PY,5,"#72D8FFFF")
992 DRAW_LINE(SHEARS_PX-3,SHEARS_PY-3,SHEARS_PX+3,SHEARS_PY+3,"#72D8FFFF"):DRAW_LINE(SHEARS_PX-3,SHEARS_PY+3,SHEARS_PX+3,SHEARS_PY-3,"#72D8FFFF"):RETURN
999 REM --- TITLE SNAKE - NATIVE RUST MOTION AND COLORS ---
1000 FOR I=15 TO 0 STEP -1
1010 SX=TT*90-I*11:SX=SX-640*INT(SX/640)-80
1020 SY=421.64+SIN(SX*0.035)*18:K=I/16
1030 FILL_CIRCLE(SX,SY,9-K*3,COLOR(0.36-0.20*K,0.86-0.36*K,0.36-0.16*K))
1040 NEXT I
1050 SX=TT*90:SX=SX-640*INT(SX/640)-80:SY=421.64+SIN(SX*0.035)*18
1060 FILL_CIRCLE(SX+3,SY-4,2.6,"BLIP_WHITE"):FILL_CIRCLE(SX+4,SY-4,1.3,"BLIP_BLACK")
1070 RETURN
