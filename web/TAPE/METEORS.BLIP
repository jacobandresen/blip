1 REM METEORS - SHOOT THE ROCKS; BIG ONES BREAK INTO SMALLER, FASTER ONES.
2 REM GAME: METEORS
3 REM LEFT/RIGHT TURN, UP THRUSTS, SPACE FIRES, Z JUMPS TO HYPERSPACE.
4 REM SCREENS: TITLE, PLAY, DEAD, OVER - EACH HAS AN UPDATE AND A DRAW.
5 REM ROCK(I) IS 0 WHEN THE SLOT IS FREE, ELSE ITS SIZE: 1 LARGE, 2 MEDIUM, 3 SMALL.
10 REM --- SETUP ---
11 ASSETS$="/TAPE/METEORS/ASSETS/"
15 TOP=28:FIELD_W=640:FIELD_H=372
20 TURN_RATE=3.6:ACCEL=260:MAX_SPEED=340
25 SHIP_R=9:SAFE_R=90
27 INVULN_TIME=2.5:RESPAWN_TIME=1.6
30 SHOTS=10:SHOT_SPEED=460
32 SHOT_LIFE=0.85:FIRE_GAP=0.22
35 ROCKS=48:EXTRA_LIFE=10000
40 SAUCER_SPEED=90:TELL=0.4
45 LOAD_ROCK_SIZES
80 PLAY_MUSIC ASSETS$+"DRIFT.WAV"
85 STATE$="TITLE"
90 LAST_TIME=TIME()
100 REM --- MAIN LOOP - UPDATE THE SCREEN WE ARE ON, THEN DRAW IT ---
110 NOW=TIME()
111 DT=CLAMP(NOW-LAST_TIME,0.0001,0.05)
112 LAST_TIME=NOW
120 READ_KEYS
130 IF STATE$="TITLE" THEN
131   UPDATE_TITLE
132 ELSEIF STATE$="PLAY" THEN
133   UPDATE_PLAY
134 ELSEIF STATE$="DEAD" THEN
135   UPDATE_DEAD
136 ELSE
137   UPDATE_OVER
138 END IF
150 IF STATE$="TITLE" THEN
151   DRAW_TITLE
152 ELSEIF STATE$="OVER" THEN
153   DRAW_OVER
154 ELSE
155   DRAW_PLAY
156 END IF
170 WAIT 0
180 GOTO 110
1000 REM --- TITLE ---
1010 SUB UPDATE_TITLE
1020   IF FIRE THEN START_GAME
1030 END SUB
1100 SUB DRAW_TITLE
1110   LOCAL T
1120   T=TIME()
1130   CLEAR("BLIP_BLACK")
1140   DRAW_HORIZON
1150   DRAW_TEXTURE(ASSETS$+"TITLE_ROCK_LARGE.PNG",76,272,88,88,0,1,0,1,T*0.16)
1160   DRAW_TEXTURE(ASSETS$+"TITLE_ROCK_MEDIUM.PNG",500,290,60,60,0,1,0,1,-T*0.22)
1170   DRAW_TEXTURE(ASSETS$+"TITLE_SHIP.PNG",298+SIN(T*0.5)*12,300,44,44,0,1,0,1,SIN(T*0.35)*0.12)
1180   DRAW_TEXT("METEORS",320,80,6,"NEON_CYAN","CENTER")
1190   DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE","PRESS FIRE","TAP TO START"),320,160,3,"NEON_YELLOW","CENTER")
1200   DRAW_TEXT(CONTROL_TEXT$("ARROWS OR WASD: TURN AND THRUST","PAD TURNS, UP THRUSTS","DRAG TO STEER"),320,212,2,"BLIP_GRAY","CENTER")
1210   DRAW_TEXT(CONTROL_TEXT$("SPACE FIRES, Z IS HYPERSPACE","BUTTONS FIRE AND HYPERSPACE","BUTTONS FIRE AND HYPERSPACE"),320,232,2,"BLIP_GRAY","CENTER")
1220 END SUB
2000 REM --- START - A NEW GAME, EACH WAVE, AND THE SHIP ---
2010 SUB START_GAME
2020   SCORE=0:LIVES=3
2030   WAVE=1
2040   NEXT_LIFE=EXTRA_LIFE
2050   CLEAR_SHOTS
2060   SAUCER_ON=0
2070   SAUCER_WAIT=FNSAUCER_WAIT(1)
2080   FX_CLEAR()
2090   RESPAWN_SHIP
2100   START_WAVE
2110   PLAY_MUSIC ASSETS$+"DRIFT.WAV"
2120   STATE$="PLAY"
2130 END SUB
2200 REM A WAVE IS TWO MORE LARGE ROCKS THAN THE WAVE NUMBER, CLEAR OF THE SHIP
2210 SUB START_WAVE
2220   LOCAL K,X,Y
2230   CLEAR_ROCKS
2240   WAVE_TIME=0
2250   FOR K=1 TO MIN(WAVE+2,12)
2260     FIND_CLEAR_SPOT
2265     RANDOM_VELOCITY 1
2270     SPAWN_ROCK 1,SPOT_X,SPOT_Y,VEL_X,VEL_Y
2280   NEXT K
2290   IF WAVE=5 THEN PLAY_MUSIC ASSETS$+"STORM.WAV"
2300 END SUB
2400 SUB RESPAWN_SHIP
2410   SHIP_X=FIELD_W/2:SHIP_Y=TOP+FIELD_H/2
2420   SHIP_VX=0:SHIP_VY=0
2430   SHIP_ANGLE=0
2440   INVULN=INVULN_TIME
2450   SHIP_ON=1
2460 END SUB
2500 REM A RANDOM SPOT AT LEAST SAFE_R FROM THE SHIP, OR FROM THE MIDDLE IF IT IS GONE
2510 SUB FIND_CLEAR_SPOT
2520   LOCAL CX,CY
2530   CX=FIELD_W/2:CY=TOP+FIELD_H/2
2540   IF SHIP_ON THEN CX=SHIP_X:CY=SHIP_Y
2550   SPOT_X=CX:SPOT_Y=CY
2560   WHILE DISTANCE(SPOT_X,SPOT_Y,CX,CY)<=SAFE_R
2570     SPOT_X=RND(FIELD_W)
2580     SPOT_Y=TOP+RND(FIELD_H)
2590   WEND
2600 END SUB
2700 REM A ROCK IN THE FIRST FREE SLOT
2710 SUB SPAWN_ROCK(SIZE,X,Y,VX,VY)
2720   LOCAL I,K
2730   FOR I=1 TO ROCKS
2740     IF ROCK(I)=0 THEN EXIT FOR
2750   NEXT I
2760   IF I>ROCKS THEN EXIT SUB
2830   ROCK(I)=SIZE
2840   ROCK_X(I)=X:ROCK_Y(I)=Y
2850   ROCK_VX(I)=VX:ROCK_VY(I)=VY
2860   ROCK_SPIN(I)=RND(3)-1.5
2870   ROCK_TURN(I)=RND(6.283185)
2880   FOR K=1 TO 10
2890     JAG(I,K)=0.75+RND(0.5)
2900   NEXT K
2910 END SUB
2950 REM ANY DIRECTION, AT A SPEED FOR THE ROCK'S SIZE
2960 SUB RANDOM_VELOCITY(SIZE)
2970   LOCAL DIRECTION,SPEED
2975   DIRECTION=RND(6.283185)
2980   SPEED=FNROCK_SPEED(SIZE)
2985   VEL_X=COS(DIRECTION)*SPEED
2990   VEL_Y=SIN(DIRECTION)*SPEED
2995 END SUB
3000 REM --- PLAY - THE SHIP, THEN THE REST OF THE FIELD, THEN WHAT HIT THE SHIP ---
3010 SUB UPDATE_PLAY
3020   IF SHIP_ON THEN FLY_SHIP
3030   UPDATE_WORLD
3040   IF SHIP_ON AND INVULN<=0 THEN CHECK_SHIP
3050 END SUB
3100 REM LIGHT DRAG: A FRICTIONLESS HULL IS UNFORGIVING TO STEER
3110 SUB FLY_SHIP
3120   LOCAL DRAG,SPEED
3130   SHIP_ANGLE=SHIP_ANGLE+(TURN_RIGHT-TURN_LEFT)*TURN_RATE*DT
3140   IF THRUST THEN
3150     SHIP_VX=SHIP_VX+SIN(SHIP_ANGLE)*ACCEL*DT
3160     SHIP_VY=SHIP_VY-COS(SHIP_ANGLE)*ACCEL*DT
3170     THRUST_SOUND=THRUST_SOUND-DT
3180     IF THRUST_SOUND<=0 THEN PLAY_SFX ASSETS$+"THRUST.WAV":THRUST_SOUND=0.18
3190   END IF
3200   DRAG=EXP(-0.35*DT)
3210   SHIP_VX=SHIP_VX*DRAG:SHIP_VY=SHIP_VY*DRAG
3220   SPEED=SQR(SHIP_VX*SHIP_VX+SHIP_VY*SHIP_VY)
3230   IF SPEED>MAX_SPEED THEN SHIP_VX=SHIP_VX*MAX_SPEED/SPEED:SHIP_VY=SHIP_VY*MAX_SPEED/SPEED
3240   SHIP_X=WRAP(SHIP_X+SHIP_VX*DT,0,FIELD_W)
3250   SHIP_Y=WRAP(SHIP_Y+SHIP_VY*DT,TOP,TOP+FIELD_H)
3260   FIRE_WAIT=FIRE_WAIT-DT
3270   IF SHOOT AND FIRE_WAIT<=0 THEN FIRE_SHOT
3280   IF HYPER THEN HYPERSPACE
3290   INVULN=MAX(0,INVULN-DT)
3300 END SUB
3400 SUB FIRE_SHOT
3410   LOCAL B
3420   FOR B=1 TO SHOTS
3430     IF NOT SHOT(B) THEN EXIT FOR
3440   NEXT B
3450   IF B>SHOTS THEN EXIT SUB
3460   SHOT(B)=1
3470   SHOT_X(B)=SHIP_X:SHOT_Y(B)=SHIP_Y
3480   SHOT_VX(B)=SIN(SHIP_ANGLE)*SHOT_SPEED+SHIP_VX*0.3
3490   SHOT_VY(B)=-COS(SHIP_ANGLE)*SHOT_SPEED+SHIP_VY*0.3
3500   SHOT_LEFT(B)=SHOT_LIFE
3510   FIRE_WAIT=FIRE_GAP
3520   PLAY_SFX ASSETS$+"FIRE.WAV"
3530 END SUB
3600 REM ONE JUMP IN TWENTY GOES WRONG
3610 SUB HYPERSPACE
3620   PLAY_SFX ASSETS$+"HYPERSPACE.WAV"
3630   SHIP_X=RND(FIELD_W):SHIP_Y=TOP+RND(FIELD_H)
3640   SHIP_VX=0:SHIP_VY=0
3650   IF RND(20)<1 THEN KILL_SHIP
3660 END SUB
3700 REM THE SAUCER'S SHOTS, THE ROCKS AND THE SAUCER ITSELF CAN ALL HIT THE SHIP
3710 SUB CHECK_SHIP
3720   LOCAL I
3730   IF ENEMY_SHOT AND DISTANCE(SHIP_X,SHIP_Y,ENEMY_X,ENEMY_Y)<SHIP_R THEN
3740     ENEMY_SHOT=0
3750     KILL_SHIP
3760     EXIT SUB
3770   END IF
3780   FOR I=1 TO ROCKS
3790     IF ROCK(I) AND DISTANCE(SHIP_X,SHIP_Y,ROCK_X(I),ROCK_Y(I))<ROCK_R(ROCK(I))+SHIP_R THEN
3800       BREAK_ROCK I,0,0
3810       KILL_SHIP
3820       EXIT SUB
3830     END IF
3840   NEXT I
3850   IF SAUCER_ON AND DISTANCE(SHIP_X,SHIP_Y,SAUCER_X,SAUCER_Y)<FNSAUCER_R()+SHIP_R THEN
3860     SAUCER_ON=0
3870     FX_BURST(SAUCER_X,SAUCER_Y,14,90,"NEON_PINK")
3880     KILL_SHIP
3890   END IF
3900 END SUB
4000 REM --- THE FIELD - SHOTS, ROCKS AND THE SAUCER MOVE, THEN THE SHOTS STRIKE ---
4010 SUB UPDATE_WORLD
4020   FX_UPDATE(DT)
4030   WAVE_TIME=WAVE_TIME+DT
4040   MOVE_SHOTS
4050   MOVE_ROCKS
4060   UPDATE_SAUCER
4070   SHOTS_HIT
4080   CHECK_WAVE
4090 END SUB
4100 REM THE SHIP'S SHOTS WRAP LIKE EVERYTHING ELSE; THE SAUCER'S LEAVE THE FIELD
4110 SUB MOVE_SHOTS
4120   LOCAL B
4130   FOR B=1 TO SHOTS
4140     IF SHOT(B) THEN
4150       SHOT_X(B)=WRAP(SHOT_X(B)+SHOT_VX(B)*DT,0,FIELD_W)
4160       SHOT_Y(B)=WRAP(SHOT_Y(B)+SHOT_VY(B)*DT,TOP,TOP+FIELD_H)
4170       SHOT_LEFT(B)=SHOT_LEFT(B)-DT
4180       IF SHOT_LEFT(B)<=0 THEN SHOT(B)=0
4190     END IF
4200   NEXT B
4210   IF ENEMY_SHOT THEN
4220     ENEMY_X=ENEMY_X+ENEMY_VX*DT
4230     ENEMY_Y=ENEMY_Y+ENEMY_VY*DT
4240     IF NOT FNON_FIELD(ENEMY_X,ENEMY_Y) THEN ENEMY_SHOT=0
4250   END IF
4260 END SUB
4300 SUB MOVE_ROCKS
4310   LOCAL I
4320   FOR I=1 TO ROCKS
4330     IF ROCK(I) THEN
4340       ROCK_X(I)=WRAP(ROCK_X(I)+ROCK_VX(I)*DT,0,FIELD_W)
4350       ROCK_Y(I)=WRAP(ROCK_Y(I)+ROCK_VY(I)*DT,TOP,TOP+FIELD_H)
4360       ROCK_TURN(I)=ROCK_TURN(I)+ROCK_SPIN(I)*DT
4370     END IF
4380   NEXT I
4390 END SUB
4400 REM A SHOT STRIKES WHAT IT PASSED THROUGH THIS FRAME, NOT ONLY WHERE IT LANDED
4410 SUB SHOTS_HIT
4420   LOCAL B,I
4430   FOR B=1 TO SHOTS
4440     IF SHOT(B) THEN
4450       FOR I=1 TO ROCKS
4460         IF ROCK(I) AND FNSHOT_HITS(B,ROCK_X(I),ROCK_Y(I),ROCK_R(ROCK(I))) THEN
4470           SHOT(B)=0
4480           AWARD ROCK_POINTS(ROCK(I))
4490           PLAY_SFX ASSETS$+"BANG_"+ROCK_NAME$(ROCK(I))
4500           BREAK_ROCK I,SHOT_VX(B),SHOT_VY(B)
4510           EXIT FOR
4520         END IF
4530       NEXT I
4540     END IF
4550     IF SHOT(B) AND SAUCER_ON AND FNSHOT_HITS(B,SAUCER_X,SAUCER_Y,FNSAUCER_R()) THEN
4560       SHOT(B)=0
4570       SHOOT_SAUCER
4580     END IF
4590   NEXT B
4600 END SUB
4700 REM FRAGMENTS LEAVE ALONG OPPOSITE SIDES OF A RANDOM AXIS, CARRYING THE ROCK'S MOMENTUM
4710 SUB BREAK_ROCK(I,PUSH_X,PUSH_Y)
4720   LOCAL SIZE,AXIS,SIDE,KICK,VX,VY
4730   SIZE=ROCK(I)
4740   ROCK(I)=0
4750   FX_BURST(ROCK_X(I),ROCK_Y(I),10,60,FNROCK_COLOR(I))
4760   IF SIZE=3 THEN EXIT SUB
4770   AXIS=RND(6.283185)
4775   REM A LITTLE OF THE SHOT'S MOMENTUM GOES INTO THE PIECES
4780   VX=ROCK_VX(I)+PUSH_X*0.04
4785   VY=ROCK_VY(I)+PUSH_Y*0.04
4790   FOR SIDE=-1 TO 1 STEP 2
4800     KICK=FNROCK_SPEED(SIZE+1)*0.6
4810     SPAWN_ROCK SIZE+1,ROCK_X(I)+COS(AXIS)*SIDE*6,ROCK_Y(I)+SIN(AXIS)*SIDE*6,VX+COS(AXIS)*SIDE*KICK,VY+SIN(AXIS)*SIDE*KICK
4820   NEXT SIDE
4830 END SUB
4900 REM THE LAST ROCK GONE BRINGS THE NEXT WAVE
4910 SUB CHECK_WAVE
4920   LOCAL I
4930   FOR I=1 TO ROCKS
4940     IF ROCK(I) THEN EXIT SUB
4950   NEXT I
4960   WAVE=WAVE+1
4970   START_WAVE
4980 END SUB
5000 REM --- THE SAUCER - IT CROSSES THE FIELD AND FIRES AT THE SHIP ---
5010 SUB UPDATE_SAUCER
5020   IF NOT SAUCER_ON THEN
5030     SAUCER_WAIT=SAUCER_WAIT-DT
5040     IF SAUCER_WAIT<=0 THEN SPAWN_SAUCER
5050     EXIT SUB
5060   END IF
5070   SAUCER_X=SAUCER_X+SAUCER_VX*DT
5080   SAUCER_TIME=SAUCER_TIME+DT
5090   SAUCER_Y=SAUCER_Y+SIN(SAUCER_TIME*2)*24*DT
5100   SAUCER_FIRE=SAUCER_FIRE-DT
5110   IF SAUCER_FIRE<=0 AND SHIP_ON THEN SAUCER_SHOOTS
5120   IF SAUCER_X<-40 OR SAUCER_X>FIELD_W+40 THEN SAUCER_ON=0
5130 END SUB
5200 REM SMALL SAUCERS COME LATER AND AIM BETTER
5210 SUB SPAWN_SAUCER
5220   LOCAL SMALL_CHANCE
5230   SMALL_CHANCE=MIN(0.33+(WAVE-1)*0.05,0.75)
5240   SAUCER_BIG=SCORE<5000 OR RND(1)>SMALL_CHANCE
5250   IF RND(2)<1 THEN SAUCER_X=-20:SAUCER_VX=SAUCER_SPEED ELSE SAUCER_X=FIELD_W+20:SAUCER_VX=-SAUCER_SPEED
5260   SAUCER_Y=TOP+40+RND(FIELD_H-80)
5270   SAUCER_TIME=0
5280   SAUCER_FIRE=FNFIRE_GAP(WAVE)/2
5290   SAUCER_ON=1
5300   SAUCER_WAIT=FNSAUCER_WAIT(WAVE)
5310 END SUB
5400 SUB SAUCER_SHOOTS
5410   LOCAL SPREAD,AIM
5420   IF SAUCER_BIG THEN SPREAD=0.35 ELSE SPREAD=0.04
5430   AIM=ATAN2(SHIP_Y-SAUCER_Y,SHIP_X-SAUCER_X)+RND(2*SPREAD)-SPREAD
5440   ENEMY_SHOT=1
5450   ENEMY_X=SAUCER_X:ENEMY_Y=SAUCER_Y
5460   ENEMY_VX=COS(AIM)*260:ENEMY_VY=SIN(AIM)*260
5470   SAUCER_FIRE=FNFIRE_GAP(WAVE)
5480 END SUB
5500 SUB SHOOT_SAUCER
5510   LOCAL POINTS
5520   SAUCER_ON=0
5530   IF SAUCER_BIG THEN POINTS=200 ELSE POINTS=1000
5540   FX_BURST(SAUCER_X,SAUCER_Y,14,90,"NEON_PINK")
5550   FX_POPUP(SAUCER_X,SAUCER_Y-14,STR$(POINTS),"NEON_YELLOW")
5560   AWARD POINTS
5570   IF SAUCER_BIG THEN PLAY_SFX ASSETS$+"SAUCER_BIG.WAV" ELSE PLAY_SFX ASSETS$+"SAUCER_SMALL.WAV"
5580 END SUB
5600 REM LATER WAVES BRING THE SAUCER SOONER AND LET IT FIRE FASTER
5610 DEF FNSAUCER_WAIT(W)=FNBETWEEN(MAX(4,9-MIN(W-1,6)*0.6),MAX(8,18-MIN(W-1,6)*1.2))
5620 DEF FNFIRE_GAP(W)=MAX(0.7,1.4-MIN(W-1,6)*0.12)
5630 DEF FNSAUCER_R()=7+5*SAUCER_BIG
6000 REM --- SCORING, AND LOSING THE SHIP ---
6010 SUB AWARD(POINTS)
6020   SCORE=SCORE+POINTS
6030   IF SCORE>=NEXT_LIFE THEN
6040     LIVES=LIVES+1
6050     NEXT_LIFE=NEXT_LIFE+EXTRA_LIFE
6060     PLAY_SFX ASSETS$+"EXTRA_LIFE.WAV"
6070     FX_POPUP(SHIP_X,SHIP_Y-24,"EXTRA LIFE","NEON_CYAN")
6080   END IF
6090 END SUB
6100 SUB KILL_SHIP
6110   IF NOT SHIP_ON THEN EXIT SUB
6120   PLAY_SFX ASSETS$+"SHIP_EXPLOSION.WAV"
6130   SHIP_ON=0
6140   FX_BURST(SHIP_X,SHIP_Y,16,110,"NEON_CYAN")
6150   LIVES=LIVES-1
6160   IF LIVES>0 THEN
6170     STATE$="DEAD"
6180     WAIT_LEFT=RESPAWN_TIME
6190   ELSE
6200     STATE$="OVER"
6210     WAIT_LEFT=2
6220   END IF
6230 END SUB
7000 REM --- DEAD - THE FIELD PLAYS ON; THE SHIP RETURNS WHEN THE MIDDLE IS CLEAR ---
7010 SUB UPDATE_DEAD
7020   LOCAL I,CLEAR
7030   UPDATE_WORLD
7040   WAIT_LEFT=WAIT_LEFT-DT
7050   IF WAIT_LEFT>0 THEN EXIT SUB
7060   CLEAR=1
7070   FOR I=1 TO ROCKS
7080     IF ROCK(I) AND DISTANCE(ROCK_X(I),ROCK_Y(I),FIELD_W/2,TOP+FIELD_H/2)<=SAFE_R THEN CLEAR=0
7090   NEXT I
7100   IF CLEAR THEN
7110     RESPAWN_SHIP
7120     STATE$="PLAY"
7130   ELSE
7140     WAIT_LEFT=0.4
7150   END IF
7160 END SUB
8000 REM --- DRAWING - VECTOR LINES ON BLACK ---
8010 SUB DRAW_PLAY
8020   LOCAL I,B
8030   CLEAR("BLIP_BLACK")
8040   FOR I=1 TO ROCKS
8050     IF ROCK(I) THEN DRAW_ROCK I
8060   NEXT I
8070   FOR B=1 TO SHOTS
8080     IF SHOT(B) THEN FILL_CIRCLE(SHOT_X(B),SHOT_Y(B),1.6,"BLIP_CYAN")
8090   NEXT B
8100   IF ENEMY_SHOT THEN FILL_CIRCLE(ENEMY_X,ENEMY_Y,2.2,"NEON_ORANGE")
8110   IF SAUCER_ON THEN DRAW_SAUCER
8120   IF SHIP_ON THEN DRAW_SHIP
8130   FX_DRAW()
8140   DRAW_HUD(SCORE,LIVES)
8150   DRAW_TEXT("WAVE "+STR$(WAVE),320,8,2,"BLIP_CYAN","CENTER")
8160   IF WAVE_TIME<1.6 THEN DRAW_TEXT("WAVE "+STR$(WAVE),320,190,4,COLOR(0.3,0.9,1,1-WAVE_TIME/1.6),"CENTER")
8170 END SUB
8200 REM A TRIANGLE POINTING ALONG SHIP_ANGLE, BLINKING WHILE IT CANNOT BE HIT
8210 SUB DRAW_SHIP
8220   LOCAL NX,NY,LX,LY,RX,RY,FLAME
8230   IF INVULN>0 AND INT(INVULN*10) MOD 2=0 THEN EXIT SUB
8240   NX=FNSHIP_X(0,12):NY=FNSHIP_Y(0,12)
8250   LX=FNSHIP_X(-2.5,10):LY=FNSHIP_Y(-2.5,10)
8260   RX=FNSHIP_X(2.5,10):RY=FNSHIP_Y(2.5,10)
8270   DRAW_LINE(NX,NY,LX,LY,"BLIP_WHITE")
8280   DRAW_LINE(LX,LY,RX,RY,"BLIP_WHITE")
8290   DRAW_LINE(RX,RY,NX,NY,"BLIP_WHITE")
8300   IF THRUST THEN
8310     FLAME=12+SIN(TIME()*34)*4
8320     DRAW_LINE((LX+RX)/2,(LY+RY)/2,FNSHIP_X(3.14159,FLAME),FNSHIP_Y(3.14159,FLAME),"NEON_ORANGE")
8330   END IF
8340 END SUB
8350 REM A POINT REACH PIXELS FROM THE SHIP, TURNED FROM ITS HEADING
8360 DEF FNSHIP_X(TURN,REACH)=SHIP_X+SIN(SHIP_ANGLE+TURN)*REACH
8370 DEF FNSHIP_Y(TURN,REACH)=SHIP_Y-COS(SHIP_ANGLE+TURN)*REACH
8400 REM TEN POINTS ROUND THE CENTRE, EACH AT ITS OWN JAGGED DISTANCE
8410 SUB DRAW_ROCK(I)
8420   LOCAL K,R,A,X,Y,LAST_X,LAST_Y,INK
8430   R=ROCK_R(ROCK(I))
8440   INK=FNROCK_COLOR(I)
8450   FOR K=0 TO 10
8460     A=ROCK_TURN(I)+K*0.628319
8470     X=ROCK_X(I)+COS(A)*R*JAG(I,(K MOD 10)+1)
8480     Y=ROCK_Y(I)+SIN(A)*R*JAG(I,(K MOD 10)+1)
8490     IF K>0 THEN DRAW_LINE(LAST_X,LAST_Y,X,Y,INK)
8500     LAST_X=X:LAST_Y=Y
8510   NEXT K
8520 END SUB
8600 REM ITS CORE LIGHTS UP JUST BEFORE IT FIRES
8610 SUB DRAW_SAUCER
8620   LOCAL W,H,X,Y
8630   W=12+6*SAUCER_BIG:H=4+2*SAUCER_BIG
8640   X=SAUCER_X:Y=SAUCER_Y
8650   DRAW_LINE(X-W,Y,X-W/2,Y-H,"NEON_PINK")
8660   DRAW_LINE(X-W/2,Y-H,X+W/2,Y-H,"NEON_PINK")
8670   DRAW_LINE(X+W/2,Y-H,X+W,Y,"NEON_PINK")
8680   DRAW_LINE(X+W,Y,X+W/2,Y+H,"NEON_PINK")
8690   DRAW_LINE(X+W/2,Y+H,X-W/2,Y+H,"NEON_PINK")
8700   DRAW_LINE(X-W/2,Y+H,X-W,Y,"NEON_PINK")
8710   DRAW_LINE(X-W,Y,X+W,Y,"NEON_PINK")
8720   IF SAUCER_FIRE<TELL AND SHIP_ON THEN FILL_GLOW_CIRCLE(X,Y,4,"NEON_YELLOW")
8730 END SUB
9000 REM --- OVER - TWO SECONDS TO READ THE SCORE, THEN FIRE TO PLAY AGAIN ---
9010 SUB UPDATE_OVER
9030   WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
9040   IF WAIT_LEFT=0 AND FIRE THEN START_GAME
9050 END SUB
9100 SUB DRAW_OVER
9110   CLEAR("BLIP_BLACK")
9120   DRAW_HORIZON
9130   DRAW_TEXT("GAME OVER",320,104,5,"BLIP_RED","CENTER")
9140   DRAW_TEXT("FINAL SCORE",320,176,2,"BLIP_GRAY","CENTER")
9150   DRAW_TEXT(STR$(SCORE),320,200,3,"NEON_YELLOW","CENTER")
9160   DRAW_TEXT("WAVE "+STR$(WAVE),320,236,2,"BLIP_CYAN","CENTER")
9170   IF WAIT_LEFT=0 THEN DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE TO PLAY AGAIN","PRESS FIRE TO PLAY AGAIN","TAP TO PLAY AGAIN"),320,290,2,"BLIP_WHITE","CENTER")
9180 END SUB
9200 REM THE PERSPECTIVE GRID, FROM THE LOWER PART OF ITS PICTURE, BELOW THE WORDS
9210 SUB DRAW_HORIZON
9220   DRAW_TEXTURE(ASSETS$+"TITLE_GRID.PNG",0,250,640,150,0,236,680,472)
9230 END SUB
9500 REM --- HELPERS ---
9510 SUB READ_KEYS
9520   TURN_LEFT=KEY_ACTIVE("LEFT") OR KEY_ACTIVE("A")
9530   TURN_RIGHT=KEY_ACTIVE("RIGHT") OR KEY_ACTIVE("D")
9540   THRUST=KEY_ACTIVE("UP") OR KEY_ACTIVE("W")
9550   SHOOT=KEY_ACTIVE("SPACE")
9560   HYPER=KEY_PRESSED("BUTTON2")
9570   FIRE=KEY_PRESSED("SPACE") OR KEY_PRESSED("ENTER")
9580 END SUB
9600 SUB CLEAR_ROCKS
9610   LOCAL I
9620   FOR I=1 TO ROCKS:ROCK(I)=0:NEXT I
9630 END SUB
9700 SUB CLEAR_SHOTS
9710   LOCAL B
9720   FOR B=1 TO SHOTS:SHOT(B)=0:NEXT B
9730   ENEMY_SHOT=0
9740 END SUB
9800 REM SIZE: RADIUS, SLOWEST AND FASTEST SPEED, POINTS, AND THE NAME OF ITS SOUND
9810 SUB LOAD_ROCK_SIZES
9820   LOCAL SIZE
9830   RESTORE 9890
9840   FOR SIZE=1 TO 3
9850     READ ROCK_R(SIZE),SLOWEST(SIZE),FASTEST(SIZE),ROCK_POINTS(SIZE),ROCK_NAME$(SIZE)
9860   NEXT SIZE
9870 END SUB
9890 DATA 30, 20,44, 20, "LARGE"
9891 DATA 17, 36,76, 50, "MEDIUM"
9892 DATA 9, 64,120, 100, "SMALL"
9900 DEF FNROCK_SPEED(SIZE)=FNBETWEEN(SLOWEST(SIZE),FASTEST(SIZE))
9910 DEF FNBETWEEN(LOW,HIGH)=LOW+RND(HIGH-LOW)
9920 DEF FNON_FIELD(X,Y)=X>=0 AND X<=FIELD_W AND Y>=TOP AND Y<=TOP+FIELD_H
9930 REM THE PATH THE SHOT TOOK THIS FRAME AGAINST A CIRCLE
9940 DEF FNSHOT_HITS(B,X,Y,R)=SEGMENT_CIRCLE_OVERLAP(SHOT_X(B)-SHOT_VX(B)*DT,SHOT_Y(B)-SHOT_VY(B)*DT,SHOT_X(B),SHOT_Y(B),X,Y,R)
9950 REM EACH WAVE HAS ITS OWN COLOUR OF ROCK
9960 DEF FNROCK_COLOR(I)=COLOR(0.55+0.45*SIN(WAVE*1.7),0.55+0.45*SIN(WAVE*1.7+2.1),0.55+0.45*SIN(WAVE*1.7+4.2))
