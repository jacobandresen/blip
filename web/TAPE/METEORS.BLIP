10 PLAY_MUSIC "METEORS_DRIFT":CLEAR("BLIP_BLACK"):T=T+0.016
20 DRAW_TEXT("METEORS",160,27,5,"NEON_CYAN","CENTER")
30 DRAW_TEXT("VECTOR SPACE FIGHTER",160,58,2,"BLIP_GRAY","CENTER")
40 DRAW_TEXT("ARROWS FLY  SPACE FIRE",160,84,2,"BLIP_CYAN","CENTER")
45 DRAW_TEXT("Z HYPERSPACE",160,100,2,"BLIP_PINK","CENTER")
50 DRAW_TEXT("SPACE TO START",160,120,2,"BLIP_YELLOW","CENTER"):GOSUB 1300:GOSUB 1320
60 IF KEY_PRESSED("SPACE")=1 THEN GOTO 800
70 WAIT 16:GOTO 10
100 CLEAR("BLIP_BLACK"):T=T+0.016
110 DRAW_HUD(SCORE,LIVES):DRAW_TEXT("WAVE "+STR$(WAVE),160,191,1,"BLIP_CYAN","CENTER")
115 IF INVULN>0 THEN INVULN=INVULN-1
120 IF KEY_HELD("LEFT")=1 THEN ANGLE=ANGLE-0.06
130 IF KEY_HELD("RIGHT")=1 THEN ANGLE=ANGLE+0.06
135 IF THRUST_WAIT>0 THEN THRUST_WAIT=THRUST_WAIT-1
140 IF KEY_HELD("UP")=1 THEN VX=VX+COS(ANGLE)*0.034:VY=VY+SIN(ANGLE)*0.034:IF THRUST_WAIT<1 THEN PLAY_SFX "METEORS/THRUST":THRUST_WAIT=11
150 VX=VX*0.9942:VY=VY*0.9942:SPEED=SQR(VX*VX+VY*VY):IF SPEED>2.67 THEN VX=VX*2.67/SPEED:VY=VY*2.67/SPEED
155 PX=PX+VX:PY=PY+VY
160 IF PX<0 THEN PX=320
170 IF PX>320 THEN PX=0
180 IF PY<25 THEN PY=200
190 IF PY>200 THEN PY=25
200 SX=PX+COS(ANGLE)*8:SY=PY+SIN(ANGLE)*8
210 LX=PX+COS(ANGLE+2.55)*7:LY=PY+SIN(ANGLE+2.55)*7
220 RX=PX+COS(ANGLE-2.55)*7:RY=PY+SIN(ANGLE-2.55)*7
230 IF INVULN=0 OR INT(INVULN/5)*5<>INVULN THEN DRAW_LINE(SX,SY,LX,LY,"BLIP_WHITE")
240 IF INVULN=0 OR INT(INVULN/5)*5<>INVULN THEN DRAW_LINE(LX,LY,RX,RY,"BLIP_WHITE")
250 IF INVULN=0 OR INT(INVULN/5)*5<>INVULN THEN DRAW_LINE(RX,RY,SX,SY,"BLIP_WHITE")
255 FLAME=9+SIN(T*34)*4:TX=(LX+RX)/2:TY=(LY+RY)/2
256 IF KEY_HELD("UP")=1 AND (INVULN=0 OR INT(INVULN/5)*5<>INVULN) THEN DRAW_LINE(TX,TY,PX-COS(ANGLE)*FLAME,PY-SIN(ANGLE)*FLAME,"NEON_ORANGE")
260 FIRE_WAIT=FIRE_WAIT-1
265 IF KEY_PRESSED("BUTTON2")=1 THEN GOSUB 850
270 IF KEY_HELD("SPACE")=1 AND FIRE_WAIT<1 THEN GOSUB 900
280 FOR I=1 TO 48
290 IF ROCK(I)=1 THEN GOSUB 1000
300 NEXT I
310 FOR B=1 TO 10
320 IF SHOT(B)=1 THEN GOSUB 1200
330 NEXT B
335 GOSUB 1480
338 GOSUB 1800
340 IF LIVES<1 THEN GOTO 700
350 WAIT 16:GOTO 100
700 CLEAR("BLIP_BLACK"):GOSUB 1300
710 DRAW_TEXT("SHIP LOST",160,55,4,"BLIP_RED","CENTER")
720 DRAW_TEXT("FINAL SCORE",160,91,2,"BLIP_GRAY","CENTER")
730 DRAW_NUMBER(SCORE,TEXT_CX(STR$(SCORE),3),119,3,"BLIP_YELLOW")
740 DRAW_TEXT("SPACE TO PLAY AGAIN",160,158,2,"BLIP_WHITE","CENTER")
750 IF KEY_PRESSED("SPACE")=1 THEN GOTO 800
760 WAIT 16:GOTO 700
800 GAME_STATE=1:SCORE=0:LIVES=3:PX=160:PY=112:VX=0:VY=0:ANGLE=-1.57:FIRE_WAIT=0:THRUST_WAIT=0:INVULN=150:SAUCER=0:UFO_WAIT=540:UBULLET=0:PLAY_MUSIC "METEORS_STORM"
810 WAVE=1:GOSUB 1700:GOTO 890
850 PLAY_SFX "METEORS/HYPERSPACE":PX=RND(320):PY=RND(172)+28:VX=0:VY=0
860 IF RND(20)<1 THEN LIVES=LIVES-1:PLAY_SFX "METEORS/SHIP_EXPLOSION":PX=160:PY=112:INVULN=150
870 RETURN
890 FOR B=1 TO 10:SHOT(B)=0:NEXT B
895 GOTO 100
900 FIRE_SLOT=0
910 FOR B=1 TO 10
920 IF SHOT(B)=0 AND FIRE_SLOT=0 THEN FIRE_SLOT=B
930 NEXT B
940 IF FIRE_SLOT=0 THEN RETURN
950 B=FIRE_SLOT:SHOT(B)=1:BX(B)=PX+COS(ANGLE)*9:BY(B)=PY+SIN(ANGLE)*9:BVX(B)=VX+COS(ANGLE)*3.6:BVY(B)=VY+SIN(ANGLE)*3.6:BT(B)=51:FIRE_WAIT=13:PLAY_SFX "METEORS/FIRE"
960 RETURN
1000 AX(I)=AX(I)+AVX(I):AY(I)=AY(I)+AVY(I)
1010 IF AX(I)<0 THEN AX(I)=320
1020 IF AX(I)>320 THEN AX(I)=0
1030 IF AY(I)<28 THEN AY(I)=198
1040 IF AY(I)>200 THEN AY(I)=28
1050 CX=AX(I):CY=AY(I):CR=AR(I):ROT=T*0.18+I:ROCK_COLOR$="BLIP_GRAY":GOSUB 1400
1060 IF INVULN<1 AND SQR((PX-AX(I))*(PX-AX(I))+(PY-AY(I))*(PY-AY(I)))<AR(I)+5 THEN LIVES=LIVES-1:PX=160:PY=112:VX=0:VY=0:ANGLE=-1.57:INVULN=150:ROCK(I)=0:PLAY_SFX "METEORS/SHIP_EXPLOSION"
1070 RETURN
1200 BX(B)=BX(B)+BVX(B):BY(B)=BY(B)+BVY(B):BT(B)=BT(B)-1
1210 IF BX(B)<0 OR BX(B)>320 OR BY(B)<25 OR BY(B)>200 OR BT(B)<1 THEN SHOT(B)=0:RETURN
1220 FILL_CIRCLE(BX(B),BY(B),1.2,"BLIP_CYAN")
1230 FOR I=1 TO 48
1240 IF ROCK(I)=1 AND SQR((BX(B)-AX(I))*(BX(B)-AX(I))+(BY(B)-AY(I))*(BY(B)-AY(I)))<AR(I) THEN GOSUB 1500
1250 NEXT I
1255 IF SHOT(B)=1 AND SAUCER=1 AND SQR((BX(B)-UX)*(BX(B)-UX)+(BY(B)-UY)*(BY(B)-UY))<UWIDTH/2 THEN SHOT(B)=0:SAUCER=0:GOSUB 1970
1260 RETURN
1300 FOR GI=0 TO 7:GT=GI/7:GY=67+133*GT*GT:GH=24+136*GT:DRAW_LINE(160-GH,GY,160+GH,GY,COLOR(0.667,0.235,1,0.1+0.35*GT)):NEXT GI
1310 DRAW_LINE(136,67,0,200,COLOR(0.667,0.235,1,0.2)):DRAW_LINE(148,67,80,200,COLOR(0.667,0.235,1,0.2)):DRAW_LINE(172,67,240,200,COLOR(0.667,0.235,1,0.2)):DRAW_LINE(184,67,320,200,COLOR(0.667,0.235,1,0.2)):RETURN
1320 I=1:ROCK_COLOR$="NEON_YELLOW":CX=62:CY=158:CR=16:ROT=T*0.28:GOSUB 1400
1330 I=2:CX=254:CY=158:CR=12:ROT=0-T*0.34:GOSUB 1400
1340 SX=160+COS(T*0.6)*7:SY=157+SIN(T*0.6)*3:ANGLE=0-1.57+SIN(T*0.4)*0.18
1350 FX=SX+COS(ANGLE)*11:FY=SY+SIN(ANGLE)*11
1360 LX=SX+COS(ANGLE+2.55)*8:LY=SY+SIN(ANGLE+2.55)*8
1370 RX=SX+COS(ANGLE-2.55)*8:RY=SY+SIN(ANGLE-2.55)*8
1380 DRAW_LINE(FX,FY,LX,LY,"NEON_CYAN"):DRAW_LINE(LX,LY,RX,RY,"NEON_CYAN"):DRAW_LINE(RX,RY,FX,FY,"NEON_CYAN")
1390 IF SIN(T*12)>0.5 THEN DRAW_LINE(SX-COS(ANGLE)*4,SY-SIN(ANGLE)*4,SX-COS(ANGLE)*10,SY-SIN(ANGLE)*10,"NEON_ORANGE")
1400 ROCK_ID=I:IF ROCK_ID<1 THEN ROCK_ID=1
1405 RAD_FACTOR=JAG(ROCK_ID,10):IF RAD_FACTOR=0 THEN RAD_FACTOR=0.75+((70+ROCK_ID*3)-INT((70+ROCK_ID*3)/10)*10)*0.05
1410 AX0=CX+COS(ROT)*CR*RAD_FACTOR:AY0=CY+SIN(ROT)*CR*RAD_FACTOR:LX=AX0:LY=AY0
1415 FOR VERT=1 TO 9
1420 RAD_FACTOR=JAG(ROCK_ID,VERT):IF RAD_FACTOR=0 THEN RAD_FACTOR=0.75+((VERT*7+ROCK_ID*3)-INT((VERT*7+ROCK_ID*3)/10)*10)*0.05
1425 A=ROT+VERT*0.628319:RAD=CR*RAD_FACTOR
1430 NX=CX+COS(A)*RAD:NY=CY+SIN(A)*RAD:DRAW_LINE(LX,LY,NX,NY,ROCK_COLOR$)
1440 LX=NX:LY=NY
1450 NEXT VERT
1460 DRAW_LINE(LX,LY,AX0,AY0,ROCK_COLOR$)
1470 RETURN
1480 ACTIVE=0:FOR J=1 TO 48:IF ROCK(J)=1 THEN ACTIVE=ACTIVE+1
1485 NEXT J
1490 IF ACTIVE=0 THEN WAVE=WAVE+1:GOSUB 1700
1495 RETURN
1500 SPLIT_X=AX(I):SPLIT_Y=AY(I):SPLIT_R=AR(I):SPLIT_VX=AVX(I):SPLIT_VY=AVY(I):ROCK(I)=0:SHOT(B)=0
1510 IF SPLIT_R>14 THEN SCORE=SCORE+20:GOTO 1530
1512 IF SPLIT_R>9 THEN SCORE=SCORE+50:GOTO 1530
1513 SCORE=SCORE+100
1515 IF SPLIT_R>14 THEN PLAY_SFX "METEORS/BANG_LARGE":GOTO 1530
1520 IF SPLIT_R>9 THEN PLAY_SFX "METEORS/BANG_MEDIUM":GOTO 1530
1525 PLAY_SFX "METEORS/BANG_SMALL"
1530 IF SPLIT_R<=9 THEN RETURN
1540 FREE1=0:FREE2=0:SPLIT_ANGLE=RND(6.283185)
1550 FOR J=1 TO 48
1560 IF ROCK(J)=0 AND FREE1=0 THEN FREE1=J
1570 IF ROCK(J)=0 AND FREE1>0 AND J<>FREE1 AND FREE2=0 THEN FREE2=J
1580 NEXT J
1590 IF FREE1=0 THEN RETURN
1600 ROCK(FREE1)=1:AX(FREE1)=SPLIT_X+COS(SPLIT_ANGLE)*5:AY(FREE1)=SPLIT_Y+SIN(SPLIT_ANGLE)*5:AR(FREE1)=SPLIT_R*0.62:AVX(FREE1)=SPLIT_VX+COS(SPLIT_ANGLE)*(0.8+RND(0.5)):AVY(FREE1)=SPLIT_VY+SIN(SPLIT_ANGLE)*(0.8+RND(0.5))
1605 FOR VERT=1 TO 10:JAG(FREE1,VERT)=0.75+RND(0.5):NEXT VERT
1610 IF FREE2=0 THEN RETURN
1615 FOR VERT=1 TO 10:JAG(FREE2,VERT)=0.75+RND(0.5):NEXT VERT
1620 ROCK(FREE2)=1:AX(FREE2)=SPLIT_X-COS(SPLIT_ANGLE)*5:AY(FREE2)=SPLIT_Y-SIN(SPLIT_ANGLE)*5:AR(FREE2)=SPLIT_R*0.62:AVX(FREE2)=SPLIT_VX-COS(SPLIT_ANGLE)*(0.8+RND(0.5)):AVY(FREE2)=SPLIT_VY-SIN(SPLIT_ANGLE)*(0.8+RND(0.5)):RETURN
1700 FOR I=1 TO 48:ROCK(I)=0:NEXT I
1710 WAVE_COUNT=WAVE+2:IF WAVE_COUNT>14 THEN WAVE_COUNT=14
1720 FOR I=1 TO WAVE_COUNT
1730 ROCK(I)=1:AR(I)=16:IF RND(2)<1 THEN AX(I)=INT(RND(320)):AY(I)=28+172*INT(RND(2)):GOTO 1735
1732 AX(I)=320*INT(RND(2)):AY(I)=INT(RND(172))+28
1735 AVX(I)=RND(1.2)-0.6:AVY(I)=RND(1.2)-0.6
1737 FOR VERT=1 TO 10:JAG(I,VERT)=0.75+RND(0.5):NEXT VERT
1740 NEXT I:RETURN
1800 IF SAUCER=0 THEN UFO_WAIT=UFO_WAIT-1
1810 IF SAUCER=0 AND UFO_WAIT<1 THEN SAUCER=1:UX=320*INT(RND(2)):UYS=INT(RND(120))+40:UFIRE=80:UBULLET=0:UBIG=1:IF SCORE>=5000 AND RND(100)<50 THEN UBIG=0
1820 IF SAUCER=1 AND UX<160 THEN UDIR=1
1830 IF SAUCER=1 AND UX>=160 THEN UDIR=0-1
1840 IF SAUCER=1 THEN UX=UX+UDIR*0.75:UY=UYS+SIN(T*3)*8:IF UBIG=1 THEN UWIDTH=24:UHEIGHT=8:GOSUB 1900
1845 IF SAUCER=1 AND UBIG=0 THEN UWIDTH=16:UHEIGHT=6:GOSUB 1900
1850 IF SAUCER=1 AND (UX<0-20 OR UX>340) THEN SAUCER=0:UFO_WAIT=INT(RND(540))+540
1860 IF UBULLET=1 THEN UBX=UBX+UBVX:UBY=UBY+UBVY:FILL_CIRCLE(UBX,UBY,2,"NEON_ORANGE")
1870 IF UBULLET=1 AND (UBX<0 OR UBX>320 OR UBY<25 OR UBY>200) THEN UBULLET=0
1880 IF UBULLET=1 AND INVULN=0 AND SQR((PX-UBX)*(PX-UBX)+(PY-UBY)*(PY-UBY))<7 THEN UBULLET=0:LIVES=LIVES-1:PX=160:PY=112:VX=0:VY=0:INVULN=150:PLAY_SFX "METEORS/SHIP_EXPLOSION"
1890 IF SAUCER=1 THEN UFIRE=UFIRE-1:IF UFIRE<1 AND UBULLET=0 THEN GOSUB 1950
1895 RETURN
1900 DRAW_LINE(UX-UWIDTH/2,UY,UX-UWIDTH/4,UY-UHEIGHT/2,"NEON_PINK"):DRAW_LINE(UX-UWIDTH/4,UY-UHEIGHT/2,UX+UWIDTH/4,UY-UHEIGHT/2,"NEON_PINK"):DRAW_LINE(UX+UWIDTH/4,UY-UHEIGHT/2,UX+UWIDTH/2,UY,"NEON_PINK")
1910 DRAW_LINE(UX+UWIDTH/2,UY,UX+UWIDTH/4,UY+UHEIGHT/2,"NEON_PINK"):DRAW_LINE(UX+UWIDTH/4,UY+UHEIGHT/2,UX-UWIDTH/4,UY+UHEIGHT/2,"NEON_PINK"):DRAW_LINE(UX-UWIDTH/4,UY+UHEIGHT/2,UX-UWIDTH/2,UY,"NEON_PINK")
1920 DRAW_LINE(UX-UWIDTH/4,UY,UX+UWIDTH/4,UY,"NEON_PINK"):RETURN
1950 UDX=PX-UX:UDY=PY-UY:UDIST=SQR(UDX*UDX+UDY*UDY):IF UDIST<1 THEN UDIST=1
1960 UBVX=UDX/UDIST*1.8:UBVY=UDY/UDIST*1.8:UBX=UX:UBY=UY:UBULLET=1:UFIRE=80:RETURN
1970 IF UBIG=1 THEN SCORE=SCORE+200:PLAY_SFX "METEORS/SAUCER_BIG":RETURN
1980 SCORE=SCORE+1000:PLAY_SFX "METEORS/SAUCER_SMALL":RETURN
