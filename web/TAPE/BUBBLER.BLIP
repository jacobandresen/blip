100 CLEAR("#08152B"):T=T+0.016
105 FOR GRAD=0 TO 11:K=GRAD/11:FILL_RECT(0,GRAD*17,320,18,COLOR(SKY0R+(SKY1R-SKY0R)*K,SKY0G+(SKY1G-SKY0G)*K,SKY0B+(SKY1B-SKY0B)*K)):NEXT GRAD
