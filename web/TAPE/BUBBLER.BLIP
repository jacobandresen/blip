180 IF TWO=0 AND KEY_HELD("LEFT")=1 AND PX>12 THEN PX=PX-1:FACE=0-1
181 IF TWO=1 AND KEY_HELD("A")=1 AND PX>12 THEN PX=PX-1:FACE=0-1
190 IF TWO=0 AND KEY_HELD("RIGHT")=1 AND PX<292 THEN PX=PX+1:FACE=1
191 IF TWO=1 AND KEY_HELD("D")=1 AND PX<292 THEN PX=PX+1:FACE=1
200 IF TWO=0 AND KEY_PRESSED("UP")=1 AND GROUND=1 THEN VY=0-2.6:GROUND=0:PLAY_SFX "BUBBLER/JUMP"
201 IF TWO=1 AND KEY_PRESSED("W")=1 AND GROUND=1 THEN VY=0-2.6:GROUND=0:PLAY_SFX "BUBBLER/JUMP"
210 OLDY=PY:VY=VY+0.09:IF VY>1.67 THEN VY=1.67
220 PY=PY+VY:GROUND=0
230 IF PY>176 AND (PX+8<132 OR PX+8>180) THEN PY=176:VY=0:GROUND=1
231 IF PY>200 THEN PY=8:VY=0
240 IF VY>=0 THEN GOSUB 900
245 FILL_GLOW_CIRCLE(PX+8,PY+18,11,"#1827D855")
246 FILL_CIRCLE(PX+8-FACE*8,PY+7,3,"#E8E0C6"):FILL_CIRCLE(PX+8-FACE*5,PY+5,2.2,"#F5EDD4"):FILL_CIRCLE(PX+8-FACE*2,PY+4,1.7,"#F5EDD4")
247 FILL_CAPSULE(PX+4,PY+13,PX+3,PY+17,2.5,2,"#3D8150"):FILL_CAPSULE(PX+12,PY+13,PX+13,PY+17,2.5,2,"#3D8150")
248 FILL_CIRCLE(PX+8,PY+8,8,"#5ADA6E")
