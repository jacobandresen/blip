50 DRAW_TEXT("SPACE BLOWS  J JOINS/ BLOWS",160,180,1,"BLIP_YELLOW","CENTER"):GOSUB 1300
60 IF KEY_PRESSED("SPACE")=1 THEN TWO=0:GOTO 800
65 IF KEY_PRESSED("J")=1 OR KEY_PRESSED("K")=1 THEN TWO=1:GOTO 800
