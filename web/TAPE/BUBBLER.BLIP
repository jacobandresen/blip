120 FILL_RECT(0,192,132,8,"#263D55"):FILL_RECT(180,192,132,8,"#263D55"):DRAW_LINE(0,192,132,192,"#9AC7B2"):DRAW_LINE(180,192,312,192,"#9AC7B2")
