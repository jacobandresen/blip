1 REM BUBBLER - BLOW BUBBLES ROUND THE TOYS, THEN POP THEM FOR CANDY. EIGHT ROUNDS.
2 REM GAME: BUBBLER
3 REM ARROWS OR WASD RUN, UP/W/G JUMPS, SPACE/F BLOWS. HOLD JUMP TO BOUNCE ON A BUBBLE.
4 REM A FRIEND JOINS WITH J OR K; THEN THE ARROWS, UP/K AND J ARE THEIRS.
5 REM SCREENS: TITLE, READY (EACH ROUND'S START), PLAY, CLEAR (THE ROUND IS WON), OVER.
6 REM THE ARENA IS THE RUST GAME'S: 26 BY 24 TILES OF 24 PIXELS UNDER A SCORE BAR.
10 REM --- SETUP ---
11 CANVAS(624,600)
12 WIDE=624:HIGH=600
13 TILE=24:HUD=24
14 COLS=26:ROWS=24
15 REM THE HOLE IN THE FLOOR AND THE CEILING, FROM COLUMN 11 TO 14
16 GAP_LEFT=11:GAP_RIGHT=14
17 GRAVITY=950:MAX_FALL=300
18 JUMP_SPEED=470
19 RUN_SPEED=118
20 BODY_W=20:BODY_H=22
21 TOY_W=20:TOY_H=20
22 TOY_SCALE=1.4
23 BUBBLE_R=12:TRAP_R=19
24 BLOW_SPEED=340
25 REM A BUBBLE CATCHES TOYS ONLY WHILE IT IS STILL FLYING
26 SHOOT_TIME=0.4
27 RISE=44:RISE_FULL=62
29 FREE_LIFE=9
30 FLYING=1:FLOATING=2:AT_TOP=3
31 MAX_TOYS=20:MAX_SHOTS=6
32 MAX_BUBBLES=24
33 MAX_CANDIES=12
34 ROUNDS=8
35 START_LIVES=5
36 MOST_LIVES=7
37 RESPAWN_SAFE=3.5
38 ASSETS$=ASSETS$+""
39 KIND$(1)="ROBOT"
40 KIND$(2)="BUNNY"
41 KIND$(3)="GHOST"
42 DRAGON$(1)="PLAYER_GREEN"
43 DRAGON$(2)="PLAYER_BLUE"
44 CANDY_VALUE(0)=500
45 CANDY_VALUE(1)=1000
46 CANDY_VALUE(2)=2000
47 CANDY_VALUE(3)=4000
48 REM CANDY COMES IN SIX COLOURS, PICKED BY WHERE IT DROPS
49 CANDY_INK$(0)="#FF78A0"
50 CANDY_INK$(1)="#78C8FF"
51 CANDY_INK$(2)="#FFC850"
52 CANDY_INK$(3)="#96E68C"
53 CANDY_INK$(4)="#C896FF"
54 CANDY_INK$(5)="#FF965A"
55 ASSETS$="/TAPE/BUBBLER/ASSETS/"
80 PLAY_MUSIC ASSETS$+"THEME.WAV"
85 STATE$="TITLE"
90 LAST_TIME=TIME()
100 REM --- MAIN LOOP - UPDATE THE SCREEN WE ARE ON, THEN DRAW IT ---
110 NOW=TIME()
111 DT=CLAMP(NOW-LAST_TIME,0.0001,0.05)
112 LAST_TIME=NOW
120 READ_KEYS
121 STATE_TIME=STATE_TIME+DT
122 FX_UPDATE(DT)
130 IF STATE$="TITLE" THEN
131   UPDATE_TITLE
132 ELSEIF STATE$="READY" THEN
133   UPDATE_READY
134 ELSEIF STATE$="PLAY" THEN
135   UPDATE_PLAY
136 ELSEIF STATE$="CLEAR" THEN
137   UPDATE_CLEAR
138 ELSE
139   UPDATE_OVER
140 END IF
150 IF STATE$="TITLE" THEN
151   DRAW_TITLE
152 ELSEIF STATE$="READY" THEN
153   DRAW_READY
154 ELSEIF STATE$="PLAY" THEN
155   DRAW_PLAY
156 ELSEIF STATE$="CLEAR" THEN
157   DRAW_CLEAR
158 ELSE
159   DRAW_OVER
160 END IF
170 WAIT 0
180 GOTO 110
190 SUB SHOW(SCREEN$)
191   STATE$=SCREEN$
192   STATE_TIME=0
193 END SUB
1000 REM --- TITLE - BLOW OR JUMP TO PLAY ALONE; J OR K FOR TWO PLAYERS ---
1010 SUB UPDATE_TITLE
1020   IF JOIN_KEY THEN
1030     TWO=1
1040     START_GAME
1050   ELSEIF BLOW_KEY(1) OR JUMP_KEY(1) THEN
1060     TWO=0
1070     START_GAME
1080   END IF
1090 END SUB
1100 SUB DRAW_TITLE
1110   LOCAL T,I,S,X,Y,R,HOP,MODE$,GLOW
1120   T=TIME()
1130   DRAW_TEXTURE(ASSETS$+"TITLE_SKY.PNG",0,0,WIDE,HIGH)
1140   DRAW_BOKEH 1,0.55,0.86
1150   REM BUBBLES DRIFT UP BEHIND THE NAME, BOTH PLAYERS' COLOURS
1160   FOR I=0 TO 13
1170     S=I*53.1
1180     X=(S*11.3) MOD WIDE
1190     Y=HIGH+20-((S*9.1+T*30) MOD (HIGH+40))
1200     R=12+SIN((T+S)*3)*0.6
1210     DRAW_GLASS X,Y,R,I MOD 2+1,T+S,0
1230   NEXT I
1240   FOR I=1 TO 7
1250     Y=144+SIN(T*3+(I-1)*0.6)*5
1260     DRAW_TEXTURE(ASSETS$+"TITLE_LETTER_"+STR$(I)+".PNG",134+I*36,Y,68,74)
1270   NEXT I
1280   FOR I=1 TO 2
1290     HOP=MAX(0,SIN(T*3.2+(I-1)*1.6))
1300     DRAW_DRAGON I,102+I*140,350-HOP*34,2.4,3-2*I
1310   NEXT I
1320   MODE$=CONTROL_TEXT$("KEYS","PAD","TOUCH")
1330   GLOW=0.65+0.35*ABS(SIN(T*2.5))
1340   DRAW_TEXTURE(ASSETS$+"TITLE_START_"+MODE$+".PNG",0,359,WIDE,40,COLOR(1,1,1,GLOW))
1350   DRAW_TEXTURE(ASSETS$+"TITLE_INFO_"+MODE$+".PNG",0,400,WIDE,92)
1360 END SUB
2000 REM --- START - A NEW GAME, A SECOND PLAYER, AND EACH ROUND FROM ITS MAP ---
2010 SUB START_GAME
2020   LOCAL P
2030   FOR P=1 TO 2
2040     LIVES(P)=START_LIVES
2050     SCORE(P)=0
2060     ALIVE(P)=0
2070   NEXT P
2080   JOINED(1)=1:JOINED(2)=TWO
2090   WON=0
2100   LOAD_ROUND 1
2110 END SUB
2200 SUB JOIN_PLAYER_TWO
2210   TWO=1:JOINED(2)=1
2220   LIVES(2)=START_LIVES
2230   SCORE(2)=0
2240   PLACE_PLAYER 2
2250 END SUB
2300 REM EACH ROUND HAS ITS SKY, THEN 24 ROWS OF 26: # A BLOCK, A AND B WHERE THE
2310 REM PLAYERS START, W A WALKER, H A HOPPER AND G A GHOST
2320 SUB LOAD_ROUND(R)
2330   LOCAL P,ROW,COL,ROW$
2340   ROUND=R
2350   CLEAR_POOLS
2360   RESTORE 20000+R*1000
2370   READ_SKY
2380   FOR ROW=0 TO ROWS-1
2390     READ ROW$
2400     FOR COL=0 TO COLS-1
2410       PLACE_CELL MID$(ROW$,COL+1,1),COL,ROW
2420     NEXT COL
2430   NEXT ROW
2440   FOR P=1 TO 2
2450     FACE(P)=3-2*P
2460     IF JOINED(P) AND LIVES(P)>0 THEN PLACE_PLAYER P
2470   NEXT P
2480   REM THE TOYS GET A LITTLE QUICKER, AND HURRY SOONER, UP TO ROUND FIVE
2490   PACE=0.8+0.04*MIN(R-1,4)
2500   TRAP_LIFE=MAX(10-0.5*MIN(R-1,4),7)
2510   HURRY_AT=70-2.5*MIN(R-1,4)
2520   ROUND_TIME=0:HURRY=0
2530   CHAIN_TIME=0
2540   PLAY_MUSIC ASSETS$+"THEME.WAV"
2550   SHOW "READY"
2560 END SUB
2700 SUB PLACE_CELL(CELL$,COL,ROW)
2710   LOCAL X,FOOT
2720   X=COL*TILE+2
2730   FOOT=HUD+(ROW+1)*TILE
2740   BLOCK(ROW,COL)=(CELL$="#")
2750   IF CELL$="#" OR COL=0 OR COL=COLS-1 THEN ADD_TILE COL,ROW
2760   IF CELL$="A" THEN
2770     SPAWN_X(1)=X
2780     SPAWN_Y(1)=FOOT-BODY_H
2790   ELSEIF CELL$="B" THEN
2800     SPAWN_X(2)=X
2810     SPAWN_Y(2)=FOOT-BODY_H
2820   ELSEIF CELL$="W" THEN
2830     ADD_TOY 1,X,FOOT-TOY_H
2840   ELSEIF CELL$="H" THEN
2850     ADD_TOY 2,X,FOOT-TOY_H
2860   ELSEIF CELL$="G" THEN
2870     ADD_TOY 3,X,FOOT-TOY_H
2880   END IF
2890 END SUB
3000 REM THE TILES ARE LISTED ONCE A ROUND, SO DRAWING THEM IS ONE SHORT LOOP
3010 SUB ADD_TILE(COL,ROW)
3020   TILE_COUNT=TILE_COUNT+1
3030   TILE_X(TILE_COUNT)=COL*TILE
3040   TILE_Y(TILE_COUNT)=HUD+ROW*TILE
3050   TILE_EDGE(TILE_COUNT)=(COL=0 OR COL=COLS-1 OR ROW=0 OR ROW=ROWS-1)
3060 END SUB
3100 SUB READ_SKY
3110   LOCAL I,K,R0,G0,B0,R1,G1,B1
3120   READ R0,G0,B0,R1,G1,B1
3130   READ GLOW_R,GLOW_G,GLOW_B
3140   FOR I=0 TO 17
3150     K=I/17
3160     BAND(I)=COLOR(LERP(R0,R1,K)/255,LERP(G0,G1,K)/255,LERP(B0,B1,K)/255)
3170   NEXT I
3180   GLOW_R=GLOW_R/255
3190   GLOW_G=GLOW_G/255
3200   GLOW_B=GLOW_B/255
3210 END SUB
3300 SUB ADD_TOY(KIND,X,Y)
3310   LOCAL I
3320   TOY_COUNT=TOY_COUNT+1
3330   I=TOY_COUNT
3340   TOY_ON(I)=1:TOY_KIND(I)=KIND
3350   TOY_X(I)=X:TOY_Y(I)=Y
3360   TOY_VX(I)=0:TOY_VY(I)=0
3370   IF X<WIDE/2 THEN TOY_DIR(I)=1 ELSE TOY_DIR(I)=-1
3380   TOY_ANGRY(I)=0
3390   TOY_GROUND(I)=0
3400   TOY_T(I)=RND(3)
3410   TOY_JUMP_WAIT(I)=0.8+RND(1.2)
3420   TOY_SHOT_WAIT(I)=2.5+RND(2)
3430   TOY_EDGE_WAIT(I)=0
3440   TOY_WINDUP(I)=0
3450   TOY_CROUCH(I)=0
3460   IF KIND=3 THEN SET_DRIFT I,TOY_DIR(I)
3470 END SUB
3500 SUB SET_DRIFT(I,DIR)
3510   TOY_VX(I)=DIR*62
3520   TOY_VY(I)=62
3530 END SUB
3600 SUB CLEAR_POOLS
3610   LOCAL I
3620   FOR I=1 TO MAX_TOYS:TOY_ON(I)=0:NEXT I
3630   FOR I=1 TO MAX_BUBBLES:BUB_ON(I)=0:NEXT I
3640   FOR I=1 TO MAX_CANDIES:CANDY_ON(I)=0:NEXT I
3650   FOR I=1 TO MAX_SHOTS:SHOT_ON(I)=0:NEXT I
3660   TOY_COUNT=0:TILE_COUNT=0
3670   FX_CLEAR
3680 END SUB
3800 SUB PLACE_PLAYER(P)
3810   PX(P)=SPAWN_X(P)
3820   PY(P)=SPAWN_Y(P)
3830   PVX(P)=0:PVY(P)=0
3840   ON_GROUND(P)=0
3850   ALIVE(P)=1
3860   DEAD_TIME(P)=0
3870   SAFE(P)=RESPAWN_SAFE
3880 END SUB
4000 REM --- READY - THE ROUND'S NUMBER, WHILE ITS TOYS POP INTO PLACE ---
4010 SUB UPDATE_READY
4020   IF STATE_TIME>1.8 THEN SHOW "PLAY"
4030 END SUB
4100 SUB DRAW_READY
4110   DRAW_ARENA MIN(STATE_TIME/1.2,1)
4120   BANNER "ROUND "+STR$(ROUND),236,4,"#FFC496"
4130   IF STATE_TIME>0.7 THEN BANNER "READY!",304,2,"#AAF0BE"
4140 END SUB
4200 REM --- PLAY - EVERYONE MOVES; THEN WHO IS HURT, AND WHETHER THE ROUND IS WON ---
4210 SUB UPDATE_PLAY
4220   IF JOIN_KEY AND NOT JOINED(2) THEN JOIN_PLAYER_TWO
4230   ROUND_TIME=ROUND_TIME+DT
4240   CHAIN_TIME=MAX(0,CHAIN_TIME-DT)
4250   IF NOT HURRY AND ROUND_TIME>=HURRY_AT THEN HURRY_UP
4260   MOVE_PLAYERS
4270   MOVE_TOYS
4280   MOVE_BUBBLES
4290   MOVE_CANDIES
4300   MOVE_SHOTS
4310   HURT_PLAYERS
4320   IF NOT (FNIN_GAME(1) OR FNIN_GAME(2)) THEN
4330     SHOW "OVER"
4340   ELSEIF TOYS_OUT+TOYS_HELD=0 AND DEAD_TIME(1)<=0 AND DEAD_TIME(2)<=0 THEN
4350     ROUND_WON
4360   END IF
4370 END SUB
4500 DEF FNIN_GAME(P)=JOINED(P) AND (LIVES(P)>0 OR DEAD_TIME(P)>0)
4510 DEF FNIN_PLAY(P)=JOINED(P) AND ALIVE(P) AND DEAD_TIME(P)<=0
4600 REM TAKING TOO LONG MAKES EVERY TOY ANGRY, AND THE MUSIC QUICKER
4610 SUB HURRY_UP
4620   LOCAL I
4630   HURRY=1
4640   FOR I=1 TO TOY_COUNT:TOY_ANGRY(I)=1:NEXT I
4650   PLAY_MUSIC ASSETS$+"HURRY.WAV"
4660 END SUB
4700 SUB DRAW_PLAY
4710   DRAW_ARENA 1
4720   IF HURRY AND ROUND_TIME<HURRY_AT+2.4 THEN BANNER "HURRY UP!",268,3,"#FF8C96"
4730   IF CHAIN_TIME>0 THEN BANNER STR$(CHAIN_SIZE)+" CHAIN!",334,3,"#FFAAC8"
4740 END SUB
5000 REM --- PLAYERS - RUN, JUMP AND BLOW; A LOST LIFE TUMBLES OFF THE SCREEN FIRST ---
5010 SUB MOVE_PLAYERS
5020   LOCAL P
5030   FOR P=1 TO 2
5040     IF DEAD_TIME(P)>0 THEN
5050       TUMBLE P
5060     ELSEIF FNIN_PLAY(P) THEN
5070       MOVE_PLAYER P
5080     END IF
5090   NEXT P
5100 END SUB
5200 SUB MOVE_PLAYER(P)
5210   LOCAL STEER
5220   STEER=RIGHT_KEY(P)-LEFT_KEY(P)
5230   PVX(P)=PVX(P)+(STEER*RUN_SPEED-PVX(P))*MIN(18*DT,1)
5240   IF STEER<>0 THEN FACE(P)=STEER
5250   IF JUMP_KEY(P) AND ON_GROUND(P) THEN
5260     PVY(P)=-JUMP_SPEED
5270     PLAY_SFX ASSETS$+"JUMP.WAV"
5280   END IF
5290   BX=PX(P):BY=PY(P)
5300   BVX=PVX(P):BVY=PVY(P)
5310   BW=BODY_W:BH=BODY_H
5320   MOVE_BODY
5330   PX(P)=BX:PY(P)=BY
5340   PVX(P)=BVX:PVY(P)=BVY
5350   ON_GROUND(P)=LANDED
5360   SAFE(P)=MAX(0,SAFE(P)-DT)
5370   BLOW_WAIT(P)=BLOW_WAIT(P)-DT
5380   IF BLOW_KEY(P) AND BLOW_WAIT(P)<=0 THEN BLOW_BUBBLE P
5390 END SUB
5500 SUB BLOW_BUBBLE(P)
5510   LOCAL I
5520   FOR I=1 TO MAX_BUBBLES
5530     IF NOT BUB_ON(I) THEN EXIT FOR
5540   NEXT I
5550   IF I>MAX_BUBBLES THEN EXIT SUB
5560   BUB_ON(I)=1
5570   BUB_X(I)=PX(P)+BODY_W/2+FACE(P)*14
5580   BUB_Y(I)=PY(P)+BODY_H/2-1
5590   BUB_VX(I)=FACE(P)*BLOW_SPEED
5600   BUB_AGE(I)=0
5610   BUB_PHASE(I)=FLYING
5620   BUB_OWNER(I)=P
5630   BUB_HOLDS(I)=0
5640   BUB_WOB(I)=RND(6)
5650   BLOW_WAIT(P)=0.24
5660   PLAY_SFX ASSETS$+"BLOW.WAV"
5670 END SUB
5800 REM A TOY'S TOUCH OR A SHOT COSTS A LIFE, BUT NOT JUST AFTER COMING BACK
5810 SUB HURT_PLAYERS
5820   LOCAL P,I,CX,CY,HIT
5830   FOR P=1 TO 2
5840     IF FNIN_PLAY(P) AND SAFE(P)=0 THEN
5850       CX=PX(P)+BODY_W/2
5860       CY=PY(P)+BODY_H/2
5870       HIT=0
5880       FOR I=1 TO TOY_COUNT
5890         IF FNTOY_TOUCHES(I,CX,CY) THEN HIT=1
5900       NEXT I
5910       FOR I=1 TO MAX_SHOTS
5920         IF FNSHOT_TOUCHES(I,CX,CY) THEN HIT=1:SHOT_ON(I)=0
5930       NEXT I
5940       IF HIT THEN LOSE_LIFE P
5950     END IF
5960   NEXT P
5970 END SUB
6100 DEF FNTOY_TOUCHES(I,X,Y)=TOY_ON(I) AND ABS(TOY_X(I)+TOY_W/2-X)<13 AND ABS(TOY_Y(I)+TOY_H/2-Y)<11
6110 DEF FNSHOT_TOUCHES(I,X,Y)=SHOT_ON(I) AND ABS(SHOT_X(I)-X)<13 AND ABS(SHOT_Y(I)-Y)<13
6200 SUB LOSE_LIFE(P)
6210   DEAD_TIME(P)=1.4
6220   PVY(P)=-260
6230   PLAY_SFX ASSETS$+"LOST.WAV"
6240   FX_BURST(PX(P)+BODY_W/2,PY(P)+BODY_H/2,14,120,"#FF8099")
6250 END SUB
6300 SUB TUMBLE(P)
6310   DEAD_TIME(P)=DEAD_TIME(P)-DT
6320   PVY(P)=PVY(P)+GRAVITY*0.5*DT
6330   PY(P)=PY(P)+PVY(P)*DT
6340   IF DEAD_TIME(P)>0 THEN EXIT SUB
6350   LIVES(P)=LIVES(P)-1
6360   IF LIVES(P)>0 THEN PLACE_PLAYER P ELSE ALIVE(P)=0
6370 END SUB
7000 REM --- TOYS - WALKERS PACE AND ROLL ROCKS, HOPPERS BOUNCE, GHOSTS DRIFT AND THROW SPARKS ---
7010 SUB MOVE_TOYS
7020   LOCAL I
7030   TOYS_OUT=0
7040   FOR I=1 TO TOY_COUNT
7050     IF TOY_ON(I) THEN
7060       MOVE_TOY I
7070       TOYS_OUT=TOYS_OUT+1
7080     END IF
7090   NEXT I
7100 END SUB
7200 SUB MOVE_TOY(I)
7210   LOCAL FAST
7220   TOY_T(I)=TOY_T(I)+DT
7230   FAST=PACE
7240   IF TOY_ANGRY(I) THEN FAST=PACE*1.35
7250   NEAREST_PLAYER TOY_X(I)+TOY_W/2,TOY_Y(I)+TOY_H/2
7260   REM A JUMP IS TOLD BEFORE IT HAPPENS: THE TOY CROUCHES, STILL, THEN SPRINGS
7270   IF TOY_CROUCH(I)>0 THEN
7280     TOY_CROUCH(I)=TOY_CROUCH(I)-DT
7290     TOY_VX(I)=0
7300     IF TOY_CROUCH(I)<=0 THEN SPRING I
7310   END IF
7320   IF TOY_KIND(I)=1 THEN
7330     WALK I,FAST
7340   ELSEIF TOY_KIND(I)=2 THEN
7350     HOP I,FAST
7360   ELSE
7370     DRIFT I,FAST
7380   END IF
7390   TOY_ATTACKS I,FAST
7400 END SUB
7500 SUB CROUCH(I,VX,VY)
7510   TOY_CROUCH(I)=0.22
7520   TOY_LEAP_VX(I)=VX
7530   TOY_LEAP_VY(I)=VY
7540 END SUB
7600 SUB SPRING(I)
7610   TOY_VX(I)=TOY_LEAP_VX(I)
7620   TOY_VY(I)=TOY_LEAP_VY(I)
7630   TOY_GROUND(I)=0
7640 END SUB
7700 SUB TURN_TOY(I)
7710   TOY_DIR(I)=-TOY_DIR(I)
7720   TOY_VX(I)=-TOY_VX(I)
7730 END SUB
7800 REM A WALKER PACES ITS PLATFORM, SOMETIMES TURNING AT THE EDGE, AND JUMPS UP AT A PLAYER ABOVE
7810 SUB WALK(I,FAST)
7820   LOCAL AHEAD
7830   IF TOY_GROUND(I) AND TOY_CROUCH(I)<=0 THEN
7840     IF TOY_WINDUP(I)>0 THEN TOY_VX(I)=0 ELSE TOY_VX(I)=TOY_DIR(I)*58*FAST
7850     TOY_EDGE_WAIT(I)=TOY_EDGE_WAIT(I)-DT
7860     IF TOY_DIR(I)>0 THEN AHEAD=TOY_X(I)+TOY_W+2 ELSE AHEAD=TOY_X(I)-2
7870     IF TOY_EDGE_WAIT(I)<=0 AND NOT FNFLOOR_AT(AHEAD,TOY_Y(I)+TOY_H) THEN
7880       TOY_EDGE_WAIT(I)=0.6
7890       IF RND(1)<0.55 THEN TURN_TOY I
7900     END IF
7910     TOY_JUMP_WAIT(I)=TOY_JUMP_WAIT(I)-DT
7920     IF TOY_JUMP_WAIT(I)<=0 THEN
7930       TOY_JUMP_WAIT(I)=(1+RND(1.4))/FAST
7940       IF TARGET AND TARGET_Y<TOY_Y(I)-30 AND ABS(TARGET_X-TOY_X(I))<150 AND RND(1)<0.7 THEN
7950         CROUCH I,TOY_DIR(I)*58*FAST,-JUMP_SPEED
7960       ELSEIF TARGET AND RND(1)<0.15 THEN
7970         TOY_DIR(I)=FNSIDE(TARGET_X-TOY_X(I))
7980       END IF
7990     END IF
8000   END IF
8010   STEP_TOY I
8020   IF HIT_WALL THEN TOY_DIR(I)=-TOY_DIR(I)
8030 END SUB
8200 REM A HOPPER BOUNCES TOWARD THE NEAREST PLAYER, HIGH WHEN THEY ARE ABOVE IT
8210 SUB HOP(I,FAST)
8220   LOCAL TOWARD,HIGH_UP
8230   IF TOY_GROUND(I) AND TOY_CROUCH(I)<=0 THEN
8240     TOY_VX(I)=TOY_VX(I)*0.8
8250     TOY_JUMP_WAIT(I)=TOY_JUMP_WAIT(I)-DT
8260     IF TOY_JUMP_WAIT(I)<=0 THEN
8270       TOY_JUMP_WAIT(I)=(0.6+RND(0.7))/FAST
8280       TOWARD=TOY_DIR(I)
8290       IF TARGET THEN TOWARD=FNSIDE(TARGET_X-TOY_X(I))
8300       IF RND(1)<0.75 THEN TOY_DIR(I)=TOWARD ELSE TOY_DIR(I)=-TOWARD
8310       HIGH_UP=(TARGET AND TARGET_Y<TOY_Y(I)-20) OR RND(1)<0.3
8320       IF HIGH_UP THEN
8330         CROUCH I,TOY_DIR(I)*85*FAST,-JUMP_SPEED*0.98
8340       ELSE
8350         CROUCH I,TOY_DIR(I)*85*FAST,-300
8360       END IF
8370     END IF
8380   END IF
8390   STEP_TOY I
8400   IF HIT_WALL THEN TURN_TOY I
8410 END SUB
8500 REM A GHOST FLOATS ON A SLANT, BOUNCING OFF THE WALLS, THE FLOOR AND THE CEILING
8510 SUB DRIFT(I,FAST)
8520   LOCAL SPEED
8530   SPEED=62*FAST
8540   TOY_VX(I)=FNSIDE(TOY_VX(I))*SPEED
8550   TOY_VY(I)=FNSIDE(TOY_VY(I))*SPEED*0.8
8560   TOY_X(I)=TOY_X(I)+TOY_VX(I)*DT
8570   TOY_Y(I)=TOY_Y(I)+TOY_VY(I)*DT+SIN(TOY_T(I)*3)*12*DT
8580   IF TOY_X(I)<TILE THEN TOY_VX(I)=SPEED
8590   IF TOY_X(I)>WIDE-TILE-TOY_W THEN TOY_VX(I)=-SPEED
8600   IF TOY_Y(I)<HUD+TILE THEN TOY_VY(I)=SPEED
8610   IF TOY_Y(I)>HIGH-TILE-TOY_H THEN TOY_VY(I)=-SPEED
8620   TOY_X(I)=CLAMP(TOY_X(I),TILE,WIDE-TILE-TOY_W)
8630   TOY_Y(I)=CLAMP(TOY_Y(I),HUD+TILE,HIGH-TILE-TOY_H)
8640 END SUB
8700 SUB STEP_TOY(I)
8710   BX=TOY_X(I):BY=TOY_Y(I)
8720   BVX=TOY_VX(I):BVY=TOY_VY(I)
8730   BW=TOY_W:BH=TOY_H
8740   MOVE_BODY
8750   TOY_X(I)=BX:TOY_Y(I)=BY
8760   TOY_VX(I)=BVX:TOY_VY(I)=BVY
8770   TOY_GROUND(I)=LANDED
8780 END SUB
8800 REM TARGET IS 1 WHEN SOMEONE IS IN PLAY; TARGET_X AND TARGET_Y ARE WHERE
8810 SUB NEAREST_PLAYER(X,Y)
8820   LOCAL P,D,BEST
8830   TARGET=0:BEST=99999
8840   FOR P=1 TO 2
8850     IF FNIN_PLAY(P) THEN
8860       D=DISTANCE(X,Y,PX(P)+BODY_W/2,PY(P)+BODY_H/2)
8870       IF D<BEST THEN
8880         BEST=D:TARGET=1
8890         TARGET_X=PX(P)+BODY_W/2
8900         TARGET_Y=PY(P)+BODY_H/2
8910       END IF
8920     END IF
8930   NEXT P
8940 END SUB
9100 REM WALKERS WIND UP, THEN ROLL A ROCK ALONG THEIR PLATFORM (FROM ROUND THREE);
9110 REM ANGRY GHOSTS AIM A SLOW SPARK AT THE NEAREST PLAYER (FROM ROUND FOUR)
9120 SUB TOY_ATTACKS(I,FAST)
9130   LOCAL CX,CY
9140   CX=TOY_X(I)+TOY_W/2
9150   CY=TOY_Y(I)+TOY_H/2
9160   TOY_SHOT_WAIT(I)=TOY_SHOT_WAIT(I)-DT
9170   IF TOY_WINDUP(I)>0 THEN
9180     TOY_WINDUP(I)=TOY_WINDUP(I)-DT
9190     IF TOY_WINDUP(I)<=0 THEN FIRE CX+TOY_DIR(I)*12,CY+2,TOY_DIR(I)*170,0,0
9200   ELSEIF TOY_SHOT_WAIT(I)<=0 AND TARGET THEN
9210     IF TOY_KIND(I)=1 AND ROUND>=3 AND TOY_GROUND(I) AND FNIN_LINE(CX,CY) THEN
9220       TOY_DIR(I)=FNSIDE(TARGET_X-CX)
9230       TOY_WINDUP(I)=0.6
9240       TOY_SHOT_WAIT(I)=(2.2+RND(1.8))/FAST
9250     ELSEIF TOY_KIND(I)=3 AND ROUND>=4 AND TOY_ANGRY(I) THEN
9260       AIM_SPARK CX,CY
9270       TOY_SHOT_WAIT(I)=(3+RND(2))/FAST
9280     ELSE
9290       TOY_SHOT_WAIT(I)=0.4
9300     END IF
9310   END IF
9320 END SUB
9500 DEF FNIN_LINE(X,Y)=ABS(TARGET_Y-Y)<14 AND ABS(TARGET_X-X)<300
9510 DEF FNSIDE(D)=1-2*(D<0)
9600 SUB AIM_SPARK(X,Y)
9610   LOCAL D
9620   D=MAX(1,DISTANCE(X,Y,TARGET_X,TARGET_Y))
9630   FIRE X,Y,(TARGET_X-X)/D*95,(TARGET_Y-Y)/D*95,1
9640 END SUB
9700 SUB FIRE(X,Y,VX,VY,SPARK)
9710   LOCAL I
9720   FOR I=1 TO MAX_SHOTS
9730     IF NOT SHOT_ON(I) THEN EXIT FOR
9740   NEXT I
9750   IF I>MAX_SHOTS THEN EXIT SUB
9760   SHOT_ON(I)=1:SHOT_T(I)=0
9770   SHOT_X(I)=X:SHOT_Y(I)=Y
9780   SHOT_VX(I)=VX:SHOT_VY(I)=VY
9790   SHOT_SPARK(I)=SPARK
9800   IF SPARK THEN PLAY_SFX ASSETS$+"SPARKLE.WAV" ELSE PLAY_SFX ASSETS$+"BOUNCE.WAV"
9810 END SUB
10000 REM --- BUBBLES - THEY FLY, FLOAT UP, GATHER UNDER THE CEILING, AND BURST IN TIME ---
10010 SUB MOVE_BUBBLES
10020   LOCAL I,P
10030   TOYS_HELD=0
10040   FOR I=1 TO MAX_BUBBLES
10050     IF BUB_ON(I) THEN MOVE_BUBBLE I
10060   NEXT I
10070   JOSTLE_BUBBLES
10080   FOR P=1 TO 2
10090     IF FNIN_PLAY(P) THEN TOUCH_BUBBLES P
10100   NEXT P
10110 END SUB
10190 REM A BUBBLE WITH A TOY IN IT SWELLS TO HOLD THE WHOLE TOY
10192 DEF FNBUB_R(I)=BUBBLE_R+(TRAP_R-BUBBLE_R)*(BUB_HOLDS(I)>0)
10194 DEF FNTOP_Y(I)=HUD+TILE+FNBUB_R(I)+4
10200 SUB MOVE_BUBBLE(I)
10210   LOCAL AWAY,LIFE
10220   BUB_AGE(I)=BUB_AGE(I)+DT
10230   BUB_WOB(I)=BUB_WOB(I)+DT
10240   IF BUB_PHASE(I)=FLYING THEN
10250     BUB_X(I)=BUB_X(I)+BUB_VX(I)*DT
10260     BUB_VX(I)=BUB_VX(I)*(1-2.5*DT)
10270     IF BUB_AGE(I)>SHOOT_TIME THEN BUB_PHASE(I)=FLOATING
10280     IF ABS(BUB_X(I)-WIDE/2)>WIDE/2-TILE-FNBUB_R(I) THEN BUB_PHASE(I)=FLOATING
10290     BUB_X(I)=CLAMP(BUB_X(I),TILE+FNBUB_R(I),WIDE-TILE-FNBUB_R(I))
10300     IF BUB_HOLDS(I)=0 THEN CATCH_TOY I
10310   ELSEIF BUB_PHASE(I)=FLOATING THEN
10320     IF BUB_HOLDS(I) THEN BUB_Y(I)=BUB_Y(I)-RISE_FULL*DT ELSE BUB_Y(I)=BUB_Y(I)-RISE*DT
10330     BUB_X(I)=BUB_X(I)+SIN(BUB_WOB(I)*2.2)*10*DT
10340     IF BUB_Y(I)<=FNTOP_Y(I) THEN BUB_PHASE(I)=AT_TOP
10350   ELSE
10360     REM UNDER THE CEILING THEY DRIFT TOWARD THE MIDDLE, WHERE CHAINS HAPPEN
10370     AWAY=WIDE/2-BUB_X(I)
10380     BUB_X(I)=BUB_X(I)+FNSIDE(AWAY)*MIN(ABS(AWAY),38)*DT+SIN(BUB_WOB(I)*1.7)*6*DT
10390     BUB_Y(I)=FNTOP_Y(I)+SIN(BUB_WOB(I)*2)*1.5
10400   END IF
10405   BUB_X(I)=CLAMP(BUB_X(I),TILE+FNBUB_R(I),WIDE-TILE-FNBUB_R(I))
10410   IF BUB_HOLDS(I) THEN LIFE=TRAP_LIFE ELSE LIFE=FREE_LIFE
10420   IF BUB_AGE(I)>LIFE AND BUB_PHASE(I)<>FLYING THEN BURST I
10430   IF BUB_ON(I) AND BUB_HOLDS(I) THEN TOYS_HELD=TOYS_HELD+1
10440 END SUB
10600 REM A BUBBLE STILL FLYING CATCHES THE FIRST TOY IT MEETS
10610 SUB CATCH_TOY(I)
10620   LOCAL K,CX,CY
10630   FOR K=1 TO TOY_COUNT
10640     CX=TOY_X(K)+TOY_W/2
10650     CY=TOY_Y(K)+TOY_H/2
10660     IF TOY_ON(K) AND ABS(BUB_X(I)-CX)<20 AND ABS(BUB_Y(I)-CY)<20 THEN
10670       TOY_ON(K)=0
10680       BUB_HOLDS(I)=K
10690       BUB_AGE(I)=0
10700       BUB_PHASE(I)=FLOATING
10710       BUB_X(I)=CX:BUB_Y(I)=CY
10720       PLAY_SFX ASSETS$+"TRAP.WAV"
10730       EXIT SUB
10740     END IF
10750   NEXT K
10760 END SUB
10900 REM ITS TIME IS UP: THE BUBBLE BURSTS, AND A TOY INSIDE COMES OUT ANGRY
10910 SUB BURST(I)
10920   LOCAL K
10930   BUB_ON(I)=0
10940   FX_BURST(BUB_X(I),BUB_Y(I),6,60,"#FFFFFF99")
10950   K=BUB_HOLDS(I)
10960   IF K=0 THEN EXIT SUB
10970   TOY_ON(K)=1:TOY_ANGRY(K)=1
10980   TOY_X(K)=BUB_X(I)-TOY_W/2
10990   TOY_Y(K)=BUB_Y(I)-TOY_H/2
11000   TOY_VX(K)=0:TOY_VY(K)=0
11010   TOY_DIR(K)=FNSIDE(RND(2)-1)
11020   TOY_JUMP_WAIT(K)=0.5
11030   TOY_SHOT_WAIT(K)=1.5+RND(1.5)
11040   TOY_WINDUP(K)=0
11050   TOY_CROUCH(K)=0
11060   IF TOY_KIND(K)=3 THEN SET_DRIFT K,1
11070   TOYS_OUT=TOYS_OUT+1
11080   PLAY_SFX ASSETS$+"POP.WAV"
11090 END SUB
11300 REM FLOATING BUBBLES NUDGE EACH OTHER INTO A CLUSTER INSTEAD OF STACKING UP
11310 SUB JOSTLE_BUBBLES
11320   LOCAL I,J
11330   FOR I=1 TO MAX_BUBBLES-1
11340     IF BUB_ON(I) AND BUB_PHASE(I)<>FLYING THEN
11350       FOR J=I+1 TO MAX_BUBBLES
11360         IF BUB_ON(J) AND BUB_PHASE(J)<>FLYING AND ABS(BUB_X(J)-BUB_X(I))<FNBUB_R(I)+FNBUB_R(J) THEN NUDGE I,J
11370       NEXT J
11380     END IF
11390   NEXT I
11400 END SUB
11500 SUB NUDGE(I,J)
11510   LOCAL DX,DY,D,PUSH
11520   DX=BUB_X(J)-BUB_X(I)
11530   DY=BUB_Y(J)-BUB_Y(I)
11540   D=MAX(SQR(DX*DX+DY*DY),0.1)
11550   IF D>=FNBUB_R(I)+FNBUB_R(J)-1 THEN EXIT SUB
11560   PUSH=(FNBUB_R(I)+FNBUB_R(J)-1-D)/2
11570   BUB_X(I)=BUB_X(I)-DX/D*PUSH
11580   BUB_X(J)=BUB_X(J)+DX/D*PUSH
11590   IF BUB_PHASE(I)=AT_TOP AND BUB_PHASE(J)=AT_TOP THEN EXIT SUB
11600   BUB_Y(I)=BUB_Y(I)-DY/D*PUSH/2
11610   BUB_Y(J)=BUB_Y(J)+DY/D*PUSH/2
11620 END SUB
11700 REM HOLD JUMP TO BOUNCE ON A BUBBLE FROM ABOVE; ANY OTHER TOUCH POPS IT,
11710 REM EXCEPT YOUR OWN EMPTY BUBBLE IN ITS FIRST QUARTER SECOND
11720 SUB TOUCH_BUBBLES(P)
11730   LOCAL I,CX,CY
11740   CX=PX(P)+BODY_W/2
11750   CY=PY(P)+BODY_H/2
11760   FOR I=1 TO MAX_BUBBLES
11770     IF BUB_ON(I) AND DISTANCE(CX,CY,BUB_X(I),BUB_Y(I))<FNBUB_R(I)+11 THEN
11780       IF PVY(P)>40 AND CY<BUB_Y(I)-6 AND JUMP_HELD(P) THEN
11790         PVY(P)=-JUMP_SPEED*0.82
11800         PLAY_SFX ASSETS$+"BOUNCE.WAV"
11810         EXIT SUB
11820       END IF
11830       IF NOT (BUB_OWNER(I)=P AND BUB_AGE(I)<0.25 AND BUB_HOLDS(I)=0) THEN
11840         POP_CHAIN I,P
11850         EXIT SUB
11860       END IF
11870     END IF
11880   NEXT I
11890 END SUB
12000 REM POP A BUBBLE, EVERY BUBBLE TOUCHING IT, AND EVERY ONE TOUCHING THOSE.
12010 REM EACH TOY IN THE CHAIN IS WORTH DOUBLE THE LAST AND DROPS A SWEETER CANDY.
12020 SUB POP_CHAIN(FIRST,P)
12030   LOCAL K,J,COUNT,KILLS,TOTAL,VALUE
12040   BUB_ON(FIRST)=0
12050   CHAIN(1)=FIRST:COUNT=1
12060   K=1
12070   WHILE K<=COUNT
12080     FOR J=1 TO MAX_BUBBLES
12090       IF BUB_ON(J) AND FNBUBBLES_TOUCH(CHAIN(K),J) THEN
12100         BUB_ON(J)=0
12110         COUNT=COUNT+1
12120         CHAIN(COUNT)=J
12130       END IF
12140     NEXT J
12150     K=K+1
12160   WEND
12170   KILLS=0:TOTAL=0:VALUE=1000
12180   FOR K=1 TO COUNT
12190     J=CHAIN(K)
12200     FX_RING(BUB_X(J),BUB_Y(J),FNBUB_R(J)*2,0.35,"#BFFFBFE6")
12210     IF BUB_HOLDS(J) THEN
12220       TOTAL=TOTAL+VALUE
12230       DROP_CANDY BUB_X(J),BUB_Y(J),MIN(KILLS,3)
12240       KILLS=KILLS+1
12250       VALUE=MIN(VALUE*2,16000)
12260     END IF
12270   NEXT K
12280   SCORE(P)=SCORE(P)+TOTAL+10*(COUNT-KILLS)
12290   PLAY_SFX ASSETS$+"POP.WAV"
12300   IF KILLS>0 THEN
12310     PLAY_SFX ASSETS$+"DEFEATED.WAV"
12320     FX_POPUP(BUB_X(FIRST),BUB_Y(FIRST)-6,STR$(TOTAL),"#FFF266")
12330   END IF
12340   IF KILLS>=2 THEN
12350     CHAIN_SIZE=KILLS:CHAIN_TIME=1.2
12360     PLAY_SFX ASSETS$+"SPARKLE.WAV"
12370   END IF
12380 END SUB
12600 DEF FNBUBBLES_TOUCH(A,B)=DISTANCE(BUB_X(A),BUB_Y(A),BUB_X(B),BUB_Y(B))<(FNBUB_R(A)+FNBUB_R(B))*1.35
13000 REM --- CANDY - IT HOPS OUT OF ITS BUBBLE, LANDS, AND WAITS NINE SECONDS TO BE EATEN ---
13010 SUB DROP_CANDY(X,Y,KIND)
13020   LOCAL I
13030   FOR I=1 TO MAX_CANDIES
13040     IF NOT CANDY_ON(I) THEN EXIT FOR
13050   NEXT I
13060   IF I>MAX_CANDIES THEN EXIT SUB
13070   CANDY_ON(I)=1
13080   CANDY_KIND(I)=KIND
13090   CANDY_X(I)=X-8:CANDY_Y(I)=Y-8
13100   CANDY_VX(I)=RND(220)-110
13110   CANDY_VY(I)=-300
13120   CANDY_T(I)=0
13130   CANDY_GROUND(I)=0
13140 END SUB
13300 SUB MOVE_CANDIES
13310   LOCAL I
13320   FOR I=1 TO MAX_CANDIES
13330     IF CANDY_ON(I) THEN MOVE_CANDY I
13340   NEXT I
13350 END SUB
13400 SUB MOVE_CANDY(I)
13410   LOCAL P
13420   CANDY_T(I)=CANDY_T(I)+DT
13430   IF NOT CANDY_GROUND(I) THEN
13440     BX=CANDY_X(I):BY=CANDY_Y(I)
13450     BVX=CANDY_VX(I):BVY=CANDY_VY(I)
13460     BW=16:BH=16
13470     MOVE_BODY
13480     CANDY_X(I)=BX:CANDY_Y(I)=BY
13490     CANDY_VX(I)=BVX*(1-0.8*DT)
13500     CANDY_VY(I)=BVY
13510     CANDY_GROUND(I)=LANDED
13520   END IF
13530   IF CANDY_T(I)>9 THEN CANDY_ON(I)=0
13540   IF CANDY_T(I)<0.35 THEN EXIT SUB
13550   FOR P=1 TO 2
13560     IF FNIN_PLAY(P) AND FNREACHES_CANDY(P,I) THEN
13570       EAT_CANDY I,P
13580       EXIT SUB
13590     END IF
13600   NEXT P
13610 END SUB
13800 DEF FNREACHES_CANDY(P,I)=ABS(PX(P)+BODY_W/2-CANDY_X(I)-8)<16 AND ABS(PY(P)+BODY_H/2-CANDY_Y(I)-8)<18
13900 SUB EAT_CANDY(I,P)
13910   LOCAL VALUE
13920   VALUE=CANDY_VALUE(CANDY_KIND(I))
13930   CANDY_ON(I)=0
13940   SCORE(P)=SCORE(P)+VALUE
13950   FX_POPUP(CANDY_X(I)+8,CANDY_Y(I),STR$(VALUE),"BLIP_WHITE")
13960   FX_BURST(CANDY_X(I)+8,CANDY_Y(I)+8,5,60,"#FFFF99")
13970   PLAY_SFX ASSETS$+"FRUIT.WAV"
13980 END SUB
14000 REM --- SHOTS - ROCKS ROLL UNTIL THEY MEET A BLOCK OR A FRESH BUBBLE;
14010 REM SPARKS DRIFT THROUGH THE WALLS AND FADE AFTER FOUR SECONDS ---
14020 SUB MOVE_SHOTS
14030   LOCAL I
14040   FOR I=1 TO MAX_SHOTS
14050     IF SHOT_ON(I) THEN MOVE_SHOT I
14060   NEXT I
14070 END SUB
14200 SUB MOVE_SHOT(I)
14210   LOCAL C,R,K
14220   SHOT_T(I)=SHOT_T(I)+DT
14230   SHOT_X(I)=SHOT_X(I)+SHOT_VX(I)*DT
14240   SHOT_Y(I)=SHOT_Y(I)+SHOT_VY(I)*DT
14250   IF SHOT_SPARK(I) THEN
14260     IF SHOT_T(I)>4 THEN END_SHOT I
14270   ELSE
14280     C=INT((SHOT_X(I)+FNSIDE(SHOT_VX(I))*5)/TILE)
14290     R=INT((SHOT_Y(I)-HUD)/TILE)
14300     IF FNBLOCK(C,R) OR C<=0 OR C>=COLS-1 THEN END_SHOT I
14310   END IF
14320   IF SHOT_Y(I)<HUD OR SHOT_Y(I)>HIGH THEN END_SHOT I
14330   FOR K=1 TO MAX_BUBBLES
14340     IF SHOT_ON(I) AND FNKNOCKS_OUT(K,I) THEN END_SHOT I
14350   NEXT K
14360 END SUB
14500 REM A BUBBLE YOU HAVE JUST BLOWN KNOCKS A SHOT OUT OF THE AIR
14510 DEF FNKNOCKS_OUT(K,I)=BUB_ON(K) AND BUB_PHASE(K)=FLYING AND DISTANCE(BUB_X(K),BUB_Y(K),SHOT_X(I),SHOT_Y(I))<BUBBLE_R+5
14600 SUB END_SHOT(I)
14610   SHOT_ON(I)=0
14620   FX_BURST(SHOT_X(I),SHOT_Y(I),5,70,"#FFD999CC")
14630 END SUB
15000 REM --- CLEAR - EVERYONE STILL IN GETS A LIFE BACK, UP TO SEVEN; THEN THE NEXT ROUND ---
15010 SUB ROUND_WON
15020   LOCAL P,I
15030   EXTENDED=0
15040   FOR P=1 TO 2
15050     IF JOINED(P) AND LIVES(P)>0 AND LIVES(P)<MOST_LIVES THEN
15060       LIVES(P)=LIVES(P)+1
15070       EXTENDED=1
15080     END IF
15090   NEXT P
15100   FOR I=1 TO MAX_SHOTS:SHOT_ON(I)=0:NEXT I
15110   PLAY_SFX ASSETS$+"SPARKLE.WAV"
15120   SHOW "CLEAR"
15130 END SUB
15300 SUB UPDATE_CLEAR
15310   MOVE_PLAYERS
15320   MOVE_BUBBLES
15330   MOVE_CANDIES
15340   IF STATE_TIME>1 THEN POP_LEFTOVERS
15350   IF STATE_TIME>3.4 AND ROUND<ROUNDS THEN LOAD_ROUND ROUND+1
15360   IF STATE_TIME>3.4 AND ROUND=ROUNDS THEN WIN_GAME
15370 END SUB
15500 REM THE LEFTOVER BUBBLES POP ONE BY ONE, EIGHT A SECOND, FOR A LITTLE APPLAUSE
15510 SUB POP_LEFTOVERS
15520   LOCAL I
15530   IF INT(STATE_TIME*8)=INT((STATE_TIME-DT)*8) THEN EXIT SUB
15540   FOR I=1 TO MAX_BUBBLES
15550     IF BUB_ON(I) THEN
15560       BUB_ON(I)=0
15570       FX_BURST(BUB_X(I),BUB_Y(I),8,80,"#FFFFFFCC")
15580       PLAY_SFX ASSETS$+"POP.WAV"
15590       EXIT SUB
15600     END IF
15610   NEXT I
15620 END SUB
15800 SUB DRAW_CLEAR
15810   DRAW_ARENA 1
15820   BANNER "CLEAR!",258,4,"#AAF0BE"
15830   IF EXTENDED AND STATE_TIME>0.6 THEN BANNER "EXTEND +1 LIFE",326,2,"#FFAAC8"
15840 END SUB
16000 REM --- OVER - EVERY LIFE LOST, OR ALL EIGHT ROUNDS WON ---
16010 SUB WIN_GAME
16020   WON=1
16030   PLAY_SFX ASSETS$+"DEFEATED.WAV"
16040   SHOW "OVER"
16050 END SUB
16100 SUB UPDATE_OVER
16110   IF STATE_TIME<2.5 THEN EXIT SUB
16120   IF BLOW_KEY(1) OR JUMP_KEY(1) OR JOIN_KEY THEN
16130     TWO=0
16140     PLAY_MUSIC ASSETS$+"THEME.WAV"
16150     SHOW "TITLE"
16160   END IF
16170 END SUB
16300 SUB DRAW_OVER
16310   LOCAL AGAIN$
16320   DRAW_ARENA 1
16330   FILL_RECT(0,HUD,WIDE,HIGH-HUD,COLOR(0.08,0.03,0.11,0.55*MIN(STATE_TIME*2,1)))
16340   IF WON THEN BANNER "YOU WIN!",232,4,"#AAF0BE" ELSE BANNER "GAME OVER",232,4,"#FFAAC8"
16350   AGAIN$=CONTROL_TEXT$("SPACE","FIRE","TAP")+" TO PLAY AGAIN"
16360   IF STATE_TIME>2.5 THEN BANNER AGAIN$,320,2,"#FFC496"
16370 END SUB
17000 REM --- BODIES - FALLING, LANDING ON PLATFORMS, AND THE HOLES TOP AND BOTTOM ---
17010 REM MOVE_BODY MOVES BX,BY (BW WIDE, BH HIGH) AT BVX,BVY. A BODY RISES THROUGH BLOCKS
17020 REM AND LANDS ON THEIR TOPS; LANDED AND HIT_WALL SAY WHAT HAPPENED.
17030 SUB MOVE_BODY
17040   LOCAL OLD_FOOT,R
17050   BVY=MIN(BVY+GRAVITY*DT,MAX_FALL)
17060   BX=BX+BVX*DT
17070   HIT_WALL=(BX<TILE OR BX>WIDE-TILE-BW)
17080   BX=CLAMP(BX,TILE,WIDE-TILE-BW)
17090   OLD_FOOT=BY+BH
17100   BY=BY+BVY*DT
17110   LANDED=0
17120   IF BVY>=0 THEN
17130     REM EVERY ROW THE FEET PASSED THIS STEP, SO A FAST FALL CANNOT SKIP A PLATFORM
17140     FOR R=-INT(-(OLD_FOOT-HUD)/TILE) TO INT((BY+BH-HUD)/TILE)
17150       IF FNBLOCK(INT((BX+3)/TILE),R) OR FNBLOCK(INT((BX+BW-3)/TILE),R) THEN
17160         BY=HUD+R*TILE-BH
17170         BVY=0:LANDED=1
17180         EXIT FOR
17190       END IF
17200     NEXT R
17210   END IF
17220   REM THE CEILING STOPS YOU, EXCEPT AT THE HOLE IN IT
17230   IF BY<HUD+TILE AND NOT FNIN_GAP(BX+BW/2) THEN
17240     BY=HUD+TILE
17250     BVY=MAX(BVY,0)
17260   END IF
17270   REM DOWN THE HOLE IN THE FLOOR, BACK IN THROUGH THE ONE IN THE CEILING
17280   IF BY>HIGH THEN BY=HUD-BH
17290 END SUB
17500 DEF FNBLOCK(C,R)=R>=1 AND R<ROWS AND BLOCK(R,C)
17510 DEF FNIN_GAP(X)=X>=GAP_LEFT*TILE AND X<(GAP_RIGHT+1)*TILE
17520 DEF FNFLOOR_AT(X,FOOT)=ABS(FOOT-HUD-TILE*INT((FOOT-HUD)/TILE+0.5))<=0.5 AND FNBLOCK(INT(X/TILE),INT((FOOT-HUD)/TILE+0.5))
18000 REM --- DRAWING ---
18010 REM GROWN IS HOW FAR THE TOYS HAVE POPPED INTO PLACE, 0 TO 1
18020 SUB DRAW_ARENA(GROWN)
18030   LOCAL I
18040   FOR I=0 TO 17
18050     FILL_RECT(0,I*HIGH/18,WIDE,HIGH/18+1,BAND(I))
18060   NEXT I
18070   DRAW_BOKEH GLOW_R,GLOW_G,GLOW_B
18080   DRAW_TILES
18090   DRAW_CANDIES
18100   DRAW_TOYS GROWN
18110   DRAW_PLAYERS
18120   DRAW_BUBBLES
18130   DRAW_SHOTS
18140   FX_DRAW
18150   DRAW_SCORES
18160 END SUB
18200 REM SOFT LIGHTS DRIFT UP BEHIND THE PLAY, AND STARS TWINKLE
18210 SUB DRAW_BOKEH(R,G,B)
18220   LOCAL I,S,T,X,Y,A
18230   T=TIME()
18240   FOR I=0 TO 21
18250     S=I*37.7
18260     X=(S*13.1) MOD WIDE
18270     Y=HIGH+20-((S*7.3+T*(6+(I MOD 5)*3)) MOD (HIGH+40))
18280     A=0.05+0.04*(SIN(T*0.8+S)*0.5+0.5)
18290     FILL_CIRCLE(X,Y,3+(I MOD 4)*3,COLOR(R,G,B,A))
18300   NEXT I
18310   FOR I=0 TO 29
18320     S=I*91.3
18330     A=SIN(T*2+S)*0.5+0.5
18340     FILL_RECT((S*5.7) MOD WIDE,HUD+(S*3.1) MOD (HIGH-HUD),1.5,1.5,COLOR(1,1,1,A*A*A*0.8))
18350   NEXT I
18360 END SUB
18500 SUB DRAW_TILES
18510   LOCAL K,TILE$,EDGE$
18520   TILE$=ASSETS$+"TILE_"+STR$(ROUND)+".PNG"
18530   EDGE$=ASSETS$+"BORDER_"+STR$(ROUND)+".PNG"
18540   FOR K=1 TO TILE_COUNT
18550     IF TILE_EDGE(K) THEN
18560       DRAW_TEXTURE(EDGE$,TILE_X(K),TILE_Y(K),TILE,TILE)
18570     ELSE
18580       DRAW_TEXTURE(TILE$,TILE_X(K),TILE_Y(K),TILE,TILE)
18590     END IF
18600   NEXT K
18610 END SUB
18800 REM A TOY CROUCHING TO JUMP, OR WINDING UP A ROCK, TREMBLES FIRST: THAT IS THE TELL
18810 SUB DRAW_TOYS(GROWN)
18820   LOCAL I,SHAKE,SCALE,FACE
18830   FOR I=1 TO TOY_COUNT
18840     IF TOY_ON(I) THEN
18850       SHAKE=0
18860       IF TOY_WINDUP(I)>0 OR TOY_CROUCH(I)>0 THEN SHAKE=SIN(TOY_T(I)*70)*1.4
18870       SCALE=TOY_SCALE*MAX(GROWN,0.05)
18880       IF TOY_CROUCH(I)>0 THEN SCALE=SCALE*0.82
18885       IF ABS(TOY_VX(I))>1 THEN FACE=SGN(TOY_VX(I)) ELSE FACE=TOY_DIR(I)
18890       DRAW_TOY TOY_KIND(I),TOY_ANGRY(I),TOY_X(I)+TOY_W/2+SHAKE,TOY_Y(I)+TOY_H,SCALE,FACE
18900     END IF
18910   NEXT I
18920 END SUB
19100 REM A TOY STANDS WITH ITS FEET AT X,FOOT; ITS PICTURE IS 32 BY 36 BEFORE SCALING, FACING
19105 REM RIGHT: A NEGATIVE WIDTH TURNS IT TO FACE LEFT
19110 SUB DRAW_TOY(KIND,ANGRY,X,FOOT,SCALE,FACE)
19120   LOCAL NAME$
19130   NAME$=KIND$(KIND)
19140   IF ANGRY THEN NAME$=NAME$+"_ANGRY"
19150   DRAW_TEXTURE(ASSETS$+NAME$+".PNG",X-16*SCALE,FOOT-36*SCALE,32*SCALE*FACE,36*SCALE)
19160 END SUB
19200 SUB DRAW_DRAGON(P,X,FOOT,SCALE,FACE)
19210   DRAW_TEXTURE(ASSETS$+DRAGON$(P)+".PNG",X-16*SCALE,FOOT-36*SCALE,32*SCALE*FACE,36*SCALE)
19220 END SUB
19300 REM A PLAYER BACK FROM A LOST LIFE BLINKS WHILE NOTHING CAN HURT THEM
19310 SUB DRAW_PLAYERS
19320   LOCAL P,BLINK
19330   FOR P=1 TO 2
19340     BLINK=SAFE(P)>0 AND INT(SAFE(P)*12) MOD 2=0
19350     IF FNIN_GAME(P) AND (ALIVE(P) OR DEAD_TIME(P)>0) AND NOT BLINK THEN
19360       DRAW_DRAGON P,PX(P)+BODY_W/2,PY(P)+BODY_H,TOY_SCALE,FACE(P)
19370     END IF
19380   NEXT P
19390 END SUB
19500 SUB DRAW_BUBBLES
19510   LOCAL I
19520   FOR I=1 TO MAX_BUBBLES
19530     IF BUB_ON(I) THEN DRAW_BUBBLE I
19540   NEXT I
19550 END SUB
19600 REM EACH PLAYER'S BUBBLES ARE TINTED THEIR COLOUR; A TOY ABOUT TO GET OUT SHAKES
19610 REM ITS BUBBLE AND FLASHES ITS RIM RED
19620 SUB DRAW_BUBBLE(I)
19630   LOCAL X,Y,R,K,ESCAPING
19640   K=BUB_HOLDS(I)
19650   X=BUB_X(I):Y=BUB_Y(I)
19655   ESCAPING=K AND BUB_AGE(I)>TRAP_LIFE-1.6
19660   IF ESCAPING THEN X=X+SIN(TIME()*50)*1.5
19670   R=FNBUB_R(I)+SIN(BUB_WOB(I)*3)*0.6
19680   IF BUB_PHASE(I)=FLYING AND K=0 THEN R=R*(0.35+0.65*MIN(BUB_AGE(I)/0.12,1))
19685   REM THE WHOLE TOY INSIDE: IT REACHES 18 PIXELS FROM ITS MIDDLE AT FULL SIZE
19690   IF K THEN DRAW_TOY TOY_KIND(K),TOY_ANGRY(K),X,Y+19*(TRAP_R-2)/18+SIN(BUB_WOB(I)*5)*0.6,(TRAP_R-2)/18,1
19700   DRAW_GLASS X,Y,R,BUB_OWNER(I),BUB_WOB(I),ESCAPING AND INT(TIME()*10) MOD 2=0
19780 END SUB
19790 REM A BUBBLE'S GLASS: ITS OWNER'S TINT, A RIM WHOSE SHEEN DRIFTS ROUND THE COLOURS AS
19791 REM IT WOBBLES (RED WHEN A TOY IS GETTING OUT), AND THE SHINE OF A WINDOW
19800 SUB DRAW_GLASS(X,Y,R,OWNER,WOB,RED)
19810   LOCAL SHEEN,RIM
19820   IF OWNER=1 THEN FILL_CIRCLE(X,Y,R,COLOR(0.47,1,0.55,0.22)) ELSE FILL_CIRCLE(X,Y,R,COLOR(0.47,0.78,1,0.22))
19830   SHEEN=(WOB*0.15+X*0.002)*6.28
19840   RIM=COLOR(0.8+0.2*SIN(SHEEN),0.8+0.2*SIN(SHEEN+2.1),0.8+0.2*SIN(SHEEN+4.2),0.85)
19850   IF RED THEN RIM=COLOR(1,0.3,0.3,0.95)
19860   DRAW_CIRCLE(X,Y,R,RIM,1.8)
19870   FILL_CIRCLE(X-R*0.38,Y-R*0.42,R*0.22,COLOR(1,1,1,0.85))
19880   FILL_CIRCLE(X+R*0.45,Y+R*0.35,1.2,COLOR(1,1,1,0.6))
19890 END SUB
20000 REM --- CANDY, SHOTS, AND THE SCORE BAR ---
20010 REM THE BIGGER THE CHAIN, THE SWEETER THE CANDY: A BONBON, A LOLLIPOP, A DONUT, A CUPCAKE
20020 SUB DRAW_CANDIES
20030   LOCAL I,X,Y,INK$
20040   FOR I=1 TO MAX_CANDIES
20050     IF CANDY_ON(I) AND NOT (CANDY_T(I)>7 AND INT(CANDY_T(I)*10) MOD 2=0) THEN
20060       X=CANDY_X(I)+8
20070       Y=CANDY_Y(I)+8
20080       IF CANDY_GROUND(I) THEN Y=Y+SIN(CANDY_T(I)*4)
20090       INK$=CANDY_INK$(INT(X*7+CANDY_KIND(I)*13) MOD 6)
20100       DRAW_CANDY CANDY_KIND(I),X,Y,INK$
20110     END IF
20120   NEXT I
20130 END SUB
20300 SUB DRAW_CANDY(KIND,X,Y,INK$)
20310   FILL_GLOW_CIRCLE(X,Y,16,"#FFCB6A40")
20320   IF KIND=0 THEN
20330     FILL_CIRCLE(X-9,Y,4,INK$)
20340     FILL_CIRCLE(X+9,Y,4,INK$)
20350     FILL_CIRCLE(X,Y,7,INK$)
20360   ELSEIF KIND=1 THEN
20370     DRAW_LINE_EX(X,Y+4,X+1,Y+14,2,"#FFF4DE")
20380     FILL_CIRCLE(X,Y-2,8,INK$)
20390     DRAW_CIRCLE(X,Y-2,4,"#FFFFFFB0",2)
20400   ELSEIF KIND=2 THEN
20410     FILL_CIRCLE(X,Y,9,"#ECA65F")
20420     FILL_CIRCLE(X,Y-1,7,INK$)
20430     FILL_CIRCLE(X,Y,3,"#56302A")
20440   ELSE
20450     FILL_RECT(X-8,Y,16,9,"#D78A61")
20460     FILL_CIRCLE(X,Y-2,9,INK$)
20470     FILL_CIRCLE(X,Y-11,3,"#FF3050")
20480   END IF
20490   FILL_CIRCLE(X-3,Y-4,2,"#FFFFFFC0")
20500 END SUB
20600 REM A SPARK IS A PINK STAR THAT FADES IN ITS LAST SECOND; A ROCK'S SPOT TURNS AS IT ROLLS
20610 SUB DRAW_SHOTS
20620   LOCAL I,X,Y,A
20630   FOR I=1 TO MAX_SHOTS
20640     X=SHOT_X(I):Y=SHOT_Y(I)
20650     IF SHOT_ON(I) AND SHOT_SPARK(I) THEN
20660       A=CLAMP(4-SHOT_T(I),0,1)
20670       FILL_CIRCLE(X,Y,7,COLOR(1,0.45,0.8,0.25*A))
20680       FILL_CIRCLE(X,Y,4,COLOR(1,0.7,0.95,A))
20690       FILL_CIRCLE(X,Y,2,COLOR(1,1,1,A))
20700     ELSEIF SHOT_ON(I) THEN
20710       FILL_CIRCLE(X+1,Y+2,6,"#1A0D2666")
20720       FILL_CIRCLE(X,Y,6,"#96786E")
20730       FILL_CIRCLE(X+COS(X/6)*2.5,Y+SIN(X/6)*2.5,1.6,"#6E5550")
20740       FILL_CIRCLE(X-2,Y-2,1.5,"#FFF2E6B0")
20750     END IF
20760   NEXT I
20770 END SUB
20800 REM THE SCORE BAR: PLAYER ONE ON THE LEFT, THE ROUND IN THE MIDDLE, PLAYER TWO ON THE RIGHT
20805 SUB DRAW_SCORES
20810   LOCAL X,PULSE
20815   FILL_RECT(0,0,WIDE,HUD,"#1A0A22EB")
20820   FILL_RECT(0,HUD-2,WIDE,2,"#FFAAC840")
20825   DRAW_TEXT("ROUND "+STR$(ROUND),WIDE/2,4,2,"#FFC496","CENTER")
20830   DRAW_SCORE 1,10
20835   IF JOINED(2) THEN
20840     X=WIDE-10-LEN(STR$(SCORE(2)))*12-8-MAX(LIVES(2),0)*11
20845     DRAW_SCORE 2,X
20850   ELSE
20855     PULSE=0.55+0.45*ABS(SIN(TIME()*3))
20860     DRAW_TEXT("2P JOIN",WIDE-94,4,2,COLOR(0.65,0.84,1,PULSE))
20865   END IF
20870 END SUB
20875 SUB DRAW_SCORE(P,X)
20880   LOCAL K,INK$
20885   IF P=1 THEN INK$="#AAF0BE" ELSE INK$="#A5D7FF"
20890   DRAW_TEXT(STR$(SCORE(P)),X,4,2,INK$,"LEFT","#3C1446")
20895   X=X+LEN(STR$(SCORE(P)))*12+10
20900   FOR K=1 TO LIVES(P)
20905     DRAW_HEART X+K*11,HUD/2-2,INK$
20910   NEXT K
20915 END SUB
20920 SUB DRAW_HEART(X,Y,INK$)
20925   FILL_CIRCLE(X-2,Y,2.6,INK$)
20930   FILL_CIRCLE(X+2,Y,2.6,INK$)
20935   FILL_CAPSULE(X-3,Y+1,X,Y+5,2,0.5,INK$)
20940   FILL_CAPSULE(X+3,Y+1,X,Y+5,2,0.5,INK$)
20945 END SUB
20950 REM WORDS ON A SOFT ROUNDED PANEL, IN THE MIDDLE OF THE ARENA
20951 SUB BANNER(TEXT$,Y,SIZE,INK$)
20952   LOCAL W,H
20953   W=LEN(TEXT$)*6*SIZE+16
20954   H=7*SIZE+16
20955   FILL_CAPSULE(WIDE/2-W/2,Y+H/2,WIDE/2+W/2,Y+H/2,H/2+2,H/2+2,INK$)
20956   FILL_CAPSULE(WIDE/2-W/2,Y+H/2,WIDE/2+W/2,Y+H/2,H/2,H/2,"#220E2C")
20957   DRAW_TEXT(TEXT$,WIDE/2+SIZE/2,Y+8+SIZE/2,SIZE,"#3C1446","CENTER")
20958   DRAW_TEXT(TEXT$,WIDE/2,Y+8,SIZE,"#FFF4DE","CENTER")
20959 END SUB
20960 REM ALONE, PLAYER ONE HAS EVERY KEY; WITH A FRIEND THE ARROWS ARE THEIRS
20961 SUB READ_KEYS
20962   LOCAL SOLO
20963   SOLO=NOT TWO
20964   LEFT_KEY(1)=KEY_ACTIVE("A") OR (SOLO AND KEY_ACTIVE("LEFT"))
20965   RIGHT_KEY(1)=KEY_ACTIVE("D") OR (SOLO AND KEY_ACTIVE("RIGHT"))
20966   JUMP_HELD(1)=KEY_ACTIVE("W") OR KEY_ACTIVE("G") OR (SOLO AND KEY_ACTIVE("UP"))
20967   JUMP_KEY(1)=KEY_PRESSED("W") OR KEY_PRESSED("G") OR (SOLO AND KEY_PRESSED("UP"))
20968   BLOW_KEY(1)=KEY_PRESSED("F") OR KEY_PRESSED("SPACE")
20969   LEFT_KEY(2)=KEY_ACTIVE("LEFT")
20970   RIGHT_KEY(2)=KEY_ACTIVE("RIGHT")
20971   JUMP_HELD(2)=KEY_ACTIVE("UP") OR KEY_ACTIVE("K")
20972   JUMP_KEY(2)=KEY_PRESSED("UP") OR KEY_PRESSED("K")
20973   BLOW_KEY(2)=KEY_PRESSED("J")
20974   JOIN_KEY=KEY_PRESSED("J") OR KEY_PRESSED("K")
20975 END SUB
