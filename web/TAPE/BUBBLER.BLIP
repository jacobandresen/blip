740 DRAW_TEXT("SPACE TO PLAY AGAIN",160,158,2,"BLIP_WHITE","CENTER")
750 IF KEY_PRESSED("SPACE")=1 THEN GOTO 800
760 WAIT 16:GOTO 700
800 GAME_STATE=1:SCORE=0:LIVES=5:ROUND=1:P2SCORE=0:P2LIVES=5:GOTO 810
810 PX=13:PY=176:VY=0:GROUND=1:FACE=1:HIT_WAIT=0:BLOW_WAIT=0:GAMEOVER=0:ROUND_TIME=0:HURRY=0
811 P2X=289:P2Y=176:P2VY=0:P2GROUND=1:P2FACE=0:P2_HIT_WAIT=0:P2_BLOW_WAIT=0
815 MSPEED=0.37+ROUND*0.02:IF MSPEED>0.47 THEN MSPEED=0.47
816 HURRY_AT=70-2.5*(ROUND-1):IF HURRY_AT<60 THEN HURRY_AT=60
817 PLAY_MUSIC "BUBBLER_MAIN"
818 IF ROUND=1 THEN SKY0R=0.071:SKY0G=0.047:SKY0B=0.204:SKY1R=0.188:SKY1G=0.078:SKY1B=0.329:BLOCK_R=0.941:BLOCK_G=0.471:BLOCK_B=0.706:LIGHT_R=1:LIGHT_G=0.745:LIGHT_B=0.882:DARK_R=0.627:DARK_G=0.235:DARK_B=0.471
819 IF ROUND=2 THEN SKY0R=0.024:SKY0G=0.094:SKY0B=0.196:SKY1R=0.039:SKY1G=0.235:SKY1B=0.353:BLOCK_R=0.314:BLOCK_G=0.784:BLOCK_B=0.902:LIGHT_R=0.667:LIGHT_G=0.941:LIGHT_B=1:DARK_R=0.118:DARK_G=0.431:DARK_B=0.588
820 IF ROUND=3 THEN SKY0R=0.118:SKY0G=0.063:SKY0B=0.031:SKY1R=0.275:SKY1G=0.141:SKY1B=0.063:BLOCK_R=0.980:BLOCK_G=0.706:BLOCK_B=0.235:LIGHT_R=1:LIGHT_G=0.902:LIGHT_B=0.588:DARK_R=0.667:DARK_G=0.392:DARK_B=0.078
821 IF ROUND=4 THEN SKY0R=0.031:SKY0G=0.118:SKY0B=0.071:SKY1R=0.063:SKY1G=0.275:SKY1B=0.157:BLOCK_R=0.431:BLOCK_G=0.863:BLOCK_B=0.431:LIGHT_R=0.745:LIGHT_G=1:LIGHT_B=0.706:DARK_R=0.157:DARK_G=0.510:DARK_B=0.235
822 IF ROUND=5 THEN SKY0R=0.102:SKY0G=0.024:SKY0B=0.118:SKY1R=0.235:SKY1G=0.039:SKY1B=0.196:BLOCK_R=0.745:BLOCK_G=0.431:BLOCK_B=0.980:LIGHT_R=0.902:LIGHT_G=0.745:LIGHT_B=1:DARK_R=0.431:DARK_G=0.196:DARK_B=0.667
823 IF ROUND=6 THEN SKY0R=0.141:SKY0G=0.039:SKY0B=0.071:SKY1R=0.329:SKY1G=0.102:SKY1B=0.157:BLOCK_R=1:BLOCK_G=0.471:BLOCK_B=0.471:LIGHT_R=1:LIGHT_G=0.769:LIGHT_B=0.729:DARK_R=0.667:DARK_G=0.220:DARK_B=0.275
824 IF ROUND=7 THEN SKY0R=0.094:SKY0G=0.086:SKY0B=0.024:SKY1R=0.235:SKY1G=0.220:SKY1B=0.063:BLOCK_R=0.886:BLOCK_G=0.871:BLOCK_B=0.329:LIGHT_R=0.988:LIGHT_G=0.980:LIGHT_B=0.690:DARK_R=0.533:DARK_G=0.510:DARK_B=0.133
825 IF ROUND>=8 THEN SKY0R=0.024:SKY0G=0.086:SKY0B=0.102:SKY1R=0.063:SKY1G=0.212:SKY1B=0.235:BLOCK_R=0.588:BLOCK_G=0.941:BLOCK_B=0.824:LIGHT_R=0.871:LIGHT_G=1:LIGHT_B=0.941:DARK_R=0.235:DARK_G=0.588:DARK_B=0.510
829 REM PLAT=ROW*1000+COL*30+LENGTH; SPAWN=ROW*100+COL*4+KIND.
830 IF ROUND=1 THEN P_COUNT=6:PLAT(ROUND,1)=7278:PLAT(ROUND,2)=11067:PLAT(ROUND,3)=11517:PLAT(ROUND,4)=15222:PLAT(ROUND,5)=19097:PLAT(ROUND,6)=19487
831 IF ROUND=2 THEN P_COUNT=2:PLAT(ROUND,1)=11222:PLAT(ROUND,2)=19166
832 IF ROUND=3 THEN P_COUNT=3:PLAT(ROUND,1)=7194:PLAT(ROUND,2)=15138:PLAT(ROUND,3)=19278
833 IF ROUND=4 THEN P_COUNT=4:PLAT(ROUND,1)=11138:PLAT(ROUND,2)=15306:PLAT(ROUND,3)=19099:PLAT(ROUND,4)=19429
834 IF ROUND=5 THEN P_COUNT=5:PLAT(ROUND,1)=7166:PLAT(ROUND,2)=11306:PLAT(ROUND,3)=15128:PLAT(ROUND,4)=15428:PLAT(ROUND,5)=19250
835 IF ROUND=6 THEN P_COUNT=6:PLAT(ROUND,1)=7096:PLAT(ROUND,2)=7306:PLAT(ROUND,3)=7516:PLAT(ROUND,4)=15157:PLAT(ROUND,5)=15427:PLAT(ROUND,6)=19306
836 IF ROUND=7 THEN P_COUNT=6:PLAT(ROUND,1)=7306:PLAT(ROUND,2)=11157:PLAT(ROUND,3)=11427:PLAT(ROUND,4)=15278:PLAT(ROUND,5)=19098:PLAT(ROUND,6)=19458
837 IF ROUND=8 THEN P_COUNT=6:PLAT(ROUND,1)=7250:PLAT(ROUND,2)=11067:PLAT(ROUND,3)=11517:PLAT(ROUND,4)=15194:PLAT(ROUND,5)=19097:PLAT(ROUND,6)=19487
838 IF ROUND=1 THEN ENEMY_COUNT=6:SPAWN(ROUND,1)=1013:SPAWN(ROUND,2)=1089:SPAWN(ROUND,3)=1437:SPAWN(ROUND,4)=1465:SPAWN(ROUND,5)=1817:SPAWN(ROUND,6)=1885
839 IF ROUND=2 THEN ENEMY_COUNT=8:SPAWN(ROUND,1)=327:SPAWN(ROUND,2)=379:SPAWN(ROUND,3)=1041:SPAWN(ROUND,4)=1061:SPAWN(ROUND,5)=1414:SPAWN(ROUND,6)=1490:SPAWN(ROUND,7)=1833:SPAWN(ROUND,8)=1869
840 IF ROUND=3 THEN ENEMY_COUNT=10:SPAWN(ROUND,1)=351:SPAWN(ROUND,2)=637:SPAWN(ROUND,3)=665:SPAWN(ROUND,4)=1014:SPAWN(ROUND,5)=1090:SPAWN(ROUND,6)=1425:SPAWN(ROUND,7)=1477:SPAWN(ROUND,8)=1809:SPAWN(ROUND,9)=1850:SPAWN(ROUND,10)=1893
841 IF ROUND=4 THEN ENEMY_COUNT=12:SPAWN(ROUND,1)=251:SPAWN(ROUND,2)=319:SPAWN(ROUND,3)=387:SPAWN(ROUND,4)=614:SPAWN(ROUND,5)=686:SPAWN(ROUND,6)=1029:SPAWN(ROUND,7)=1073:SPAWN(ROUND,8)=1413:SPAWN(ROUND,9)=1450:SPAWN(ROUND,10)=1485:SPAWN(ROUND,11)=1821:SPAWN(ROUND,12)=1877
842 IF ROUND=5 THEN ENEMY_COUNT=15:SPAWN(ROUND,1)=251:SPAWN(ROUND,2)=319:SPAWN(ROUND,3)=387:SPAWN(ROUND,4)=633:SPAWN(ROUND,5)=669:SPAWN(ROUND,6)=1013:SPAWN(ROUND,7)=1050:SPAWN(ROUND,8)=1089:SPAWN(ROUND,9)=1421:SPAWN(ROUND,10)=1438:SPAWN(ROUND,11)=1481:SPAWN(ROUND,12)=1809:SPAWN(ROUND,13)=1841:SPAWN(ROUND,14)=1861:SPAWN(ROUND,15)=1893
843 IF ROUND=6 THEN ENEMY_COUNT=13:SPAWN(ROUND,1)=251:SPAWN(ROUND,2)=319:SPAWN(ROUND,3)=387:SPAWN(ROUND,4)=622:SPAWN(ROUND,5)=649:SPAWN(ROUND,6)=682:SPAWN(ROUND,7)=1017:SPAWN(ROUND,8)=1085:SPAWN(ROUND,9)=1433:SPAWN(ROUND,10)=1470:SPAWN(ROUND,11)=1813:SPAWN(ROUND,12)=1849:SPAWN(ROUND,13)=1889
844 IF ROUND=7 THEN ENEMY_COUNT=12:SPAWN(ROUND,1)=227:SPAWN(ROUND,2)=279:SPAWN(ROUND,3)=617:SPAWN(ROUND,4)=650:SPAWN(ROUND,5)=685:SPAWN(ROUND,6)=1034:SPAWN(ROUND,7)=1069:SPAWN(ROUND,8)=1413:SPAWN(ROUND,9)=1449:SPAWN(ROUND,10)=1490:SPAWN(ROUND,11)=1825:SPAWN(ROUND,12)=1873
845 IF ROUND=8 THEN ENEMY_COUNT=11:SPAWN(ROUND,1)=251:SPAWN(ROUND,2)=323:SPAWN(ROUND,3)=383:SPAWN(ROUND,4)=641:SPAWN(ROUND,5)=661:SPAWN(ROUND,6)=1017:SPAWN(ROUND,7)=1086:SPAWN(ROUND,8)=1437:SPAWN(ROUND,9)=1466:SPAWN(ROUND,10)=1821:SPAWN(ROUND,11)=1881
850 FOR P=1 TO P_COUNT:PCODE=PLAT(ROUND,P):PROW=INT(PCODE/1000):PREST=PCODE-PROW*1000:PCOL=INT(PREST/30):PLEN=PREST-PCOL*30:PXLINE(P)=PCOL*12:PYLINE(P)=8+PROW*8:PWLINE(P)=PLEN*12:NEXT P
860 FOR E=1 TO ENEMY_COUNT
861 MONSTER(E)=1:ETRAPPED(E)=0:EANGRY(E)=0:EGROUND(E)=1:EVY(E)=0:ECODE=SPAWN(ROUND,E):EROW=INT(ECODE/100):EREST=ECODE-EROW*100:ECOL=INT(EREST/4):ETYPE(E)=EREST-ECOL*4:EX(E)=ECOL*12+1:EY(E)=EROW*8:EMIN(E)=12:EMAX(E)=292:EDIR(E)=1
862 FOR P=1 TO P_COUNT
863 IF PYLINE(P)=8+(EROW+1)*8 AND EX(E)+15>PXLINE(P) AND EX(E)<PXLINE(P)+PWLINE(P) THEN EMIN(E)=PXLINE(P)+1:EMAX(E)=PXLINE(P)+PWLINE(P)-17
864 NEXT P
865 IF EX(E)>PX THEN EDIR(E)=0-1
866 JUMP_CD(E)=45:JUMP_NOW(E)=0:NEXT E
870 E=E
889 FOR E=1 TO ENEMY_COUNT:EHOME(E)=EY(E):JUMP_CD(E)=30+INT(RND(75)):FIRE_CD(E)=80+INT(RND(100)):NEXT E
890 FOR B=1 TO 6:BUBBLE(B)=0:QOWNER(B)=1:NEXT B
892 FOR S=1 TO 6:SHOT(S)=0:NEXT S
895 GOTO 100
900 FOR P=1 TO P_COUNT
910 IF OLDY+16<=PYLINE(P) AND PY+16>=PYLINE(P) AND PX+14>PXLINE(P) AND PX<PXLINE(P)+PWLINE(P) THEN PY=PYLINE(P)-16:VY=0:GROUND=1
920 NEXT P
930 RETURN
1000 BUBBLE_SLOT=0
1010 FOR B=1 TO 6
1020 IF BUBBLE(B)=0 AND BUBBLE_SLOT=0 THEN BUBBLE_SLOT=B
1030 NEXT B
1040 IF BUBBLE_SLOT=0 THEN RETURN
1050 B=BUBBLE_SLOT:BUBBLE(B)=1:QOWNER(B)=1:QX(B)=PX+8+FACE*9:QY(B)=PY+8:QDIR(B)=FACE:BT(B)=24:BLOW_WAIT=14:PLAY_SFX "BUBBLER/BLOW":RETURN
1100 IF ETRAPPED(E)=0 THEN EY_OLD(E)=EY(E):EX(E)=EX(E)+EDIR(E)*MSPEED*(1+0.35*EANGRY(E))
1101 IF ETRAPPED(E)=0 AND ETYPE(E)=1 AND EGROUND(E)=1 THEN JUMP_CD(E)=JUMP_CD(E)-1:IF JUMP_CD(E)<1 THEN JUMP_CD(E)=60+INT(RND(85)):IF PY<EY(E)-20 AND ABS(PX-EX(E))<150 AND RND(10)<7 THEN EVY(E)=0-2.6:EGROUND(E)=0
1102 IF ETRAPPED(E)=0 AND ETYPE(E)=2 AND EGROUND(E)=1 THEN JUMP_CD(E)=JUMP_CD(E)-1:IF JUMP_CD(E)<1 THEN JUMP_CD(E)=36+INT(RND(43)):JUMP_NOW(E)=1
1103 IF JUMP_NOW(E)=1 AND PX>EX(E) THEN EDIR(E)=1:EVY(E)=0-2.6:EGROUND(E)=0:JUMP_NOW(E)=0
1104 IF JUMP_NOW(E)=1 AND PX<=EX(E) THEN EDIR(E)=0-1:EVY(E)=0-2.6:EGROUND(E)=0:JUMP_NOW(E)=0
1105 IF ETRAPPED(E)=0 AND ETYPE(E)<>3 AND EGROUND(E)=0 THEN EVY(E)=EVY(E)+0.09:EY(E)=EY(E)+EVY(E)
1106 IF ETRAPPED(E)=0 AND ETYPE(E)=3 THEN EY(E)=EHOME(E)+SIN(T*3+E)*4
1107 IF ETRAPPED(E)=0 AND ETYPE(E)<>3 THEN EGROUND(E)=0:GOSUB 1500
1110 IF EX(E)<EMIN(E) OR EX(E)>EMAX(E) THEN EDIR(E)=0-EDIR(E)
1115 IF ETRAPPED(E)=0 AND ETYPE(E)=3 THEN FILL_GLOW_CIRCLE(EX(E)+8,EY(E)+8,13,"#A8E9FF55")
1120 IF ETRAPPED(E)=0 AND ETYPE(E)=1 THEN FILL_CIRCLE(EX(E)+8,EY(E)+8,8,"#C8BEF5")
1121 IF ETRAPPED(E)=0 AND ETYPE(E)=2 THEN FILL_CIRCLE(EX(E)+8,EY(E)+8,8,"#FFC3DC")
1122 IF ETRAPPED(E)=0 AND ETYPE(E)=3 THEN FILL_CIRCLE(EX(E)+8,EY(E)+8,8,"#D7F5FF")
1123 IF ETRAPPED(E)=0 AND ETYPE(E)=2 THEN DRAW_LINE(EX(E)+5,EY(E)+4,EX(E)+4,EY(E)-5,"#FFD8E8"):DRAW_LINE(EX(E)+11,EY(E)+4,EX(E)+12,EY(E)-5,"#FFD8E8")
1125 IF ETRAPPED(E)=0 THEN FILL_CAPSULE(EX(E)+5,EY(E)+13,EX(E)+3,EY(E)+17,2,1.5,"#B84653"):FILL_CAPSULE(EX(E)+11,EY(E)+13,EX(E)+13,EY(E)+17,2,1.5,"#B84653")
1126 IF ETRAPPED(E)=0 THEN FILL_CIRCLE(EX(E)+5,EY(E)+6,2,"BLIP_WHITE"):FILL_CIRCLE(EX(E)+11,EY(E)+6,2,"BLIP_WHITE")
1127 IF ETRAPPED(E)=0 THEN FILL_CIRCLE(EX(E)+5,EY(E)+6,1,"#17233B"):FILL_CIRCLE(EX(E)+11,EY(E)+6,1,"#17233B")
1130 IF LIVES>0 AND ETRAPPED(E)=0 AND HIT_WAIT<1 AND ABS(PX-EX(E))<13 AND ABS(PY-EY(E))<14 THEN LIVES=LIVES-1:HIT_WAIT=60:PX=13:PY=176:VY=0:PLAY_SFX "BUBBLER/LOST"
1131 IF TWO=1 AND P2LIVES>0 AND ETRAPPED(E)=0 AND P2_HIT_WAIT<1 AND ABS(P2X-EX(E))<13 AND ABS(P2Y-EY(E))<14 THEN P2LIVES=P2LIVES-1:P2_HIT_WAIT=60:P2X=289:P2Y=176:P2VY=0:PLAY_SFX "BUBBLER/LOST"
1135 IF ETRAPPED(E)=0 THEN FIRE_CD(E)=FIRE_CD(E)-1
1136 IF ETRAPPED(E)=0 AND (ROUND>=3 OR EANGRY(E)=1) AND ETYPE(E)=1 AND EGROUND(E)=1 AND FIRE_CD(E)<=0 AND ABS(PY-EY(E))<14 AND ABS(PX-EX(E))<150 THEN GOSUB 1750
1137 IF ETRAPPED(E)=0 AND (ROUND>=4 OR EANGRY(E)=1) AND ETYPE(E)=3 AND FIRE_CD(E)<=0 THEN GOSUB 1750
1140 RETURN
1200 IF BUBBLE(B)=1 THEN QX(B)=QX(B)+QDIR(B)*2.8:BT(B)=BT(B)-1
1205 IF BUBBLE(B)=1 AND (QX(B)<18 OR QX(B)>294 OR BT(B)<1) THEN BUBBLE(B)=3:BT(B)=540:QDIR(B)=0
1210 IF BUBBLE(B)=3 THEN QY(B)=QY(B)-0.24:BT(B)=BT(B)-1
1212 IF BUBBLE(B)=3 AND QY(B)<20 THEN QY(B)=20
1214 IF BUBBLE(B)=3 AND QY(B)=20 AND QX(B)<160 THEN QX(B)=QX(B)+0.6
1215 IF BUBBLE(B)=3 AND QY(B)=20 AND QX(B)>160 THEN QX(B)=QX(B)-0.6
1216 IF BUBBLE(B)=3 AND BT(B)<1 THEN BUBBLE(B)=0:PLAY_SFX "BUBBLER/POP"
1220 IF BUBBLE(B)=1 THEN FILL_GLOW_CIRCLE(QX(B),QY(B),5,"BLIP_CYAN")
1221 IF BUBBLE(B)=3 THEN FILL_GLOW_CIRCLE(QX(B),QY(B),6,"#89E8FFAA"):FILL_CIRCLE(QX(B),QY(B),4,"#D7F5FF")
1230 IF BUBBLE(B)=2 THEN QY(B)=QY(B)-0.35:BT(B)=BT(B)-1:FILL_GLOW_CIRCLE(QX(B),QY(B),9,"BLIP_MAGENTA")
1232 TRAPPED=TRAP(B):IF BUBBLE(B)=2 AND BT(B)<1 THEN MONSTER(TRAPPED)=1:ETRAPPED(TRAPPED)=0:EX(TRAPPED)=QX(B)-8:EY(TRAPPED)=QY(B)-8:EGROUND(TRAPPED)=0:EVY(TRAPPED)=0-1:EANGRY(TRAPPED)=1:FIRE_CD(TRAPPED)=90:BUBBLE(B)=0:PLAY_SFX "BUBBLER/POP":RETURN
1235 IF (BUBBLE(B)=2 OR BUBBLE(B)=3) AND ABS(QX(B)-PX-8)<15 AND ABS(QY(B)-PY-8)<15 AND NOT(VY>0 AND PY+16<QY(B) AND KEY_HELD("UP")=1) THEN SCORER=1:GOSUB 1280
1236 IF (BUBBLE(B)=2 OR BUBBLE(B)=3) AND ABS(QX(B)-P2X-8)<15 AND ABS(QY(B)-P2Y-8)<15 AND TWO=1 AND NOT(P2VY>0 AND P2Y+16<QY(B) AND (KEY_HELD("UP")=1 OR KEY_HELD("K")=1)) THEN SCORER=2:GOSUB 1280
1237 IF BUBBLE(B)=2 AND VY>0 AND PY+16<QY(B) AND ABS(QX(B)-PX-8)<15 AND KEY_HELD("UP")=1 THEN VY=0-2.1:PLAY_SFX "BUBBLER/BOUNCE"
1238 IF BUBBLE(B)=2 AND TWO=1 AND P2VY>0 AND P2Y+16<QY(B) AND ABS(QX(B)-P2X-8)<15 AND (KEY_HELD("UP")=1 OR KEY_HELD("K")=1) THEN P2VY=0-2.1:PLAY_SFX "BUBBLER/BOUNCE"
1250 FOR E=1 TO ENEMY_COUNT
1260 IF BUBBLE(B)=1 AND MONSTER(E)=1 AND ETRAPPED(E)=0 AND ABS(QX(B)-EX(E))<11 AND ABS(QY(B)-EY(E))<12 THEN BUBBLE(B)=2:TRAP(B)=E:ETRAPPED(E)=1:QDIR(B)=0:BT(B)=630-30*ROUND:IF BT(B)<480 THEN BT(B)=480:PLAY_SFX "BUBBLER/TRAP"
1270 NEXT E
1280 TRAPPED=TRAP(B):IF BUBBLE(B)=2 THEN MONSTER(TRAPPED)=0:ETRAPPED(TRAPPED)=0:BUBBLE(B)=0:PLAY_SFX "BUBBLER/DEFEATED"
1281 IF BUBBLE(B)=0 AND SCORER=1 THEN SCORE=SCORE+100
1282 IF BUBBLE(B)=0 AND SCORER=2 THEN P2SCORE=P2SCORE+100
1283 IF BUBBLE(B)=3 THEN BUBBLE(B)=0:PLAY_SFX "BUBBLER/POP"
1284 RETURN
1300 HOP1=ABS(SIN(T*3))*8:HOP2=ABS(SIN(T*3+1.6))*8
1350 FILL_GLOW_CIRCLE(82,166,16,"#2050F080")
1360 FILL_CAPSULE(73,145-HOP1,75,160-HOP1,6,8,"#5AD66E")
1370 FILL_CAPSULE(70,152-HOP1,61,157-HOP1,4,2,"#55C96E")
1380 FILL_CAPSULE(76,152-HOP1,86,157-HOP1,4,2,"#55C96E")
1390 FILL_CIRCLE(74,139-HOP1,8,"#64E07B")
1400 FILL_CIRCLE(70,137-HOP1,1.5,"BLIP_WHITE"):FILL_CIRCLE(77,137-HOP1,1.5,"BLIP_WHITE")
1410 FILL_CAPSULE(70,132-HOP1,66,128-HOP1,2,1,"#B5F58A")
1420 FILL_GLOW_CIRCLE(238,166,16,"#2090F080")
1430 FILL_CAPSULE(229,145-HOP2,231,160-HOP2,6,8,"#64BDF4")
1440 FILL_CAPSULE(226,152-HOP2,217,157-HOP2,4,2,"#57A8EC")
1450 FILL_CAPSULE(232,152-HOP2,242,157-HOP2,4,2,"#57A8EC")
1460 FILL_CIRCLE(230,139-HOP2,8,"#78C9FF")
1470 FILL_CIRCLE(226,137-HOP2,1.5,"BLIP_WHITE"):FILL_CIRCLE(233,137-HOP2,1.5,"BLIP_WHITE")
1480 FILL_CAPSULE(226,132-HOP2,222,128-HOP2,2,1,"#B8E6FF")
1490 RETURN
1500 FOR P=1 TO P_COUNT
1510 IF EVY(E)>=0 AND EY_OLD(E)+16<=PYLINE(P) AND EY(E)+16>=PYLINE(P) AND EX(E)+15>PXLINE(P) AND EX(E)<PXLINE(P)+PWLINE(P) THEN EY(E)=PYLINE(P)-16:EVY(E)=0:EGROUND(E)=1
1520 NEXT P
1530 IF EY(E)>176 THEN EY(E)=176:EVY(E)=0:EGROUND(E)=1
1540 RETURN
1550 SX(S)=SX(S)+SVX(S):SY(S)=SY(S)+SVY(S):SHOT_T(S)=SHOT_T(S)-1
1560 IF SHOT_T(S)<1 OR SX(S)<0 OR SX(S)>320 OR SY(S)<38 OR SY(S)>184 THEN SHOT(S)=0:RETURN
1570 IF SHOT_KIND(S)=1 THEN FILL_CIRCLE(SX(S)+1,SY(S)+2,5,"#382D3B"):FILL_CIRCLE(SX(S),SY(S),5,"#96786E"):FILL_CIRCLE(SX(S)-2,SY(S)-2,1.5,"#FFF0D8")
1580 IF SHOT_KIND(S)=2 THEN FILL_GLOW_CIRCLE(SX(S),SY(S),8,"#FF74C855"):DRAW_LINE(SX(S)-3,SY(S),SX(S)+3,SY(S),"#FFD5F5"):DRAW_LINE(SX(S),SY(S)-3,SX(S),SY(S)+3,"BLIP_WHITE")
1590 IF LIVES>0 AND HIT_WAIT<1 AND SX(S)>PX AND SX(S)<PX+16 AND SY(S)>PY AND SY(S)<PY+16 THEN SHOT(S)=0:LIVES=LIVES-1:HIT_WAIT=60:PX=13:PY=176:VY=0:PLAY_SFX "BUBBLER/LOST":RETURN
1591 IF TWO=1 AND P2LIVES>0 AND P2_HIT_WAIT<1 AND SX(S)>P2X AND SX(S)<P2X+16 AND SY(S)>P2Y AND SY(S)<P2Y+16 THEN SHOT(S)=0:P2LIVES=P2LIVES-1:P2_HIT_WAIT=60:P2X=289:P2Y=176:P2VY=0:PLAY_SFX "BUBBLER/LOST":RETURN
1592 FOR B=1 TO 6
1594 IF BUBBLE(B)=1 AND SQR((SX(S)-QX(B))*(SX(S)-QX(B))+(SY(S)-QY(B))*(SY(S)-QY(B)))<14 THEN SHOT(S)=0:PLAY_SFX "BUBBLER/POP"
1596 NEXT B
1598 RETURN
1600 IF KEY_HELD("LEFT")=1 AND P2X>12 THEN P2X=P2X-1:P2FACE=0-1
1601 IF KEY_HELD("RIGHT")=1 AND P2X<292 THEN P2X=P2X+1:P2FACE=1
1602 IF (KEY_PRESSED("UP")=1 OR KEY_PRESSED("K")=1) AND P2GROUND=1 THEN P2VY=0-2.6:P2GROUND=0:PLAY_SFX "BUBBLER/JUMP"
1603 P2_OLDY=P2Y:P2VY=P2VY+0.09:IF P2VY>1.67 THEN P2VY=1.67
1604 P2Y=P2Y+P2VY:P2GROUND=0:IF P2Y>176 AND (P2X+8<132 OR P2X+8>180) THEN P2Y=176:P2VY=0:P2GROUND=1
1605 IF P2VY>=0 THEN GOSUB 1700
1607 IF P2Y>200 THEN P2Y=8:P2VY=0
1610 FILL_GLOW_CIRCLE(P2X+8,P2Y+18,11,"#1827D855")
1611 FILL_CIRCLE(P2X+8-P2FACE*8,P2Y+7,3,"#D9EAF4"):FILL_CIRCLE(P2X+8-P2FACE*5,P2Y+5,2.2,"#EAF5FF"):FILL_CIRCLE(P2X+8-P2FACE*2,P2Y+4,1.7,"#EAF5FF")
1612 FILL_CAPSULE(P2X+4,P2Y+13,P2X+3,P2Y+17,2.5,2,"#3B6C9A"):FILL_CAPSULE(P2X+12,P2Y+13,P2X+13,P2Y+17,2.5,2,"#3B6C9A")
1613 FILL_CIRCLE(P2X+8,P2Y+8,8,"#5AAAFE"):FILL_CIRCLE(P2X+6,P2Y+5,4,"#79BDFF"):FILL_CIRCLE(P2X+8+P2FACE*2.5,P2Y+10,4.6,"#FFF0CD")
1614 FILL_CIRCLE(P2X+8+P2FACE*2,P2Y+5,2.1,"#281D36"):FILL_CIRCLE(P2X+8+P2FACE*7,P2Y+5,2,"#281D36")
1615 FILL_CIRCLE(P2X+8+P2FACE*1.4,P2Y+4.4,0.7,"BLIP_WHITE"):FILL_CIRCLE(P2X+8+P2FACE*6.4,P2Y+4.4,0.7,"BLIP_WHITE")
1616 FILL_CIRCLE(P2X+8+P2FACE*4,P2Y+9,1.1,"#FF9FA8"):FILL_CIRCLE(P2X+8+P2FACE*8,P2Y+9,1.1,"#FF9FA8")
1617 DRAW_LINE(P2X+8+P2FACE*9,P2Y+9,P2X+8+P2FACE*11,P2Y+9,"#783F56"):FILL_CIRCLE(P2X+8-P2FACE,P2Y-1,2.5,"#8BC8FF")
1618 P2_BLOW_WAIT=P2_BLOW_WAIT-1:P2_HIT_WAIT=P2_HIT_WAIT-1:RETURN
1650 BUBBLE_SLOT=0
1651 FOR B=1 TO 6
1652 IF BUBBLE(B)=0 AND BUBBLE_SLOT=0 THEN BUBBLE_SLOT=B
1653 NEXT B
1654 IF BUBBLE_SLOT=0 THEN RETURN
1655 B=BUBBLE_SLOT:BUBBLE(B)=1:QOWNER(B)=2:QX(B)=P2X+8+P2FACE*9:QY(B)=P2Y+8:QDIR(B)=P2FACE:BT(B)=24:P2_BLOW_WAIT=14:PLAY_SFX "BUBBLER/BLOW":RETURN
1700 FOR P=1 TO P_COUNT
1701 IF P2_OLDY+16<=PYLINE(P) AND P2Y+16>=PYLINE(P) AND P2X+14>PXLINE(P) AND P2X<PXLINE(P)+PWLINE(P) THEN P2Y=PYLINE(P)-16:P2VY=0:P2GROUND=1
1702 NEXT P
1703 RETURN
1750 BSLOT=0
1760 FOR Z=1 TO 6
1770 IF SHOT(Z)=0 AND BSLOT=0 THEN BSLOT=Z
1780 NEXT Z
1790 IF BSLOT=0 THEN FIRE_CD(E)=30:RETURN
1800 DIRSHOT=1
1810 IF PX<EX(E) THEN DIRSHOT=0-1
1820 IF ETYPE(E)=1 THEN SHOT(BSLOT)=1:SHOT_KIND(BSLOT)=1:SX(BSLOT)=EX(E)+8:SY(BSLOT)=EY(E)+14:SVX(BSLOT)=DIRSHOT*1.4:SVY(BSLOT)=0:SHOT_T(BSLOT)=180:FIRE_CD(E)=150+INT(RND(90)):PLAY_SFX "BUBBLER/BOUNCE":RETURN
1830 DX=PX+8-(EX(E)+8):DY=PY+8-(EY(E)+8):DIST=SQR(DX*DX+DY*DY):IF DIST<1 THEN DIST=1
1840 SHOT(BSLOT)=1:SHOT_KIND(BSLOT)=2:SX(BSLOT)=EX(E)+8:SY(BSLOT)=EY(E)+8:SVX(BSLOT)=DX/DIST*0.8:SVY(BSLOT)=DY/DIST*0.8:SHOT_T(BSLOT)=210:FIRE_CD(E)=180+INT(RND(120)):PLAY_SFX "BUBBLER/SPARKLE":RETURN
1900 CLEAR("#121A52")
1910 FOR GRAD=0 TO 11:K=GRAD/11:FILL_RECT(0,GRAD*17,320,18,COLOR(0.071+0.117*K,0.047+0.031*K,0.204+0.125*K)):NEXT GRAD
1920 DRAW_LINE(0,38,320,38,"#254665")
1930 FOR I=0 TO 9:QX=I*31+15:QY=9+INT(I*37-370*INT(I*37/190)):FILL_RECT(QX,QY,1.5,1.5,COLOR(0.45,0.7,1,0.25+ABS(SIN(T*2+I))*0.55)):NEXT I
1940 FOR I=0 TO 13
1950 QX=I*23+8:QY=190-(I*29+T*30-240*INT((I*29+T*30)/240)):BR=3+INT(I/4)
1960 FILL_GLOW_CIRCLE(QX,QY,BR+3,COLOR(0.15,0.55,1,0.12)):FILL_CIRCLE(QX,QY,BR,COLOR(0.45,0.8,1,0.12))
1970 PEN 2:CIRCLE QX,QY,BR:FILL_CIRCLE(QX-2,QY-2,1.1,"#FFFFFFAA")
1980 NEXT I:PEN 7:RETURN
