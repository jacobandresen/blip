1 REM FLOW: TITLE 10 -> ROUND SETUP 800/810 -> PLAY 100 -> RESULT 700.
2 REM MODULES: PLAYERS 180/1600; MONSTERS 1100; BUBBLES 1200.
3 REM MODULES: FRUIT 1850; TITLE ART 1900; CHAIN POP 2000.
4 REM STATE: MONSTER(E), BUBBLE(B), FRUIT(F), AND SHOT(S) ARE SLOT POOLS.
5 REM GAME: BUBBLER
10 REM BUBBLER - TITLE, START, AND SECOND-PLAYER JOIN
11 CANVAS(624,600):PLAY_MUSIC "BUBBLER_MAIN":TT=TIME():GOSUB 1900
20 FOR LETTER=1 TO 7:BOB=SIN(TT*3+(LETTER-1)*0.6)*5
21 DRAW_TEXTURE("/TAPE/GFX/BUBBLER/TITLE_LETTER_"+STR$(LETTER)+".PNG",170+(LETTER-1)*36,144+BOB,68,74):NEXT LETTER
30 HOP1=CLAMP(SIN(TT*3.2),0,1):HOP2=CLAMP(SIN(TT*3.2+1.6),0,1)
31 DRAW_TEXTURE("/TAPE/GFX/BUBBLER/PLAYER_GREEN.PNG",203.6,263.6-HOP1*34,76.8,86.4)
32 DRAW_TEXTURE("/TAPE/GFX/BUBBLER/PLAYER_BLUE.PNG",343.6,263.6-HOP2*34,76.8,86.4)
35 CONTROL$=CONTROL_TEXT$("KEYS","PAD","TOUCH"):GLOW=0.65+0.35*ABS(SIN(TT*2.5))
40 DRAW_TEXTURE("/TAPE/GFX/BUBBLER/TITLE_INFO_"+CONTROL$+".PNG",0,400,624,92)
50 DRAW_TEXTURE("/TAPE/GFX/BUBBLER/TITLE_START_"+CONTROL$+".PNG",0,359,624,40,COLOR(1,1,1,GLOW))
60 IF KEY_PRESSED("SPACE")=1 OR KEY_PRESSED("F")=1 OR KEY_PRESSED("G")=1 OR KEY_PRESSED("Z")=1 THEN TWO=0:GOTO 800
65 IF KEY_PRESSED("J")=1 OR KEY_PRESSED("K")=1 THEN TWO=1:GOTO 800
70 WAIT 16:GOTO 10
99 REM --- PLAY LOOP - WORLD ART, PLAYERS, MONSTERS, AND BUBBLES ---
100 CANVAS(320,200):CLEAR("#08152B"):T=T+0.016
105 FOR GRAD=0 TO 11:K=GRAD/11:FILL_RECT(0,GRAD*17,320,18,COLOR(SKY0R+(SKY1R-SKY0R)*K,SKY0G+(SKY1G-SKY0G)*K,SKY0B+(SKY1B-SKY0B)*K)):NEXT GRAD
106 DRAW_LINE(0,38,320,38,"#254665")
107 FILL_CIRCLE(36,25,1,BLIP_WHITE):FILL_CIRCLE(82,16,1,BLIP_WHITE):FILL_CIRCLE(148,29,1,BLIP_WHITE):FILL_CIRCLE(207,13,1,BLIP_WHITE):FILL_CIRCLE(278,31,1,BLIP_WHITE)
108 FILL_CIRCLE(58,55,1,BLIP_CYAN):FILL_CIRCLE(128,48,1,BLIP_CYAN):FILL_CIRCLE(246,58,1,BLIP_CYAN)
109 FOR B=0 TO 13:BX=B*23+8:BY=16+(B*37-200*INT(B*37/200)):BR=1+(B-4*INT(B/4))*0.5:FILL_GLOW_CIRCLE(BX,BY,BR,"#FF8CDC18"):NEXT B
110 DRAW_NUMBER(SCORE,8,8,1,"#6EDC87"):FOR I=1 TO LIVES:FILL_CIRCLE(27+I*6,7,1.7,"#6EDC87"):FILL_CIRCLE(30+I*6,7,1.7,"#6EDC87"):DRAW_LINE(25+I*6,8,28+I*6,11,"#6EDC87"):DRAW_LINE(31+I*6,8,28+I*6,11,"#6EDC87"):NEXT I:DRAW_TEXT("ROUND "+STR$(ROUND),160,2,1,"#FFB78F","CENTER")
111 IF TWO=1 THEN DRAW_NUMBER(P2SCORE,248,10,1,"BLIP_CYAN"):DRAW_NUMBER(P2LIVES,302,10,1,"BLIP_WHITE")
112 IF TWO=0 AND (KEY_PRESSED("J")=1 OR KEY_PRESSED("K")=1) THEN TWO=1:P2_HIT_WAIT=90
120 FOR X=0 TO 10:DRAW_TEXTURE("/TAPE/GFX/BUBBLER/BORDER_LOW_"+STR$(ROUND)+".PNG",X*12,192,12,8):DRAW_TEXTURE("/TAPE/GFX/BUBBLER/BORDER_LOW_"+STR$(ROUND)+".PNG",180+X*12,192,12,8):NEXT X
121 REM THE FLOOR IS BUILT FROM THE SAME TILE ART AS THE RUST GAME.
122 FOR Y=1 TO 22:DRAW_TEXTURE("/TAPE/GFX/BUBBLER/BORDER_LOW_"+STR$(ROUND)+".PNG",0,8+Y*8,12,8):DRAW_TEXTURE("/TAPE/GFX/BUBBLER/BORDER_LOW_"+STR$(ROUND)+".PNG",300,8+Y*8,12,8):NEXT Y
123 FOR X=0 TO 10:DRAW_TEXTURE("/TAPE/GFX/BUBBLER/BORDER_LOW_"+STR$(ROUND)+".PNG",X*12,8,12,8):DRAW_TEXTURE("/TAPE/GFX/BUBBLER/BORDER_LOW_"+STR$(ROUND)+".PNG",180+X*12,8,12,8):NEXT X
130 FOR P=1 TO P_COUNT:FOR X=0 TO INT(PWLINE(P)/12)-1:DRAW_TEXTURE("/TAPE/GFX/BUBBLER/TILE_LOW_"+STR$(ROUND)+".PNG",PXLINE(P)+X*12,PYLINE(P),12,8):NEXT X:NEXT P
178 JUMP1=KEY_HELD("W") OR KEY_HELD("G") OR KEY_HELD("Z") OR (TWO=0 AND KEY_HELD("UP"))
179 REM --- PLAYER ONE - RUN, JUMP, GRAVITY, AND LANDING ---
180 IF TWO=0 AND (KEY_HELD("LEFT")=1 OR KEY_HELD("A")=1) AND PX>12 THEN PX=PX-1:FACE=0-1
181 IF TWO=1 AND KEY_HELD("A")=1 AND PX>12 THEN PX=PX-1:FACE=0-1
190 IF TWO=0 AND (KEY_HELD("RIGHT")=1 OR KEY_HELD("D")=1) AND PX<292 THEN PX=PX+1:FACE=1
191 IF TWO=1 AND KEY_HELD("D")=1 AND PX<292 THEN PX=PX+1:FACE=1
200 IF TWO=0 AND (KEY_PRESSED("UP")=1 OR KEY_PRESSED("W")=1 OR KEY_PRESSED("G")=1 OR KEY_PRESSED("Z")=1) AND GROUND=1 THEN VY=0-2.6:GROUND=0:PLAY_SFX "BUBBLER/JUMP"
201 IF TWO=1 AND (KEY_PRESSED("W")=1 OR KEY_PRESSED("G")=1 OR KEY_PRESSED("Z")=1) AND GROUND=1 THEN VY=0-2.6:GROUND=0:PLAY_SFX "BUBBLER/JUMP"
210 OLDY=PY:VY=VY+0.09:IF VY>1.67 THEN VY=1.67
220 PY=PY+VY:GROUND=0
230 IF PY>176 AND (PX+8<132 OR PX+8>180) THEN PY=176:VY=0:GROUND=1
231 IF PY>200 THEN PY=8:VY=0
240 IF VY>=0 THEN GOSUB 900
245 FILL_GLOW_CIRCLE(PX+8,PY+18,11,"#1827D855")
246 DRAW_TEXTURE("/TAPE/GFX/BUBBLER/PLAYER_GREEN.PNG",PX,PY-1,16,18)
270 IF TWO=1 AND P2LIVES>0 THEN GOSUB 1600
279 REM --- BUBBLE INPUT - EACH PLAYER HAS A SEPARATE COOLDOWN ---
280 IF (KEY_PRESSED("SPACE")=1 OR KEY_PRESSED("F")=1) AND BLOW_WAIT<1 THEN GOSUB 1000
281 IF TWO=1 AND KEY_PRESSED("J")=1 AND P2_BLOW_WAIT<1 THEN GOSUB 1650
290 BLOW_WAIT=BLOW_WAIT-1:HIT_WAIT=HIT_WAIT-1
299 REM --- UPDATE ACTIVE MONSTERS, BUBBLES, SHOTS, AND FRUIT ---
300 FOR E=1 TO ENEMY_COUNT
310 IF MONSTER(E)=1 THEN GOSUB 1100
320 NEXT E
330 FOR B=1 TO 36
340 IF BUBBLE(B)>0 THEN GOSUB 1200
350 NEXT B
355 FOR S=1 TO 6
356 IF SHOT(S)=1 THEN GOSUB 1550
357 NEXT S
358 FOR F=1 TO 36:IF FRUIT(F)>0 THEN GOSUB 1850
359 NEXT F
360 IF TWO=0 AND LIVES<1 THEN GOTO 700
361 IF TWO=1 AND LIVES<1 AND P2LIVES<1 THEN GOTO 700
365 ALIVE_COUNT=0
366 FOR E=1 TO ENEMY_COUNT:ALIVE_COUNT=ALIVE_COUNT+MONSTER(E):NEXT E
367 IF ALIVE_COUNT>0 THEN ROUND_TIME=ROUND_TIME+0.016
368 IF ALIVE_COUNT>0 AND HURRY=0 AND ROUND_TIME>HURRY_AT THEN HURRY=1:PLAY_MUSIC "BUBBLER_HURRY"
369 IF ALIVE_COUNT=0 AND CLEAR_TIME=0 THEN GOSUB 2080
370 IF ALIVE_COUNT=0 THEN CLEAR_TIME=CLEAR_TIME+0.016
371 IF ALIVE_COUNT>0 THEN CLEAR_TIME=0
372 IF CLEAR_TIME>3.4 THEN GOTO 680
373 IF ALIVE_COUNT=0 THEN DRAW_TEXT("CLEAR!",160,65,3,"BLIP_CYAN","CENTER")
374 IF ALIVE_COUNT=0 AND CLEAR_TIME>0.6 AND EXTENDED=1 THEN DRAW_TEXT("EXTEND +1 LIFE",160,88,1,"BLIP_YELLOW","CENTER")
380 WAIT 16:GOTO 100
680 WAIT 16:ROUND=ROUND+1
681 IF ROUND>8 THEN GOTO 690
682 GOTO 810
690 CLEAR("BLIP_BLACK"):IF GAMEOVER=0 THEN PLAY_SFX "BUBBLER/DEFEATED":GAMEOVER=1
691 DRAW_TEXT("YOU WIN!",160,55,4,"BLIP_CYAN","CENTER")
692 DRAW_TEXT("FINAL SCORE",160,91,2,"BLIP_GRAY","CENTER"):DRAW_NUMBER(SCORE,TEXT_CX(STR$(SCORE),3),119,3,"BLIP_YELLOW")
693 DRAW_TEXT("PRESS BUBBLE TO PLAY AGAIN",160,158,2,"BLIP_WHITE","CENTER"):IF KEY_PRESSED("SPACE")=1 OR KEY_PRESSED("F")=1 OR KEY_PRESSED("G")=1 OR KEY_PRESSED("Z")=1 THEN GOTO 800
694 WAIT 16:GOTO 690
699 REM --- GAME OVER AND RESTART ---
700 CLEAR("BLIP_BLACK")
705 IF GAMEOVER=0 THEN PLAY_SFX "BUBBLER/LOST":GAMEOVER=1
710 DRAW_TEXT("GAME OVER",160,55,4,"BLIP_RED","CENTER")
720 DRAW_TEXT("FINAL SCORE",160,91,2,"BLIP_GRAY","CENTER")
730 DRAW_NUMBER(SCORE,TEXT_CX(STR$(SCORE),3),119,3,"BLIP_YELLOW")
740 DRAW_TEXT("PRESS BUBBLE TO PLAY AGAIN",160,158,2,"BLIP_WHITE","CENTER")
750 IF (KEY_PRESSED("SPACE")=1 OR KEY_PRESSED("F")=1 OR KEY_PRESSED("G")=1 OR KEY_PRESSED("Z")=1) THEN GOTO 800
760 WAIT 16:GOTO 700
799 REM --- ROUND SETUP - PALETTE, PLATFORMS, AND MONSTERS ---
800 GAME_STATE=1:SCORE=0:LIVES=5:ROUND=1:P2SCORE=0:P2LIVES=5:GOTO 810
810 PX=13:PY=176:VY=0:GROUND=1:FACE=1:HIT_WAIT=0:BLOW_WAIT=0:GAMEOVER=0:ROUND_TIME=0:HURRY=0:CLEAR_TIME=0
811 P2X=289:P2Y=176:P2VY=0:P2GROUND=1:P2FACE=0:P2_HIT_WAIT=0:P2_BLOW_WAIT=0
815 MSPEED=0.37+ROUND*0.02:IF MSPEED>0.47 THEN MSPEED=0.47
816 HURRY_AT=70-2.5*(ROUND-1):IF HURRY_AT<60 THEN HURRY_AT=60
817 PLAY_MUSIC "BUBBLER_MAIN"
818 IF ROUND=1 THEN SKY0R=0.071:SKY0G=0.047:SKY0B=0.204:SKY1R=0.188:SKY1G=0.078:SKY1B=0.329:BLOCK_R=0.941:BLOCK_G=0.471:BLOCK_B=0.706:LIGHT_R=1:LIGHT_G=0.745:LIGHT_B=0.882:DARK_R=0.627:DARK_G=0.235:DARK_B=0.471
819 IF ROUND=2 THEN SKY0R=0.024:SKY0G=0.094:SKY0B=0.196:SKY1R=0.039:SKY1G=0.235:SKY1B=0.353:BLOCK_R=0.314:BLOCK_G=0.784:BLOCK_B=0.902:LIGHT_R=0.667:LIGHT_G=0.941:LIGHT_B=1:DARK_R=0.118:DARK_G=0.431:DARK_B=0.588
820 IF ROUND=3 THEN SKY0R=0.118:SKY0G=0.063:SKY0B=0.031:SKY1R=0.275:SKY1G=0.141:SKY1B=0.063:BLOCK_R=0.980:BLOCK_G=0.706:BLOCK_B=0.235:LIGHT_R=1:LIGHT_G=0.902:LIGHT_B=0.588:DARK_R=0.667:DARK_G=0.392:DARK_B=0.078
821 IF ROUND=4 THEN SKY0R=0.031:SKY0G=0.118:SKY0B=0.071:SKY1R=0.063:SKY1G=0.275:SKY1B=0.157:BLOCK_R=0.431:BLOCK_G=0.863:BLOCK_B=0.431:LIGHT_R=0.745:LIGHT_G=1:LIGHT_B=0.706:DARK_R=0.157:DARK_G=0.510:DARK_B=0.235
822 IF ROUND=5 THEN SKY0R=0.102:SKY0G=0.024:SKY0B=0.118:SKY1R=0.235:SKY1G=0.039:SKY1B=0.196:BLOCK_R=0.745:BLOCK_G=0.431:BLOCK_B=0.980:LIGHT_R=0.902:LIGHT_G=0.745:LIGHT_B=1:DARK_R=0.431:DARK_G=0.196:DARK_B=0.667
823 IF ROUND=6 THEN SKY0R=0.141:SKY0G=0.039:SKY0B=0.071:SKY1R=0.329:SKY1G=0.102:SKY1B=0.157:BLOCK_R=1:BLOCK_G=0.471:BLOCK_B=0.471:LIGHT_R=1:LIGHT_G=0.769:LIGHT_B=0.729:DARK_R=0.667:DARK_G=0.220:DARK_B=0.275
824 IF ROUND=7 THEN SKY0R=0.094:SKY0G=0.086:SKY0B=0.024:SKY1R=0.235:SKY1G=0.220:SKY1B=0.063:BLOCK_R=0.886:BLOCK_G=0.871:BLOCK_B=0.329:LIGHT_R=0.988:LIGHT_G=0.980:LIGHT_B=0.690:DARK_R=0.533:DARK_G=0.510:DARK_B=0.133
825 IF ROUND>=8 THEN SKY0R=0.024:SKY0G=0.086:SKY0B=0.102:SKY1R=0.063:SKY1G=0.212:SKY1B=0.235:BLOCK_R=0.588:BLOCK_G=0.941:BLOCK_B=0.824:LIGHT_R=0.871:LIGHT_G=1:LIGHT_B=0.941:DARK_R=0.235:DARK_G=0.588:DARK_B=0.510
829 REM PLAT=ROW*1000+COL*30+LENGTH; SPAWN=ROW*100+COL*4+KIND.
830 IF ROUND=1 THEN P_COUNT=6:PLAT(ROUND,1)=7278:PLAT(ROUND,2)=11067:PLAT(ROUND,3)=11517:PLAT(ROUND,4)=15222:PLAT(ROUND,5)=19097:PLAT(ROUND,6)=19487
831 IF ROUND=2 THEN P_COUNT=2:PLAT(ROUND,1)=11222:PLAT(ROUND,2)=19166
832 IF ROUND=3 THEN P_COUNT=3:PLAT(ROUND,1)=7194:PLAT(ROUND,2)=15138:PLAT(ROUND,3)=19278
833 IF ROUND=4 THEN P_COUNT=4:PLAT(ROUND,1)=11138:PLAT(ROUND,2)=15306:PLAT(ROUND,3)=19099:PLAT(ROUND,4)=19429
834 IF ROUND=5 THEN P_COUNT=5:PLAT(ROUND,1)=7166:PLAT(ROUND,2)=11306:PLAT(ROUND,3)=15128:PLAT(ROUND,4)=15428:PLAT(ROUND,5)=19250
835 IF ROUND=6 THEN P_COUNT=6:PLAT(ROUND,1)=7096:PLAT(ROUND,2)=7306:PLAT(ROUND,3)=7516:PLAT(ROUND,4)=15157:PLAT(ROUND,5)=15427:PLAT(ROUND,6)=19306
836 IF ROUND=7 THEN P_COUNT=6:PLAT(ROUND,1)=7306:PLAT(ROUND,2)=11157:PLAT(ROUND,3)=11427:PLAT(ROUND,4)=15278:PLAT(ROUND,5)=19098:PLAT(ROUND,6)=19458
837 IF ROUND=8 THEN P_COUNT=6:PLAT(ROUND,1)=7250:PLAT(ROUND,2)=11067:PLAT(ROUND,3)=11517:PLAT(ROUND,4)=15194:PLAT(ROUND,5)=19097:PLAT(ROUND,6)=19487
838 IF ROUND=1 THEN ENEMY_COUNT=6:SPAWN(ROUND,1)=1013:SPAWN(ROUND,2)=1089:SPAWN(ROUND,3)=1437:SPAWN(ROUND,4)=1465:SPAWN(ROUND,5)=1817:SPAWN(ROUND,6)=1885
839 IF ROUND=2 THEN ENEMY_COUNT=8:SPAWN(ROUND,1)=327:SPAWN(ROUND,2)=379:SPAWN(ROUND,3)=1041:SPAWN(ROUND,4)=1061:SPAWN(ROUND,5)=1414:SPAWN(ROUND,6)=1490:SPAWN(ROUND,7)=1833:SPAWN(ROUND,8)=1869
840 IF ROUND=3 THEN ENEMY_COUNT=10:SPAWN(ROUND,1)=351:SPAWN(ROUND,2)=637:SPAWN(ROUND,3)=665:SPAWN(ROUND,4)=1014:SPAWN(ROUND,5)=1090:SPAWN(ROUND,6)=1425:SPAWN(ROUND,7)=1477:SPAWN(ROUND,8)=1809:SPAWN(ROUND,9)=1850:SPAWN(ROUND,10)=1893
841 IF ROUND=4 THEN ENEMY_COUNT=12:SPAWN(ROUND,1)=251:SPAWN(ROUND,2)=319:SPAWN(ROUND,3)=387:SPAWN(ROUND,4)=614:SPAWN(ROUND,5)=686:SPAWN(ROUND,6)=1029:SPAWN(ROUND,7)=1073:SPAWN(ROUND,8)=1413:SPAWN(ROUND,9)=1450:SPAWN(ROUND,10)=1485:SPAWN(ROUND,11)=1821:SPAWN(ROUND,12)=1877
842 IF ROUND=5 THEN ENEMY_COUNT=15:SPAWN(ROUND,1)=251:SPAWN(ROUND,2)=319:SPAWN(ROUND,3)=387:SPAWN(ROUND,4)=633:SPAWN(ROUND,5)=669:SPAWN(ROUND,6)=1013:SPAWN(ROUND,7)=1050:SPAWN(ROUND,8)=1089:SPAWN(ROUND,9)=1421:SPAWN(ROUND,10)=1438:SPAWN(ROUND,11)=1481:SPAWN(ROUND,12)=1809:SPAWN(ROUND,13)=1841:SPAWN(ROUND,14)=1861:SPAWN(ROUND,15)=1893
843 IF ROUND=6 THEN ENEMY_COUNT=13:SPAWN(ROUND,1)=251:SPAWN(ROUND,2)=319:SPAWN(ROUND,3)=387:SPAWN(ROUND,4)=622:SPAWN(ROUND,5)=649:SPAWN(ROUND,6)=682:SPAWN(ROUND,7)=1017:SPAWN(ROUND,8)=1085:SPAWN(ROUND,9)=1433:SPAWN(ROUND,10)=1470:SPAWN(ROUND,11)=1813:SPAWN(ROUND,12)=1849:SPAWN(ROUND,13)=1889
844 IF ROUND=7 THEN ENEMY_COUNT=12:SPAWN(ROUND,1)=227:SPAWN(ROUND,2)=279:SPAWN(ROUND,3)=617:SPAWN(ROUND,4)=650:SPAWN(ROUND,5)=685:SPAWN(ROUND,6)=1034:SPAWN(ROUND,7)=1069:SPAWN(ROUND,8)=1413:SPAWN(ROUND,9)=1449:SPAWN(ROUND,10)=1490:SPAWN(ROUND,11)=1825:SPAWN(ROUND,12)=1873
845 IF ROUND=8 THEN ENEMY_COUNT=11:SPAWN(ROUND,1)=251:SPAWN(ROUND,2)=323:SPAWN(ROUND,3)=383:SPAWN(ROUND,4)=641:SPAWN(ROUND,5)=661:SPAWN(ROUND,6)=1017:SPAWN(ROUND,7)=1086:SPAWN(ROUND,8)=1437:SPAWN(ROUND,9)=1466:SPAWN(ROUND,10)=1821:SPAWN(ROUND,11)=1881
850 FOR P=1 TO P_COUNT:PCODE=PLAT(ROUND,P):PROW=INT(PCODE/1000):PREST=PCODE-PROW*1000:PCOL=INT(PREST/30):PLEN=PREST-PCOL*30:PXLINE(P)=PCOL*12:PYLINE(P)=8+PROW*8:PWLINE(P)=PLEN*12:NEXT P
860 FOR E=1 TO ENEMY_COUNT
861 MONSTER(E)=1:ETRAPPED(E)=0:EANGRY(E)=0:EGROUND(E)=1:EVY(E)=0:ECODE=SPAWN(ROUND,E):EROW=INT(ECODE/100):EREST=ECODE-EROW*100:ECOL=INT(EREST/4):ETYPE(E)=EREST-ECOL*4:EX(E)=ECOL*12+1:EY(E)=EROW*8:EMIN(E)=12:EMAX(E)=292:EDIR(E)=1
862 FOR P=1 TO P_COUNT
863 IF PYLINE(P)=8+(EROW+1)*8 AND EX(E)+15>PXLINE(P) AND EX(E)<PXLINE(P)+PWLINE(P) THEN EMIN(E)=PXLINE(P)+1:EMAX(E)=PXLINE(P)+PWLINE(P)-17
864 NEXT P
865 IF EX(E)>PX THEN EDIR(E)=0-1
866 JUMP_CD(E)=45:JUMP_NOW(E)=0:NEXT E
870 E=E
889 FOR E=1 TO ENEMY_COUNT:EHOME(E)=EY(E):JUMP_CD(E)=30+INT(RND(75)):FIRE_CD(E)=80+INT(RND(100)):NEXT E
890 FOR B=1 TO 36:BUBBLE(B)=0:QOWNER(B)=1:NEXT B
891 FOR F=1 TO 36:FRUIT(F)=0:NEXT F
892 FOR S=1 TO 6:SHOT(S)=0:NEXT S
895 GOTO 100
899 REM --- PLAYER ONE LANDING - ONLY CATCH PLATFORMS FROM ABOVE ---
900 FOR P=1 TO P_COUNT
910 IF OLDY+16<=PYLINE(P) AND PY+16>=PYLINE(P) AND PX+14>PXLINE(P) AND PX<PXLINE(P)+PWLINE(P) THEN PY=PYLINE(P)-16:VY=0:GROUND=1
920 NEXT P
930 RETURN
998 REM QOWNER LINKS EACH BUBBLE TO ITS PLAYER FOR SCORE AND POPS.
999 REM --- PLAYER ONE BUBBLE - ALLOCATE A FREE SLOT ---
1000 BUBBLE_SLOT=0
1010 FOR B=1 TO 36
1020 IF BUBBLE(B)=0 AND BUBBLE_SLOT=0 THEN BUBBLE_SLOT=B
1030 NEXT B
1040 IF BUBBLE_SLOT=0 THEN RETURN
1050 B=BUBBLE_SLOT:BUBBLE(B)=1:QOWNER(B)=1:QX(B)=PX+8+FACE*9:QY(B)=PY+8:QDIR(B)=FACE:QVEL(B)=2.8:BT(B)=24:BLOW_WAIT=14:PLAY_SFX "BUBBLER/BLOW":RETURN
1099 REM --- MONSTER UPDATE - MOVEMENT, JUMPS, ANGER, AND ATTACKS ---
1100 IF ETRAPPED(E)=0 THEN EY_OLD(E)=EY(E):EX(E)=EX(E)+EDIR(E)*MSPEED*(1+0.35*EANGRY(E))
1101 IF ETRAPPED(E)=0 AND ETYPE(E)=1 AND EGROUND(E)=1 THEN JUMP_CD(E)=JUMP_CD(E)-1:IF JUMP_CD(E)<1 THEN JUMP_CD(E)=60+INT(RND(85)):IF PY<EY(E)-20 AND ABS(PX-EX(E))<150 AND RND(10)<7 THEN EVY(E)=0-2.6:EGROUND(E)=0
1102 IF ETRAPPED(E)=0 AND ETYPE(E)=2 AND EGROUND(E)=1 THEN JUMP_CD(E)=JUMP_CD(E)-1:IF JUMP_CD(E)<1 THEN JUMP_CD(E)=36+INT(RND(43)):JUMP_NOW(E)=1
1103 IF JUMP_NOW(E)=1 AND PX>EX(E) THEN EDIR(E)=1:EVY(E)=0-2.6:EGROUND(E)=0:JUMP_NOW(E)=0
1104 IF JUMP_NOW(E)=1 AND PX<=EX(E) THEN EDIR(E)=0-1:EVY(E)=0-2.6:EGROUND(E)=0:JUMP_NOW(E)=0
1105 IF ETRAPPED(E)=0 AND ETYPE(E)<>3 AND EGROUND(E)=0 THEN EVY(E)=EVY(E)+0.09:EY(E)=EY(E)+EVY(E)
1106 IF ETRAPPED(E)=0 AND ETYPE(E)=3 THEN EY(E)=EHOME(E)+SIN(T*3+E)*4
1107 IF ETRAPPED(E)=0 AND ETYPE(E)<>3 THEN EGROUND(E)=0:GOSUB 1500
1110 IF EX(E)<EMIN(E) OR EX(E)>EMAX(E) THEN EDIR(E)=0-EDIR(E)
1115 IF ETRAPPED(E)=0 AND ETYPE(E)=3 THEN FILL_GLOW_CIRCLE(EX(E)+8,EY(E)+8,13,"#A8E9FF55")
1120 IF ETRAPPED(E)=0 AND ETYPE(E)=1 AND EANGRY(E)=0 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/ROBOT.PNG",EX(E),EY(E)-1,16,18)
1121 IF ETRAPPED(E)=0 AND ETYPE(E)=2 AND EANGRY(E)=0 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/BUNNY.PNG",EX(E),EY(E)-1,16,18)
1122 IF ETRAPPED(E)=0 AND ETYPE(E)=3 AND EANGRY(E)=0 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/GHOST.PNG",EX(E),EY(E)-1,16,18)
1123 IF ETRAPPED(E)=0 AND ETYPE(E)=1 AND EANGRY(E)=1 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/ROBOT_ANGRY.PNG",EX(E),EY(E)-1,16,18)
1124 IF ETRAPPED(E)=0 AND ETYPE(E)=2 AND EANGRY(E)=1 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/BUNNY_ANGRY.PNG",EX(E),EY(E)-1,16,18)
1125 IF ETRAPPED(E)=0 AND ETYPE(E)=3 AND EANGRY(E)=1 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/GHOST_ANGRY.PNG",EX(E),EY(E)-1,16,18)
1130 IF LIVES>0 AND ETRAPPED(E)=0 AND HIT_WAIT<1 AND ABS(PX-EX(E))<13 AND ABS(PY-EY(E))<14 THEN LIVES=LIVES-1:HIT_WAIT=60:PX=13:PY=176:VY=0:PLAY_SFX "BUBBLER/LOST"
1131 IF TWO=1 AND P2LIVES>0 AND ETRAPPED(E)=0 AND P2_HIT_WAIT<1 AND ABS(P2X-EX(E))<13 AND ABS(P2Y-EY(E))<14 THEN P2LIVES=P2LIVES-1:P2_HIT_WAIT=60:P2X=289:P2Y=176:P2VY=0:PLAY_SFX "BUBBLER/LOST"
1135 IF ETRAPPED(E)=0 THEN FIRE_CD(E)=FIRE_CD(E)-1
1136 IF ETRAPPED(E)=0 AND (ROUND>=3 OR EANGRY(E)=1) AND ETYPE(E)=1 AND EGROUND(E)=1 AND FIRE_CD(E)<=0 AND ABS(PY-EY(E))<14 AND ABS(PX-EX(E))<150 THEN GOSUB 1750
1137 IF ETRAPPED(E)=0 AND (ROUND>=4 OR EANGRY(E)=1) AND ETYPE(E)=3 AND FIRE_CD(E)<=0 THEN GOSUB 1750
1140 RETURN
1189 REM --- TRAPPING - TEST A MOVING BUBBLE AGAINST MONSTERS ---
1190 FOR E=1 TO ENEMY_COUNT
1191 IF MONSTER(E)=1 AND ETRAPPED(E)=0 AND ABS(QX(B)-EX(E)-8)<10 AND ABS(QY(B)-EY(E)-8)<7 THEN BUBBLE(B)=2:TRAP(B)=E:ETRAPPED(E)=1:QDIR(B)=0:BT(B)=600-30*ROUND:PLAY_SFX "BUBBLER/TRAP":IF BT(B)<420 THEN BT(B)=420
1192 NEXT E:RETURN
1198 REM BUBBLE(B): 0=FREE, 1=TRAVELLING, 2=TRAPPED, 3=EMPTY FLOATING.
1199 REM --- BUBBLE LIFECYCLE - TRAVEL, FLOAT, TRAP, ESCAPE, AND POP ---
1200 IF BUBBLE(B)=1 THEN QX(B)=QX(B)+QDIR(B)*QVEL(B):QVEL(B)=QVEL(B)*0.958:BT(B)=BT(B)-1
1201 IF BUBBLE(B)=1 THEN GOSUB 1190
1205 IF BUBBLE(B)=1 AND (QX(B)<18 OR QX(B)>294 OR BT(B)<1) THEN BUBBLE(B)=3:BT(B)=540:QDIR(B)=0
1210 IF BUBBLE(B)=3 THEN QY(B)=QY(B)-0.38:BT(B)=BT(B)-1
1212 IF BUBBLE(B)=3 AND QY(B)<20 THEN QY(B)=20
1214 IF BUBBLE(B)=3 AND QY(B)=20 AND QX(B)<160 THEN QX(B)=QX(B)+0.6
1215 IF BUBBLE(B)=3 AND QY(B)=20 AND QX(B)>160 THEN QX(B)=QX(B)-0.6
1216 IF BUBBLE(B)=3 AND BT(B)<1 THEN BUBBLE(B)=0:PLAY_SFX "BUBBLER/POP"
1220 IF BUBBLE(B)=1 THEN FILL_GLOW_CIRCLE(QX(B),QY(B),5,"BLIP_CYAN")
1221 IF BUBBLE(B)=3 THEN FILL_GLOW_CIRCLE(QX(B),QY(B),6,"#89E8FFAA"):FILL_CIRCLE(QX(B),QY(B),4,"#D7F5FF")
1230 IF BUBBLE(B)=2 THEN QY(B)=QY(B)-0.35:BT(B)=BT(B)-1:FILL_GLOW_CIRCLE(QX(B),QY(B),9,"#FF68D488"):FILL_CIRCLE(QX(B),QY(B),6,"#F6B8F5AA"):GOSUB 2060
1232 TRAPPED=TRAP(B):IF BUBBLE(B)=2 AND BT(B)<1 THEN MONSTER(TRAPPED)=1:ETRAPPED(TRAPPED)=0:EX(TRAPPED)=QX(B)-8:EY(TRAPPED)=QY(B)-8:EGROUND(TRAPPED)=0:EVY(TRAPPED)=0-1:EANGRY(TRAPPED)=1:FIRE_CD(TRAPPED)=90:BUBBLE(B)=0:PLAY_SFX "BUBBLER/POP":RETURN
1235 IF (BUBBLE(B)=2 OR BUBBLE(B)=3) AND ABS(QX(B)-PX-8)<12 AND ABS(QY(B)-PY-8)<8 AND NOT(VY>0 AND PY+16<QY(B) AND JUMP1=1) THEN SCORER=1:GOSUB 1280
1236 IF (BUBBLE(B)=2 OR BUBBLE(B)=3) AND ABS(QX(B)-P2X-8)<12 AND ABS(QY(B)-P2Y-8)<8 AND TWO=1 AND NOT(P2VY>0 AND P2Y+16<QY(B) AND (KEY_HELD("UP")=1 OR KEY_HELD("K")=1)) THEN SCORER=2:GOSUB 1280
1237 IF (BUBBLE(B)=2 OR BUBBLE(B)=3) AND VY>0 AND PY+16<QY(B) AND ABS(QX(B)-PX-8)<15 AND JUMP1=1 THEN VY=0-2.1:PLAY_SFX "BUBBLER/BOUNCE"
1238 IF (BUBBLE(B)=2 OR BUBBLE(B)=3) AND TWO=1 AND P2VY>0 AND P2Y+16<QY(B) AND ABS(QX(B)-P2X-8)<15 AND (KEY_HELD("UP")=1 OR KEY_HELD("K")=1) THEN P2VY=0-2.1:PLAY_SFX "BUBBLER/BOUNCE"
1270 RETURN
1279 REM --- POP ENTRY - RESOLVE THE CONNECTED BUBBLE CHAIN ---
1280 GOSUB 2000:RETURN
1499 REM --- MONSTER LANDING - SETTLE ON PLATFORMS OR THE FLOOR ---
1500 FOR P=1 TO P_COUNT
1510 IF EVY(E)>=0 AND EY_OLD(E)+16<=PYLINE(P) AND EY(E)+16>=PYLINE(P) AND EX(E)+15>PXLINE(P) AND EX(E)<PXLINE(P)+PWLINE(P) THEN EY(E)=PYLINE(P)-16:EVY(E)=0:EGROUND(E)=1
1520 NEXT P
1530 IF EY(E)>176 THEN EY(E)=176:EVY(E)=0:EGROUND(E)=1
1540 RETURN
1549 REM --- MONSTER SHOTS - MOVEMENT, DRAWING, AND PLAYER HITS ---
1550 SX(S)=SX(S)+SVX(S):SY(S)=SY(S)+SVY(S):SHOT_T(S)=SHOT_T(S)-1
1560 IF SHOT_T(S)<1 OR SX(S)<0 OR SX(S)>320 OR SY(S)<38 OR SY(S)>184 THEN SHOT(S)=0:RETURN
1570 IF SHOT_KIND(S)=1 THEN FILL_CIRCLE(SX(S)+1,SY(S)+2,5,"#382D3B"):FILL_CIRCLE(SX(S),SY(S),5,"#96786E"):FILL_CIRCLE(SX(S)-2,SY(S)-2,1.5,"#FFF0D8")
1580 IF SHOT_KIND(S)=2 THEN FILL_GLOW_CIRCLE(SX(S),SY(S),8,"#FF74C855"):DRAW_LINE(SX(S)-3,SY(S),SX(S)+3,SY(S),"#FFD5F5"):DRAW_LINE(SX(S),SY(S)-3,SX(S),SY(S)+3,"BLIP_WHITE")
1590 IF LIVES>0 AND HIT_WAIT<1 AND SX(S)>PX AND SX(S)<PX+16 AND SY(S)>PY AND SY(S)<PY+16 THEN SHOT(S)=0:LIVES=LIVES-1:HIT_WAIT=60:PX=13:PY=176:VY=0:PLAY_SFX "BUBBLER/LOST":RETURN
1591 IF TWO=1 AND P2LIVES>0 AND P2_HIT_WAIT<1 AND SX(S)>P2X AND SX(S)<P2X+16 AND SY(S)>P2Y AND SY(S)<P2Y+16 THEN SHOT(S)=0:P2LIVES=P2LIVES-1:P2_HIT_WAIT=60:P2X=289:P2Y=176:P2VY=0:PLAY_SFX "BUBBLER/LOST":RETURN
1592 FOR B=1 TO 36
1594 IF BUBBLE(B)=1 AND SQR((SX(S)-QX(B))*(SX(S)-QX(B))+(SY(S)-QY(B))*(SY(S)-QY(B)))<14 THEN SHOT(S)=0:PLAY_SFX "BUBBLER/POP"
1596 NEXT B
1598 RETURN
1599 REM --- PLAYER TWO - MOVEMENT, GRAVITY, AND LANDING ---
1600 IF KEY_HELD("LEFT")=1 AND P2X>12 THEN P2X=P2X-1:P2FACE=0-1
1601 IF KEY_HELD("RIGHT")=1 AND P2X<292 THEN P2X=P2X+1:P2FACE=1
1602 IF (KEY_PRESSED("UP")=1 OR KEY_PRESSED("K")=1) AND P2GROUND=1 THEN P2VY=0-2.6:P2GROUND=0:PLAY_SFX "BUBBLER/JUMP"
1603 P2_OLDY=P2Y:P2VY=P2VY+0.09:IF P2VY>1.67 THEN P2VY=1.67
1604 P2Y=P2Y+P2VY:P2GROUND=0:IF P2Y>176 AND (P2X+8<132 OR P2X+8>180) THEN P2Y=176:P2VY=0:P2GROUND=1
1605 IF P2VY>=0 THEN GOSUB 1700
1607 IF P2Y>200 THEN P2Y=8:P2VY=0
1610 FILL_GLOW_CIRCLE(P2X+8,P2Y+18,11,"#1827D855")
1611 DRAW_TEXTURE("/TAPE/GFX/BUBBLER/PLAYER_BLUE.PNG",P2X,P2Y-1,16,18)
1618 P2_BLOW_WAIT=P2_BLOW_WAIT-1:P2_HIT_WAIT=P2_HIT_WAIT-1:RETURN
1649 REM --- PLAYER TWO BUBBLE - OWNERSHIP AND START POSITION ---
1650 BUBBLE_SLOT=0
1651 FOR B=1 TO 36
1652 IF BUBBLE(B)=0 AND BUBBLE_SLOT=0 THEN BUBBLE_SLOT=B
1653 NEXT B
1654 IF BUBBLE_SLOT=0 THEN RETURN
1655 B=BUBBLE_SLOT:BUBBLE(B)=1:QOWNER(B)=2:QX(B)=P2X+8+P2FACE*9:QY(B)=P2Y+8:QDIR(B)=P2FACE:QVEL(B)=2.8:BT(B)=24:P2_BLOW_WAIT=14:PLAY_SFX "BUBBLER/BLOW":RETURN
1699 REM --- PLAYER TWO LANDING - PLATFORMS FROM ABOVE ---
1700 FOR P=1 TO P_COUNT
1701 IF P2_OLDY+16<=PYLINE(P) AND P2Y+16>=PYLINE(P) AND P2X+14>PXLINE(P) AND P2X<PXLINE(P)+PWLINE(P) THEN P2Y=PYLINE(P)-16:P2VY=0:P2GROUND=1
1702 NEXT P
1703 RETURN
1749 REM --- MONSTER ATTACK - ALLOCATE A PROJECTILE SLOT ---
1750 BSLOT=0
1760 FOR Z=1 TO 6
1770 IF SHOT(Z)=0 AND BSLOT=0 THEN BSLOT=Z
1780 NEXT Z
1790 IF BSLOT=0 THEN FIRE_CD(E)=30:RETURN
1800 DIRSHOT=1
1810 IF PX<EX(E) THEN DIRSHOT=0-1
1820 IF ETYPE(E)=1 THEN SHOT(BSLOT)=1:SHOT_KIND(BSLOT)=1:SX(BSLOT)=EX(E)+8:SY(BSLOT)=EY(E)+14:SVX(BSLOT)=DIRSHOT*1.4:SVY(BSLOT)=0:SHOT_T(BSLOT)=180:FIRE_CD(E)=150+INT(RND(90)):PLAY_SFX "BUBBLER/BOUNCE":RETURN
1830 DX=PX+8-(EX(E)+8):DY=PY+8-(EY(E)+8):DIST=SQR(DX*DX+DY*DY):IF DIST<1 THEN DIST=1
1840 SHOT(BSLOT)=1:SHOT_KIND(BSLOT)=2:SX(BSLOT)=EX(E)+8:SY(BSLOT)=EY(E)+8:SVX(BSLOT)=DX/DIST*0.8:SVY(BSLOT)=DY/DIST*0.8:SHOT_T(BSLOT)=210:FIRE_CD(E)=180+INT(RND(120)):PLAY_SFX "BUBBLER/SPARKLE":RETURN
1849 REM --- FRUIT UPDATE - LIFETIME, MOTION, AND COLLECTION ---
1850 FRUIT_TIME(F)=FRUIT_TIME(F)+1:IF FRUIT_TIME(F)>540 THEN FRUIT(F)=0:RETURN
1851 IF FRUIT(F)=1 THEN FX(F)=FX(F)+FVX(F):FVY(F)=FVY(F)+0.09:FYOLD=FY(F):FY(F)=FY(F)+FVY(F):FVX(F)=FVX(F)*0.985:GOSUB 1860
1852 IF FRUIT(F)>0 AND FRUIT(F)=2 AND FRUIT_TIME(F)>420 AND INT(FRUIT_TIME(F)/8)*8=FRUIT_TIME(F) THEN RETURN
1853 IF FRUIT(F)>0 THEN GOSUB 1870
1854 IF FRUIT(F)>0 AND FRUIT_TIME(F)>=22 AND ABS(FX(F)-PX)<16 AND ABS(FY(F)-PY)<18 THEN SCORER=1:GOSUB 1880
1855 IF FRUIT(F)>0 AND FRUIT_TIME(F)>=22 AND TWO=1 AND ABS(FX(F)-P2X)<16 AND ABS(FY(F)-P2Y)<18 THEN SCORER=2:GOSUB 1880
1856 RETURN
1859 REM --- FRUIT LANDING - SETTLE ON PLATFORMS OR FLOOR ---
1860 FOR P=1 TO P_COUNT
1861 IF FVY(F)>=0 AND FYOLD+16<=PYLINE(P) AND FY(F)+16>=PYLINE(P) AND FX(F)+16>PXLINE(P) AND FX(F)<PXLINE(P)+PWLINE(P) THEN FY(F)=PYLINE(P)-16:FRUIT_HOME(F)=FY(F):FVY(F)=0:FVX(F)=0:FRUIT(F)=2
1862 NEXT P:IF FY(F)>176 THEN FY(F)=176:FRUIT_HOME(F)=176:FVY(F)=0:FVX(F)=0:FRUIT(F)=2
1863 IF FRUIT(F)=2 THEN FY(F)=FRUIT_HOME(F)+SIN(T*4+F)*0.5
1864 RETURN
1869 REM --- FRUIT ART - TYPE AND GLOW ---
1870 FILL_GLOW_CIRCLE(FX(F)+8,FY(F)+8,8,"#FFCB6A44")
1871 IF FRUIT_KIND(F)=0 THEN FILL_CIRCLE(FX(F)+8,FY(F)+8,4,"#FF78A0"):FILL_CIRCLE(FX(F)+7,FY(F)+6,1,"BLIP_WHITE")
1872 IF FRUIT_KIND(F)=1 THEN DRAW_LINE(FX(F)+8,FY(F)+10,FX(F)+9,FY(F)+15,"BLIP_WHITE"):FILL_CIRCLE(FX(F)+8,FY(F)+6,5,"#78C8FF"):FILL_CIRCLE(FX(F)+7,FY(F)+5,1,"BLIP_WHITE")
1873 IF FRUIT_KIND(F)=2 THEN FILL_CIRCLE(FX(F)+8,FY(F)+8,5,"#ECA65F"):FILL_CIRCLE(FX(F)+8,FY(F)+7,4,"#FF78A0"):FILL_CIRCLE(FX(F)+8,FY(F)+8,1.5,"#56302A")
1874 IF FRUIT_KIND(F)>=3 THEN FILL_RECT(FX(F)+3,FY(F)+5,10,8,"#D78A61"):FILL_CIRCLE(FX(F)+8,FY(F)+5,6,"#FFE3B1"):FILL_CIRCLE(FX(F)+8,FY(F)+2,2,"#FF687D")
1875 RETURN
1879 REM --- FRUIT SCORE - AWARD ITS VALUE TO THE COLLECTOR ---
1880 IF FRUIT_KIND(F)=0 THEN FRUIT_VALUE=500
1881 IF FRUIT_KIND(F)=1 THEN FRUIT_VALUE=1000
1882 IF FRUIT_KIND(F)=2 THEN FRUIT_VALUE=2000
1883 IF FRUIT_KIND(F)>=3 THEN FRUIT_VALUE=4000
1884 IF SCORER=1 THEN SCORE=SCORE+FRUIT_VALUE:PX_EAT=PX:PY_EAT=PY
1885 IF SCORER=2 THEN P2SCORE=P2SCORE+FRUIT_VALUE:PX_EAT=P2X:PY_EAT=P2Y
1886 FRUIT(F)=0:PLAY_SFX "BUBBLER/FRUIT":DRAW_TEXT("+"+STR$(FRUIT_VALUE),PX_EAT,PY_EAT-5,1,"BLIP_YELLOW"):RETURN
1899 REM --- TITLE BACKGROUND - GENERATED SKY AND ANIMATED LIGHT ---
1900 DRAW_TEXTURE("/TAPE/GFX/BUBBLER/TITLE_SKY.PNG",0,0,624,600)
1901 REM TT IS ELAPSED TIME; TITLE BUBBLES USE A 24-HUE, TWO-OWNER ATLAS.
1910 FOR I=0 TO 21:S=I*37.7:QX=WRAP(S*13.1,0,624):QY=620-WRAP(S*7.3+TT*(6+(I-5*INT(I/5))*3),0,640)
1920 BR=3+(I-4*INT(I/4))*3:A=0.05+0.04*(SIN(TT*0.8+S)*0.5+0.5):FILL_CIRCLE(QX,QY,BR,COLOR(1,0.549,0.863,A)):NEXT I
1930 FOR I=0 TO 29:S=I*91.3:QX=WRAP(S*5.7,0,624):QY=24+WRAP(S*3.1,0,576):A=SIN(TT*2+S)*0.5+0.5
1940 FILL_RECT(QX,QY,1.5,1.5,COLOR(1,1,1,A*A*A*0.8)):NEXT I
1950 FOR I=0 TO 13:S=I*53.1:QX=WRAP(S*11.3,0,624):QY=620-WRAP(S*9.1+TT*30,0,640):WOBBLE=TT+S
1960 HUE=INT(WRAP(WOBBLE*0.15+QX*0.002,0,1)*24):OWNER=I-2*INT(I/2):SIZE=(12+SIN(WOBBLE*3)*0.6)*32/12
1970 DRAW_TEXTURE("/TAPE/GFX/BUBBLER/TITLE_BUBBLES.PNG",QX-SIZE/2,QY-SIZE/2,SIZE,SIZE,HUE,24,OWNER,2,0):NEXT I
1980 RETURN
1998 REM INPUT: B STARTS THE CHAIN; SCORER RECEIVES ITS POINTS.
1999 REM --- CHAIN SEARCH - FIND ALL TOUCHING BUBBLES ---
2000 FOR C=1 TO 36:CHAIN(C)=0:NEXT C:CHAIN(B)=1:CHAIN_MORE=1
2001 IF CHAIN_MORE=0 THEN GOTO 2007
2002 CHAIN_MORE=0:FOR C=1 TO 36
2003 FOR D=1 TO 36
2004 IF CHAIN(C)=1 AND CHAIN(D)=0 AND (BUBBLE(D)=2 OR BUBBLE(D)=3) AND DISTANCE(QX(C),QY(C)*1.54,QX(D),QY(D)*1.54)<17 THEN CHAIN(D)=1:CHAIN_MORE=1
2005 NEXT D:NEXT C:IF CHAIN_MORE=1 THEN GOTO 2001
2007 CHAIN_KILLS=0:CHAIN_SCORE=0:FOR C=1 TO 36
2008 IF CHAIN(C)=1 THEN GOSUB 2020
2009 NEXT C
2010 IF CHAIN_KILLS>1 THEN CHAIN_TIME=72:PLAY_SFX "BUBBLER/SPARKLE"
2011 IF SCORER=1 THEN SCORE=SCORE+CHAIN_SCORE
2012 IF SCORER=2 THEN P2SCORE=P2SCORE+CHAIN_SCORE
2013 PLAY_SFX "BUBBLER/POP":RETURN
2019 REM --- POP ONE BUBBLE AND RESOLVE ITS CONTENTS ---
2020 IF BUBBLE(C)=2 THEN GOSUB 2030
2021 IF BUBBLE(C)=3 THEN CHAIN_SCORE=CHAIN_SCORE+10
2022 BUBBLE(C)=0:RETURN
2029 REM --- TRAPPED MONSTER - DEFEAT, CHAIN SCORE, AND FRUIT ---
2030 TRAPPED=TRAP(C):MONSTER(TRAPPED)=0:ETRAPPED(TRAPPED)=0:CHAIN_KILLS=CHAIN_KILLS+1:CHAIN_VALUE=1000
2031 IF CHAIN_KILLS=2 THEN CHAIN_VALUE=2000
2032 IF CHAIN_KILLS=3 THEN CHAIN_VALUE=4000
2033 IF CHAIN_KILLS=4 THEN CHAIN_VALUE=8000
2034 IF CHAIN_KILLS>=5 THEN CHAIN_VALUE=16000
2035 CHAIN_SCORE=CHAIN_SCORE+CHAIN_VALUE:GOSUB 2040:RETURN
2039 REM --- FRUIT DROP - ALLOCATE A FREE SLOT ---
2040 FRUIT_SLOT=0:FOR Z=1 TO 36:IF FRUIT(Z)=0 AND FRUIT_SLOT=0 THEN FRUIT_SLOT=Z
2041 NEXT Z:IF FRUIT_SLOT=0 THEN RETURN
2042 FRUIT(FRUIT_SLOT)=1:FX(FRUIT_SLOT)=QX(C)-8:FY(FRUIT_SLOT)=QY(C)-8:FRUIT_HOME(FRUIT_SLOT)=FY(FRUIT_SLOT):FVX(FRUIT_SLOT)=RND(1.6)-0.8:FVY(FRUIT_SLOT)=0-1.7:FRUIT_KIND(FRUIT_SLOT)=CHAIN_KILLS-1
2043 IF FRUIT_KIND(FRUIT_SLOT)>3 THEN FRUIT_KIND(FRUIT_SLOT)=3
2044 FRUIT_TIME(FRUIT_SLOT)=0:RETURN
2059 REM --- TRAPPED MONSTER ART - NORMAL AND ANGRY PALETTES ---
2060 IF ETYPE(TRAP(B))=1 AND EANGRY(TRAP(B))=0 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/ROBOT.PNG",QX(B)-7,QY(B)-8,14,16)
2061 IF ETYPE(TRAP(B))=2 AND EANGRY(TRAP(B))=0 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/BUNNY.PNG",QX(B)-7,QY(B)-8,14,16)
2062 IF ETYPE(TRAP(B))=3 AND EANGRY(TRAP(B))=0 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/GHOST.PNG",QX(B)-7,QY(B)-8,14,16)
2063 IF ETYPE(TRAP(B))=1 AND EANGRY(TRAP(B))=1 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/ROBOT_ANGRY.PNG",QX(B)-7,QY(B)-8,14,16)
2064 IF ETYPE(TRAP(B))=2 AND EANGRY(TRAP(B))=1 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/BUNNY_ANGRY.PNG",QX(B)-7,QY(B)-8,14,16)
2065 IF ETYPE(TRAP(B))=3 AND EANGRY(TRAP(B))=1 THEN DRAW_TEXTURE("/TAPE/GFX/BUBBLER/GHOST_ANGRY.PNG",QX(B)-7,QY(B)-8,14,16)
2066 RETURN
2079 REM --- ROUND REWARD - CLEAR SHOTS AND EXTEND LIVES ---
2080 EXTENDED=0:FOR S=1 TO 6:SHOT(S)=0:NEXT S
2081 IF LIVES>0 AND LIVES<7 THEN LIVES=LIVES+1:EXTENDED=1
2082 IF TWO=1 AND P2LIVES>0 AND P2LIVES<7 THEN P2LIVES=P2LIVES+1:EXTENDED=1
2083 PLAY_SFX "BUBBLER/SPARKLE":RETURN
