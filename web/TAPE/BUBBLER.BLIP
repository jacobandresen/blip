250 FILL_CIRCLE(PX+8+FACE*2,PY+5,2.1,"#281D36"):FILL_CIRCLE(PX+8+FACE*7,PY+5,2,"#281D36")
251 FILL_CIRCLE(PX+8+FACE*1.4,PY+4.4,0.7,"BLIP_WHITE"):FILL_CIRCLE(PX+8+FACE*6.4,PY+4.4,0.7,"BLIP_WHITE")
252 FILL_CIRCLE(PX+8+FACE*4,PY+9,1.1,"#FF9FA8"):FILL_CIRCLE(PX+8+FACE*8,PY+9,1.1,"#FF9FA8")
260 DRAW_LINE(PX+8+FACE*9,PY+9,PX+8+FACE*11,PY+9,"#783F56"):FILL_CIRCLE(PX+8-FACE*1,PY-1,2.5,"#8AE785")
270 IF TWO=1 AND P2LIVES>0 THEN GOSUB 1600
280 IF KEY_PRESSED("SPACE")=1 AND BLOW_WAIT<1 THEN GOSUB 1000
281 IF TWO=1 AND KEY_PRESSED("J")=1 AND P2_BLOW_WAIT<1 THEN GOSUB 1650
290 BLOW_WAIT=BLOW_WAIT-1:HIT_WAIT=HIT_WAIT-1
300 FOR E=1 TO ENEMY_COUNT
310 IF MONSTER(E)=1 THEN GOSUB 1100
320 NEXT E
330 FOR B=1 TO 6
340 IF BUBBLE(B)>0 THEN GOSUB 1200
350 NEXT B
355 FOR S=1 TO 6
356 IF SHOT(S)=1 THEN GOSUB 1550
357 NEXT S
360 IF TWO=0 AND LIVES<1 THEN GOTO 700
361 IF TWO=1 AND LIVES<1 AND P2LIVES<1 THEN GOTO 700
365 ALIVE_COUNT=0
366 FOR E=1 TO ENEMY_COUNT:ALIVE_COUNT=ALIVE_COUNT+MONSTER(E):NEXT E
367 ROUND_TIME=ROUND_TIME+0.016
368 IF HURRY=0 AND ROUND_TIME>HURRY_AT THEN HURRY=1:PLAY_MUSIC "BUBBLER_HURRY"
370 IF ALIVE_COUNT=0 THEN GOTO 680
380 WAIT 16:GOTO 100
680 WAIT 16:ROUND=ROUND+1:SCORE=SCORE+500:IF TWO=1 THEN P2SCORE=P2SCORE+500
681 IF ROUND>8 THEN GOTO 690
682 GOTO 810
690 CLEAR("BLIP_BLACK"):IF GAMEOVER=0 THEN PLAY_SFX "BUBBLER/DEFEATED":GAMEOVER=1
691 DRAW_TEXT("YOU WIN!",160,55,4,"BLIP_CYAN","CENTER")
692 DRAW_TEXT("FINAL SCORE",160,91,2,"BLIP_GRAY","CENTER"):DRAW_NUMBER(SCORE,TEXT_CX(STR$(SCORE),3),119,3,"BLIP_YELLOW")
693 DRAW_TEXT("SPACE TO PLAY AGAIN",160,158,2,"BLIP_WHITE","CENTER"):IF KEY_PRESSED("SPACE")=1 THEN GOTO 800
694 WAIT 16:GOTO 690
