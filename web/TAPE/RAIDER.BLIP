1 REM RAIDER - FLY NORTH OVER THE SEA, SHOOT DOWN EVERY FLIGHT, BEAT SEVEN BOSSES.
2 REM GAME: RAIDER
3 REM ARROWS OR WASD FLY THE PLANE, SPACE FIRES. AN ACE DROPS A BIGGER GUN.
4 REM SCREENS: TITLE, PLAY, DEAD, OVER - EACH HAS AN UPDATE AND A DRAW.
5 REM THE SKY IS A COLUMN DOWN THE MIDDLE; THE PANELS EITHER SIDE KEEP THE SCORE.
10 REM --- SETUP ---
15 SKY_X=140:SKY_W=360
20 PLANE_W=50:PLANE_H=44
25 ENEMY_W=46:ENEMY_H=39
30 SPEED=190:ACCEL=1950:BRAKE=2550
35 SHOT_SPEED=315:ENEMY_SHOT_SPEED=154
40 HEALTH_MAX=5:GRACE_TIME=1.15
45 SHOTS=64:ENEMIES=10:ENEMY_SHOTS=24
50 LAST_LEVEL=7:SEA_SPEED=70
55 LOAD_WEAPONS
60 LOAD_BOSSES
65 PANEL$="#0B1630":EDGE$="#2B4A80"
80 PLAY_MUSIC "RAIDER_MAIN"
85 STATE$="TITLE"
90 LAST_TIME=TIME()
100 REM --- MAIN LOOP - UPDATE THE SCREEN WE ARE ON, THEN DRAW IT ---
110 NOW=TIME()
111 DT=CLAMP(NOW-LAST_TIME,0.0001,0.05)
112 LAST_TIME=NOW
120 READ_KEYS
130 IF STATE$="TITLE" THEN
131   UPDATE_TITLE
132 ELSEIF STATE$="PLAY" THEN
133   UPDATE_PLAY
134 ELSEIF STATE$="DEAD" THEN
135   UPDATE_DEAD
136 ELSE
137   UPDATE_OVER
138 END IF
150 IF STATE$="TITLE" THEN
151   DRAW_TITLE
152 ELSEIF STATE$="OVER" THEN
153   DRAW_OVER
154 ELSE
155   DRAW_PLAY
156 END IF
170 WAIT 0
180 GOTO 110
1000 REM --- TITLE ---
1010 SUB UPDATE_TITLE
1020   IF FIRE THEN START_GAME
1030 END SUB
1100 SUB DRAW_TITLE
1110   CLEAR(PANEL$)
1120   DRAW_TEXTURE("/TAPE/GFX/RAIDER/TITLE_BACKDROP.PNG",SKY_X,0,SKY_W,400)
1130   DRAW_TEXT("RAIDER",320,90,5,COLOR(0.38,0.72,1),"CENTER",COLOR(0.015,0.045,0.12))
1140   DRAW_TEXTURE("/TAPE/GFX/RAIDER/PLAYER_PLANE.PNG",270,150,99,87)
1150   DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE TO START","PRESS FIRE TO START","TAP TO START"),320,276,2,"BLIP_WHITE","CENTER","BLIP_BLACK")
1160   DRAW_PANELS
1170   DRAW_TEXT("FLY",70,120,2,"BLIP_GRAY","CENTER")
1180   DRAW_TEXT(CONTROL_TEXT$("ARROWS","STICK","DRAG"),70,144,2,"BLIP_WHITE","CENTER")
1190   DRAW_TEXT("FIRE",570,120,2,"BLIP_GRAY","CENTER")
1200   DRAW_TEXT(CONTROL_TEXT$("SPACE","BUTTON","TAP"),570,144,2,"BLIP_WHITE","CENTER")
1210 END SUB
2000 REM --- START - A NEW GAME, A NEW LIFE ---
2010 SUB START_GAME
2020   SCORE=0:LIVES=3
2030   LEVEL=1:KILLS=0
2040   WEAPON=1
2050   WON=0
2060   CLEAR_SKY
2070   SPAWN_WAIT=1.5
2080   SCROLL=0
2090   FX_CLEAR()
2100   NEW_PLANE
2110   PLAY_MUSIC "RAIDER_ALT"
2120   STATE$="PLAY"
2130 END SUB
2200 SUB NEW_PLANE
2210   PLANE_X=SKY_X+SKY_W/2-PLANE_W/2
2220   PLANE_Y=330
2230   PLANE_VX=0:PLANE_VY=0
2240   HEALTH=HEALTH_MAX
2250   GRACE=2
2260   FIRE_WAIT=0
2270 END SUB
2300 SUB CLEAR_SKY
2310   LOCAL I
2320   FOR I=1 TO SHOTS:SHOT(I)=0:NEXT I
2330   FOR I=1 TO ENEMIES:ENEMY(I)=0:NEXT I
2340   FOR I=1 TO ENEMY_SHOTS:ENEMY_SHOT(I)=0:NEXT I
2350   BOSS_ON=0:CAPSULE_ON=0:HEALTH_ON=0
2360 END SUB
3000 REM --- PLAY ---
3010 SUB UPDATE_PLAY
3020   FX_UPDATE(DT)
3030   SCROLL=SCROLL+SEA_SPEED*DT
3040   GRACE=MAX(0,GRACE-DT)
3050   BANNER_LEFT=MAX(0,BANNER_LEFT-DT)
3060   FLY_PLANE
3070   MOVE_SHOTS
3080   SEND_FLIGHTS
3090   MOVE_ENEMIES
3100   IF BOSS_ON THEN UPDATE_BOSS
3110   MOVE_ENEMY_SHOTS
3120   MOVE_PICKUPS
3130 END SUB
3200 REM THE PLANE SPEEDS UP TOWARD WHERE THE STICK POINTS, AND BRAKES HARDER THAN IT ACCELERATES
3210 SUB FLY_PLANE
3220   PLANE_VX=FNTOWARD(PLANE_VX,STICK_X*SPEED,FNRATE(STICK_X))
3230   PLANE_VY=FNTOWARD(PLANE_VY,STICK_Y*SPEED,FNRATE(STICK_Y))
3240   PLANE_X=CLAMP(PLANE_X+PLANE_VX*DT,SKY_X,SKY_X+SKY_W-PLANE_W)
3250   PLANE_Y=CLAMP(PLANE_Y+PLANE_VY*DT,140,400-PLANE_H-8)
3260   FIRE_WAIT=FIRE_WAIT-DT
3270   IF SHOOT AND FIRE_WAIT<=0 THEN FIRE_VOLLEY
3280 END SUB
3290 DEF FNTOWARD(V,TARGET,STEP)=V+CLAMP(TARGET-V,-STEP,STEP)
3295 DEF FNRATE(STICK)=(ACCEL*ABS(STICK)+BRAKE*(STICK=0))*DT
3300 REM EACH GUN TIER FIRES MORE ROUNDS, SIDE BY SIDE, A LITTLE FASTER
3310 SUB FIRE_VOLLEY
3320   LOCAL G,I
3330   FOR G=1 TO GUNS(WEAPON)
3340     FOR I=1 TO SHOTS
3350       IF NOT SHOT(I) THEN EXIT FOR
3360     NEXT I
3370     IF I<=SHOTS THEN
3380       SHOT(I)=1
3390       SHOT_X(I)=PLANE_X+PLANE_W/2+(G-(GUNS(WEAPON)+1)/2)*6
3400       SHOT_Y(I)=PLANE_Y
3410     END IF
3420   NEXT G
3430   FIRE_WAIT=0.17-0.01*WEAPON
3440   PLAY_SFX "RAIDER/BURST"+STR$(WEAPON)+"_1"
3450 END SUB
3500 SUB MOVE_SHOTS
3510   LOCAL I
3520   FOR I=1 TO SHOTS
3530     IF SHOT(I) THEN
3540       SHOT_Y(I)=SHOT_Y(I)-SHOT_SPEED*DT
3550       IF SHOT_Y(I)<-10 THEN SHOT(I)=0 ELSE SHOT_HITS I
3560     END IF
3570   NEXT I
3580 END SUB
3600 REM A ROUND STOPS AT THE FIRST THING IT MEETS
3610 SUB SHOT_HITS(I)
3620   LOCAL E
3630   IF BOSS_ON AND BOSS_IN AND FNINSIDE(SHOT_X(I),SHOT_Y(I),BOSS_X,BOSS_Y,BOSS_W,BOSS_H) THEN
3640     SHOT(I)=0
3650     HIT_BOSS
3660     EXIT SUB
3670   END IF
3680   FOR E=1 TO ENEMIES
3690     IF ENEMY(E) AND FNINSIDE(SHOT_X(I),SHOT_Y(I),ENEMY_X(E),ENEMY_Y(E),ENEMY_W,ENEMY_H) THEN
3700       SHOT(I)=0
3710       SHOOT_DOWN E
3720       EXIT SUB
3730     END IF
3740   NEXT E
3750 END SUB
4000 REM --- ENEMIES - THEY COME IN PAIRS, A GRUNT, A WEAVER OR AN ACE ---
4010 REM ENEMY(E) IS 0 FOR A FREE SLOT, ELSE ITS TYPE: 1 GRUNT, 2 WEAVER, 3 ACE
4020 SUB SEND_FLIGHTS
4030   LOCAL MIDDLE,KIND,DRIFT,SIDE
4040   IF BOSS_ON THEN EXIT SUB
4050   IF KILLS>=60+15*(LEVEL-1) THEN START_BOSS:EXIT SUB
4060   SPAWN_WAIT=SPAWN_WAIT-DT
4070   IF SPAWN_WAIT>0 THEN EXIT SUB
4080   SPAWN_WAIT=MAX(0.7,1.4-LEVEL*0.08)
4090   MIDDLE=SKY_X+60+RND(SKY_W-120)
4100   KIND=INT(RND(3))+1
4110   IF RND(2)<1 THEN DRIFT=-1 ELSE DRIFT=1
4120   FOR SIDE=-1 TO 1 STEP 2
4130     SPAWN_ENEMY KIND,MIDDLE+SIDE*34-ENEMY_W/2,-ENEMY_H+SIDE*12,DRIFT
4140   NEXT SIDE
4150 END SUB
4200 SUB SPAWN_ENEMY(KIND,X,Y,DRIFT)
4210   LOCAL E
4220   FOR E=1 TO ENEMIES
4230     IF NOT ENEMY(E) THEN EXIT FOR
4240   NEXT E
4250   IF E>ENEMIES THEN EXIT SUB
4260   ENEMY(E)=KIND
4270   ENEMY_X(E)=X:ENEMY_Y(E)=Y
4280   ENEMY_DRIFT(E)=DRIFT
4290   ENEMY_FIRE(E)=0.8+RND(0.9)
4300 END SUB
4400 SUB MOVE_ENEMIES
4410   LOCAL E
4420   FOR E=1 TO ENEMIES
4430     IF ENEMY(E) THEN MOVE_ENEMY E
4440   NEXT E
4450 END SUB
4500 REM GRUNTS SLIDE ACROSS, WEAVERS SWING, ACES TURN TOWARD THE PLANE
4510 SUB MOVE_ENEMY(E)
4520   ENEMY_Y(E)=ENEMY_Y(E)+110*DT
4530   IF ENEMY(E)=1 THEN ENEMY_X(E)=ENEMY_X(E)+ENEMY_DRIFT(E)*42*DT
4540   IF ENEMY(E)=2 THEN ENEMY_X(E)=ENEMY_X(E)+SIN(ENEMY_Y(E)*0.03+E)*90*DT
4550   IF ENEMY(E)=3 THEN ENEMY_X(E)=ENEMY_X(E)+CLAMP(PLANE_X-ENEMY_X(E),-51*DT,51*DT)
4560   IF ENEMY_X(E)<SKY_X OR ENEMY_X(E)>SKY_X+SKY_W-ENEMY_W THEN ENEMY_DRIFT(E)=-ENEMY_DRIFT(E)
4570   ENEMY_X(E)=CLAMP(ENEMY_X(E),SKY_X,SKY_X+SKY_W-ENEMY_W)
4580   ENEMY_FIRE(E)=ENEMY_FIRE(E)-DT
4590   IF ENEMY_FIRE(E)<=0 AND ENEMY_Y(E)>0 THEN ENEMY_FIRES E
4600   IF FNTOUCHES_PLANE(ENEMY_X(E),ENEMY_Y(E),ENEMY_W,ENEMY_H) THEN HURT_PLANE
4610   IF ENEMY_Y(E)>400 THEN ENEMY(E)=0
4620 END SUB
4700 REM ONE ROUND, AIMED AT THE PLANE, EVERY SECOND OR TWO
4710 SUB ENEMY_FIRES(E)
4720   ENEMY_FIRE(E)=1.1+RND(0.8)
4730   AIM_SHOT ENEMY_X(E)+ENEMY_W/2,ENEMY_Y(E)+ENEMY_H*0.7,0
4740   PLAY_SFX "RAIDER/ENEMY_GUN"
4750 END SUB
4800 REM POINTS, THE KILL COUNT TOWARD THE BOSS, AND SOMETIMES SOMETHING TO PICK UP
4810 SUB SHOOT_DOWN(E)
4820   SCORE=SCORE+60+ENEMY(E)*20
4830   KILLS=KILLS+1
4840   FX_BURST(ENEMY_X(E)+ENEMY_W/2,ENEMY_Y(E)+ENEMY_H/2,14,90,"#FFB040")
4850   PLAY_SFX "RAIDER/ENEMY_EXPLODE0"
4860   IF ENEMY(E)=3 AND NOT CAPSULE_ON THEN
4870     CAPSULE_ON=1
4880     CAPSULE_X=ENEMY_X(E)+ENEMY_W/2-7
4885     CAPSULE_Y=ENEMY_Y(E)+ENEMY_H/2
4890   ELSEIF RND(1)<0.06 AND NOT HEALTH_ON THEN
4900     HEALTH_ON=1
4910     HEALTH_X=ENEMY_X(E)+ENEMY_W/2-7
4915     HEALTH_Y=ENEMY_Y(E)+ENEMY_H/2
4920   END IF
4930   ENEMY(E)=0
4940 END SUB
5000 REM --- ENEMY ROUNDS ---
5010 REM A ROUND FROM X,Y AT THE PLANE, TURNED BY TURN RADIANS
5020 SUB AIM_SHOT(X,Y,TURN)
5030   LOCAL Q,AIM
5040   FOR Q=1 TO ENEMY_SHOTS
5050     IF NOT ENEMY_SHOT(Q) THEN EXIT FOR
5060   NEXT Q
5070   IF Q>ENEMY_SHOTS THEN EXIT SUB
5080   AIM=ATAN2(PLANE_Y+PLANE_H/2-Y,PLANE_X+PLANE_W/2-X)+TURN
5090   ENEMY_SHOT(Q)=1
5100   ROUND_X(Q)=X:ROUND_Y(Q)=Y
5110   ROUND_VX(Q)=COS(AIM)*ENEMY_SHOT_SPEED
5120   ROUND_VY(Q)=SIN(AIM)*ENEMY_SHOT_SPEED
5130 END SUB
5200 SUB MOVE_ENEMY_SHOTS
5210   LOCAL Q
5220   FOR Q=1 TO ENEMY_SHOTS
5230     IF ENEMY_SHOT(Q) THEN
5240       ROUND_X(Q)=ROUND_X(Q)+ROUND_VX(Q)*DT
5250       ROUND_Y(Q)=ROUND_Y(Q)+ROUND_VY(Q)*DT
5260       IF ROUND_Y(Q)>410 OR ROUND_Y(Q)<-10 OR ROUND_X(Q)<SKY_X OR ROUND_X(Q)>SKY_X+SKY_W THEN ENEMY_SHOT(Q)=0
5270       IF FNTOUCHES_PLANE(ROUND_X(Q)-2,ROUND_Y(Q)-2,4,4) THEN
5280         ENEMY_SHOT(Q)=0
5290         HURT_PLANE
5300       END IF
5310     END IF
5320   NEXT Q
5330 END SUB
5400 REM THE PLANE IS HIT ONLY IN ITS MIDDLE, NOT ITS WINGTIPS
5410 DEF FNTOUCHES_PLANE(X,Y,W,H)=RECTS_OVERLAP(X,Y,W,H,PLANE_X+11,PLANE_Y+9,PLANE_W-22,PLANE_H-18)
5420 DEF FNINSIDE(PX,PY,X,Y,W,H)=PX>X AND PX<X+W AND PY>Y AND PY<Y+H
6000 REM --- THE BOSS - IT COMES AFTER ENOUGH KILLS, AND GUARDS THE NEXT LEVEL ---
6010 SUB START_BOSS
6020   BOSS_ON=1:BOSS_IN=0
6030   BOSS_W=BOSS_WIDE(LEVEL):BOSS_H=BOSS_TALL(LEVEL)
6040   BOSS_X=SKY_X+SKY_W/2-BOSS_W/2
6045   BOSS_Y=-BOSS_H
6050   BOSS_HP=24+LEVEL*6:BOSS_MAX=BOSS_HP
6060   BOSS_IMAGE$="/TAPE/GFX/RAIDER/BOSS_"+STR$(LEVEL)+".PNG"
6070   BOSS_WARNING=1.3
6080   BOSS_FIRE=1.2
6090   BOSS_TIME=0
6100   PLAY_SFX "RAIDER/BOSS_WARNING"
6110 END SUB
6200 REM A WARNING, THEN IT FLIES IN AND WEAVES ACROSS THE TOP, FIRING THREE ROUNDS AT A TIME
6210 SUB UPDATE_BOSS
6220   LOCAL F
6230   IF BOSS_WARNING>0 THEN BOSS_WARNING=BOSS_WARNING-DT:EXIT SUB
6240   IF BOSS_Y<24 THEN
6250     BOSS_Y=BOSS_Y+60*DT
6260     EXIT SUB
6270   END IF
6280   BOSS_IN=1
6290   BOSS_TIME=BOSS_TIME+DT
6300   BOSS_X=SKY_X+(SKY_W-BOSS_W)/2+SIN(BOSS_TIME*0.45)*(SKY_W-BOSS_W)/2
6310   BOSS_Y=24+ABS(SIN(BOSS_TIME*0.5))*10
6320   IF FNTOUCHES_PLANE(BOSS_X+BOSS_W*0.2,BOSS_Y+BOSS_H*0.15,BOSS_W*0.6,BOSS_H*0.7) THEN HURT_PLANE
6330   BOSS_FIRE=BOSS_FIRE-DT
6340   IF BOSS_FIRE<=0 THEN
6350     BOSS_FIRE=0.8
6360     FOR F=-1 TO 1
6370       AIM_SHOT BOSS_X+BOSS_W/2,BOSS_Y+BOSS_H,F*0.22
6380     NEXT F
6390     PLAY_SFX "RAIDER/ENEMY_GUN"
6400   END IF
6410 END SUB
6500 SUB HIT_BOSS
6510   BOSS_HP=BOSS_HP-1
6520   PLAY_SFX "RAIDER/ENEMY_EXPLODE0"
6530   IF BOSS_HP>0 THEN EXIT SUB
6540   BOSS_ON=0
6550   SCORE=SCORE+500*LEVEL
6560   FX_BURST(BOSS_X+BOSS_W/2,BOSS_Y+BOSS_H/2,40,160,"#FFB040")
6570   PLAY_SFX "RAIDER/STAGE_CLEAR"
6580   IF LEVEL=LAST_LEVEL THEN
6590     WON=1
6600     STATE$="OVER"
6610     WAIT_LEFT=2
6620   ELSE
6630     LEVEL=LEVEL+1
6640     KILLS=0
6650     SPAWN_WAIT=2
6660     BANNER$="BOSS DOWN"
6670     BANNER_LEFT=2
6680   END IF
6690 END SUB
7000 REM --- PICKUPS - AN ACE'S CAPSULE RAISES THE GUN; A RED CROSS MENDS TWO HITS ---
7010 SUB MOVE_PICKUPS
7020   IF CAPSULE_ON THEN
7030     CAPSULE_Y=CAPSULE_Y+68*DT
7040     IF CAPSULE_Y>400 THEN CAPSULE_ON=0
7050     IF FNTOUCHES_PLANE(CAPSULE_X,CAPSULE_Y,14,14) THEN CAPSULE_ON=0:UPGRADE_GUN
7060   END IF
7070   IF HEALTH_ON THEN
7080     HEALTH_Y=HEALTH_Y+68*DT
7090     IF HEALTH_Y>400 THEN HEALTH_ON=0
7100     IF FNTOUCHES_PLANE(HEALTH_X,HEALTH_Y,14,14) THEN HEALTH_ON=0:HEALTH=MIN(HEALTH_MAX,HEALTH+2)
7110   END IF
7120 END SUB
7200 SUB UPGRADE_GUN
7210   WEAPON=MIN(WEAPON+1,5)
7220   SCORE=SCORE+30*WEAPON
7230   IF WEAPON=5 THEN
7240     PLAY_SFX "RAIDER/MAX_POWER"
7250     BANNER$="MAX POWER"
7260     BANNER_LEFT=2
7270   ELSE
7280     PLAY_SFX "RAIDER/POWERUP"+STR$(WEAPON)
7290   END IF
7300 END SUB
7400 REM --- HURT - FIVE HITS TO A PLANE; EACH COSTS A GUN TIER, DOWN TO TWO ---
7410 SUB HURT_PLANE
7420   IF GRACE>0 OR STATE$<>"PLAY" THEN EXIT SUB
7430   HEALTH=HEALTH-1
7440   IF HEALTH>0 THEN
7450     IF WEAPON>2 THEN WEAPON=WEAPON-1
7460     PLAY_SFX "RAIDER/PLAYER_HIT"
7470     GRACE=GRACE_TIME
7480     EXIT SUB
7490   END IF
7500   FX_BURST(PLANE_X+PLANE_W/2,PLANE_Y+PLANE_H/2,30,140,"#FF7040")
7510   PLAY_SFX "RAIDER/PLAYER_EXPLODE0"
7520   LIVES=LIVES-1
7530   IF LIVES>0 THEN
7540     STATE$="DEAD"
7550     WAIT_LEFT=1.5
7560   ELSE
7570     PLAY_SFX "RAIDER/GAME_OVER"
7580     STATE$="OVER"
7590     WAIT_LEFT=2
7600   END IF
7610 END SUB
8000 REM --- DEAD - THE SKY GOES ON A MOMENT WITHOUT THE PLANE ---
8010 SUB UPDATE_DEAD
8020   FX_UPDATE(DT)
8030   SCROLL=SCROLL+SEA_SPEED*DT
8040   MOVE_ENEMIES
8050   MOVE_ENEMY_SHOTS
8060   WAIT_LEFT=WAIT_LEFT-DT
8070   IF WAIT_LEFT<=0 THEN
8080     NEW_PLANE
8090     STATE$="PLAY"
8100   END IF
8110 END SUB
8200 REM --- DRAWING - THE SEA, THEN EVERYTHING ABOVE IT, THEN THE PANELS ---
8210 SUB DRAW_PLAY
8220   DRAW_SEA
8230   DRAW_PICKUPS
8240   DRAW_ENEMIES
8250   IF BOSS_ON AND BOSS_WARNING<=0 THEN DRAW_BOSS
8260   DRAW_ROUNDS
8270   IF STATE$="PLAY" AND (GRACE=0 OR INT(GRACE*10) MOD 2=0) THEN DRAW_TEXTURE("/TAPE/GFX/RAIDER/PLAYER_PLANE.PNG",PLANE_X,PLANE_Y,PLANE_W,PLANE_H)
8280   DRAW_CLOUDS
8290   FX_DRAW()
8300   DRAW_PANELS
8310   DRAW_SCORES
8320   IF BOSS_ON AND BOSS_WARNING>0 THEN
8330     DRAW_TEXT("WARNING",320,150,4,"BLIP_RED","CENTER","BLIP_BLACK")
8340     DRAW_TEXT(BOSS_NAME$(LEVEL),320,190,2,"BLIP_WHITE","CENTER","BLIP_BLACK")
8350   END IF
8360   IF BANNER_LEFT>0 THEN DRAW_TEXT(BANNER$,320,170,3,"BLIP_YELLOW","CENTER","BLIP_BLACK")
8370 END SUB
8400 REM THE SEA DARKENS AWAY FROM THE SUN; ITS SWELL AND ISLANDS SLIDE PAST
8410 SUB DRAW_SEA
8420   LOCAL ROW,Y
8430   FOR ROW=0 TO 9
8440     FILL_RECT(SKY_X,ROW*40,SKY_W,41,COLOR(0.06+ROW*0.004,0.17+ROW*0.006,0.36+ROW*0.008))
8450   NEXT ROW
8460   FOR ROW=0 TO 9
8470     Y=(ROW*40+SCROLL) MOD 400
8480     DRAW_LINE(SKY_X,Y,SKY_X+SKY_W,Y+3,"#5C7FB040")
8490   NEXT ROW
8500   DRAW_TEXTURE("/TAPE/GFX/RAIDER/ISLAND_SMALL.PNG",SKY_X+250,FNSCENERY_Y(40,1),48,33)
8510   DRAW_TEXTURE("/TAPE/GFX/RAIDER/ISLAND_LARGE.PNG",SKY_X+20,FNSCENERY_Y(260,1),105,72)
8520 END SUB
8600 SUB DRAW_CLOUDS
8605   REM CLOUDS ARE NEARER THAN THE SEA, SO THEY PASS FASTER
8610   DRAW_TEXTURE("/TAPE/GFX/RAIDER/CLOUD_1.PNG",SKY_X+40,FNSCENERY_Y(10,1.4),60,39)
8620   DRAW_TEXTURE("/TAPE/GFX/RAIDER/CLOUD_2.PNG",SKY_X+230,FNSCENERY_Y(200,1.4),72,40)
8630 END SUB
8640 REM SCENERY SCROLLS PAST AT PACE TIMES THE SEA AND COMES ROUND AGAIN FROM ABOVE
8650 DEF FNSCENERY_Y(START,PACE)=(START+SCROLL*PACE) MOD 480-80
8700 SUB DRAW_PICKUPS
8710   IF CAPSULE_ON THEN DRAW_TEXTURE("/TAPE/GFX/RAIDER/POWERUP.PNG",CAPSULE_X,CAPSULE_Y,14,14,GUN_COLOR$(MIN(WEAPON+1,5)))
8720   IF HEALTH_ON THEN DRAW_TEXTURE("/TAPE/GFX/RAIDER/HEALTH_PACK.PNG",HEALTH_X,HEALTH_Y,14,14)
8730 END SUB
8800 SUB DRAW_ENEMIES
8810   LOCAL E
8820   FOR E=1 TO ENEMIES
8830     IF ENEMY(E) THEN DRAW_TEXTURE(ENEMY_IMAGE$(ENEMY(E)),ENEMY_X(E),ENEMY_Y(E),ENEMY_W,ENEMY_H)
8840   NEXT E
8850 END SUB
8900 SUB DRAW_BOSS
8910   DRAW_TEXTURE(BOSS_IMAGE$,BOSS_X,BOSS_Y,BOSS_W,BOSS_H)
8920   DRAW_RECT(BOSS_X,BOSS_Y-8,BOSS_W,5,"BLIP_GRAY")
8930   FILL_RECT(BOSS_X,BOSS_Y-8,BOSS_W*BOSS_HP/BOSS_MAX,5,"BLIP_RED")
8940 END SUB
9000 SUB DRAW_ROUNDS
9010   LOCAL I
9020   FOR I=1 TO SHOTS
9030     IF SHOT(I) THEN FILL_RECT(SHOT_X(I)-1,SHOT_Y(I),3,9,GUN_COLOR$(WEAPON))
9040   NEXT I
9050   FOR I=1 TO ENEMY_SHOTS
9060     IF ENEMY_SHOT(I) THEN FILL_CIRCLE(ROUND_X(I),ROUND_Y(I),3,"#FF755C")
9070   NEXT I
9080 END SUB
9100 REM THE PANELS EITHER SIDE OF THE SKY
9110 SUB DRAW_PANELS
9120   FILL_RECT(0,0,SKY_X,400,PANEL$)
9130   FILL_RECT(SKY_X+SKY_W,0,640-SKY_X-SKY_W,400,PANEL$)
9140   FILL_RECT(SKY_X-3,0,3,400,EDGE$)
9150   FILL_RECT(SKY_X+SKY_W,0,3,400,EDGE$)
9160 END SUB
9200 SUB DRAW_SCORES
9210   LOCAL I
9220   DRAW_TEXT("SCORE",70,28,2,"BLIP_GRAY","CENTER")
9230   DRAW_TEXT(STR$(SCORE),70,50,3,"BLIP_YELLOW","CENTER")
9240   DRAW_TEXT("LEVEL",70,110,2,"BLIP_GRAY","CENTER")
9250   DRAW_TEXT(STR$(LEVEL)+" OF "+STR$(LAST_LEVEL),70,132,2,"BLIP_WHITE","CENTER")
9260   DRAW_TEXT("LIVES",570,28,2,"BLIP_GRAY","CENTER")
9270   FOR I=1 TO MIN(LIVES,3)
9280     DRAW_TEXTURE("/TAPE/GFX/RAIDER/PLAYER_PLANE.PNG",516+(I-1)*36,48,30,26)
9290   NEXT I
9295   IF LIVES>3 THEN DRAW_TEXT("X"+STR$(LIVES),570,80,2,"BLIP_WHITE","CENTER")
9300   DRAW_TEXT("HEALTH",570,110,2,"BLIP_GRAY","CENTER")
9310   FOR I=1 TO HEALTH_MAX
9320     IF I<=HEALTH THEN FILL_RECT(520+(I-1)*20,132,16,10,"#4CD964") ELSE DRAW_RECT(520+(I-1)*20,132,16,10,"#2E5E3A")
9330   NEXT I
9340   DRAW_TEXT("GUNS",570,190,2,"BLIP_GRAY","CENTER")
9350   FOR I=1 TO 5
9360     IF I<=WEAPON THEN FILL_CIRCLE(530+(I-1)*10,214,4,GUN_COLOR$(WEAPON)) ELSE FILL_CIRCLE(530+(I-1)*10,214,2,EDGE$)
9370   NEXT I
9380 END SUB
9400 REM --- OVER - THE MISSION'S RESULT; FIRE AGAIN AFTER TWO SECONDS ---
9410 SUB UPDATE_OVER
9420   WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
9430   IF WAIT_LEFT=0 AND FIRE THEN START_GAME
9440 END SUB
9500 SUB DRAW_OVER
9510   CLEAR(PANEL$)
9520   IF WON THEN DRAW_TEXT("MISSION COMPLETE",320,110,4,"BLIP_CYAN","CENTER") ELSE DRAW_TEXT("MISSION ENDED",320,110,4,"BLIP_RED","CENTER")
9530   DRAW_TEXT("FINAL SCORE",320,180,2,"BLIP_GRAY","CENTER")
9540   DRAW_TEXT(STR$(SCORE),320,204,3,"BLIP_YELLOW","CENTER")
9550   DRAW_TEXT("LEVEL "+STR$(LEVEL),320,240,2,"BLIP_WHITE","CENTER")
9560   IF WAIT_LEFT=0 THEN DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE TO FLY AGAIN","PRESS FIRE TO FLY AGAIN","TAP TO FLY AGAIN"),320,300,2,"BLIP_WHITE","CENTER")
9570 END SUB
9600 REM --- KEYS AND TABLES ---
9610 SUB READ_KEYS
9620   STICK_X=(KEY_ACTIVE("RIGHT") OR KEY_ACTIVE("D"))-(KEY_ACTIVE("LEFT") OR KEY_ACTIVE("A"))
9630   STICK_Y=(KEY_ACTIVE("DOWN") OR KEY_ACTIVE("S"))-(KEY_ACTIVE("UP") OR KEY_ACTIVE("W"))
9640   SHOOT=KEY_ACTIVE("SPACE")
9650   FIRE=KEY_PRESSED("SPACE") OR KEY_PRESSED("ENTER")
9660 END SUB
9700 REM EACH GUN TIER: ROUNDS PER VOLLEY AND THEIR COLOUR
9710 SUB LOAD_WEAPONS
9720   LOCAL W
9730   RESTORE 9790
9740   FOR W=1 TO 5
9750     READ GUNS(W),GUN_COLOR$(W)
9760   NEXT W
9770   RESTORE 9795
9780   FOR W=1 TO 3:READ ENEMY_IMAGE$(W):NEXT W
9785 END SUB
9790 DATA 2,"BLIP_YELLOW", 3,"BLIP_YELLOW", 5,"BLIP_CYAN", 6,"BLIP_ORANGE", 8,"#FFDA40"
9795 DATA "/TAPE/GFX/RAIDER/ENEMY_GRUNT.PNG", "/TAPE/GFX/RAIDER/ENEMY_WEAVER.PNG", "/TAPE/GFX/RAIDER/ENEMY_ACE.PNG"
9800 REM EACH LEVEL'S BOSS: ITS NAME AND ITS SIZE IN THE SKY
9810 SUB LOAD_BOSSES
9820   LOCAL L
9830   RESTORE 9890
9840   FOR L=1 TO LAST_LEVEL
9850     READ BOSS_NAME$(L),BOSS_WIDE(L),BOSS_TALL(L)
9860   NEXT L
9870 END SUB
9890 DATA "KI-49 DONRYU",72,57, "KI-67 HIRYU",78,63, "G4M BETTY",87,69, "G8N RENZAN",112,80
9891 DATA "H8K EMILY",123,92, "G5N SHINZAN",137,100, "FUGAKU",144,114
