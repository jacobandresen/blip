1 REM FLOW: ASSETS 20 -> TITLE 1600 -> LEVEL 1000 -> PLAY 170.
2 REM MODULES: BRICK HITS 330; PICKUPS 1410; EXTRA BALLS 1800/2000.
3 REM STATE: B(C,R) IS THE BRICK GRID; DA/DX/DY/DK HOLD PICKUPS.
5 REM GAME: BOUNCER
10 REM BOUNCER - TITLE 1600 / PLAY 170 / LEVEL SETUP 1000
20 T$(0)="BRICK_RED"
30 T$(1)="BRICK_ORANGE"
40 T$(2)="BRICK_YELLOW"
50 T$(3)="BRICK_GREEN"
60 T$(4)="BRICK_BLUE"
70 T$(5)="BRICK_PURPLE"
75 D$(0)="DROP_WIDE":D$(1)="DROP_NARROW":D$(2)="DROP_SLOW":D$(3)="DROP_LIFE":D$(4)="DROP_MULTI"
80 LV=1:SC=0:L=3:BTX=154:BD=1:PLAY_MUSIC "BOUNCER_TITLE":GOSUB 1600
90 GOSUB 1000
100 WAIT 250
110 GOTO 160
159 REM --- NEW LIFE - RESET PADDLE, BALLS, AND SERVE ---
160 CLS:PW=60:PX=130:PPX=130:BX=160:BY=169:VX=1.6:VY=-2.7:SPIN=0:CURVE=0:HITPAD=0:T=0:ROT=0:REST=0:CHAIN=0:SERVE=1:EXTRA=0:EXTRA2=0:FT=0:POPT=0:LTAP=0:RTAP=0:DASH=0:DT=0:QUIET=0
169 REM --- PLAY LOOP - HUD, TIMERS, AND FALLING PICKUPS ---
170 CANVAS(320,200):CLEAR("BLIP_BLACK")
180 DRAW_HUD(SC,L)
185 IF PWE>0 THEN PWE=PWE-1:IF PWE=0 THEN PW=60
186 IF SLE>0 THEN SLE=SLE-1:IF SLE=0 THEN SV=1
187 GOSUB 1410
188 IF PWE>0 AND PW>60 THEN DRAW_TEXT("WIDE "+STR$(INT(PWE/60)),160,168,1,"BLIP_GREEN","CENTER")
189 IF PWE>0 AND PW<60 THEN DRAW_TEXT("NARROW "+STR$(INT(PWE/60)),160,168,1,"BLIP_RED","CENTER")
190 IF REST>0 THEN REST=REST-1:GOTO 400
192 IF SLE>0 THEN DRAW_TEXT("SLOW "+STR$(INT(SLE/60)),160,168,1,"BLIP_CYAN","CENTER")
194 REM --- INPUT - STEERING AND DOUBLE-TAP DASH ---
195 K$=INKEY$
200 IF (KEY_PRESSED("LEFT") OR KEY_PRESSED("A"))=1 AND LTAP>0 THEN DASH=-1:DT=21
201 IF (KEY_PRESSED("LEFT") OR KEY_PRESSED("A"))=1 AND LTAP<=0 THEN LTAP=17
202 IF (KEY_PRESSED("RIGHT") OR KEY_PRESSED("D"))=1 AND RTAP>0 THEN DASH=1:DT=21
203 IF (KEY_PRESSED("RIGHT") OR KEY_PRESSED("D"))=1 AND RTAP<=0 THEN RTAP=17
204 IF LTAP>0 THEN LTAP=LTAP-1
205 IF RTAP>0 THEN RTAP=RTAP-1
206 IF DT>0 THEN DT=DT-1:IF DT=0 THEN DASH=0
207 SPEED=3
208 IF DT>0 THEN SPEED=3+2.7*DT/21
209 IF (KEY_ACTIVE("LEFT") OR KEY_ACTIVE("A")) THEN PX=PX-SPEED
210 IF (KEY_ACTIVE("RIGHT") OR KEY_ACTIVE("D")) THEN PX=PX+SPEED
220 IF PX<6 THEN PX=6
230 IF PX>314-PW THEN PX=314-PW
235 PVEL=PX-PPX:PPX=PX
236 IF SERVE=1 THEN BX=PX+(PW-12)/2:BY=169
237 IF SERVE=1 AND K$<>" " THEN GOTO 400
238 IF SERVE=1 THEN SERVE=0:DIR=1-2*INT(RND(2)):VX=DIR*(1.9+RND(0.5)):VY=-2.55:SPIN=0:CURVE=0:PLAY_MUSIC "BOUNCER_GAME"
239 QUIET=QUIET+0.016:SEEKX=BX:SEEKY=BY:SEEKVX=VX:SEEKVY=VY:GOSUB 2400:VX=SEEKVX:VY=SEEKVY:MAIN_SEEK_C=SEEK_C:MAIN_SEEK_R=SEEK_R:GOSUB 2220:GOSUB 2300
240 BX=BX+VX*SV
250 BY=BY+VY*SV
260 IF BX<6 THEN BX=6:VX=ABS(VX):PLAY_SFX "WALL_HIT"
270 IF BX>314 THEN BX=314:VX=-ABS(VX):PLAY_SFX "WALL_HIT"
280 IF BY<23 THEN BY=23:VY=ABS(VY):PLAY_SFX "WALL_HIT"
290 LOST=0
291 IF BY>205 AND EXTRA=1 THEN BX=BX2:BY=BY2:VX=VX2:VY=VY2:SPIN=0:CURVE=0:EXTRA=0:GOTO 300
292 IF BY>205 AND EXTRA=0 AND EXTRA2=1 THEN BX=BX3:BY=BY3:VX=VX3:VY=VY3:SPIN=0:CURVE=0:EXTRA2=0:GOTO 300
293 IF BY>205 AND EXTRA=0 AND EXTRA2=0 THEN LOST=1
294 IF LOST=1 THEN L=L-1:CHAIN=0:EXTRA=0:EXTRA2=0:DASH=0:DT=0:LTAP=0:RTAP=0:SPIN=0:CURVE=0:PLAY_SFX "LIFE_LOST":BX=PX+(PW-12)/2:BY=169:VX=1.6:VY=-2.7:REST=28:SERVE=1
300 IF L<1 THEN GOTO 900
309 HITPAD=0
310 IF BY>168 AND BY<188 AND BX>PX-6 AND BX<PX+PW AND VY>0 THEN HITPAD=1
311 IF HITPAD=1 THEN SP=SQR(VX*VX+VY*VY):INX=VX:REL=(BX-PX)/PW*2-1
312 IF HITPAD=1 AND REL>1 THEN REL=1
313 IF HITPAD=1 AND REL<0-1 THEN REL=0-1
314 IF HITPAD=1 THEN VX=SP*SIN(REL*1.15)+PVEL*0.18
315 IF HITPAD=1 THEN VY=0-ABS(SP*COS(REL*1.15)):MAG=SQR(VX*VX+VY*VY):VX=VX/MAG*SP:VY=VY/MAG*SP
316 IF HITPAD=1 THEN SPIN=0:RELX=(PVEL-INX)*90
317 IF HITPAD=1 AND ABS(RELX)>30 THEN SPIN=RELX/700*1.3
318 IF HITPAD=1 AND ABS(SPIN)>1.3 THEN SPIN=1.3*SPIN/ABS(SPIN)
319 IF HITPAD=1 THEN CURVE=0:CHAIN=0:PLAY_SFX "PADDLE_HIT_"+STR$(INT(RND(3)))
320 R=INT((BY-31)/13)
321 REM --- BRICK COLLISIONS - SCORE, BREAKS, AND PICKUPS ---
330 C=INT((BX-6)/30)
340 IF BY<31 OR BY>110 OR R<0 OR R>5 OR C<0 OR C>9 THEN GOTO 390
350 HIT=0:BT=B(C,R):OLDV=VY
351 IF BT=3 THEN B(C,R)=4:IF OLDV>0 THEN BY=31+R*13-1:VY=-ABS(VY)
352 IF BT=3 AND OLDV<0 THEN BY=31+R*13+12:VY=ABS(VY)
353 IF BT=3 THEN PLAY_SFX "BRICK_HIT_"+STR$(INT(RND(3)))
354 IF BT=1 OR BT=2 OR BT=4 THEN B(C,R)=0:HIT=1:CHAIN=CHAIN+1:CM=CHAIN:IF CM>5 THEN CM=5
360 IF HIT=1 THEN SC=SC+(6-R)*10*LV*CM:LEFT=LEFT-1:QUIET=0
361 IF HIT=1 AND OLDV>0 THEN BY=31+R*13-1:VY=-ABS(VY)
362 IF HIT=1 AND OLDV<0 THEN BY=31+R*13+12:VY=ABS(VY)
363 IF HIT=1 AND ABS(VX)<4 THEN VX=VX*1.03
364 IF HIT=1 THEN FX=BX:FY=BY:FT=12:POP=(6-R)*10*LV*CM:POPT=20
370 IF HIT=1 AND ABS(VY)<4 THEN VY=VY*1.03
380 IF HIT=1 THEN PLAY_SFX "BRICK_BREAK_"+STR$(INT(RND(3))):IF BT=2 THEN GOSUB 1330
385 IF HIT=1 AND RND(100)<30 THEN GOSUB 1540
390 IF EXTRA=1 THEN GOSUB 1800
391 IF EXTRA2=1 THEN GOSUB 2000
392 SEEK_C=MAIN_SEEK_C:SEEK_R=MAIN_SEEK_R
395 IF LEFT=0 THEN GOTO 800
399 REM --- DRAW BRICKS, PADDLE, BALLS, AND EFFECTS ---
400 FOR R=0 TO 5
410 FOR C=0 TO 9
420 IF B(C,R)=1 THEN DRAW_TEXTURE(T$(R),6+C*30,31+R*13,29,11)
430 IF B(C,R)=2 THEN DRAW_TEXTURE("BRICK_BOMB",6+C*30,31+R*13,29,11)
440 IF B(C,R)=3 THEN DRAW_TEXTURE("BRICK_STEEL",6+C*30,31+R*13,29,11)
445 IF B(C,R)=4 THEN DRAW_TEXTURE("BRICK_STEEL_CRACKED",6+C*30,31+R*13,29,11)
450 NEXT C
460 NEXT R
461 IF QUIET>5 AND MAIN_SEEK_C>=0 THEN DRAW_RECT(4+MAIN_SEEK_C*30,29+MAIN_SEEK_R*13,33,15,COLOR(1,0.75+0.2*SIN(T*0.128),0.2))
465 IF FT>0 THEN FILL_SUNBURST(FX,FY,8,ROT,FT,COLOR(1,0.85,0.25),COLOR(1,0.2,0.05)):FT=FT-1
466 IF POPT>0 THEN DRAW_NUMBER(POP,FX,FY-12-(20-POPT),1,"BLIP_YELLOW"):POPT=POPT-1
467 IF SERVE=1 THEN DRAW_TEXT("PRESS SPACE TO LAUNCH",160,153,1,"BLIP_CYAN","CENTER")
468 IF DT>0 THEN FILL_RECT(PX-DASH*6,182,PW,5,COLOR(0.35,0.75,1,0.24))
469 IF DT>0 THEN FILL_RECT(PX-DASH*12,182,PW,5,COLOR(0.35,0.75,1,0.14))
470 DRAW_TEXTURE("PADDLE",PX,180,6,8,0,0,12,24)
480 DRAW_TEXTURE("PADDLE",PX+6,180,PW-12,8,12,0,96,24)
490 DRAW_TEXTURE("PADDLE",PX+PW-6,180,6,8,108,0,12,24)
494 T=T+1:ROT=ROT+0.08
495 F=INT(T/4)-INT(T/48)*12
496 DRAW_TEXTURE("BALL",BX-6,BY-6,12,12,F,12,9,19,ROT)
497 DRAW_TEXTURE("BALL_SHADE",BX-6,BY-6,12,12)
498 IF EXTRA=1 THEN DRAW_TEXTURE("BALL",BX2-6,BY2-6,12,12,F,12,9,19,ROT+0.5):DRAW_TEXTURE("BALL_SHADE",BX2-6,BY2-6,12,12)
499 IF EXTRA2=1 THEN DRAW_TEXTURE("BALL",BX3-6,BY3-6,12,12,F,12,9,19,ROT-0.5):DRAW_TEXTURE("BALL_SHADE",BX3-6,BY3-6,12,12)
500 WAIT 16:GOTO 170
799 REM --- LEVEL CLEAR ---
800 CLS:PLAY_SFX "WIN":WIN_TIME=90
810 CLEAR("BLIP_BLACK")
820 DRAW_TEXT("CLEARED",160,70,3,"BLIP_GREEN","CENTER")
830 DRAW_TEXT("LEVEL "+STR$(LV+1),160,101,2,"BLIP_YELLOW","CENTER")
880 WIN_TIME=WIN_TIME-1
885 IF WIN_TIME>0 THEN WAIT 16:GOTO 810
890 LV=LV+1:GOSUB 1000:CLS:PX=130:PPX=130:BX=160:BY=169:VX=1.6:VY=-2.7:SPIN=0:CURVE=0:HITPAD=0:T=0:ROT=0:REST=0:CHAIN=0:SERVE=1:EXTRA=0:EXTRA2=0:QUIET=0:IF INT(LV/2)*2=LV THEN GOTO 895
891 PLAY_MUSIC "BOUNCER_GAME":GOTO 170
895 PLAY_MUSIC "BOUNCER_ALT":GOTO 170
899 REM --- GAME OVER AND RESTART ---
900 CLS
910 CLEAR("BLIP_BLACK")
920 DRAW_TEXT("GAME OVER",160,75,3,"BLIP_RED","CENTER")
930 DRAW_TEXT("FINAL SCORE",160,108,1,"BLIP_WHITE","CENTER")
940 DRAW_NUMBER(SC,202,108,1,"BLIP_YELLOW")
950 DRAW_TEXT("SPACE TO RESTART",160,151,1,"BLIP_CYAN","CENTER")
960 K$=INKEY$:IF K$<>" " THEN WAIT 16:GOTO 900
970 LV=1:SC=0:L=3:GOSUB 1600:GOSUB 1000:GOTO 100
998 REM B(C,R): 0=EMPTY, 1=NORMAL, 2=BOMB, 3=ARMORED, 4=CRACKED.
999 REM --- LEVEL SETUP - BRICK PATTERN AND TEMPORARY POWERS ---
1000 PW=60:PWE=0:SV=1:SLE=0:EXTRA=0:EXTRA2=0:DASH=0:DT=0:LTAP=0:RTAP=0
1005 FOR I=0 TO 7:DA(I)=0:NEXT I
1010 LEFT=0
1015 PAT=LV-INT((LV-1)/8)*8
1020 NB=0:ST=(LV-3)*5:IF ST>30 THEN ST=30
1030 FOR R=0 TO 5
1040 FOR C=0 TO 9
1050 B(C,R)=1
1060 IF PAT=2 AND INT((R+C)/2)*2<>R+C THEN B(C,R)=0
1070 IF PAT=3 AND ABS(C-4.5)>3 THEN B(C,R)=0
1080 IF PAT=4 AND ABS(C-4.5)>R+1 THEN B(C,R)=0
1090 IF PAT=5 AND C>1 AND C<8 THEN B(C,R)=0
1100 IF PAT=6 AND INT(R/2)*2<>R THEN B(C,R)=0
1110 IF PAT=7 AND R<>0 AND R<>5 AND C<>0 AND C<>9 THEN B(C,R)=0
1120 IF PAT=8 AND ABS(C-R*1.8)>0.8 AND ABS(C-(9-R*1.8))>0.8 THEN B(C,R)=0
1125 IF LV>=2 AND NB<4 AND B(C,R)=1 THEN IF RND(100)<5 THEN B(C,R)=2:NB=NB+1
1130 IF LV>=4 AND B(C,R)=1 THEN IF RND(100)<ST THEN B(C,R)=3
1135 IF B(C,R)>0 THEN LEFT=LEFT+1
1140 NEXT C:NEXT R
1150 RETURN
1329 REM --- BOMB BRICK - BREAK ITS NEIGHBOURS ---
1330 PLAY_SFX "BOMB":BC=C:BR=R
1340 FOR DY=-1 TO 1
1350 FOR DX=-1 TO 1
1360 TC=BC+DX:TR=BR+DY
1370 BOMB_HIT=0:IF TC>=0 AND TC<10 AND TR>=0 AND TR<6 THEN IF B(TC,TR)=1 OR B(TC,TR)=2 OR B(TC,TR)=4 THEN BOMB_HIT=1:B(TC,TR)=0:LEFT=LEFT-1:CHAIN=CHAIN+1:CM=CHAIN
1375 IF BOMB_HIT=1 AND CM>5 THEN CM=5
1377 IF BOMB_HIT=1 THEN SC=SC+(6-TR)*10*LV*CM:QUIET=0:IF RND(100)<30 THEN GOSUB 1540
1380 IF TC>=0 AND TC<10 AND TR>=0 AND TR<6 THEN IF B(TC,TR)=3 THEN B(TC,TR)=4
1390 NEXT DX:NEXT DY
1400 RETURN
1409 REM --- PICKUPS - FALL, COLLIDE WITH PADDLE, OR EXPIRE ---
1410 FOR I=0 TO 7
1420 IF DA(I)=1 THEN DY(I)=DY(I)+1
1430 IF DA(I)=1 AND DY(I)+12>172 AND DY(I)<190 AND DX(I)+22>PX AND DX(I)<PX+PW THEN GOSUB 1480
1440 IF DA(I)=1 AND DY(I)>200 THEN DA(I)=0
1450 IF DA(I)=1 THEN DRAW_TEXTURE(D$(DK(I)),DX(I),DY(I),22,12)
1460 NEXT I
1470 RETURN
1478 REM INPUT: I IS THE FALLING PICKUP SLOT; DK(I) SELECTS ITS EFFECT.
1479 REM --- APPLY A PICKUP TO THE PADDLE OR BALL POOL ---
1480 K=DK(I):DA(I)=0
1490 IF K=0 THEN PW=98:PWE=480:PLAY_SFX "PICKUP_GOOD"
1500 IF K=1 THEN PW=35:PWE=480:PLAY_SFX "PICKUP_BAD"
1510 IF K=2 THEN SV=0.6:SLE=480:PLAY_SFX "PICKUP_GOOD"
1520 IF K=3 THEN L=L+1:PLAY_SFX "PICKUP_LIFE"
1530 IF K=4 AND EXTRA=0 THEN EXTRA=1:BX2=BX:BY2=BY:VX2=VX*0.900447-VY*0.434966:VY2=VX*0.434966+VY*0.900447
1531 IF K=4 AND EXTRA2=0 THEN EXTRA2=1:BX3=BX:BY3=BY:VX3=VX*0.900447+VY*0.434966:VY3=0-VX*0.434966+VY*0.900447
1532 IF K=4 THEN PLAY_SFX "PICKUP_GOOD"
1535 RETURN
1539 REM --- SPAWN A PICKUP IN THE FIRST FREE SLOT ---
1540 DS=-1:FOR I=0 TO 7
1550 IF DA(I)=0 AND DS=-1 THEN DS=I
1560 NEXT I
1570 IF DS>=0 THEN DA(DS)=1:DX(DS)=BX-11:DY(DS)=BY:DK(DS)=INT(RND(10)):K=DK(DS)
1580 IF DS>=0 AND K<2 THEN DK(DS)=0
1585 IF DS>=0 AND K>=2 AND K<4 THEN DK(DS)=2
1590 IF DS>=0 AND K>=4 AND K<6 THEN DK(DS)=4
1595 IF DS>=0 AND K>=6 AND K<9 THEN DK(DS)=1
1598 IF DS>=0 AND K=9 THEN DK(DS)=3
1599 RETURN
1600 CANVAS(480,540):CLS:CLEAR("BLIP_BLACK"):TT=TIME()
1601 REM --- TITLE - NATIVE RUST LAYOUT AND GENERATED SPRITES ---
1610 FOR R=0 TO 1:COUNT=8-R*2:START=1+R:X0=(480-COUNT*46+2)/2
1620 FOR C=0 TO COUNT-1:K=START+C:K=K-6*INT(K/6)
1630 DRAW_TEXTURE(T$(K),X0+C*46,64+R*20,44,18)
1640 NEXT C:NEXT R
1650 DRAW_TEXT("BOUNCER",240,135,6,"BLIP_CYAN","CENTER")
1660 DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE","PRESS FIRE","TAP TO START"),240,270,3,"BLIP_WHITE","CENTER")
1670 DRAW_TEXT(CONTROL_TEXT$("LEFT RIGHT ARROW OR AD","PAD LEFT AND RIGHT","DRAG TO MOVE"),240,360,2,"BLIP_GRAY","CENTER")
1680 DRAW_TEXT(CONTROL_TEXT$("SPACE TO LAUNCH","FIRE TO LAUNCH","TAP TO LAUNCH"),240,380,2,"BLIP_GRAY","CENTER")
1690 DRAW_TEXT(CONTROL_TEXT$("DOUBLE TAP TO DASH","DOUBLE TAP TO DASH",""),240,400,2,"BLIP_GRAY","CENTER")
1700 CX=240+SIN(TT*1.2)*132:TX=CX-9:TY=444+SIN(TT*2)*7
1705 FOR I=3 TO 1 STEP -1:FILL_RECT(TX-I*8,TY+3,18,18,COLOR(0.25,0.55,1,0.11/I)):NEXT I
1710 DRAW_TEXTURE("BALL",TX,TY,18,18,0,12,0,19,TT*0.7)
1715 DRAW_TEXTURE("BALL_SHADE",TX,TY,18,18)
1720 PX=CLAMP(CX-40,0,400)
1730 DRAW_TEXTURE("PADDLE",PX,492,6,12,0,0,12,24)
1740 DRAW_TEXTURE("PADDLE",PX+6,492,68,12,12,0,96,24)
1745 DRAW_TEXTURE("PADDLE",PX+74,492,6,12,108,0,12,24)
1750 K$=INKEY$
1755 IF K$<>" " THEN WAIT 16:GOTO 1600
1760 CANVAS(320,200):RETURN
1799 REM --- SECOND BALL - MOTION AND COLLISIONS ---
1800 SEEKX=BX2:SEEKY=BY2:SEEKVX=VX2:SEEKVY=VY2:GOSUB 2400:VX2=SEEKVX:VY2=SEEKVY:BX2=BX2+VX2*SV:BY2=BY2+VY2*SV
1810 IF BX2<6 THEN BX2=6:VX2=ABS(VX2):PLAY_SFX "WALL_HIT"
1820 IF BX2>314 THEN BX2=314:VX2=-ABS(VX2):PLAY_SFX "WALL_HIT"
1830 IF BY2<23 THEN BY2=23:VY2=ABS(VY2):PLAY_SFX "WALL_HIT"
1840 IF BY2>205 THEN EXTRA=0:RETURN
1850 IF BY2>168 AND BY2<188 AND BX2>PX-6 AND BX2<PX+PW AND VY2>0 THEN VY2=-ABS(VY2):VX2=(BX2-PX-PW/2)/13+PVEL*0.35:CHAIN=0:PLAY_SFX "PADDLE_HIT_"+STR$(INT(RND(3)))
1860 R2=INT((BY2-31)/13):C2=INT((BX2-6)/30)
1870 IF BY2<31 OR BY2>110 OR R2<0 OR R2>5 OR C2<0 OR C2>9 THEN RETURN
1880 HIT2=0:BT2=B(C2,R2):OLDV2=VY2
1890 IF BT2=3 THEN B(C2,R2)=4:IF OLDV2>0 THEN BY2=31+R2*13-1:VY2=-ABS(VY2)
1900 IF BT2=3 AND OLDV2<0 THEN BY2=31+R2*13+12:VY2=ABS(VY2)
1905 IF BT2=3 THEN PLAY_SFX "BRICK_HIT_"+STR$(INT(RND(3)))
1910 IF BT2=1 OR BT2=2 OR BT2=4 THEN B(C2,R2)=0:HIT2=1:CHAIN=CHAIN+1:CM=CHAIN:IF CM>5 THEN CM=5
1920 IF HIT2=1 THEN SC=SC+(6-R2)*10*LV*CM:LEFT=LEFT-1:QUIET=0
1925 IF HIT2=1 THEN FX=BX2:FY=BY2:FT=12:POP=(6-R2)*10*LV*CM:POPT=20
1930 IF HIT2=1 AND OLDV2>0 THEN BY2=31+R2*13-1:VY2=-ABS(VY2)
1940 IF HIT2=1 AND OLDV2<0 THEN BY2=31+R2*13+12:VY2=ABS(VY2)
1950 IF HIT2=1 AND ABS(VX2)<4 THEN VX2=VX2*1.03
1960 IF HIT2=1 AND ABS(VY2)<4 THEN VY2=VY2*1.03
1970 IF HIT2=1 THEN PLAY_SFX "BRICK_BREAK_"+STR$(INT(RND(3))):IF BT2=2 THEN C=C2:R=R2:GOSUB 1330
1980 IF HIT2=1 AND RND(100)<30 THEN GOSUB 1540
1990 RETURN
1999 REM --- THIRD BALL - MOTION AND COLLISIONS ---
2000 SEEKX=BX3:SEEKY=BY3:SEEKVX=VX3:SEEKVY=VY3:GOSUB 2400:VX3=SEEKVX:VY3=SEEKVY:BX3=BX3+VX3*SV:BY3=BY3+VY3*SV
2010 IF BX3<6 THEN BX3=6:VX3=ABS(VX3):PLAY_SFX "WALL_HIT"
2020 IF BX3>314 THEN BX3=314:VX3=-ABS(VX3):PLAY_SFX "WALL_HIT"
2030 IF BY3<23 THEN BY3=23:VY3=ABS(VY3):PLAY_SFX "WALL_HIT"
2040 IF BY3>205 THEN EXTRA2=0:RETURN
2050 IF BY3>168 AND BY3<188 AND BX3>PX-6 AND BX3<PX+PW AND VY3>0 THEN VY3=-ABS(VY3):VX3=(BX3-PX-PW/2)/13+PVEL*0.35:CHAIN=0:PLAY_SFX "PADDLE_HIT_"+STR$(INT(RND(3)))
2060 R3=INT((BY3-31)/13):C3=INT((BX3-6)/30)
2070 IF BY3<31 OR BY3>110 OR R3<0 OR R3>5 OR C3<0 OR C3>9 THEN RETURN
2080 HIT3=0:BT3=B(C3,R3):OLDV3=VY3
2090 IF BT3=3 THEN B(C3,R3)=4:IF OLDV3>0 THEN BY3=31+R3*13-1:VY3=-ABS(VY3)
2100 IF BT3=3 AND OLDV3<0 THEN BY3=31+R3*13+12:VY3=ABS(VY3)
2110 IF BT3=3 THEN PLAY_SFX "BRICK_HIT_"+STR$(INT(RND(3)))
2120 IF BT3=1 OR BT3=2 OR BT3=4 THEN B(C3,R3)=0:HIT3=1:CHAIN=CHAIN+1:CM=CHAIN:IF CM>5 THEN CM=5
2130 IF HIT3=1 THEN SC=SC+(6-R3)*10*LV*CM:LEFT=LEFT-1:QUIET=0
2140 IF HIT3=1 THEN FX=BX3:FY=BY3:FT=12:POP=(6-R3)*10*LV*CM:POPT=20
2150 IF HIT3=1 AND OLDV3>0 THEN BY3=31+R3*13-1:VY3=-ABS(VY3)
2160 IF HIT3=1 AND OLDV3<0 THEN BY3=31+R3*13+12:VY3=ABS(VY3)
2170 IF HIT3=1 AND ABS(VX3)<4 THEN VX3=VX3*1.03
2180 IF HIT3=1 AND ABS(VY3)<4 THEN VY3=VY3*1.03
2190 IF HIT3=1 THEN PLAY_SFX "BRICK_BREAK_"+STR$(INT(RND(3))):IF BT3=2 THEN C=C3:R=R3:GOSUB 1330
2200 IF HIT3=1 AND RND(100)<30 THEN GOSUB 1540
2210 RETURN
2219 REM --- SCREWBALL - DECAY SPIN AND LIMIT TOTAL CURVE ---
2220 IF ABS(SPIN)<0.001 OR CURVE>=0.75 THEN RETURN
2230 ANG=SPIN*0.016
2240 IF ABS(ANG)>0.75-CURVE THEN ANG=0.75-CURVE
2250 IF SPIN<0 THEN ANG=0-ANG
2260 IF 0.75-CURVE<=ABS(SPIN*0.016) THEN SPIN=0
2270 RX=VX*90:RY=VY*162:OX=RX:OY=RY
2280 VX=(OX*COS(ANG)-OY*SIN(ANG))/90:VY=(OX*SIN(ANG)+OY*COS(ANG))/162:CURVE=CURVE+ABS(ANG):SPIN=SPIN*0.9856
2290 RETURN
2299 REM --- SPEED - PREVENT FLAT STALLS AND CAP ACCELERATION ---
2300 SPX=VX*90:SPY=VY*162:SPD=SQR(SPX*SPX+SPY*SPY)
2310 FLAT=1-ABS(SPY)/SPD/0.4:IF FLAT<0 THEN FLAT=0
2320 DIRY=1-2*(VY<0):VY=VY+DIRY*(0.00691+0.02568*FLAT)
2330 IF ABS(SPIN)>0.001 OR CURVE>0 THEN VX=VX*1.00288:VY=VY*1.00288
2340 SPX=VX*90:SPY=VY*162:SPD=SQR(SPX*SPX+SPY*SPY)
2350 IF SPD>546 THEN FAC=546/SPD:VX=VX*FAC:VY=VY*FAC
2360 RETURN
2399 REM --- QUIET BALL - STEER TOWARD THE NEAREST REMAINING BRICK ---
2400 SEEK_C=-1:SEEK_R=-1:IF QUIET<=5 OR SEEKVY>=0 THEN RETURN
2410 BESTD=999999
2420 FOR R=0 TO 5:FOR C=0 TO 9
2430 IF B(C,R)>0 THEN TARGETX=6+C*30+14.5:TARGETY=31+R*13+5.5:DX=TARGETX-SEEKX-6:DY=TARGETY-SEEKY-6:DIST=SQR(DX*DX+DY*DY)
2431 IF B(C,R)>0 AND DIST<BESTD THEN BESTD=DIST:SEEK_C=C:SEEK_R=R:BESTX=DX:BESTY=DY:BESTDIST=DIST
2440 NEXT C:NEXT R
2450 IF SEEK_C<0 THEN RETURN
2460 IF BESTDIST<1 THEN RETURN
2470 SPD=SQR(SEEKVX*SEEKVX+SEEKVY*SEEKVY):DOT=SEEKVX*BESTX+SEEKVY*BESTY:CROSS=SEEKVX*BESTY-SEEKVY*BESTX:ANGLE=0.024
2480 IF ABS(CROSS)<0.0001 AND DOT>0 THEN ANGLE=0
2490 IF DOT>0 AND ABS(CROSS)<ANGLE*SPD*BESTDIST THEN ANGLE=ABS(CROSS)/(SPD*BESTDIST)
2500 IF CROSS<0 THEN ANGLE=0-ANGLE
2510 OX=SEEKVX:OY=SEEKVY:SEEKVX=OX*COS(ANGLE)-OY*SIN(ANGLE):SEEKVY=OX*SIN(ANGLE)+OY*COS(ANGLE):RETURN
