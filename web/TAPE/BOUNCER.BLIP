1 REM BOUNCER - KEEP THE BALL UP AND BREAK EVERY BRICK.
2 REM GAME: BOUNCER
3 REM LEFT/RIGHT MOVE THE PADDLE; TAP TWICE TO DASH. SPACE LAUNCHES THE BALL.
4 REM SCREENS: TITLE, LAUNCH, PLAY, DEAD, CLEAR, OVER - EACH HAS AN UPDATE AND A DRAW.
5 REM BRICK(C,R): 0 GONE, 1 PLAIN, 2 BOMB, 3 STEEL, 4 CRACKED STEEL. UP TO THREE BALLS.
10 REM --- SETUP ---
11 ASSETS$="/TAPE/BOUNCER/ASSETS/"
15 FIELD_X=120:FIELD_W=400:TOP=8
20 COLS=10:ROWS=6
25 BRICK_W=36:BRICK_H=14
27 BRICK_X=131:BRICK_Y=48
30 PAD_H=10:PAD_Y=362:PAD_SPEED=220
35 BALL=14:BALL_START=190:BALL_MAX=330
40 DROP_W=26:DROP_H=14
45 ASSETS$=ASSETS$+""
50 PANEL$="#0E0E1A":EDGE$="#2E3150"
55 LOAD_TABLES
80 PLAY_MUSIC ASSETS$+"BOUNCE.WAV"
85 STATE$="TITLE"
90 LAST_TIME=TIME()
100 REM --- MAIN LOOP - UPDATE THE SCREEN WE ARE ON, THEN DRAW IT ---
110 NOW=TIME()
111 DT=CLAMP(NOW-LAST_TIME,0.0001,0.05)
112 LAST_TIME=NOW
120 READ_KEYS
130 IF STATE$="TITLE" THEN
131   UPDATE_TITLE
132 ELSEIF STATE$="LAUNCH" THEN
133   UPDATE_LAUNCH
134 ELSEIF STATE$="PLAY" THEN
135   UPDATE_PLAY
136 ELSEIF STATE$="OVER" THEN
137   UPDATE_OVER
138 ELSE
139   UPDATE_PAUSE
140 END IF
150 IF STATE$="TITLE" THEN
151   DRAW_TITLE
152 ELSEIF STATE$="CLEAR" THEN
153   DRAW_CLEAR
154 ELSEIF STATE$="OVER" THEN
155   DRAW_OVER
156 ELSE
157   DRAW_PLAY
158 END IF
170 WAIT 0
180 GOTO 110
1000 REM --- TITLE ---
1010 SUB UPDATE_TITLE
1020   IF FIRE THEN START_GAME
1030 END SUB
1100 SUB DRAW_TITLE
1110   LOCAL T,R,C,X
1120   T=TIME()
1130   CLEAR("BLIP_BLACK")
1140   FOR R=0 TO 1
1150     FOR C=0 TO 7-R*2
1160       DRAW_TEXTURE(ASSETS$+"BRICK_"+BRICK_COLOR$((C+R+1) MOD 6)+".PNG",FIELD_X+(FIELD_W-(8-R*2)*46)/2+C*46,40+R*20,44,18)
1170     NEXT C
1180   NEXT R
1190   DRAW_TEXT("BOUNCER",320,110,6,"BLIP_CYAN","CENTER")
1200   DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE","PRESS FIRE","TAP TO START"),320,200,3,"BLIP_WHITE","CENTER")
1210   X=320+SIN(T*1.2)*150
1220   DRAW_BALL X-9,300+SIN(T*2)*7,18,T*3
1230   DRAW_PADDLE CLAMP(X-40,FIELD_X,FIELD_X+FIELD_W-80),PAD_Y,80
1240   DRAW_PANELS
1250   DRAW_TEXT("MOVE",60,120,2,"BLIP_GRAY","CENTER")
1260   DRAW_TEXT(CONTROL_TEXT$("ARROWS","PAD","DRAG"),60,144,2,"BLIP_WHITE","CENTER")
1270   DRAW_TEXT("LAUNCH",580,120,2,"BLIP_GRAY","CENTER")
1280   DRAW_TEXT(CONTROL_TEXT$("SPACE","FIRE","TAP"),580,144,2,"BLIP_WHITE","CENTER")
1290   DRAW_TEXT(CONTROL_TEXT$("TAP TWICE","TAP TWICE",""),580,200,2,"BLIP_GRAY","CENTER")
1300   DRAW_TEXT(CONTROL_TEXT$("TO DASH","TO DASH",""),580,222,2,"BLIP_GRAY","CENTER")
1310 END SUB
2000 REM --- START - A NEW GAME, EACH LEVEL, AND EACH BALL ---
2010 SUB START_GAME
2020   SCORE=0:LIVES=3
2030   LEVEL=1
2040   START_LEVEL
2050 END SUB
2100 SUB START_LEVEL
2110   BUILD_BRICKS
2120   BALL_SPEED=BALL_START
2130   FX_CLEAR()
2140   REM ODD LEVELS PLAY THE TITLE TUNE, EVEN LEVELS THE OTHER ONE
2150   IF LEVEL MOD 2 THEN PLAY_MUSIC ASSETS$+"BOUNCE.WAV" ELSE PLAY_MUSIC ASSETS$+"REBOUND.WAV"
2160   NEW_BALL
2170 END SUB
2200 REM THE BALL SITS ON THE PADDLE, READY TO GO UP 36 TO 43 DEGREES OFF VERTICAL
2210 SUB NEW_BALL
2220   LOCAL K,ANGLE,SIDE
2230   CLEAR_EFFECTS
2240   PAD_X=320-PAD_W/2
2250   FOR K=1 TO 3:BALL_ON(K)=0:NEXT K
2260   BALL_ON(1)=1
2270   ANGLE=0.62+RND(0.12)
2280   IF RND(2)<1 THEN SIDE=1 ELSE SIDE=-1
2290   BALL_VX(1)=SIDE*BALL_SPEED*SIN(ANGLE)
2300   BALL_VY(1)=-BALL_SPEED*COS(ANGLE)
2310   BALL_SPIN(1)=0:BALL_CURVE(1)=0
2320   SINCE_BREAK=0:CHAIN=0
2330   STATE$="LAUNCH"
2340 END SUB
2400 REM EIGHT LAYOUTS TAKE TURNS; BOMBS FROM LEVEL TWO, STEEL FROM LEVEL FOUR
2410 SUB BUILD_BRICKS
2420   LOCAL C,R,BOMBS,STEEL
2430   BRICKS_LEFT=0
2440   STEEL=CLAMP((LEVEL-3)*0.05,0,0.3)
2450   FOR R=0 TO ROWS-1
2460     FOR C=0 TO COLS-1
2465       IN_LAYOUT (LEVEL-1) MOD 8,C,R
2470       BRICK(C,R)=PLACED
2480       IF BRICK(C,R) AND LEVEL>=4 AND RND(1)<STEEL THEN
2490         BRICK(C,R)=3
2500       ELSEIF BRICK(C,R) AND LEVEL>=2 AND BOMBS<4 AND RND(100)<5 THEN
2510         BRICK(C,R)=2
2520         BOMBS=BOMBS+1
2530       END IF
2540       IF BRICK(C,R) THEN BRICKS_LEFT=BRICKS_LEFT+1
2550     NEXT C
2560   NEXT R
2570 END SUB
2600 REM WHETHER LAYOUT P HAS A BRICK AT COLUMN C, ROW R; D IS ITS DISTANCE FROM THE MIDDLE
2610 SUB IN_LAYOUT(P,C,R)
2620   LOCAL D
2630   D=ABS(C-4.5)
2640   IF P=0 THEN PLACED=1
2650   IF P=1 THEN PLACED=((R+C) MOD 2=0)
2660   IF P=2 THEN PLACED=(D<=3)
2670   IF P=3 THEN PLACED=(D<=R+1)
2680   IF P=4 THEN PLACED=(C<2 OR C>7)
2690   IF P=5 THEN PLACED=(R MOD 2=0)
2700   IF P=6 THEN PLACED=(R=0 OR R=5 OR C=0 OR C=9)
2710   IF P=7 THEN PLACED=(ABS(C-R*1.8)<1 OR ABS(C-9+R*1.8)<1)
2720 END SUB
3000 REM --- PLAY ---
3010 SUB UPDATE_LAUNCH
3020   MOVE_PADDLE
3030   FX_UPDATE(DT)
3040   BALL_X(1)=PAD_X+PAD_W/2-BALL/2
3050   BALL_Y(1)=PAD_Y-BALL-2
3060   IF FIRE OR KEY_PRESSED("UP") OR KEY_PRESSED("W") THEN STATE$="PLAY"
3070 END SUB
3100 SUB UPDATE_PLAY
3110   LOCAL K,SPEED,LEFT_IN_PLAY
3120   MOVE_PADDLE
3130   TICK_EFFECTS
3140   MOVE_DROPS
3150   FX_UPDATE(DT)
3160   SINCE_BREAK=SINCE_BREAK+DT
3170   IF SLOW_LEFT>0 THEN SPEED=BALL_SPEED*0.6 ELSE SPEED=BALL_SPEED
3180   FOR K=1 TO 3
3190     IF BALL_ON(K) THEN FLY_BALL K,SPEED
3200   NEXT K
3210   FOR K=1 TO 3
3220     LEFT_IN_PLAY=LEFT_IN_PLAY+BALL_ON(K)
3230   NEXT K
3240   IF LEFT_IN_PLAY=0 THEN LOSE_LIFE:EXIT SUB
3250   IF BRICKS_LEFT=0 THEN
3260     PLAY_SFX ASSETS$+"WIN.WAV"
3270     STATE$="CLEAR"
3280     WAIT_LEFT=1.5
3290   END IF
3300 END SUB
3400 REM TAPPING A DIRECTION TWICE IN QUICK SUCCESSION DASHES THAT WAY FOR A MOMENT
3410 SUB MOVE_PADDLE
3420   LOCAL OLD_X,BOOST
3430   OLD_X=PAD_X
3440   LEFT_TAP=LEFT_TAP+DT:RIGHT_TAP=RIGHT_TAP+DT
3450   IF TAP_LEFT THEN
3460     IF LEFT_TAP<0.28 THEN DASH_DIR=-1:DASH_LEFT=0.35:LEFT_TAP=99 ELSE LEFT_TAP=0
3470   END IF
3480   IF TAP_RIGHT THEN
3490     IF RIGHT_TAP<0.28 THEN DASH_DIR=1:DASH_LEFT=0.35:RIGHT_TAP=99 ELSE RIGHT_TAP=0
3500   END IF
3510   DASH_LEFT=MAX(0,DASH_LEFT-DT)
3520   BOOST=1+0.9*DASH_LEFT/0.35
3530   IF HOLD_LEFT THEN PAD_X=PAD_X-PAD_SPEED*DT*FNBOOST(-1,BOOST)
3540   IF HOLD_RIGHT THEN PAD_X=PAD_X+PAD_SPEED*DT*FNBOOST(1,BOOST)
3550   PAD_X=CLAMP(PAD_X,FIELD_X,FIELD_X+FIELD_W-PAD_W)
3560   PAD_VX=(PAD_X-OLD_X)/DT
3570 END SUB
3580 DEF FNBOOST(DIR,BOOST)=1+(BOOST-1)*(DASH_DIR=DIR)
3600 REM ONE FRAME OF BALL K: STEERING, SPIN, PULL, THEN SMALL STEPS AGAINST WALLS,
3601 REM PADDLE AND BRICKS, SO A FAST BALL CANNOT SLIP BETWEEN THEM
3610 SUB FLY_BALL(K,SPEED)
3620   LOCAL STEPS,SDT,I
3630   SEEK_BRICK K
3640   CURVE_BALL K
3650   PULL_BALL K
3660   BALL_ROLL(K)=BALL_ROLL(K)+BALL_VX(K)*DT/7
3670   STEPS=CLAMP(-INT(-FNSPEED(K)*DT/(BALL*0.4)),1,8)
3680   SDT=DT/STEPS
3690   FOR I=1 TO STEPS
3700     BALL_X(K)=BALL_X(K)+BALL_VX(K)*SDT
3710     BALL_Y(K)=BALL_Y(K)+BALL_VY(K)*SDT
3720     BOUNCE_OFF_WALLS K
3730     BOUNCE_OFF_PADDLE K,SPEED
3740     HIT_BRICKS K,SPEED
3750     IF BALL_Y(K)>400 THEN
3760       BALL_ON(K)=0
3770       FX_BURST(BALL_X(K)+BALL/2,396,14,160,"BLIP_RED")
3780       EXIT SUB
3790     END IF
3800   NEXT I
3810 END SUB
3820 DEF FNSPEED(K)=MAX(1,SQR(BALL_VX(K)*BALL_VX(K)+BALL_VY(K)*BALL_VY(K)))
3900 REM A SPINNING BALL CURVES, UP TO 43 DEGREES, AND ITS SPIN BLEEDS AWAY
3910 SUB CURVE_BALL(K)
3920   LOCAL TURN
3930   IF ABS(BALL_SPIN(K))<=0.001 THEN EXIT SUB
3940   TURN=BALL_SPIN(K)*DT
3950   IF ABS(TURN)>0.75-BALL_CURVE(K) THEN
3960     TURN=SGN(TURN)*MAX(0,0.75-BALL_CURVE(K))
3970     BALL_SPIN(K)=0
3980   END IF
3990   BALL_CURVE(K)=BALL_CURVE(K)+ABS(TURN)
4000   TURN_BALL K,TURN
4010   BALL_SPIN(K)=BALL_SPIN(K)*MAX(0,1-0.9*DT)
4020 END SUB
4100 REM THE PULL STEEPENS A FLAT FLIGHT, AND A CURVING BALL QUICKENS
4110 SUB PULL_BALL(K)
4120   LOCAL FLAT,SPEED,CAP
4130   FLAT=CLAMP(1-ABS(BALL_VY(K))/FNSPEED(K)/0.4,0,1)
4140   BALL_VY(K)=BALL_VY(K)+SGN(BALL_VY(K)+0.0001)*(55+200*FLAT)*DT
4150   IF ABS(BALL_SPIN(K))>0.001 OR BALL_CURVE(K)>0 THEN
4160     BALL_VX(K)=BALL_VX(K)*(1+0.18*DT)
4170     BALL_VY(K)=BALL_VY(K)*(1+0.18*DT)
4180   END IF
4190   SPEED=FNSPEED(K):CAP=BALL_MAX*1.3
4200   IF SPEED>CAP THEN SET_SPEED K,CAP
4210 END SUB
4300 REM FIVE SECONDS WITHOUT A BREAK, A RISING BALL BENDS TOWARD THE NEAREST BRICK
4310 SUB SEEK_BRICK(K)
4320   LOCAL C,R,D,NEAREST,WANT
4330   SEEK_C=-1
4340   IF SINCE_BREAK<=5 OR BALL_VY(K)>=0 THEN EXIT SUB
4350   NEAREST=999999
4360   FOR R=0 TO ROWS-1
4370     FOR C=0 TO COLS-1
4380       IF BRICK(C,R) THEN
4390         D=DISTANCE(FNBRICK_X(C)+BRICK_W/2,FNBRICK_Y(R)+BRICK_H/2,BALL_X(K)+BALL/2,BALL_Y(K)+BALL/2)
4400         IF D<NEAREST THEN NEAREST=D:SEEK_C=C:SEEK_R=R
4410       END IF
4420     NEXT C
4430   NEXT R
4440   IF SEEK_C<0 THEN EXIT SUB
4450   WANT=ATAN2(FNBRICK_Y(SEEK_R)+BRICK_H/2-BALL_Y(K)-BALL/2,FNBRICK_X(SEEK_C)+BRICK_W/2-BALL_X(K)-BALL/2)
4460   TURN_BALL K,CLAMP(ANGLE_DIFF(ATAN2(BALL_VY(K),BALL_VX(K)),WANT),-1.5*DT,1.5*DT)
4470 END SUB
4500 SUB TURN_BALL(K,ANGLE)
4510   LOCAL VX,VY
4520   VX=BALL_VX(K):VY=BALL_VY(K)
4530   BALL_VX(K)=VX*COS(ANGLE)-VY*SIN(ANGLE)
4540   BALL_VY(K)=VX*SIN(ANGLE)+VY*COS(ANGLE)
4550 END SUB
4600 SUB SET_SPEED(K,SPEED)
4610   LOCAL NOW
4620   NOW=FNSPEED(K)
4630   BALL_VX(K)=BALL_VX(K)/NOW*SPEED
4640   BALL_VY(K)=BALL_VY(K)/NOW*SPEED
4650 END SUB
4700 SUB BOUNCE_OFF_WALLS(K)
4710   IF BALL_X(K)<FIELD_X THEN
4720     BALL_X(K)=2*FIELD_X-BALL_X(K)
4730     BALL_VX(K)=ABS(BALL_VX(K))
4740     PLAY_SFX ASSETS$+"WALL_HIT.WAV",0.55
4750   ELSEIF BALL_X(K)>FIELD_X+FIELD_W-BALL THEN
4760     BALL_X(K)=2*(FIELD_X+FIELD_W-BALL)-BALL_X(K)
4770     BALL_VX(K)=-ABS(BALL_VX(K))
4780     PLAY_SFX ASSETS$+"WALL_HIT.WAV",0.55
4790   END IF
4800   IF BALL_Y(K)<TOP THEN
4810     BALL_Y(K)=2*TOP-BALL_Y(K)
4820     BALL_VY(K)=ABS(BALL_VY(K))
4830     PLAY_SFX ASSETS$+"WALL_HIT.WAV",0.55
4840   END IF
4850 END SUB
4900 REM WHERE THE BALL MEETS THE PADDLE AIMS IT; A PADDLE MOVING ACROSS IT PUTS ON SPIN
4910 SUB BOUNCE_OFF_PADDLE(K,SPEED)
4920   LOCAL AIM,VX,VY,ACROSS
4930   IF BALL_VY(K)<=0 THEN EXIT SUB
4940   IF NOT RECTS_OVERLAP(BALL_X(K),BALL_Y(K),BALL,BALL,PAD_X,PAD_Y,PAD_W,PAD_H) THEN EXIT SUB
4950   PLAY_SFX ASSETS$+"PADDLE_HIT_"+STR$(INT(RND(3)))
4960   CHAIN=0
4970   FX_RING(BALL_X(K)+BALL/2,PAD_Y,18,0.25,COLOR(0.6,0.85,1,0.8))
4980   AIM=CLAMP(((BALL_X(K)+BALL/2-PAD_X)/PAD_W-0.5)*2,-1,1)*1.15
4990   VX=SPEED*SIN(AIM)+PAD_VX*0.18
5000   VY=MIN(-ABS(SPEED*COS(AIM)),-SPEED*0.32)
5010   ACROSS=PAD_VX-BALL_VX(K)
5020   BALL_VX(K)=VX:BALL_VY(K)=VY
5030   SET_SPEED K,SPEED
5040   BALL_Y(K)=PAD_Y-BALL-0.5
5050   IF ABS(ACROSS)>23 THEN BALL_SPIN(K)=SGN(ACROSS)*MIN(ABS(ACROSS)/(PAD_SPEED+BALL_MAX),1)*1.3 ELSE BALL_SPIN(K)=0
5060   BALL_CURVE(K)=0
5070 END SUB
5100 REM --- BRICKS - THE BALL BOUNCES OFF THE FIRST BRICK IT TOUCHES ---
5110 SUB HIT_BRICKS(K,SPEED)
5120   LOCAL CX,CY,RAD,C,R,X,Y,DX,DY,D,NX,NY,VN
5130   RAD=BALL/2
5140   CX=BALL_X(K)+RAD:CY=BALL_Y(K)+RAD
5150   IF CY-RAD>FNBRICK_Y(ROWS) THEN EXIT SUB
5160   FOR R=MAX(0,INT((CY-RAD-BRICK_Y)/16)) TO MIN(ROWS-1,INT((CY+RAD-BRICK_Y)/16))
5170     FOR C=MAX(0,INT((CX-RAD-BRICK_X)/38)) TO MIN(COLS-1,INT((CX+RAD-BRICK_X)/38))
5180       IF BRICK(C,R) THEN
5190         X=CLAMP(CX,FNBRICK_X(C),FNBRICK_X(C)+BRICK_W)
5200         Y=CLAMP(CY,FNBRICK_Y(R),FNBRICK_Y(R)+BRICK_H)
5210         DX=CX-X:DY=CY-Y
5220         D=SQR(DX*DX+DY*DY)
5230         IF D<RAD THEN
5240           REM PUSHED BACK OUT ALONG THE NEAREST FACE, AND TURNED OFF IT
5250           IF D>0.001 THEN NX=DX/D:NY=DY/D ELSE NX=0:NY=-SGN(BALL_VY(K))
5260           VN=BALL_VX(K)*NX+BALL_VY(K)*NY
5270           IF VN<0 THEN BALL_VX(K)=BALL_VX(K)-2*VN*NX:BALL_VY(K)=BALL_VY(K)-2*VN*NY
5280           BALL_X(K)=BALL_X(K)+NX*(RAD-D+0.5)
5290           BALL_Y(K)=BALL_Y(K)+NY*(RAD-D+0.5)
5300           SET_SPEED K,SPEED
5310           IF BRICK(C,R)=3 THEN CRACK_BRICK C,R ELSE BREAK_BRICK C,R,0
5320           EXIT SUB
5330         END IF
5340       END IF
5350     NEXT C
5360   NEXT R
5370 END SUB
5380 DEF FNBRICK_X(C)=BRICK_X+C*38
5390 DEF FNBRICK_Y(R)=BRICK_Y+R*16
5400 SUB CRACK_BRICK(C,R)
5410   BRICK(C,R)=4
5420   FX_BURST(FNBRICK_X(C)+BRICK_W/2,FNBRICK_Y(R)+BRICK_H/2,5,70,"BLIP_GRAY")
5430   PLAY_SFX ASSETS$+"BRICK_HIT_"+STR$(INT(RND(3)))
5440 END SUB
5500 REM POINTS GROW DOWN THE WALL AND WITH EACH BREAK BEFORE THE PADDLE, UP TO X5;
5501 REM A BOMB TAKES ITS NEIGHBOURS WITH IT
5510 SUB BREAK_BRICK(C,R,BLASTED)
5520   LOCAL KIND,TIMES,POINTS,X,Y,DC,DR
5530   KIND=BRICK(C,R)
5540   BRICK(C,R)=0
5550   BRICKS_LEFT=BRICKS_LEFT-1
5560   SINCE_BREAK=0
5570   CHAIN=CHAIN+1
5580   TIMES=MIN(CHAIN,5)
5590   POINTS=(ROWS-R)*10*LEVEL*TIMES
5600   SCORE=SCORE+POINTS
5610   X=FNBRICK_X(C)+BRICK_W/2:Y=FNBRICK_Y(R)+BRICK_H/2
5620   FX_BURST(X,Y,10,120,BURST_COLOR$(KIND,R))
5630   IF TIMES>1 THEN FX_POPUP(X,Y,STR$(POINTS)+" X"+STR$(TIMES),"BLIP_YELLOW") ELSE FX_POPUP(X,Y,STR$(POINTS),"BLIP_WHITE")
5640   BALL_SPEED=MIN(BALL_SPEED+5.5,BALL_MAX)
5650   IF RND(10)<3 THEN DROP_PICKUP X-DROP_W/2,FNBRICK_Y(R)
5660   IF KIND<>2 THEN
5670     IF NOT BLASTED THEN PLAY_SFX ASSETS$+"BRICK_BREAK_"+STR$(INT(RND(3)))
5680     EXIT SUB
5690   END IF
5700   PLAY_SFX ASSETS$+"BOMB.WAV"
5710   FX_RING(X,Y,50,0.35,"BLIP_ORANGE")
5720   FOR DR=-1 TO 1
5730     FOR DC=-1 TO 1
5740       IF FNON_GRID(C+DC,R+DR) THEN
5750         IF BRICK(C+DC,R+DR) THEN BREAK_BRICK C+DC,R+DR,1
5760       END IF
5770     NEXT DC
5780   NEXT DR
5790 END SUB
5800 DEF FNON_GRID(C,R)=C>=0 AND C<COLS AND R>=0 AND R<ROWS
6000 REM --- PICKUPS - THEY FALL FROM BROKEN BRICKS; THE PADDLE CATCHES THEM ---
6010 REM DROP(D) IS 0 FOR A FREE SLOT, ELSE THE KIND PLUS ONE
6020 SUB DROP_PICKUP(X,Y)
6030   LOCAL D,ROLL
6040   FOR D=1 TO 8
6050     IF NOT DROP(D) THEN EXIT FOR
6060   NEXT D
6070   IF D>8 THEN EXIT SUB
6080   ROLL=INT(RND(10))
6090   DROP(D)=DROP_FOR_ROLL(ROLL)+1
6100   DROP_X(D)=X:DROP_Y(D)=Y
6110 END SUB
6200 SUB MOVE_DROPS
6210   LOCAL D
6220   FOR D=1 TO 8
6230     IF DROP(D) THEN
6240       DROP_Y(D)=DROP_Y(D)+94*DT
6250       IF RECTS_OVERLAP(DROP_X(D),DROP_Y(D),DROP_W,DROP_H,PAD_X,PAD_Y,PAD_W,PAD_H) THEN
6260         CATCH DROP(D)-1
6270         DROP(D)=0
6280       ELSEIF DROP_Y(D)>400 THEN
6290         DROP(D)=0
6300       END IF
6310     END IF
6320   NEXT D
6330 END SUB
6400 REM WIDE AND NARROW CHANGE THE PADDLE AND SLOW THE BALL, FOR EIGHT SECONDS;
6401 REM LIFE IS A LIFE; MULTI SPLITS THE BALL INTO THREE
6410 SUB CATCH(KIND)
6420   IF KIND=0 THEN PAD_W=102:WIDTH_LEFT=8:PLAY_SFX ASSETS$+"PICKUP_GOOD.WAV"
6430   IF KIND=1 THEN PAD_W=36:WIDTH_LEFT=8:PLAY_SFX ASSETS$+"PICKUP_BAD.WAV"
6440   IF KIND=2 THEN SLOW_LEFT=8:PLAY_SFX ASSETS$+"PICKUP_GOOD.WAV"
6450   IF KIND=3 THEN LIVES=LIVES+1:PLAY_SFX ASSETS$+"PICKUP_LIFE.WAV"
6460   IF KIND=4 THEN SPLIT_BALL:PLAY_SFX ASSETS$+"PICKUP_GOOD.WAV"
6470 END SUB
6500 REM NEW BALLS LEAVE THE FIRST ONE IN PLAY A FAN'S WIDTH EITHER SIDE OF IT
6510 SUB SPLIT_BALL
6520   LOCAL K,FROM,SIDE
6530   FOR FROM=1 TO 3
6540     IF BALL_ON(FROM) THEN EXIT FOR
6550   NEXT FROM
6560   IF FROM>3 THEN EXIT SUB
6570   SIDE=1
6580   FOR K=1 TO 3
6590     IF NOT BALL_ON(K) THEN
6600       BALL_ON(K)=1
6610       BALL_X(K)=BALL_X(FROM):BALL_Y(K)=BALL_Y(FROM)
6620       BALL_VX(K)=BALL_VX(FROM):BALL_VY(K)=BALL_VY(FROM)
6630       TURN_BALL K,0.45*SIDE
6640       REM NEVER STRAIGHT ALONG THE PADDLE LINE
6650       IF ABS(BALL_VY(K))<FNSPEED(K)*0.3 THEN BALL_VY(K)=-FNSPEED(K)*0.3
6660       BALL_SPIN(K)=0:BALL_CURVE(K)=0
6670       SIDE=-SIDE
6680     END IF
6690   NEXT K
6700 END SUB
6800 SUB TICK_EFFECTS
6810   IF WIDTH_LEFT>0 THEN
6820     WIDTH_LEFT=MAX(0,WIDTH_LEFT-DT)
6830     IF WIDTH_LEFT=0 THEN PAD_W=64
6840   END IF
6850   SLOW_LEFT=MAX(0,SLOW_LEFT-DT)
6860 END SUB
6900 SUB CLEAR_EFFECTS
6910   LOCAL D
6920   PAD_W=64:WIDTH_LEFT=0:SLOW_LEFT=0
6930   FOR D=1 TO 8:DROP(D)=0:NEXT D
6940 END SUB
7000 REM --- LOSING A BALL, CLEARING A LEVEL, AND THE PAUSES BETWEEN ---
7010 SUB LOSE_LIFE
7020   PLAY_SFX ASSETS$+"LIFE_LOST.WAV"
7030   CLEAR_EFFECTS
7040   LIVES=LIVES-1
7050   IF LIVES>0 THEN
7060     STATE$="DEAD"
7070     WAIT_LEFT=1.2
7080   ELSE
7090     STATE$="OVER"
7100     WAIT_LEFT=2
7110   END IF
7120 END SUB
7200 REM AFTER A LOST BALL A NEW ONE WAITS ON THE PADDLE; AFTER A CLEAR, THE NEXT LEVEL
7210 SUB UPDATE_PAUSE
7220   FX_UPDATE(DT)
7230   WAIT_LEFT=WAIT_LEFT-DT
7240   IF WAIT_LEFT>0 THEN EXIT SUB
7250   IF STATE$="CLEAR" THEN
7260     LEVEL=LEVEL+1
7270     START_LEVEL
7280   ELSE
7290     NEW_BALL
7300   END IF
7310 END SUB
7400 SUB DRAW_CLEAR
7410   DRAW_PLAY
7420   DRAW_TEXT("CLEARED",320,170,4,"BLIP_GREEN","CENTER","BLIP_BLACK")
7430   DRAW_TEXT("LEVEL "+STR$(LEVEL+1),320,214,3,"BLIP_YELLOW","CENTER","BLIP_BLACK")
7440 END SUB
8000 REM --- OVER - TWO SECONDS TO READ THE SCORE, THEN FIRE TO PLAY AGAIN ---
8010 SUB UPDATE_OVER
8020   WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
8030   IF WAIT_LEFT=0 AND FIRE THEN START_GAME
8040 END SUB
8100 SUB DRAW_OVER
8110   CLEAR("BLIP_BLACK")
8120   DRAW_TEXT("GAME OVER",320,120,5,"BLIP_RED","CENTER")
8130   DRAW_TEXT("FINAL SCORE",320,190,2,"BLIP_GRAY","CENTER")
8140   DRAW_TEXT(STR$(SCORE),320,214,3,"BLIP_YELLOW","CENTER")
8150   DRAW_TEXT("LEVEL "+STR$(LEVEL),320,250,2,"BLIP_CYAN","CENTER")
8160   IF WAIT_LEFT=0 THEN DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE TO PLAY AGAIN","PRESS FIRE TO PLAY AGAIN","TAP TO PLAY AGAIN"),320,300,2,"BLIP_WHITE","CENTER")
8170 END SUB
8500 REM --- DRAWING ---
8510 SUB DRAW_PLAY
8520   LOCAL C,R,K,D
8530   CLEAR("BLIP_BLACK")
8540   FOR R=0 TO ROWS-1
8550     FOR C=0 TO COLS-1
8560       IF BRICK(C,R) THEN DRAW_TEXTURE(ASSETS$+BRICK_IMAGE$(BRICK(C,R),R),FNBRICK_X(C),FNBRICK_Y(R),BRICK_W,BRICK_H)
8570     NEXT C
8580   NEXT R
8590   IF SEEK_C>=0 AND STATE$="PLAY" THEN DRAW_RECT(FNBRICK_X(SEEK_C)-2,FNBRICK_Y(SEEK_R)-2,BRICK_W+4,BRICK_H+4,COLOR(1,0.75+0.2*SIN(TIME()*8),0.2))
8600   FOR D=1 TO 8
8610     IF DROP(D) THEN DRAW_TEXTURE(ASSETS$+"DROP_"+DROP_NAME$(DROP(D)-1)+".PNG",DROP_X(D),DROP_Y(D),DROP_W,DROP_H)
8620   NEXT D
8630   IF DASH_LEFT>0 THEN FILL_RECT(PAD_X-DASH_DIR*10,PAD_Y,PAD_W,PAD_H,COLOR(0.35,0.75,1,0.25))
8640   DRAW_PADDLE PAD_X,PAD_Y,PAD_W
8650   FOR K=1 TO 3
8660     IF BALL_ON(K) AND STATE$<>"DEAD" THEN DRAW_BALL BALL_X(K),BALL_Y(K),BALL,BALL_ROLL(K)
8670   NEXT K
8680   FX_DRAW()
8690   IF STATE$="LAUNCH" THEN DRAW_TEXT(CONTROL_TEXT$("SPACE TO LAUNCH","FIRE TO LAUNCH","TAP TO LAUNCH"),320,300,2,"BLIP_CYAN","CENTER")
8700   DRAW_PANELS
8710   DRAW_SCORES
8720 END SUB
8800 REM THE BALL IS A ROLLING SPHERE: ONE FRAME OF ITS SHEET, AND A SHADE ON TOP
8810 SUB DRAW_BALL(X,Y,SIZE,ROLL)
8820   DRAW_TEXTURE(ASSETS$+"BALL.PNG",X,Y,SIZE,SIZE,INT(ROLL) MOD 12,12,9,19,0)
8830   DRAW_TEXTURE(ASSETS$+"BALL_SHADE.PNG",X,Y,SIZE,SIZE)
8840 END SUB
8900 REM THE PADDLE'S PICTURE IS CAP, MIDDLE, CAP, SO IT STRETCHES TO ANY WIDTH
8910 SUB DRAW_PADDLE(X,Y,W)
8920   DRAW_TEXTURE(ASSETS$+"PADDLE.PNG",X,Y,6,PAD_H,0,0,12,24)
8930   DRAW_TEXTURE(ASSETS$+"PADDLE.PNG",X+6,Y,W-12,PAD_H,12,0,96,24)
8940   DRAW_TEXTURE(ASSETS$+"PADDLE.PNG",X+W-6,Y,6,PAD_H,108,0,12,24)
8950 END SUB
9000 SUB DRAW_PANELS
9010   FILL_RECT(0,0,FIELD_X,400,PANEL$)
9020   FILL_RECT(FIELD_X+FIELD_W,0,640-FIELD_X-FIELD_W,400,PANEL$)
9030   FILL_RECT(FIELD_X-3,0,3,400,EDGE$)
9040   FILL_RECT(FIELD_X+FIELD_W,0,3,400,EDGE$)
9050 END SUB
9100 REM SCORE AND LEVEL ON THE LEFT; LIVES, AND WHAT IS IN EFFECT, ON THE RIGHT.
9101 REM AN EFFECT BLINKS IN ITS LAST TWO SECONDS
9110 SUB DRAW_SCORES
9120   LOCAL I,Y
9130   DRAW_TEXT("SCORE",60,28,2,"BLIP_GRAY","CENTER")
9140   DRAW_TEXT(STR$(SCORE),60,50,3,"BLIP_YELLOW","CENTER")
9150   DRAW_TEXT("LEVEL",60,110,2,"BLIP_GRAY","CENTER")
9160   DRAW_TEXT(STR$(LEVEL),60,132,3,"BLIP_WHITE","CENTER")
9170   IF CHAIN>1 THEN DRAW_TEXT("X"+STR$(MIN(CHAIN,5)),60,190,3,"BLIP_YELLOW","CENTER")
9180   DRAW_TEXT("LIVES",580,28,2,"BLIP_GRAY","CENTER")
9190   FOR I=1 TO MIN(LIVES,4)
9200     DRAW_BALL 546+(I-1)*18,48,14,0
9210   NEXT I
9220   Y=110
9230   IF WIDTH_LEFT>0 AND PAD_W>64 THEN DRAW_EFFECT "WIDE",WIDTH_LEFT,"BLIP_GREEN",Y:Y=Y+40
9240   IF WIDTH_LEFT>0 AND PAD_W<64 THEN DRAW_EFFECT "NARROW",WIDTH_LEFT,"BLIP_RED",Y:Y=Y+40
9250   IF SLOW_LEFT>0 THEN DRAW_EFFECT "SLOW",SLOW_LEFT,"BLIP_CYAN",Y
9260 END SUB
9300 SUB DRAW_EFFECT(NAME$,LEFT,INK$,Y)
9310   IF LEFT>2 OR INT(LEFT*6) MOD 2=0 THEN DRAW_TEXT(NAME$,580,Y,2,INK$,"CENTER")
9320   DRAW_TEXT(STR$(INT(LEFT)+1)+"S",580,Y+20,2,"BLIP_GRAY","CENTER")
9330 END SUB
9500 REM --- KEYS AND TABLES ---
9510 SUB READ_KEYS
9520   HOLD_LEFT=KEY_ACTIVE("LEFT") OR KEY_ACTIVE("A")
9530   HOLD_RIGHT=KEY_ACTIVE("RIGHT") OR KEY_ACTIVE("D")
9540   TAP_LEFT=KEY_PRESSED("LEFT") OR KEY_PRESSED("A")
9550   TAP_RIGHT=KEY_PRESSED("RIGHT") OR KEY_PRESSED("D")
9560   FIRE=KEY_PRESSED("SPACE") OR KEY_PRESSED("ENTER")
9570 END SUB
9600 REM EACH ROW'S COLOUR, EACH PICKUP'S NAME, AND WHICH PICKUP EACH ROLL OF TEN GIVES
9610 SUB LOAD_TABLES
9620   LOCAL I,R
9630   RESTORE 9690
9640   FOR I=0 TO 5:READ BRICK_COLOR$(I):NEXT I
9645   FOR I=0 TO 5:READ BURST_COLOR$(1,I):NEXT I
9650   FOR I=0 TO 4:READ DROP_NAME$(I):NEXT I
9660   FOR I=0 TO 9:READ DROP_FOR_ROLL(I):NEXT I
9670   FOR R=0 TO 5
9672     BRICK_IMAGE$(1,R)="BRICK_"+BRICK_COLOR$(R)+".PNG"
9674     BRICK_IMAGE$(2,R)="BRICK_BOMB.PNG"
9676     BRICK_IMAGE$(3,R)="BRICK_STEEL.PNG"
9678     BRICK_IMAGE$(4,R)="BRICK_STEEL_CRACKED.PNG"
9682     BURST_COLOR$(2,R)="BLIP_ORANGE"
9684     BURST_COLOR$(4,R)="BLIP_GRAY"
9686   NEXT R
9688 END SUB
9690 DATA "RED","ORANGE","YELLOW","GREEN","BLUE","PURPLE"
9691 DATA "BLIP_RED","BLIP_ORANGE","BLIP_YELLOW","BLIP_GREEN","BLIP_BLUE","NEON_PURPLE"
9692 DATA "WIDE","NARROW","SLOW","LIFE","MULTI"
9693 DATA 0,0, 2,2, 4,4, 1,1,1, 3
