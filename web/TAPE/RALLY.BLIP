10 PLAY_MUSIC "RALLY_MAIN":T=T+0.016
20 CLEAR("BLIP_BLACK")
30 FOR NY=12 TO 189 STEP 12:FILL_RECT(159,NY,2,5,"BLIP_DARKGRAY"):NEXT NY
40 FILL_RECT(85,88,4,24,"BLIP_GRAY"):FILL_RECT(231,88,4,24,"BLIP_GRAY")
50 TRAVEL=T*78-320*INT(T*78/320):BALL_X=80+TRAVEL
60 IF TRAVEL>160 THEN BALL_X=400-TRAVEL
70 BALL_Y=139+SIN(T*2.1)*8
80 FILL_RECT(BALL_X-12,BALL_Y,4,4,COLOR(0.72,0.92,1,0.18)):FILL_RECT(BALL_X-7,BALL_Y,4,4,COLOR(0.72,0.92,1,0.4))
90 FILL_RECT(BALL_X-2,BALL_Y,4,4,"BLIP_WHITE")
100 DRAW_TEXT("RALLY",160,65,5,"BLIP_CYAN","CENTER")
110 DRAW_TEXT("BLIP TABLE TENNIS",160,83,2,"BLIP_GRAY","CENTER")
120 DRAW_TEXT("P1 DIAL / ARROWS: 1 PLAYER",160,103,2,"BLIP_WHITE","CENTER")
130 DRAW_TEXT("P2 DIAL / I K: 2 PLAYERS",160,119,2,"BLIP_WHITE","CENTER")
150 IF KEY_PRESSED("I")=1 OR KEY_PRESSED("K")=1 THEN MODE=2:STOP_MUSIC:GOTO 800
160 IF KEY_PRESSED("UP")=1 OR KEY_PRESSED("DOWN")=1 OR KEY_PRESSED("W")=1 OR KEY_PRESSED("S")=1 OR KEY_PRESSED("SPACE")=1 THEN MODE=1:STOP_MUSIC:GOTO 800
170 WAIT 16:GOTO 10
200 CLEAR("BLIP_BLACK")
210 FILL_RECT(80,10,160,1,"BLIP_GRAY")
220 FOR NET_Y=12 TO 189 STEP 12:FILL_RECT(159,NET_Y,2,5,"BLIP_DARKGRAY"):NEXT NET_Y
230 DRAW_NUMBER(PLAYER_SCORE,134,2,2,"BLIP_CYAN"):DRAW_TEXT(":7",145,2,2,"BLIP_GRAY")
235 DRAW_NUMBER(CPU_SCORE,171,2,2,"BLIP_YELLOW"):DRAW_TEXT(":7",182,2,2,"BLIP_GRAY")
240 FILL_RECT(85,PY,4,24,"BLIP_WHITE"):FILL_RECT(231,CY,4,24,"BLIP_GRAY")
250 FILL_RECT(BX,BY,4,4,"BLIP_WHITE")
255 OLDPY=PY:OLDCY=CY
260 IF KEY_HELD("UP")=1 AND PY>12 THEN PY=PY-2
270 IF KEY_HELD("DOWN")=1 AND PY<165 THEN PY=PY+2
280 IF KEY_HELD("W")=1 AND PY>12 THEN PY=PY-2
290 IF KEY_HELD("S")=1 AND PY<165 THEN PY=PY+2
300 IF MODE=2 AND KEY_HELD("I")=1 AND CY>12 THEN CY=CY-2
310 IF MODE=2 AND KEY_HELD("K")=1 AND CY<165 THEN CY=CY+2
320 IF MODE=1 AND VX>0 AND CY+12<BY+2+AI_ERR AND CY<165 THEN CY=CY+1
330 IF MODE=1 AND VX>0 AND CY+12>BY+2+AI_ERR AND CY>12 THEN CY=CY-1
335 IF MODE=1 AND VX<=0 AND CY<88 THEN CY=CY+0.5
336 IF MODE=1 AND VX<=0 AND CY>88 THEN CY=CY-0.5
340 BX=BX+VX:BY=BY+VY
350 IF BY<10 THEN BY=10:VY=ABS(VY):PLAY_SFX "RALLY/WALL"
360 IF BY>186 THEN BY=186:VY=0-ABS(VY):PLAY_SFX "RALLY/WALL"
370 HITP=0:IF BX<91 AND BX>85 AND BY+4>PY AND BY<PY+24 THEN BX=89:HITP=1:HITDIR=1:AI_ERR=(RND(1)-0.5)*16.8:BALL_SPEED=BALL_SPEED+0.0833
371 IF HITP=1 AND BALL_SPEED>2.5 THEN BALL_SPEED=2.5
372 IF HITP=1 THEN REL=(BY+2-PY-12)/24:IF REL>0.5 THEN REL=0.5
373 IF HITP=1 AND REL<0-0.5 THEN REL=0-0.5
374 IF HITP=1 THEN A=REL*1.1:VX=HITDIR*BALL_SPEED*COS(A):VY=BALL_SPEED*SIN(A)+(PY-OLDPY)*0.0833:V=SQR(VX*VX+VY*VY):VX=VX/V*BALL_SPEED:VY=VY/V*BALL_SPEED:PLAY_SFX "RALLY/HIT_L"
380 IF BX+4>229 AND BX<235 AND BY+4>CY AND BY<CY+24 THEN BX=227:HITP=1:HITDIR=0-1
381 IF HITP=1 AND HITDIR<0 THEN REL=(BY+2-CY-12)/24:IF REL>0.5 THEN REL=0.5
382 IF HITP=1 AND HITDIR<0 AND REL<0-0.5 THEN REL=0-0.5
383 IF HITP=1 AND HITDIR<0 THEN BALL_SPEED=BALL_SPEED+0.0833:IF BALL_SPEED>2.5 THEN BALL_SPEED=2.5
384 IF HITP=1 AND HITDIR<0 THEN A=REL*1.1:VX=HITDIR*BALL_SPEED*COS(A):VY=BALL_SPEED*SIN(A)+(CY-OLDCY)*0.0833:V=SQR(VX*VX+VY*VY):VX=VX/V*BALL_SPEED:VY=VY/V*BALL_SPEED:PLAY_SFX "RALLY/HIT_R"
390 IF BX<78 THEN CPU_SCORE=CPU_SCORE+1:DIR=0-1:PLAY_SFX "RALLY/SCORE_R":GOTO 500
400 IF BX>242 THEN PLAYER_SCORE=PLAYER_SCORE+1:DIR=1:PLAY_SFX "RALLY/SCORE_L":GOTO 500
410 IF PLAYER_SCORE>=7 OR CPU_SCORE>=7 THEN GOTO 700
420 WAIT 16:GOTO 200
500 BX=158:BY=98:VX=0:VY=0:PLAY_MUSIC "RALLY_MAIN":CLEAR("BLIP_BLACK")
510 FOR POINT_NET=12 TO 189 STEP 12:FILL_RECT(159,POINT_NET,2,5,"BLIP_DARKGRAY"):NEXT POINT_NET
520 DRAW_NUMBER(PLAYER_SCORE,134,2,2,"BLIP_CYAN"):DRAW_TEXT(":7",145,2,2,"BLIP_GRAY"):DRAW_NUMBER(CPU_SCORE,171,2,2,"BLIP_YELLOW"):DRAW_TEXT(":7",182,2,2,"BLIP_GRAY")
530 DRAW_TEXT("POINT!",160,96,3,"BLIP_YELLOW","CENTER")
540 WAIT 1200:GOTO 600
600 PLAY_MUSIC "RALLY_MAIN":CLEAR("BLIP_BLACK"):FILL_RECT(80,10,160,1,"BLIP_GRAY")
610 FOR SERVE_NET=12 TO 189 STEP 12:FILL_RECT(159,SERVE_NET,2,5,"BLIP_DARKGRAY"):NEXT SERVE_NET
620 DRAW_NUMBER(PLAYER_SCORE,134,2,2,"BLIP_CYAN"):DRAW_TEXT(":7",145,2,2,"BLIP_GRAY")
630 DRAW_NUMBER(CPU_SCORE,171,2,2,"BLIP_YELLOW"):DRAW_TEXT(":7",182,2,2,"BLIP_GRAY")
635 IF KEY_HELD("UP")=1 AND PY>12 THEN PY=PY-2
636 IF KEY_HELD("DOWN")=1 AND PY<165 THEN PY=PY+2
637 IF KEY_HELD("W")=1 AND PY>12 THEN PY=PY-2
638 IF KEY_HELD("S")=1 AND PY<165 THEN PY=PY+2
639 IF MODE=2 AND KEY_HELD("K")=1 AND CY<165 THEN CY=CY+2
640 IF MODE=2 AND KEY_HELD("I")=1 AND CY>12 THEN CY=CY-2
645 FILL_RECT(85,PY,4,24,"BLIP_WHITE"):FILL_RECT(231,CY,4,24,"BLIP_GRAY"):FILL_RECT(BX,BY,4,4,"BLIP_WHITE")
650 DRAW_TEXT("PRESS FIRE",160,119,2,"BLIP_GRAY","CENTER")
660 IF KEY_PRESSED("SPACE")=1 OR KEY_PRESSED("UP")=1 OR KEY_PRESSED("DOWN")=1 OR KEY_PRESSED("W")=1 OR KEY_PRESSED("S")=1 OR KEY_PRESSED("I")=1 OR KEY_PRESSED("K")=1 THEN BALL_SPEED=1.5:A=(RND(1)-0.5)*0.77:VX=DIR*BALL_SPEED*COS(A):VY=BALL_SPEED*SIN(A):STOP_MUSIC:GOTO 200
670 WAIT 16:GOTO 600
700 PLAY_MUSIC "RALLY_MAIN":CLEAR("BLIP_BLACK"):FILL_RECT(80,10,160,1,"BLIP_GRAY")
710 FOR OVER_NET=12 TO 189 STEP 12:FILL_RECT(159,OVER_NET,2,5,"BLIP_DARKGRAY"):NEXT OVER_NET
720 DRAW_NUMBER(PLAYER_SCORE,134,2,2,"BLIP_CYAN"):DRAW_TEXT(":7",145,2,2,"BLIP_GRAY")
730 DRAW_NUMBER(CPU_SCORE,171,2,2,"BLIP_YELLOW"):DRAW_TEXT(":7",182,2,2,"BLIP_GRAY")
740 DRAW_TEXT("MATCH OVER",160,74,4,"BLIP_CYAN","CENTER")
750 IF PLAYER_SCORE>CPU_SCORE THEN DRAW_TEXT("PLAYER 1 WINS",160,105,3,"BLIP_YELLOW","CENTER")
760 IF PLAYER_SCORE<CPU_SCORE AND MODE=1 THEN DRAW_TEXT("CPU WINS",160,105,3,"BLIP_RED","CENTER")
770 IF PLAYER_SCORE<CPU_SCORE AND MODE=2 THEN DRAW_TEXT("PLAYER 2 WINS",160,105,3,"BLIP_RED","CENTER")
780 DRAW_TEXT("MOVE A PADDLE TO PLAY AGAIN",160,137,2,"BLIP_WHITE","CENTER")
790 IF KEY_PRESSED("UP")=1 OR KEY_PRESSED("DOWN")=1 OR KEY_PRESSED("W")=1 OR KEY_PRESSED("S")=1 OR KEY_PRESSED("I")=1 OR KEY_PRESSED("K")=1 THEN PLAYER_SCORE=0:CPU_SCORE=0:GOTO 800
795 WAIT 16:GOTO 700
800 PLAYER_SCORE=0:CPU_SCORE=0:PY=88:CY=88:BX=158:BY=98:VX=0:VY=0:AI_ERR=0:BALL_SPEED=1.5:DIR=1
810 IF RND(2)<1 THEN DIR=0-1
820 WAIT 16:GOTO 600
