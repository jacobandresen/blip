1 REM FLOW: TITLE 10 -> MATCH 800 -> SERVE/PLAY 200 -> DRAW 500.
2 REM MODULES: FIELD 900; PADDLES 1000; SWEPT BALL STEP 1100; BOUNCE 1300.
3 REM STATE: STATE=0 SERVE, 1 PLAY, 2 POINT PAUSE, 3 MATCH OVER.
5 REM GAME: RALLY
10 REM RALLY - TITLE AND ONE- OR TWO-PLAYER SELECTION
11 CANVAS(480,540):PLAY_MUSIC "RALLY_MAIN":TT=TIME()
20 CLEAR("BLIP_BLACK")
30 FOR NY=28 TO 539 STEP 22:FILL_RECT(239,NY,3,13,"#2A2A2A"):NEXT NY
40 FILL_RECT(0,27,480,1,"#1C1C1C"):DRAW_TEXT("0:7",168,5,2,"BLIP_YELLOW"):DRAW_TEXT("0:7",260,5,2,"BLIP_YELLOW"):FILL_RECT(28,248,12,72,"#D2D2D2"):FILL_RECT(440,248,12,72,"#D2D2D2")
50 TRAVEL=TT*150-960*INT(TT*150/960):BALL_X=TRAVEL:TRAIL_DIR=-1
60 IF TRAVEL>480 THEN BALL_X=960-TRAVEL:TRAIL_DIR=1
70 BALL_Y=410+SIN(TT*2.1)*10
80 FOR I=0 TO 2:ALPHA=0.12:IF I=1 THEN ALPHA=0.24
81 IF I=2 THEN ALPHA=0.42
82 FILL_RECT(BALL_X+(I+1)*9*TRAIL_DIR,BALL_Y,12,12,COLOR(0.72,0.92,1,ALPHA)):NEXT I
90 FILL_RECT(BALL_X,BALL_Y,12,12,"BLIP_WHITE")
100 DRAW_TEXT("RALLY",240,250,5,"BLIP_YELLOW","CENTER")
120 DRAW_TEXT("MOVE LEFT PADDLE: 1 PLAYER",240,298,2,"BLIP_WHITE","CENTER")
130 DRAW_TEXT("MOVE RIGHT PADDLE: 2 PLAYERS",240,320,2,"BLIP_WHITE","CENTER")
150 IF KEY_PRESSED("I")=1 OR KEY_PRESSED("K")=1 THEN MODE=2:STOP_MUSIC:GOTO 800
160 IF KEY_PRESSED("UP")=1 OR KEY_PRESSED("DOWN")=1 OR KEY_PRESSED("W")=1 OR KEY_PRESSED("S")=1 OR KEY_PRESSED("SPACE")=1 THEN MODE=1:STOP_MUSIC:GOTO 800
170 WAIT 0:GOTO 10
199 REM --- UPDATE - NATIVE RESOLUTION AND ELAPSED SECONDS ---
200 CANVAS(480,540):NOW=TIME():DT=CLAMP(NOW-LAST_TIME,0.0001,0.1):LAST_TIME=NOW:PREVIOUS_STATE=STATE
210 IF STATE=2 THEN POINT_WAIT=MAX(0,POINT_WAIT-DT):IF POINT_WAIT=0 THEN STATE=0
220 IF STATE=3 THEN OVER_WAIT=MAX(0,OVER_WAIT-DT):GOTO 700
230 IF PREVIOUS_STATE=2 THEN GOTO 500
240 GOSUB 1000
250 IF STATE=0 AND (KEY_PRESSED("SPACE") OR KEY_PRESSED("ENTER") OR KEY_PRESSED("UP") OR KEY_PRESSED("DOWN") OR KEY_PRESSED("W") OR KEY_PRESSED("S") OR KEY_PRESSED("I") OR KEY_PRESSED("K")) THEN GOSUB 1200:GOTO 500
260 IF STATE=1 THEN GOSUB 1100
270 GOTO 500
499 REM --- DRAW THE CURRENT STATE WITHOUT ADVANCING ITS PHYSICS ---
500 GOSUB 900
510 IF STATE=0 THEN DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE","PRESS FIRE","TAP TO SERVE"),240,338,2,"BLIP_GRAY","CENTER")
520 IF STATE=2 AND INT(POINT_WAIT*6)-2*INT(INT(POINT_WAIT*6)/2)=0 THEN DRAW_TEXT("POINT!",240,284,3,"BLIP_YELLOW","CENTER")
590 WAIT 0:GOTO 200
599 REM --- SERVE ENTRY - THE BALL WAITS WHILE PADDLES CAN MOVE ---
600 STATE=0:GOTO 200
699 REM --- MATCH OVER - A TWO-SECOND READ BEFORE RESTART ---
700 GOSUB 900:RESULT$="GAME OVER"
710 IF MODE=1 AND PLAYER_SCORE>=7 THEN RESULT$="YOU WIN!"
720 IF MODE=2 AND PLAYER_SCORE>=7 THEN RESULT$="P1 WINS!"
730 IF MODE=2 AND CPU_SCORE>=7 THEN RESULT$="P2 WINS!"
740 DRAW_TEXT(RESULT$,240,264,3,"BLIP_YELLOW","CENTER")
750 IF OVER_WAIT=0 THEN DRAW_TEXT("MOVE A PADDLE TO PLAY AGAIN",240,308,2,"BLIP_GRAY","CENTER")
760 IF OVER_WAIT=0 AND (KEY_PRESSED("UP") OR KEY_PRESSED("DOWN") OR KEY_PRESSED("W") OR KEY_PRESSED("S") OR KEY_PRESSED("I") OR KEY_PRESSED("K")) THEN GOTO 800
770 WAIT 0:GOTO 200
799 REM --- NEW MATCH - SCORES, SERVE DIRECTION, AND CENTERED PADDLES ---
800 GAME_STATE=1:PLAYER_SCORE=0:CPU_SCORE=0:AI_ERR=0:DIR=1:IF RND(2)<1 THEN DIR=0-1
810 GOSUB 1500:STATE=0:PLAY_MUSIC "RALLY_MAIN":LAST_TIME=TIME():GOTO 200
899 REM --- NATIVE FIELD - HUD, NET, BOTH PADDLES, AND THE BALL ---
900 CLEAR("BLIP_BLACK")
910 FOR NET_Y=28 TO 539 STEP 22:FILL_RECT(239,NET_Y,3,13,"#2A2A2A"):NEXT NET_Y
920 FILL_RECT(0,27,480,1,"#1C1C1C"):DRAW_TEXT(STR$(PLAYER_SCORE)+":7",168,5,2,"BLIP_YELLOW"):DRAW_TEXT(STR$(CPU_SCORE)+":7",260,5,2,"BLIP_YELLOW")
930 IF STATE<2 THEN FILL_RECT(28,PY,12,72,"#D2D2D2"):FILL_RECT(440,CY,12,72,"#D2D2D2"):FILL_RECT(BX,BY,12,12,"BLIP_WHITE")
940 RETURN
999 REM --- PADDLES - OR ALIASES ONCE; CPU TRACKS ONLY AN APPROACHING BALL ---
1000 OLDPY=PY:OLDCY=CY
1010 PY=PY+300*DT*((KEY_ACTIVE("DOWN") OR KEY_ACTIVE("S"))-(KEY_ACTIVE("UP") OR KEY_ACTIVE("W")))
1020 IF MODE=2 THEN CY=CY+300*DT*(KEY_ACTIVE("K")-KEY_ACTIVE("I"))
1030 IF MODE=1 AND STATE=1 THEN TARGET=248:AI_MOVE=145*DT*0.5:IF VX>0 THEN TARGET=BY+6-36+AI_ERR:AI_MOVE=145*DT
1040 IF MODE=1 AND STATE=1 THEN CY=CY+CLAMP(TARGET-CY,0-AI_MOVE,AI_MOVE)
1050 PY=CLAMP(PY,30,466):CY=CLAMP(CY,30,466):LPAD_VY=(PY-OLDPY)/DT:RPAD_VY=(CY-OLDCY)/DT:RETURN
1099 REM --- BALL - SUBSTEPS AND SWEPT HITS PREVENT TUNNELING AT LOW FRAME RATES ---
1100 SPEED=MAX(1,SQR(VX*VX+VY*VY)):SUBSTEPS=CLAMP(0-INT(0-SPEED*DT/6),1,8):SDT=DT/SUBSTEPS
1110 FOR BALL_STEP=1 TO SUBSTEPS
1120 PREV_X=BX+6:PREV_Y=BY+6:BX=BX+VX*SDT:BY=BY+VY*SDT:NEXT_X=BX+6:NEXT_Y=BY+6
1130 IF BY<28 THEN BY=56-BY:VY=ABS(VY):PLAY_SFX "RALLY/WALL"
1140 IF BY+12>540 THEN BY=1056-BY:VY=0-ABS(VY):PLAY_SFX "RALLY/WALL"
1150 IF VX<0 AND SEGMENT_RECT_OVERLAP(PREV_X,PREV_Y,NEXT_X,NEXT_Y,22,PY-6,24,84) THEN BX=40:HIT_Y=PY:HIT_VY=LPAD_VY:HIT_DIR=1:GOSUB 1300:AI_ERR=RND(1)*50.4-25.2:PLAY_SFX "RALLY/HIT_L"
1160 IF VX>0 AND SEGMENT_RECT_OVERLAP(PREV_X,PREV_Y,NEXT_X,NEXT_Y,434,CY-6,24,84) THEN BX=428:HIT_Y=CY:HIT_VY=RPAD_VY:HIT_DIR=0-1:GOSUB 1300:PLAY_SFX "RALLY/HIT_R"
1170 IF BX+12<0 THEN CPU_SCORE=CPU_SCORE+1:DIR=0-1:PLAY_SFX "RALLY/SCORE_R":GOSUB 1400:BALL_STEP=SUBSTEPS
1180 IF BX>480 THEN PLAYER_SCORE=PLAYER_SCORE+1:DIR=1:PLAY_SFX "RALLY/SCORE_L":GOSUB 1400:BALL_STEP=SUBSTEPS
1190 NEXT BALL_STEP:RETURN
1199 REM --- LAUNCH - THE POINT'S LOSER RECEIVES A SLIGHTLY ANGLED SERVE ---
1200 A=(RND(1)-0.5)*0.77:VX=DIR*BALL_SPEED*COS(A):VY=BALL_SPEED*SIN(A):STATE=1:STOP_MUSIC:RETURN
1299 REM --- PADDLE BOUNCE - IMPACT ANGLE, SPEED RAMP, AND QUARTER-VELOCITY SPIN ---
1300 REL=CLAMP((BY+6-HIT_Y)/72-0.5,0-0.5,0.5):BALL_SPEED=MIN(BALL_SPEED+15,450):A=REL*1.1
1310 VX=HIT_DIR*BALL_SPEED*COS(A):VY=BALL_SPEED*SIN(A)+HIT_VY*0.25:MAGNITUDE=MAX(1,SQR(VX*VX+VY*VY))
1320 VX=VX/MAGNITUDE*BALL_SPEED:VY=VY/MAGNITUDE*BALL_SPEED:RETURN
1399 REM --- POINT - FIRST TO SEVEN WINS; OTHERWISE RESET AND PAUSE 1.2 SECONDS ---
1400 PLAY_MUSIC "RALLY_MAIN"
1410 IF PLAYER_SCORE>=7 OR CPU_SCORE>=7 THEN STATE=3:OVER_WAIT=2:GAME_STATE=2:RETURN
1420 GOSUB 1500:STATE=2:POINT_WAIT=1.2:RETURN
1499 REM --- RESET FOR SERVE - THE NATIVE 72-PIXEL PADDLES START CENTERED ---
1500 PY=248:CY=248:BX=234:BY=278:VX=0:VY=0:BALL_SPEED=275:RETURN
