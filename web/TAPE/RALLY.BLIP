1 REM RALLY - TWO PADDLES AND A BALL. FIRST TO SEVEN WINS.
2 REM GAME: RALLY
3 REM LEFT PADDLE: W/S OR THE ARROWS. RIGHT PADDLE: I/K, OR THE CPU.
4 REM SCREENS: TITLE, SERVE, PLAY, POINT, OVER - EACH HAS AN UPDATE AND A DRAW.
10 REM --- SETUP ---
11 ASSETS$="/TAPE/RALLY/ASSETS/"
20 WIN=7
25 TOP=32
30 PAD_W=12:PAD_H=64
35 LEFT_X=32:RIGHT_X=596
40 HOME_Y=184
45 BALL=12
50 PAD_SPEED=320:CPU_SPEED=170
55 SERVE_SPEED=360:SPEED_UP=20:TOP_SPEED=600
60 PAD$="#D2D2D2"
70 PLAY_MUSIC ASSETS$+"LOOP1.WAV"
80 STATE$="TITLE"
90 LAST_TIME=TIME()
100 REM --- MAIN LOOP - UPDATE THE SCREEN WE ARE ON, THEN DRAW IT ---
110 NOW=TIME()
111 DT=CLAMP(NOW-LAST_TIME,0.0001,0.1)
112 LAST_TIME=NOW
120 READ_KEYS
130 IF STATE$="TITLE" THEN
131   UPDATE_TITLE
132 ELSEIF STATE$="SERVE" THEN
133   UPDATE_SERVE
134 ELSEIF STATE$="PLAY" THEN
135   UPDATE_PLAY
136 ELSEIF STATE$="POINT" THEN
137   UPDATE_POINT
138 ELSE
139   UPDATE_OVER
140 END IF
150 IF STATE$="TITLE" THEN
151   DRAW_TITLE
152 ELSEIF STATE$="SERVE" THEN
153   DRAW_SERVE
154 ELSEIF STATE$="PLAY" THEN
155   DRAW_PLAY
156 ELSEIF STATE$="POINT" THEN
157   DRAW_POINT
158 ELSE
159   DRAW_OVER
160 END IF
170 WAIT 0
180 GOTO 110
1000 REM --- TITLE - MOVE A PADDLE TO CHOOSE ONE OR TWO PLAYERS ---
1010 SUB UPDATE_TITLE
1020   IF RIGHT_MOVED THEN
1030     PLAYERS=2
1040     START_GAME
1050   ELSEIF LEFT_MOVED OR FIRE THEN
1060     PLAYERS=1
1070     START_GAME
1080   END IF
1090 END SUB
1100 SUB DRAW_TITLE
1110   LOCAL T,X,Y,SIDE,I
1120   CLEAR("BLIP_BLACK")
1130   DRAW_NET
1140   DRAW_SCORES 0,0
1150   FILL_RECT(LEFT_X,HOME_Y,PAD_W,PAD_H,PAD$)
1160   FILL_RECT(RIGHT_X,HOME_Y,PAD_W,PAD_H,PAD$)
1170   REM THE BALL CROSSES THE COURT AND BACK, ITS TRAIL FADING BEHIND IT
1180   T=TIME()
1190   X=T*190 MOD 1280
1200   SIDE=-1
1210   IF X>640 THEN X=1280-X:SIDE=1
1220   Y=300+SIN(T*2.1)*10
1230   FOR I=1 TO 3
1240     FILL_RECT(X+I*9*SIDE,Y,BALL,BALL,COLOR(0.72,0.92,1,0.12*(4-I)))
1250   NEXT I
1260   FILL_RECT(X,Y,BALL,BALL,"BLIP_WHITE")
1270   DRAW_TEXT("RALLY",320,112,6,"BLIP_YELLOW","CENTER")
1280   DRAW_TEXT("MOVE LEFT PADDLE: 1 PLAYER",320,194,2,"BLIP_WHITE","CENTER")
1290   DRAW_TEXT("MOVE RIGHT PADDLE: 2 PLAYERS",320,218,2,"BLIP_WHITE","CENTER")
1300 END SUB
2000 REM --- START - A NEW MATCH, AND THE COURT BEFORE EACH SERVE ---
2010 SUB START_GAME
2020   LEFT_SCORE=0:RIGHT_SCORE=0
2030   AI_ERR=0
2040   SERVE_DIR=1
2050   IF RND(2)<1 THEN SERVE_DIR=-1
2060   RESET_FOR_SERVE
2070   STATE$="SERVE"
2080 END SUB
2100 SUB RESET_FOR_SERVE
2110   LPAD_Y=HOME_Y:RPAD_Y=HOME_Y
2120   BALL_X=320-BALL/2:BALL_Y=216-BALL/2
2130   BALL_VX=0:BALL_VY=0
2140   BALL_SPEED=SERVE_SPEED
2150 END SUB
2200 REM THE LOSER OF THE LAST POINT RECEIVES, AT A SLIGHT ANGLE
2210 SUB LAUNCH
2220   LOCAL ANGLE
2230   ANGLE=(RND(1)-0.5)*0.77
2240   BALL_VX=SERVE_DIR*BALL_SPEED*COS(ANGLE)
2250   BALL_VY=BALL_SPEED*SIN(ANGLE)
2260 END SUB
3000 REM --- PLAY - THE PADDLES ALWAYS MOVE; THE BALL WAITS FOR THE SERVE ---
3010 SUB UPDATE_SERVE
3020   MOVE_PADDLES
3030   IF FIRE OR LEFT_MOVED OR RIGHT_MOVED THEN
3040     LAUNCH
3050     STATE$="PLAY"
3060   END IF
3070 END SUB
3100 SUB UPDATE_PLAY
3110   LOCAL OLD_L,OLD_R
3120   OLD_L=LPAD_Y:OLD_R=RPAD_Y
3130   MOVE_PADDLES
3140   REM A MOVING PADDLE PUTS SPIN ON THE BALL
3150   LPAD_VY=(LPAD_Y-OLD_L)/DT
3160   RPAD_VY=(RPAD_Y-OLD_R)/DT
3170   MOVE_BALL
3180 END SUB
3200 SUB DRAW_SERVE
3210   DRAW_PLAY
3220   DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE","PRESS FIRE","TAP TO SERVE"),320,256,2,"BLIP_GRAY","CENTER")
3230 END SUB
3300 SUB DRAW_PLAY
3310   CLEAR("BLIP_BLACK")
3320   DRAW_NET
3330   DRAW_SCORES LEFT_SCORE,RIGHT_SCORE
3340   FILL_RECT(LEFT_X,LPAD_Y,PAD_W,PAD_H,PAD$)
3350   FILL_RECT(RIGHT_X,RPAD_Y,PAD_W,PAD_H,PAD$)
3360   FILL_RECT(BALL_X,BALL_Y,BALL,BALL,"BLIP_WHITE")
3370 END SUB
4000 REM --- PADDLES - THE CPU CHASES THE BALL ONLY WHILE IT IS COMING ---
4010 SUB MOVE_PADDLES
4020   LOCAL TARGET,REACH
4030   LPAD_Y=LPAD_Y+PAD_SPEED*DT*(LEFT_DOWN-LEFT_UP)
4040   IF PLAYERS=2 THEN
4050     RPAD_Y=RPAD_Y+PAD_SPEED*DT*(RIGHT_DOWN-RIGHT_UP)
4060   ELSEIF STATE$="PLAY" THEN
4070     TARGET=HOME_Y
4080     REACH=CPU_SPEED*DT/2
4090     IF BALL_VX>0 THEN
4100       TARGET=BALL_Y+BALL/2-PAD_H/2+AI_ERR
4110       REACH=CPU_SPEED*DT
4120     END IF
4130     RPAD_Y=RPAD_Y+CLAMP(TARGET-RPAD_Y,-REACH,REACH)
4140   END IF
4150   LPAD_Y=CLAMP(LPAD_Y,TOP+2,400-PAD_H-2)
4160   RPAD_Y=CLAMP(RPAD_Y,TOP+2,400-PAD_H-2)
4170 END SUB
5000 REM --- BALL - SMALL STEPS, SO A FAST BALL CANNOT JUMP A PADDLE ---
5010 SUB MOVE_BALL
5020   LOCAL SPEED,STEPS,SDT,I,LEFT_AT,RIGHT_AT
5030   SPEED=MAX(1,SQR(BALL_VX*BALL_VX+BALL_VY*BALL_VY))
5040   STEPS=CLAMP(-INT(-SPEED*DT/6),1,8)
5050   SDT=DT/STEPS
5060   FOR I=1 TO STEPS
5070     REM THE PADDLES TOO ARE WHERE THEY WERE PARTWAY THROUGH THE FRAME
5080     LEFT_AT=LPAD_Y-LPAD_VY*DT*(1-(I-0.5)/STEPS)
5090     RIGHT_AT=RPAD_Y-RPAD_VY*DT*(1-(I-0.5)/STEPS)
5100     X0=BALL_X+BALL/2:Y0=BALL_Y+BALL/2
5110     BALL_X=BALL_X+BALL_VX*SDT
5120     BALL_Y=BALL_Y+BALL_VY*SDT
5130     BOUNCE_OFF_WALLS
5140     IF BALL_VX<0 AND FNHITS_PADDLE(LEFT_X,LEFT_AT) THEN
5150       BALL_X=LEFT_X+PAD_W
5160       BOUNCE LEFT_AT,LPAD_VY,1
5170       AI_ERR=RND(1)*PAD_H*0.7-PAD_H*0.35
5180       PLAY_SFX ASSETS$+"HIT_L.WAV"
5190     ELSEIF BALL_VX>0 AND FNHITS_PADDLE(RIGHT_X,RIGHT_AT) THEN
5200       BALL_X=RIGHT_X-BALL
5210       BOUNCE RIGHT_AT,RPAD_VY,-1
5220       PLAY_SFX ASSETS$+"HIT_R.WAV"
5230     END IF
5240     IF BALL_X+BALL<0 THEN AWARD_POINT 0:EXIT SUB
5250     IF BALL_X>640 THEN AWARD_POINT 1:EXIT SUB
5260   NEXT I
5270 END SUB
5300 SUB BOUNCE_OFF_WALLS
5310   IF BALL_Y<TOP THEN
5320     BALL_Y=2*TOP-BALL_Y
5330     BALL_VY=ABS(BALL_VY)
5340     PLAY_SFX ASSETS$+"WALL.WAV"
5350   ELSEIF BALL_Y+BALL>400 THEN
5360     BALL_Y=2*(400-BALL)-BALL_Y
5370     BALL_VY=-ABS(BALL_VY)
5380     PLAY_SFX ASSETS$+"WALL.WAV"
5390   END IF
5400 END SUB
5500 REM WHERE THE BALL MEETS THE PADDLE SETS ITS ANGLE; IT SPEEDS UP A LITTLE EACH HIT
5510 SUB BOUNCE(PAD_Y,PAD_VY,DIR)
5520   LOCAL ANGLE,LENGTH
5530   BALL_SPEED=MIN(BALL_SPEED+SPEED_UP,TOP_SPEED)
5540   ANGLE=CLAMP((BALL_Y+BALL/2-PAD_Y)/PAD_H-0.5,-0.5,0.5)*1.1
5550   BALL_VX=DIR*BALL_SPEED*COS(ANGLE)
5560   BALL_VY=BALL_SPEED*SIN(ANGLE)+PAD_VY*0.25
5570   REM THE SPIN BENDS THE BALL BUT NEVER SPEEDS IT UP
5580   LENGTH=MAX(1,SQR(BALL_VX*BALL_VX+BALL_VY*BALL_VY))
5590   BALL_VX=BALL_VX/LENGTH*BALL_SPEED
5600   BALL_VY=BALL_VY/LENGTH*BALL_SPEED
5610 END SUB
5700 REM THE BALL'S PATH THIS STEP, FROM X0,Y0, AGAINST A PADDLE GROWN BY HALF A BALL
5710 DEF FNHITS_PADDLE(X,Y)=SEGMENT_RECT_OVERLAP(X0,Y0,BALL_X+BALL/2,BALL_Y+BALL/2,X-BALL/2,Y-BALL/2,PAD_W+BALL,PAD_H+BALL)
7000 REM --- POINT - SCORE IT, THEN PAUSE BEFORE THE NEXT SERVE ---
7010 SUB AWARD_POINT(LEFT_SCORED)
7020   IF LEFT_SCORED THEN
7030     LEFT_SCORE=LEFT_SCORE+1
7040     SERVE_DIR=1
7050     PLAY_SFX ASSETS$+"SCORE_L.WAV"
7060   ELSE
7070     RIGHT_SCORE=RIGHT_SCORE+1
7080     SERVE_DIR=-1
7090     PLAY_SFX ASSETS$+"SCORE_R.WAV"
7100   END IF
7110   IF LEFT_SCORE>=WIN OR RIGHT_SCORE>=WIN THEN
7120     STATE$="OVER"
7130     WAIT_LEFT=2
7140   ELSE
7150     RESET_FOR_SERVE
7160     STATE$="POINT"
7170     WAIT_LEFT=1.2
7180   END IF
7190 END SUB
7200 SUB UPDATE_POINT
7210   WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
7220   IF WAIT_LEFT=0 THEN STATE$="SERVE"
7230 END SUB
7300 SUB DRAW_POINT
7310   CLEAR("BLIP_BLACK")
7320   DRAW_NET
7330   DRAW_SCORES LEFT_SCORE,RIGHT_SCORE
7340   REM THE WORD BLINKS THREE TIMES A SECOND
7350   IF INT(WAIT_LEFT*6) MOD 2=0 THEN DRAW_TEXT("POINT!",320,200,3,"BLIP_YELLOW","CENTER")
7360 END SUB
8000 REM --- OVER - TWO SECONDS TO READ THE RESULT, THEN MOVE A PADDLE ---
8010 SUB UPDATE_OVER
8020   WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
8030   IF WAIT_LEFT=0 AND (LEFT_MOVED OR RIGHT_MOVED) THEN START_GAME
8040 END SUB
8100 SUB DRAW_OVER
8110   LOCAL RESULT$
8120   CLEAR("BLIP_BLACK")
8130   DRAW_NET
8140   DRAW_SCORES LEFT_SCORE,RIGHT_SCORE
8150   IF PLAYERS=2 THEN
8160     IF LEFT_SCORE>=WIN THEN RESULT$="P1 WINS!" ELSE RESULT$="P2 WINS!"
8170   ELSE
8180     IF LEFT_SCORE>=WIN THEN RESULT$="YOU WIN!" ELSE RESULT$="GAME OVER"
8190   END IF
8200   DRAW_TEXT(RESULT$,320,180,3,"BLIP_YELLOW","CENTER")
8210   IF WAIT_LEFT=0 THEN DRAW_TEXT("MOVE A PADDLE TO PLAY AGAIN",320,224,2,"BLIP_GRAY","CENTER")
8220 END SUB
9000 REM --- HELPERS - THE KEYS, ONCE A FRAME, AND THE COURT ---
9010 SUB READ_KEYS
9020   LEFT_UP=KEY_ACTIVE("UP") OR KEY_ACTIVE("W")
9030   LEFT_DOWN=KEY_ACTIVE("DOWN") OR KEY_ACTIVE("S")
9040   RIGHT_UP=KEY_ACTIVE("I")
9050   RIGHT_DOWN=KEY_ACTIVE("K")
9060   LEFT_MOVED=KEY_PRESSED("UP") OR KEY_PRESSED("DOWN") OR KEY_PRESSED("W") OR KEY_PRESSED("S")
9070   RIGHT_MOVED=KEY_PRESSED("I") OR KEY_PRESSED("K")
9080   FIRE=KEY_PRESSED("SPACE") OR KEY_PRESSED("ENTER")
9090 END SUB
9100 SUB DRAW_NET
9110   LOCAL Y
9120   FOR Y=TOP TO 399 STEP 22
9130     FILL_RECT(319,Y,3,13,"#2A2A2A")
9140   NEXT Y
9150 END SUB
9200 SUB DRAW_SCORES(LEFT,RIGHT)
9210   FILL_RECT(0,TOP-1,640,1,"#1C1C1C")
9220   DRAW_TEXT(STR$(LEFT)+":"+STR$(WIN),248,8,2,"BLIP_YELLOW")
9230   DRAW_TEXT(STR$(RIGHT)+":"+STR$(WIN),340,8,2,"BLIP_YELLOW")
9240 END SUB
