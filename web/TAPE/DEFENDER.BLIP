1 REM DEFENDER - HOLD THE GROUND AGAINST THE MARCHING FORMATION.
2 REM GAME: DEFENDER
3 REM LEFT/RIGHT MOVE, SPACE FIRES. EVERY FIFTH WAVE ENDS WITH A MOTHERSHIP.
4 REM SCREENS: TITLE, PLAY, DEAD, CLEAR, OVER - EACH HAS AN UPDATE AND A DRAW.
5 REM ALIEN I IS ROW R, COLUMN C OF THE FORMATION: I=R*COLS+C+1, COUNTING FROM 0.
10 REM --- SETUP ---
11 ASSETS$="/TAPE/DEFENDER/ASSETS/"
15 GROUND=376:SHIP_Y=352
20 ALIEN_W=36:ALIEN_H=24
25 GAP_X=8:GAP_Y=4:FORMATION_Y=58
30 SPEED=200:ACCEL=2200:BRAKE=3200
35 SHOT_SPEED=315:BOMBS=4
40 SHIELD_Y=300:BLOCK=10
45 UFO_Y=32:UFO_W=36:UFO_H=20
50 BOSS_W=94:BOSS_H=52:BOSS_Y=78
55 LOAD_THEMES
80 PLAY_MUSIC ASSETS$+"INVASION.WAV"
85 STATE$="TITLE"
90 LAST_TIME=TIME()
100 REM --- MAIN LOOP - UPDATE THE SCREEN WE ARE ON, THEN DRAW IT ---
110 NOW=TIME()
111 DT=CLAMP(NOW-LAST_TIME,0.0001,0.05)
112 LAST_TIME=NOW
120 READ_KEYS
130 IF STATE$="TITLE" THEN
131   UPDATE_TITLE
132 ELSEIF STATE$="PLAY" THEN
133   UPDATE_PLAY
134 ELSEIF STATE$="DEAD" THEN
135   UPDATE_DEAD
136 ELSEIF STATE$="CLEAR" THEN
137   UPDATE_CLEAR
138 ELSE
139   UPDATE_OVER
140 END IF
150 IF STATE$="TITLE" THEN
151   DRAW_TITLE
152 ELSEIF STATE$="CLEAR" THEN
153   DRAW_CLEAR
154 ELSEIF STATE$="OVER" THEN
155   DRAW_OVER
156 ELSE
157   DRAW_PLAY
158 END IF
170 WAIT 0
180 GOTO 110
1000 REM --- TITLE - THE POINT VALUES, AND A PATROL STEPPING ACROSS THE FOOT ---
1010 SUB UPDATE_TITLE
1020   IF FIRE THEN START_GAME
1030 END SUB
1100 SUB DRAW_TITLE
1110   LOCAL BEAT,FRAME$,K,I,STEP_X,AT
1120   BEAT=INT(TIME()*2)
1130   IF BEAT MOD 2 THEN FRAME$="B" ELSE FRAME$="A"
1140   CLEAR("BLIP_BLACK")
1150   DRAW_TEXT("DEFENDER",320,64,6,"BLIP_MAGENTA","CENTER")
1170   FOR K=0 TO 2
1180     DRAW_TEXTURE(ASSETS$+ALIEN_IMAGE$(K)+FRAME$,258,170+K*24,24,18,ALIEN_COLOR$(K))
1190     DRAW_TEXT(STR$(30-K*10)+" PTS",340,172+K*24,2,ALIEN_COLOR$(K),"CENTER")
1200   NEXT K
1210   DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE","PRESS FIRE","TAP TO START"),320,262,3,"BLIP_WHITE","CENTER")
1220   AT=BEAT MOD 10
1230   IF AT<5 THEN STEP_X=AT ELSE STEP_X=9-AT
1240   FOR I=0 TO 5
1250     DRAW_TEXTURE(ASSETS$+ALIEN_IMAGE$(I MOD 3)+FRAME$,150+I*60+STEP_X*12,340,24,18,ALIEN_COLOR$(I MOD 3))
1260   NEXT I
1270 END SUB
2000 REM --- START - A NEW GAME, AND EACH WAVE ---
2010 SUB START_GAME
2020   SCORE=0:LIVES=3
2030   LEVEL=1
2040   START_WAVE
2050   PLAY_MUSIC ASSETS$+"INVASION.WAV"
2060 END SUB
2100 REM EACH WAVE TAKES ITS SHAPE, BOMB SPEED AND BOMB RATE FROM ITS THEME
2110 SUB START_WAVE
2120   LOCAL THEME
2130   THEME=(LEVEL-1) MOD 5
2140   ROWS=THEME_ROWS(THEME):COLS=THEME_COLS(THEME)
2150   IF LEVEL=1 THEN ROWS=4
2160   IF LEVEL=2 THEN ROWS=5
2170   BOMB_SPEED=THEME_BOMB_SPEED(THEME)
2180   BOMB_SOONEST=MAX(THEME_SOONEST(THEME)*0.6,THEME_SOONEST(THEME)-MIN(LEVEL-1,5)*0.04)
2190   BOMB_LATEST=MAX(THEME_LATEST(THEME)*0.45,THEME_LATEST(THEME)-MIN(LEVEL-1,5)*0.15)
2200   BUILD_FORMATION THEME
2210   IF THEME=2 OR THEME=4 THEN CLEAR_SHIELDS ELSE BUILD_SHIELDS
2220   RESET_ROUND
2230   IF LEVEL=1 THEN BOMB_WAIT=3.5 ELSE BOMB_WAIT=2
2240   LASER_USED=0
2250   BOSS_ON=0:BOSS_DONE=0
2260   STATE$="PLAY"
2270 END SUB
2300 SUB BUILD_FORMATION(THEME)
2310   LOCAL R,C,I,LEFT_X
2320   LEFT_X=(640-(COLS*(ALIEN_W+GAP_X)-GAP_X))/2
2330   FOR R=0 TO ROWS-1
2340     FOR C=0 TO COLS-1
2350       I=R*COLS+C+1
2360       ALIVE(I)=1
2370       KIND(I)=ROW_KIND(THEME,R)
2380       ALIEN_X(I)=LEFT_X+C*(ALIEN_W+GAP_X)
2390       ALIEN_Y(I)=FORMATION_Y+R*(ALIEN_H+GAP_Y)
2400     NEXT C
2410   NEXT R
2420   ALIENS_LEFT=ROWS*COLS
2430   MARCH_DIR=1:MARCH_DROP=0:MARCH_CLOCK=0
2440   FRAME=0
2450 END SUB
2500 REM FOUR BUNKERS OF FOUR BY THREE BLOCKS, EVENLY ACROSS THE SCREEN
2510 SUB BUILD_SHIELDS
2520   LOCAL S,R,C
2530   FOR S=1 TO 4
2540     SHIELD_X(S)=90+(S-1)*140
2550     FOR R=1 TO 3
2560       FOR C=1 TO 4:SHIELD(S,R,C)=1:NEXT C
2570     NEXT R
2580   NEXT S
2590 END SUB
2600 SUB CLEAR_SHIELDS
2610   LOCAL S,R,C
2620   FOR S=1 TO 4
2630     FOR R=1 TO 3
2640       FOR C=1 TO 4:SHIELD(S,R,C)=0:NEXT C
2650     NEXT R
2660   NEXT S
2670 END SUB
2700 REM A FRESH START FOR THE SHIP, THE SHOTS AND THE VISITORS; THE FORMATION STAYS
2710 SUB RESET_ROUND
2720   LOCAL K
2730   SHIP_X=320-16:SHIP_VX=0
2740   SHOT_ON=0
2750   FOR K=1 TO BOMBS:BOMB(K)=0:NEXT K
2760   UFO_ON=0:UFO_BOMB=0
2770   UFO_WAIT=6+INT(RND(7))
2780   DIVER=0:DIVE_PICK=0
2790   DIVE_WAIT=7+INT(RND(6))
2800   STREAK=0:STILL=0
2810   FX_CLEAR()
2815   FOR K=1 TO 8:BOOM_LEFT(K)=0:NEXT K
2820 END SUB
3000 REM --- PLAY ---
3010 SUB UPDATE_PLAY
3020   FX_UPDATE(DT)
3025   AGE_BOOMS
3030   MOVE_SHIP
3040   MOVE_SHOT
3050   MARCH
3060   DROP_BOMBS
3070   MOVE_BOMBS
3080   IF STATE$<>"PLAY" THEN EXIT SUB
3090   UPDATE_DIVER
3100   IF STATE$<>"PLAY" THEN EXIT SUB
3110   CHECK_LANDING
3120   IF BOSS_ON THEN UPDATE_BOSS ELSE UPDATE_UFO
3130   IF STATE$="PLAY" THEN CHECK_WAVE_CLEAR
3140 END SUB
3200 REM THE CANNON HAS MASS: IT SPOOLS UP TO SPEED AND BRAKES OVER A FEW FRAMES
3210 SUB MOVE_SHIP
3220   LOCAL TARGET,RATE
3230   TARGET=STICK*SPEED
3240   IF TARGET=0 OR TARGET*SHIP_VX<0 THEN RATE=BRAKE*DT ELSE RATE=ACCEL*DT
3250   SHIP_VX=SHIP_VX+CLAMP(TARGET-SHIP_VX,-RATE,RATE)
3260   SHIP_X=SHIP_X+SHIP_VX*DT
3270   IF SHIP_X<0 OR SHIP_X>640-32 THEN SHIP_VX=0
3280   SHIP_X=CLAMP(SHIP_X,0,640-32)
3290   IF STICK=0 THEN STILL=STILL+DT ELSE STILL=0
3300   GRACE=MAX(0,GRACE-DT)
3310   REM HOLD TO FIRE: A NEW SHOT GOES AS SOON AS THE LAST ONE IS GONE
3320   IF SHOOT AND NOT SHOT_ON AND GRACE=0 THEN
3330     SHOT_ON=1
3340     SHOT_X=SHIP_X+14:SHOT_Y=SHIP_Y
3350     PLAY_SFX ASSETS$+"SHOOT.WAV"
3360   END IF
3370 END SUB
3400 REM THE SHOT STOPS AT THE FIRST THING IN ITS PATH: AN ALIEN, A DIVER, A BLOCK, A UFO
3410 SUB MOVE_SHOT
3420   LOCAL FROM_Y,I,ROW,C
3430   IF NOT SHOT_ON THEN EXIT SUB
3440   FROM_Y=SHOT_Y
3450   SHOT_Y=SHOT_Y-SHOT_SPEED*DT
3460   IF SHOT_Y<28 THEN SHOT_ON=0:STREAK=0:EXIT SUB
3470   FOR ROW=ROWS-1 TO 0 STEP -1
3480     FOR C=0 TO COLS-1
3490       I=ROW*COLS+C+1
3500       IF ALIVE(I) AND FNSHOT_HITS(FROM_Y,ALIEN_X(I),ALIEN_Y(I),ALIEN_W,ALIEN_H) THEN SHOOT_ALIEN I:EXIT SUB
3510     NEXT C
3520   NEXT ROW
3530   IF DIVER AND FNSHOT_HITS(FROM_Y,DIVER_X,DIVER_Y,ALIEN_W,ALIEN_H) THEN SHOOT_DIVER:EXIT SUB
3540   HIT_SHIELD SHOT_X,SHOT_Y
3545   IF HIT_BLOCK THEN SHOT_ON=0:EXIT SUB
3550   IF UFO_ON AND UFO_MODE$<>"FIRING" AND FNSHOT_HITS(FROM_Y,UFO_X,UFO_Y,UFO_W,UFO_H) THEN SHOOT_UFO:EXIT SUB
3560   IF BOSS_ON AND FNSHOT_HITS(FROM_Y,BOSS_X,FNBOSS_Y(),BOSS_W,BOSS_H) THEN HIT_BOSS
3570 END SUB
3580 REM THE SHOT'S PATH THIS FRAME, AND A LITTLE EITHER SIDE, AGAINST A BOX
3590 DEF FNSHOT_HITS(FROM_Y,X,Y,W,H)=SEGMENT_RECT_OVERLAP(SHOT_X+2,FROM_Y+6,SHOT_X+2,SHOT_Y+6,X-2,Y-6,W+4,H+12)
3600 REM A RUN OF HITS RAISES THE MULTIPLE: X2 FROM THE FOURTH, UP TO X5
3610 SUB SHOOT_ALIEN(I)
3620   LOCAL TIMES,POINTS
3630   SHOT_ON=0
3640   ALIVE(I)=0
3650   ALIENS_LEFT=ALIENS_LEFT-1
3660   STREAK=STREAK+1
3670   TIMES=MIN(1+INT((STREAK-1)/3),5)
3680   POINTS=(30-KIND(I)*10)*LEVEL*TIMES
3690   SCORE=SCORE+POINTS
3700   PLAY_SFX ASSETS$+"EXPLOSION.WAV"
3705   BOOM ALIEN_X(I),ALIEN_Y(I)-6,1
3710   FX_BURST(ALIEN_X(I)+ALIEN_W/2,ALIEN_Y(I)+ALIEN_H/2,10,110,ALIEN_COLOR$(KIND(I)))
3720   IF TIMES>1 THEN FX_POPUP(ALIEN_X(I)+ALIEN_W/2,ALIEN_Y(I),STR$(POINTS)+" X"+STR$(TIMES),"BLIP_YELLOW") ELSE FX_POPUP(ALIEN_X(I)+ALIEN_W/2,ALIEN_Y(I),STR$(POINTS),ALIEN_COLOR$(KIND(I)))
3730   IF DIVE_PICK=I THEN DIVE_PICK=0
3740 END SUB
4000 REM --- THE FORMATION - IT STEPS SIDEWAYS, AND DROPS A ROW AT EACH EDGE ---
4010 REM FEWER ALIENS MARCH FASTER, AND EACH LEVEL A LITTLE FASTER STILL
4020 SUB MARCH
4030   LOCAL I,EDGE
4040   MARCH_CLOCK=MARCH_CLOCK+DT
4050   IF MARCH_CLOCK<FNMARCH_GAP() THEN EXIT SUB
4060   MARCH_CLOCK=0
4070   IF ALIENS_LEFT>0 THEN
4080     PLAY_SFX ASSETS$+"MARCH"+STR$(MARCH_BEAT+1)
4090     MARCH_BEAT=(MARCH_BEAT+1) MOD 4
4100   END IF
4110   IF MARCH_DROP THEN
4120     FOR I=1 TO ROWS*COLS
4130       IF ALIVE(I) THEN ALIEN_Y(I)=ALIEN_Y(I)+8+4*MIN((LEVEL-1)/3,1)
4140     NEXT I
4150     MARCH_DIR=-MARCH_DIR
4160     MARCH_DROP=0
4170     EXIT SUB
4180   END IF
4190   FRAME=1-FRAME
4200   FOR I=1 TO ROWS*COLS
4210     IF ALIVE(I) THEN
4220       ALIEN_X(I)=ALIEN_X(I)+12*MARCH_DIR
4230       IF ALIEN_X(I)<2 OR ALIEN_X(I)+ALIEN_W>638 THEN EDGE=1
4240       BREAK_SHIELDS ALIEN_X(I),ALIEN_Y(I),ALIEN_W,ALIEN_H
4250     END IF
4260   NEXT I
4270   IF EDGE THEN MARCH_DROP=1
4280 END SUB
4290 DEF FNMARCH_GAP()=MAX(0.065,0.52*ALIENS_LEFT/(ROWS*COLS)*MAX(0.5,1-(LEVEL-1)*0.07))
4300 REM AN INVASION THAT REACHES THE GROUND ENDS THE GAME AT ONCE
4310 SUB CHECK_LANDING
4320   LOCAL I
4330   FOR I=1 TO ROWS*COLS
4340     IF ALIVE(I) AND ALIEN_Y(I)+ALIEN_H>=GROUND THEN
4350       LIVES=1
4360       LOSE_SHIP
4370       EXIT SUB
4380     END IF
4390   NEXT I
4400 END SUB
4500 REM --- BOMBS - THE LOWEST ALIEN OF A RANDOM COLUMN DROPS ONE, UP TO FOUR AT ONCE ---
4510 SUB DROP_BOMBS
4520   LOCAL C,R,I,K,SHOOTER
4530   IF BOSS_ON THEN EXIT SUB
4540   BOMB_WAIT=BOMB_WAIT-DT
4550   IF BOMB_WAIT>0 THEN EXIT SUB
4560   BOMB_WAIT=LERP(BOMB_SOONEST,BOMB_LATEST,RND(1))
4570   C=INT(RND(COLS))
4580   FOR R=ROWS-1 TO 0 STEP -1
4590     I=R*COLS+C+1
4600     IF ALIVE(I) THEN SHOOTER=I:EXIT FOR
4610   NEXT R
4620   IF SHOOTER=0 THEN EXIT SUB
4630   DROP_BOMB ALIEN_X(SHOOTER)+ALIEN_W/2-2,ALIEN_Y(SHOOTER)+ALIEN_H
4640 END SUB
4700 SUB DROP_BOMB(X,Y)
4710   LOCAL K
4720   FOR K=1 TO BOMBS
4730     IF NOT BOMB(K) THEN EXIT FOR
4740   NEXT K
4750   IF K>BOMBS THEN EXIT SUB
4760   BOMB(K)=1
4770   BOMB_X(K)=X:BOMB_Y(K)=Y
4780 END SUB
4800 SUB MOVE_BOMBS
4810   LOCAL K
4820   FOR K=1 TO BOMBS
4830     IF BOMB(K) THEN
4840       BOMB_Y(K)=BOMB_Y(K)+BOMB_SPEED*DT
4845       HIT_SHIELD BOMB_X(K),BOMB_Y(K)
4850       IF HIT_BLOCK THEN BOMB(K)=0
4860       IF BOMB(K) AND FNHITS_SHIP(BOMB_X(K),BOMB_Y(K)) THEN BOMB(K)=0:LOSE_SHIP:EXIT SUB
4870       IF BOMB_Y(K)+12>GROUND THEN BOMB(K)=0:FX_BURST(BOMB_X(K)+2,GROUND-2,6,60,"BLIP_ORANGE")
4880     END IF
4890   NEXT K
4900   IF UFO_BOMB THEN
4910     UFO_BOMB_Y=UFO_BOMB_Y+BOMB_SPEED*DT
4915     HIT_SHIELD UFO_BOMB_X,UFO_BOMB_Y
4920     IF HIT_BLOCK THEN UFO_BOMB=0
4930     IF UFO_BOMB AND FNHITS_SHIP(UFO_BOMB_X,UFO_BOMB_Y) THEN UFO_BOMB=0:LOSE_SHIP:EXIT SUB
4940     IF UFO_BOMB_Y+12>GROUND THEN UFO_BOMB=0
4950   END IF
4960 END SUB
4970 REM A BOMB AGAINST THE SHIP'S WEDGE, WHOSE TOP CORNERS ARE EMPTY SKY: ITS HALF-WIDTH
4971 REM GROWS FROM 1 PIXEL AT THE NOSE TO 16 AT THE BASE
4980 DEF FNHITS_SHIP(BX,BY)=BY+12>=SHIP_Y AND BY<=GROUND AND ABS(BX+2-(SHIP_X+16))<=MAX(1+(MIN(BY+12,GROUND)-SHIP_Y)/24*15,3)+2
5000 REM --- SHIELDS - ANY SHOT, BOMB OR ALIEN THAT MEETS A BLOCK TAKES IT AWAY ---
5010 REM THE BLOCK UNDER A ROUND AT X,Y GOES; HIT_BLOCK SAYS WHETHER THERE WAS ONE
5020 SUB HIT_SHIELD(X,Y)
5030   LOCAL S,R,C
5040   HIT_BLOCK=0
5050   FOR S=1 TO 4
5060     IF X+2>=SHIELD_X(S) AND X+2<SHIELD_X(S)+4*BLOCK THEN EXIT FOR
5070   NEXT S
5080   IF S>4 OR Y+12<SHIELD_Y OR Y>=SHIELD_Y+3*BLOCK THEN EXIT SUB
5090   C=INT((X+2-SHIELD_X(S))/BLOCK)+1
5100   FOR R=1 TO 3
5110     IF SHIELD(S,R,C) AND Y+12>=SHIELD_Y+(R-1)*BLOCK AND Y<SHIELD_Y+R*BLOCK THEN
5120       SHIELD(S,R,C)=0
5130       HIT_BLOCK=1
5140       FX_BURST(SHIELD_X(S)+(C-0.5)*BLOCK,SHIELD_Y+(R-0.5)*BLOCK,5,50,"BLIP_GREEN")
5150       EXIT SUB
5160     END IF
5170   NEXT R
5180 END SUB
5200 REM WHATEVER BOX X,Y,W,H COVERS IS GONE: THE FORMATION AND DIVERS PLOUGH THROUGH
5210 SUB BREAK_SHIELDS(X,Y,W,H)
5220   LOCAL S,R,C
5230   IF Y+H<SHIELD_Y THEN EXIT SUB
5240   FOR S=1 TO 4
5250     FOR R=1 TO 3
5260       FOR C=1 TO 4
5270         IF SHIELD(S,R,C) AND RECTS_OVERLAP(X,Y,W,H,FNBLOCK_X(S,C),FNBLOCK_Y(R),BLOCK,BLOCK) THEN SHIELD(S,R,C)=0
5280       NEXT C
5290     NEXT R
5300   NEXT S
5310 END SUB
5320 DEF FNBLOCK_X(S,C)=SHIELD_X(S)+(C-1)*BLOCK
5330 DEF FNBLOCK_Y(R)=SHIELD_Y+(R-1)*BLOCK
5400 REM --- DIVERS - FROM WAVE THREE, THE LOWEST ALIEN OF A COLUMN GLOWS, THEN DIVES ---
5410 SUB UPDATE_DIVER
5420   IF DIVER THEN
5430     FLY_DIVER
5440   ELSEIF DIVE_PICK THEN
5450     DIVE_TELL=DIVE_TELL-DT
5460     IF DIVE_TELL<=0 THEN START_DIVE
5470   ELSEIF LEVEL>=3 AND NOT BOSS_ON THEN
5480     DIVE_WAIT=DIVE_WAIT-DT
5490     IF DIVE_WAIT<=0 AND ALIENS_LEFT>=6 THEN PICK_DIVER
5500   END IF
5510 END SUB
5600 SUB PICK_DIVER
5610   LOCAL C,R,I
5620   DIVE_WAIT=7+INT(RND(6))
5630   C=INT(RND(COLS))
5640   FOR R=ROWS-1 TO 0 STEP -1
5650     I=R*COLS+C+1
5660     IF ALIVE(I) THEN DIVE_PICK=I:DIVE_TELL=0.8:EXIT SUB
5670   NEXT R
5680 END SUB
5700 SUB START_DIVE
5710   ALIVE(DIVE_PICK)=0
5720   ALIENS_LEFT=ALIENS_LEFT-1
5730   DIVER=1
5740   DIVER_X=ALIEN_X(DIVE_PICK)
5745   DIVER_Y=ALIEN_Y(DIVE_PICK)
5750   DIVER_KIND=KIND(DIVE_PICK)
5760   DIVE_PICK=0
5770   PLAY_SFX ASSETS$+"DIVE.WAV"
5780 END SUB
5800 REM IT STEERS FOR THE SHIP, THROUGH ANY SHIELD IN THE WAY, AND MISSING IT HITS THE GROUND
5810 SUB FLY_DIVER
5820   DIVER_Y=DIVER_Y+112*DT
5830   DIVER_X=DIVER_X+CLAMP(SHIP_X-DIVER_X,-60*DT,60*DT)
5840   BREAK_SHIELDS DIVER_X+6,DIVER_Y+6,ALIEN_W-12,ALIEN_H-12
5850   IF RECTS_OVERLAP(DIVER_X+6,DIVER_Y+6,ALIEN_W-12,ALIEN_H-12,SHIP_X+5,SHIP_Y,22,24) THEN
5860     DIVER=0
5870     LOSE_SHIP
5880   ELSEIF DIVER_Y+ALIEN_H>=GROUND THEN
5890     DIVER=0
5900     BOOM DIVER_X,GROUND-30,1
5910     PLAY_SFX ASSETS$+"EXPLOSION.WAV"
5920   END IF
5930 END SUB
5940 REM A DIVER IS WORTH DOUBLE
5950 SUB SHOOT_DIVER
5960   LOCAL POINTS
5970   SHOT_ON=0
5980   DIVER=0
5990   STREAK=STREAK+1
6000   POINTS=(30-DIVER_KIND*10)*LEVEL*2
6010   SCORE=SCORE+POINTS
6020   PLAY_SFX ASSETS$+"EXPLOSION.WAV"
6025   BOOM DIVER_X,DIVER_Y-6,1
6030   FX_BURST(DIVER_X+ALIEN_W/2,DIVER_Y+ALIEN_H/2,14,130,ALIEN_COLOR$(DIVER_KIND))
6040   FX_POPUP(DIVER_X+ALIEN_W/2,DIVER_Y,"DIVER "+STR$(POINTS),"BLIP_YELLOW")
6050 END SUB
6100 REM --- THE UFO - A BONUS THAT PASSES BY, OR ONCE A WAVE A HUNTER WITH A LASER ---
6110 SUB UPDATE_UFO
6120   IF NOT UFO_ON THEN
6130     UFO_WAIT=UFO_WAIT-DT
6140     IF UFO_WAIT<=0 AND ALIENS_LEFT>0 THEN LAUNCH_UFO
6150     EXIT SUB
6160   END IF
6170   UFO_FRAME=INT(TIME()*14) MOD 8
6180   IF UFO_MODE$="FLYING" THEN
6190     FLY_UFO
6200   ELSEIF UFO_MODE$="TRACKING" THEN
6210     STALK_SHIP
6220   ELSEIF UFO_MODE$="CHARGING" THEN
6230     UFO_TIMER=UFO_TIMER-DT
6240     IF UFO_TIMER<=0 THEN FIRE_LASER
6250   ELSE
6260     UFO_TIMER=UFO_TIMER-DT
6270     IF UFO_TIMER<=0 THEN UFO_GONE:BOOM UFO_X,UFO_Y-8,1:PLAY_SFX ASSETS$+"EXPLOSION.WAV"
6280   END IF
6290 END SUB
6300 REM ONE PASS IN THREE, ONCE A WAVE, IS THE LASER ATTACK
6310 SUB LAUNCH_UFO
6320   UFO_ON=1
6330   IF RND(2)<1 THEN UFO_DIR=1:UFO_X=-UFO_W ELSE UFO_DIR=-1:UFO_X=640
6340   PLAY_SFX ASSETS$+"UFO_SIREN.WAV"
6350   IF NOT LASER_USED AND RND(1)<0.35 THEN
6360     LASER_USED=1
6370     UFO_MODE$="TRACKING"
6380     UFO_TIMER=4
6390   ELSE
6400     UFO_MODE$="FLYING"
6410     UFO_TIMER=3
6420   END IF
6430 END SUB
6500 REM IT DROPS ONE BOMB, THREE SECONDS INTO ITS PASS
6510 SUB FLY_UFO
6520   UFO_X=UFO_X+80*UFO_DIR*DT
6530   IF UFO_X>640 OR UFO_X+UFO_W<0 THEN UFO_GONE:EXIT SUB
6540   UFO_TIMER=UFO_TIMER-DT
6550   IF UFO_TIMER<=0 THEN
6560     UFO_TIMER=999
6570     UFO_BOMB=1
6575     UFO_BOMB_X=UFO_X+UFO_W/2-2
6578     UFO_BOMB_Y=UFO_Y+12
6580   END IF
6590 END SUB
6600 REM IT CHASES THE SHIP, FASTER THAN IT CAN RUN, AND COMMITS ONCE THE SHIP HOLDS
6601 REM STILL BENEATH IT, OR AFTER FOUR SECONDS
6610 SUB STALK_SHIP
6620   LOCAL TARGET
6630   TARGET=CLAMP(SHIP_X+16-UFO_W/2,0,640-UFO_W)
6640   UFO_X=UFO_X+CLAMP(TARGET-UFO_X,-230*DT,230*DT)
6650   UFO_TIMER=UFO_TIMER-DT
6660   IF UFO_TIMER<=0 OR (UFO_TIMER<=2.2 AND ABS(UFO_X-TARGET)<14 AND STILL>=0.4) THEN
6670     UFO_MODE$="CHARGING"
6680     UFO_TIMER=1.9
6690     PLAY_SFX ASSETS$+"LASER_CHARGE.WAV"
6700   END IF
6710 END SUB
6800 REM THE BEAM TAKES EVERY ALIEN, BLOCK AND SHIP IN ITS COLUMN
6810 SUB FIRE_LASER
6820   LOCAL I
6830   UFO_MODE$="FIRING"
6840   UFO_TIMER=0.4
6850   LASER_X=UFO_X
6860   PLAY_SFX ASSETS$+"LASER_BLAST.WAV"
6870   FOR I=1 TO ROWS*COLS
6880     IF ALIVE(I) AND ALIEN_X(I)<LASER_X+UFO_W AND ALIEN_X(I)+ALIEN_W>LASER_X THEN
6890       ALIVE(I)=0
6900       ALIENS_LEFT=ALIENS_LEFT-1
6910       SCORE=SCORE+(30-KIND(I)*10)*LEVEL
6920       BOOM ALIEN_X(I),ALIEN_Y(I)-6,1
6930     END IF
6940   NEXT I
6950   BREAK_SHIELDS LASER_X,SHIELD_Y,UFO_W,3*BLOCK
6960   IF SHIP_X<LASER_X+UFO_W AND SHIP_X+32>LASER_X THEN LOSE_SHIP
6970 END SUB
7000 REM A HIT IS WORTH 50 TO 300, SHOWN WHERE IT WAS
7010 SUB SHOOT_UFO
7020   LOCAL BONUS
7030   SHOT_ON=0
7040   BONUS=(INT(RND(6))+1)*50
7050   SCORE=SCORE+BONUS
7060   BOOM UFO_X,UFO_Y-8,1
7070   FX_POPUP(UFO_X+UFO_W/2,UFO_Y+14,STR$(BONUS),"BLIP_YELLOW")
7080   PLAY_SFX ASSETS$+"EXPLOSION.WAV"
7090   UFO_GONE
7100 END SUB
7200 SUB UFO_GONE
7210   UFO_ON=0
7220   UFO_BOMB=0
7230   UFO_WAIT=6+INT(RND(7))
7240 END SUB
7300 REM --- THE MOTHERSHIP - EVERY FIFTH WAVE IS NOT OVER UNTIL IT IS DOWN ---
7310 SUB START_BOSS
7320   LOCAL N
7330   N=INT(LEVEL/5)
7340   BOSS_ON=1
7350   BOSS_HP=16+8*(N-1):BOSS_MAX=BOSS_HP
7360   BOSS_SPEED=78+14*(N-1)
7370   BOSS_VOLLEY=MAX(0.42,1.05-0.09*(N-1))
7380   IF RND(2)<1 THEN BOSS_DIR=1:BOSS_X=-BOSS_W ELSE BOSS_DIR=-1:BOSS_X=640
7390   BOSS_PHASE=0
7400   BOSS_FIRE=1.4
7410   UFO_GONE
7420   PLAY_SFX ASSETS$+"UFO_SIREN.WAV"
7430   PLAY_MUSIC ASSETS$+"MOTHERSHIP.WAV"
7440 END SUB
7500 REM IT CROSSES AND TURNS AT THE EDGES, RIDING A SLOW SWELL, AND DROPS THREE BOMBS
7510 SUB UPDATE_BOSS
7520   LOCAL K
7530   BOSS_PHASE=BOSS_PHASE+DT*1.6
7540   BOSS_X=BOSS_X+BOSS_SPEED*BOSS_DIR*DT
7550   IF BOSS_X<0 THEN BOSS_X=0:BOSS_DIR=1
7560   IF BOSS_X+BOSS_W>640 THEN BOSS_X=640-BOSS_W:BOSS_DIR=-1
7570   BOSS_FLASH=MAX(0,BOSS_FLASH-DT)
7580   BOSS_FIRE=BOSS_FIRE-DT
7590   IF BOSS_FIRE>0 THEN EXIT SUB
7600   BOSS_FIRE=BOSS_VOLLEY
7610   FOR K=0 TO 2
7620     DROP_BOMB BOSS_X+BOSS_W*(0.18+K*0.32),FNBOSS_Y()+BOSS_H
7630   NEXT K
7640   PLAY_SFX ASSETS$+"SHOOT.WAV"
7650 END SUB
7660 DEF FNBOSS_Y()=BOSS_Y+SIN(BOSS_PHASE)*20
7700 SUB HIT_BOSS
7710   SHOT_ON=0
7720   BOSS_HP=BOSS_HP-1
7730   BOSS_FLASH=0.08
7740   SCORE=SCORE+10
7750   PLAY_SFX ASSETS$+"EXPLOSION.WAV"
7760   FX_BURST(SHOT_X,SHOT_Y,6,60,"BLIP_WHITE")
7770   IF BOSS_HP>0 THEN EXIT SUB
7780   BOSS_ON=0
7790   BOSS_DONE=1
7800   SCORE=SCORE+500*LEVEL
7810   BOOM BOSS_X+BOSS_W/2-36,FNBOSS_Y(),2.2
7815   BOOM BOSS_X,FNBOSS_Y(),1.6
7818   BOOM BOSS_X+BOSS_W-36,FNBOSS_Y()+10,1.6
7820   PLAY_MUSIC ASSETS$+"INVASION.WAV"
7830 END SUB
7900 REM --- THE WAVE - CLEAR, OR ON A FIFTH WAVE, THE MOTHERSHIP'S TURN ---
7910 SUB CHECK_WAVE_CLEAR
7920   IF ALIENS_LEFT>0 OR BOSS_ON OR DIVER THEN EXIT SUB
7930   IF LEVEL MOD 5=0 AND NOT BOSS_DONE THEN START_BOSS:EXIT SUB
7940   PLAY_SFX ASSETS$+"LEVEL_CLEAR.WAV"
7950   LEVEL=LEVEL+1
7960   STATE$="CLEAR"
7970   WAIT_LEFT=1.5
7980 END SUB
8000 SUB UPDATE_CLEAR
8010   WAIT_LEFT=WAIT_LEFT-DT
8020   IF WAIT_LEFT<=0 THEN START_WAVE
8030 END SUB
8100 SUB DRAW_CLEAR
8110   CLEAR("BLIP_BLACK")
8120   DRAW_TEXT("WAVE CLEAR",320,140,4,"BLIP_CYAN","CENTER")
8130   DRAW_TEXT("LEVEL "+STR$(LEVEL),320,200,3,"BLIP_YELLOW","CENTER")
8140 END SUB
8200 REM --- LOSING THE SHIP - A PAUSE, THEN THE SAME FORMATION WITH A NEW SHIP ---
8210 SUB LOSE_SHIP
8220   LOCAL K
8230   IF STATE$<>"PLAY" THEN EXIT SUB
8240   BOOM SHIP_X-20,SHIP_Y-30,2.4
8245   BOOM SHIP_X+6,SHIP_Y-20,1.6
8250   PLAY_SFX ASSETS$+"EXPLOSION.WAV"
8260   LIVES=LIVES-1
8270   FOR K=1 TO BOMBS:BOMB(K)=0:NEXT K
8280   UFO_BOMB=0:SHOT_ON=0
8290   DIVER=0:DIVE_PICK=0
8300   IF UFO_ON THEN UFO_GONE
8310   STATE$="DEAD"
8320   IF LIVES>0 THEN WAIT_LEFT=3.6 ELSE WAIT_LEFT=0.7
8330 END SUB
8400 SUB UPDATE_DEAD
8410   FX_UPDATE(DT)
8415   AGE_BOOMS
8420   WAIT_LEFT=WAIT_LEFT-DT
8430   IF WAIT_LEFT>0 THEN EXIT SUB
8440   IF LIVES<=0 THEN
8450     PLAY_SFX ASSETS$+"GAME_OVER.WAV"
8460     STATE$="OVER"
8470     WAIT_LEFT=2
8480   ELSE
8490     GRACE=1.2
8500     STATE$="PLAY"
8510   END IF
8520 END SUB
8600 REM --- OVER - TWO SECONDS TO READ THE SCORE, THEN FIRE TO PLAY AGAIN ---
8610 SUB UPDATE_OVER
8620   WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
8630   IF WAIT_LEFT=0 AND FIRE THEN START_GAME
8640 END SUB
8700 SUB DRAW_OVER
8710   CLEAR("BLIP_BLACK")
8720   DRAW_TEXT("GAME OVER",320,120,5,"BLIP_RED","CENTER")
8730   DRAW_TEXT("FINAL SCORE",320,190,2,"BLIP_GRAY","CENTER")
8740   DRAW_TEXT(STR$(SCORE),320,214,3,"BLIP_YELLOW","CENTER")
8750   IF WAIT_LEFT=0 THEN DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE TO PLAY AGAIN","PRESS FIRE TO PLAY AGAIN","TAP TO PLAY AGAIN"),320,290,2,"BLIP_WHITE","CENTER")
8760 END SUB
8800 REM --- EXPLOSIONS - A FIREBALL THAT FADES OVER HALF A SECOND, SIZED BY SCALE ---
8810 SUB BOOM(X,Y,SCALE)
8820   LOCAL K
8830   FOR K=1 TO 8
8840     IF BOOM_LEFT(K)<=0 THEN EXIT FOR
8850   NEXT K
8860   IF K>8 THEN EXIT SUB
8870   BOOM_LEFT(K)=0.45*SCALE
8880   BOOM_LIFE(K)=0.45*SCALE
8890   BOOM_X(K)=X:BOOM_Y(K)=Y
8900   BOOM_SIZE(K)=36*SCALE
8910 END SUB
8920 SUB AGE_BOOMS
8930   LOCAL K
8940   FOR K=1 TO 8
8943     BOOM_LEFT(K)=BOOM_LEFT(K)-DT
8946   NEXT K
8950 END SUB
8960 SUB DRAW_BOOMS
8970   LOCAL K
8980   FOR K=1 TO 8
8990     IF BOOM_LEFT(K)>0 THEN DRAW_TEXTURE(ASSETS$+"EXPLOSION.PNG",BOOM_X(K),BOOM_Y(K),BOOM_SIZE(K),BOOM_SIZE(K),COLOR(1,1,1,BOOM_LEFT(K)/BOOM_LIFE(K)))
8995   NEXT K
8998 END SUB
9000 REM --- DRAWING ---
9010 SUB DRAW_PLAY
9020   LOCAL I,K,FRAME$
9030   IF FRAME THEN FRAME$="B" ELSE FRAME$="A"
9040   CLEAR("BLIP_BLACK")
9050   FOR I=1 TO ROWS*COLS
9060     IF ALIVE(I) THEN DRAW_ALIEN I
9070   NEXT I
9090   IF DIVER THEN DRAW_TEXTURE(ASSETS$+ALIEN_IMAGE$(DIVER_KIND)+FRAME$,DIVER_X,DIVER_Y,ALIEN_W,ALIEN_H,"BLIP_WHITE")
9100   DRAW_SHIELDS
9110   IF UFO_ON THEN DRAW_UFO
9120   IF BOSS_ON THEN DRAW_BOSS
9130   IF SHOT_ON THEN DRAW_TEXTURE(ASSETS$+"BULLET.PNG",SHOT_X,SHOT_Y,4,12)
9140   FOR K=1 TO BOMBS
9150     IF BOMB(K) THEN DRAW_TEXTURE(ASSETS$+"BULLET.PNG",BOMB_X(K),BOMB_Y(K),4,12,"BLIP_ORANGE")
9160   NEXT K
9170   IF UFO_BOMB THEN DRAW_TEXTURE(ASSETS$+"BULLET.PNG",UFO_BOMB_X,UFO_BOMB_Y,4,12,"BLIP_ORANGE")
9180   IF STATE$="PLAY" AND (GRACE=0 OR INT(GRACE*10) MOD 2=0) THEN DRAW_TEXTURE(ASSETS$+"PLAYER_SHIP",SHIP_X,SHIP_Y,32,24)
9190   DRAW_LINE(0,GROUND,640,GROUND,"BLIP_GREEN")
9195   DRAW_BOOMS
9200   FX_DRAW()
9210   DRAW_HUD(SCORE,LIVES)
9220   IF STREAK>=2 THEN DRAW_TEXT(STR$(STREAK)+" IN A ROW  X"+STR$(MIN(1+INT((STREAK-1)/3),5)),320,382,2,"BLIP_YELLOW","CENTER")
9230 END SUB
9240 REM THE ONE ABOUT TO DIVE SHAKES AND FLASHES WHITE: THE TELL
9250 SUB DRAW_ALIEN(I)
9255   LOCAL X,INK$
9260   X=ALIEN_X(I)
9265   INK$=ALIEN_COLOR$(KIND(I))
9270   IF I=DIVE_PICK THEN
9275     X=X+SIN(TIME()*60)*3
9280     IF INT(TIME()*14) MOD 2=0 THEN INK$="BLIP_WHITE"
9285   END IF
9290   DRAW_TEXTURE(ASSETS$+ALIEN_IMAGE$(KIND(I))+FRAME$,X,ALIEN_Y(I),ALIEN_W,ALIEN_H,INK$)
9295 END SUB
9300 SUB DRAW_SHIELDS
9310   LOCAL S,R,C
9320   FOR S=1 TO 4
9330     FOR R=1 TO 3
9340       FOR C=1 TO 4
9350         IF SHIELD(S,R,C) THEN DRAW_TEXTURE(ASSETS$+"SHIELD_BLOCK",FNBLOCK_X(S,C),FNBLOCK_Y(R),BLOCK,BLOCK)
9360       NEXT C
9370     NEXT R
9380   NEXT S
9390 END SUB
9400 REM WHILE IT STALKS, A FAINT LINE SHOWS WHO IT IS AFTER; CHARGING, ITS BEAM GROWS
9410 SUB DRAW_UFO
9420   LOCAL GROW,X
9430   IF UFO_MODE$<>"FIRING" THEN DRAW_SAUCER UFO_X,UFO_Y,UFO_W,UFO_H,UFO_FRAME,"BLIP_WHITE"
9440   X=UFO_X+UFO_W/2
9450   IF UFO_MODE$="TRACKING" THEN DRAW_LINE(X,UFO_Y+UFO_H,SHIP_X+16,SHIP_Y,COLOR(1,0.3,0.3,0.2))
9460   IF UFO_MODE$="CHARGING" THEN
9470     GROW=1-UFO_TIMER/1.9
9480     FILL_GLOW_CIRCLE(X,UFO_Y+10,10+GROW*20,COLOR(1,0.25+GROW*0.5,0.15,0.6+GROW*0.4))
9490     DRAW_GLOW_LINE(X,UFO_Y+10,X,GROUND,COLOR(1,0.2,0.2,0.5+GROW*0.4))
9500   END IF
9510   IF UFO_MODE$="FIRING" THEN
9520     FILL_RECT(0,28,640,GROUND-28,COLOR(1,1,1,0.12))
9530     DRAW_GLOW_LINE(LASER_X+8,UFO_Y,LASER_X+8,GROUND,COLOR(1,0.35,0.35,0.8))
9540     DRAW_GLOW_LINE(LASER_X+UFO_W-8,UFO_Y,LASER_X+UFO_W-8,GROUND,COLOR(1,0.35,0.35,0.8))
9550     DRAW_LINE_EX(X,UFO_Y,X,GROUND,8,"BLIP_WHITE")
9560   END IF
9570 END SUB
9600 SUB DRAW_BOSS
9610   LOCAL Y,INK$
9620   Y=FNBOSS_Y()
9630   IF BOSS_FLASH>0 THEN INK$="BLIP_WHITE" ELSE INK$="#FF5050"
9640   DRAW_SAUCER BOSS_X,Y,BOSS_W,BOSS_H,INT(TIME()*14),INK$
9650   FILL_RECT(BOSS_X,Y+BOSS_H+4,BOSS_W,5,"#5A1010")
9660   FILL_RECT(BOSS_X,Y+BOSS_H+4,BOSS_W*BOSS_HP/BOSS_MAX,5,"BLIP_RED")
9670 END SUB
9672 REM THE SAUCER, THEN ITS EIGHT RIM LIGHTS, YELLOW AND WHITE BY TURNS, TURNED A STEP A FRAME
9674 SUB DRAW_SAUCER(X,Y,W,H,TURN,INK$)
9676   LOCAL I,A,SX,SY,LIGHT$
9678   DRAW_TEXTURE(ASSETS$+"UFO_SAUCER",X,Y,W,H,INK$)
9680   SX=W/36:SY=H/20
9682   FOR I=0 TO 7
9683     A=(I+TURN)/8*6.2832
9684     IF (I+TURN) MOD 2 THEN LIGHT$="BLIP_WHITE" ELSE LIGHT$="#FFE63C"
9686     FILL_RECT(X+INT(18.5+COS(A)*15)*SX,Y+INT(11.9+SIN(A)*5.3)*SY,SX,2*SY,LIGHT$)
9690   NEXT I
9692 END SUB
9700 REM --- KEYS AND TABLES ---
9710 SUB READ_KEYS
9720   STICK=(KEY_ACTIVE("RIGHT") OR KEY_ACTIVE("D"))-(KEY_ACTIVE("LEFT") OR KEY_ACTIVE("A"))
9730   SHOOT=KEY_ACTIVE("SPACE") OR KEY_ACTIVE("UP") OR KEY_ACTIVE("W")
9740   FIRE=KEY_PRESSED("SPACE") OR KEY_PRESSED("ENTER")
9750 END SUB
9800 REM EACH THEME: ROWS, COLUMNS, BOMB SPEED, SOONEST AND LATEST BOMB GAP, THEN
9801 REM THE KIND OF ALIEN IN EACH ROW (0 SQUID, 1 CRAB, 2 OCTOPUS)
9810 SUB LOAD_THEMES
9820   LOCAL T,R
9830   RESTORE 9880
9840   FOR T=0 TO 4
9850     READ THEME_ROWS(T),THEME_COLS(T),THEME_BOMB_SPEED(T),THEME_SOONEST(T),THEME_LATEST(T)
9860     FOR R=0 TO 5:READ ROW_KIND(T,R):NEXT R
9865   NEXT T
9870   FOR T=0 TO 2
9871     READ ALIEN_IMAGE$(T),ALIEN_COLOR$(T)
9872   NEXT T
9875 END SUB
9880 DATA 5,10, 120, 0.6,2.0,  0,1,1,2,2,2
9881 DATA 6,10, 150, 0.5,1.5,  0,1,1,2,2,2
9882 DATA 3,11, 188, 0.35,1.0, 0,1,2,2,2,2
9883 DATA 4,10, 165, 0.45,1.2, 0,0,1,2,2,2
9884 DATA 6,8,  210, 0.3,0.85, 0,0,1,1,2,2
9890 DATA "ALIEN_SQUID_","BLIP_MAGENTA", "ALIEN_CRAB_","BLIP_CYAN", "ALIEN_OCTOPUS_","BLIP_GREEN"
