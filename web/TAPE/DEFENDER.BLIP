1 REM FLOW: TITLE 10 -> WAVE SETUP 200 -> PLAY 320 -> RESULT 900.
2 REM MODULES: SHIELDS 1000; DIVERS 1100; SHIP HIT TEST 1430; UFO 1500.
3 REM STATE: AX/AY HOLD FORMATION POSITIONS; DIVERS MOVE SEPARATELY.
5 REM GAME: DEFENDER
10 REM GALACTIC DEFENDER - TITLE AND POINT VALUES
20 LV=1:SC=0:L=3:PLAY_MUSIC "DEFENDER_MAIN"
40 T=0:AF=0
50 CANVAS(480,540):CLEAR("BLIP_BLACK"):TT=TIME():BEAT=INT(TT*2):AF=BEAT-2*INT(BEAT/2):AF$="A":IF AF=1 THEN AF$="B"
60 DRAW_TEXT("GALACTIC",240,108,5,"BLIP_CYAN","CENTER")
70 DRAW_TEXT("DEFENDER",240,158,5,"BLIP_MAGENTA","CENTER")
80 DRAW_TEXTURE("ALIEN_SQUID_"+AF$,178,230,18,14,"BLIP_MAGENTA")
90 DRAW_TEXTURE("ALIEN_CRAB_"+AF$,178,250,18,14,"BLIP_CYAN")
100 DRAW_TEXTURE("ALIEN_OCTOPUS_"+AF$,178,270,18,14,"BLIP_GREEN")
110 DRAW_TEXT("30 PTS",240,230,2,"BLIP_MAGENTA","CENTER")
120 DRAW_TEXT("20 PTS",240,250,2,"BLIP_CYAN","CENTER")
130 DRAW_TEXT("10 PTS",240,270,2,"BLIP_GREEN","CENTER")
140 DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE","PRESS FIRE","TAP TO START"),240,360,3,"BLIP_WHITE","CENTER")
150 POS=BEAT-10*INT(BEAT/10):STEPX=POS:IF POS>=5 THEN STEPX=9-POS
160 FOR I=0 TO 5:KIND=I-3*INT(I/3):AN$="ALIEN_SQUID_":AC$="BLIP_MAGENTA":IF KIND=1 THEN AN$="ALIEN_CRAB_":AC$="BLIP_CYAN"
170 IF KIND=2 THEN AN$="ALIEN_OCTOPUS_":AC$="BLIP_GREEN"
180 DRAW_TEXTURE(AN$+AF$,90+I*52+STEPX*12,450,18,14,AC$):NEXT I
190 IF KEY_PRESSED("SPACE")=0 THEN WAIT 0:GOTO 50
199 REM --- WAVE SETUP - FORMATION THEME, SHIELDS, AND ENEMIES ---
200 CANVAS(320,200):CLS
205 THEME=LV-1-INT((LV-1)/5)*5:ROWS=4:COLS=10
206 IF THEME=0 AND LV>1 THEN ROWS=5
207 IF THEME=1 THEN ROWS=5
208 IF THEME=2 THEN ROWS=3:COLS=11
209 IF THEME=3 THEN ROWS=4
210 IF THEME=4 THEN ROWS=6:COLS=8
211 MAXI=ROWS*COLS-1:LEFT=ROWS*COLS
212 FOR R=0 TO ROWS-1
213 FOR C=0 TO COLS-1
230 I=R*COLS+C:AX(I)=INT((320-(COLS*27-3))/2)+C*27:AY(I)=25+R*13:AA(I)=1:AK(I)=2
240 IF R=0 THEN AK(I)=0
250 IF THEME=0 AND R>0 AND R<3 THEN AK(I)=1
251 IF THEME=0 AND LV>1 AND R=4 THEN AK(I)=2
252 IF THEME=1 AND R>0 AND R<3 THEN AK(I)=1
253 IF THEME=2 AND R=1 THEN AK(I)=1
254 IF THEME=3 AND R<2 THEN AK(I)=0
255 IF THEME=3 AND R=2 THEN AK(I)=1
256 IF THEME=4 AND R<2 THEN AK(I)=0
257 IF THEME=4 AND R>1 AND R<4 THEN AK(I)=1
270 NEXT C
271 NEXT R
280 FOR S=0 TO 3
290 SX(S)=56+S*59
295 FOR R=0 TO 2
296 FOR C=0 TO 3
297 SH(S*12+R*4+C)=1:IF THEME=2 OR THEME=4 THEN SH(S*12+R*4+C)=0
298 NEXT C
299 NEXT R
300 NEXT S
310 PX=148:D=1:BT=120:IF LV=1 THEN BT=210
311 BB=0:BB2=0:BB3=0:BB4=0:B=1:BY=0:START=1:REST=0:T=0:AF=0:UFO=0:UMODE=0:ULUSED=0:USTART=0:ULX=0:UTR=0:UCH=0:UFIRE=0:PSTILL=0:PV=0:UFB=0:UFBX=0:UFBY=0:UFT=0:UFDROP=0:UT=0:UM=INT(RND(360))+360:MT=0:DROP=0:TURN=0:STREAK=0:MS=0:BOSS=0:DV=0:DIVCD=INT(RND(300))+420:DTELL=0:DPT=0
312 BL=LV-1:IF BL>5 THEN BL=5
313 BMIN=36-2.4*BL:BMAX=120-9*BL:BS=2.67
314 IF THEME=1 THEN BMIN=30-1.8*BL:BMAX=90-7.2*BL:BS=3.33
315 IF THEME=2 THEN BMIN=21-1.2*BL:BMAX=60-4.8*BL:BS=4.17
316 IF THEME=3 THEN BMIN=27-1.8*BL:BMAX=72-6*BL:BS=3.67
317 IF THEME=4 THEN BMIN=18-1.2*BL:BMAX=51-4.2*BL:BS=4.67
319 REM --- PLAY LOOP - FORMATION, PLAYER, SHOTS, AND SHIELDS ---
320 CANVAS(320,200):CLEAR("BLIP_BLACK")
325 LS=1-(LV-1)*0.07
326 IF LS<0.5 THEN LS=0.5
327 SP=31*LEFT/(ROWS*COLS)*LS
328 IF SP<4 THEN SP=4
330 DRAW_HUD(SC,L)
360 IF MT<SP THEN MT=MT+1:GOTO 450
365 MT=0:MS=MS+1:IF MS>3 THEN MS=0
366 PLAY_SFX "MARCH"+STR$(MS+1)
370 IF DROP=1 THEN GOTO 380
375 GOTO 400
380 DROPY=4+(LV-1)*0.67:IF DROPY>6 THEN DROPY=6
385 FOR I=0 TO MAXI
386 IF AA(I)=1 THEN AY(I)=AY(I)+DROPY
390 NEXT I
395 DROP=0:D=-D:GOTO 450
400 TURN=0:AF=1-AF:FOR I=0 TO MAXI
405 IF AA(I)=0 THEN GOTO 420
410 AX(I)=AX(I)+D*8
415 IF AX(I)>296 AND D=1 THEN TURN=1
416 IF AX(I)<2 AND D=-1 THEN TURN=1
420 NEXT I
425 IF TURN=1 THEN DROP=1
430 GOTO 450
450 IF LV>=3 AND BOSS=0 THEN GOSUB 1100
451 FOR J=0 TO MAXI
460 IF AA(J)=0 THEN GOTO 490
470 IF AK(J)=0 AND AF=0 THEN DRAW_TEXTURE("ALIEN_SQUID_A",AX(J),AY(J),24,10)
471 IF AK(J)=0 AND AF=1 THEN DRAW_TEXTURE("ALIEN_SQUID_B",AX(J),AY(J),24,10)
472 IF AK(J)=1 AND AF=0 THEN DRAW_TEXTURE("ALIEN_CRAB_A",AX(J),AY(J),24,10)
473 IF AK(J)=1 AND AF=1 THEN DRAW_TEXTURE("ALIEN_CRAB_B",AX(J),AY(J),24,10)
474 IF AK(J)=2 AND AF=0 THEN DRAW_TEXTURE("ALIEN_OCTOPUS_A",AX(J),AY(J),24,10)
475 IF AK(J)=2 AND AF=1 THEN DRAW_TEXTURE("ALIEN_OCTOPUS_B",AX(J),AY(J),24,10)
480 IF AY(J)>177 THEN GOTO 900
489 NEXT J
490 IF DV=1 THEN FILL_GLOW_CIRCLE(AX(DIDX)+12,AY(DIDX)+5,9,COLOR(1,0.25,0.1,0.45))
491 IF DV=2 AND DVT=0 AND AF=0 THEN DRAW_TEXTURE("ALIEN_SQUID_A",DXD,DYD,24,10,"BLIP_WHITE")
492 IF DV=2 AND DVT=0 AND AF=1 THEN DRAW_TEXTURE("ALIEN_SQUID_B",DXD,DYD,24,10,"BLIP_WHITE")
493 IF DV=2 AND DVT=1 AND AF=0 THEN DRAW_TEXTURE("ALIEN_CRAB_A",DXD,DYD,24,10,"BLIP_WHITE")
494 IF DV=2 AND DVT=1 AND AF=1 THEN DRAW_TEXTURE("ALIEN_CRAB_B",DXD,DYD,24,10,"BLIP_WHITE")
495 IF DV=2 AND DVT=2 AND AF=0 THEN DRAW_TEXTURE("ALIEN_OCTOPUS_A",DXD,DYD,24,10,"BLIP_WHITE")
496 IF DV=2 AND DVT=2 AND AF=1 THEN DRAW_TEXTURE("ALIEN_OCTOPUS_B",DXD,DYD,24,10,"BLIP_WHITE")
497 IF THEME=2 OR THEME=4 THEN GOTO 540
498 FOR S=0 TO 3
500 FOR R=0 TO 2
510 FOR C=0 TO 3
520 SI=S*12+R*4+C:IF SH(SI)=1 THEN DRAW_TEXTURE("SHIELD_BLOCK",SX(S)+C*8,158+R*4,8,4)
530 NEXT C
531 NEXT R
532 NEXT S
538 REM --- PLAYER STEERING AND FIRE ---
539 PSTILL=PSTILL+1:DIR=(KEY_ACTIVE("RIGHT") OR KEY_ACTIVE("D"))-(KEY_ACTIVE("LEFT") OR KEY_ACTIVE("A"))
540 IF REST=0 AND DIR*PV<0 AND PV>0 THEN PV=PV-.59:PSTILL=0
541 IF REST=0 AND DIR*PV<0 AND PV<0 THEN PV=PV+.59:PSTILL=0
542 IF REST=0 AND DIR=0 AND PV>0 THEN PV=PV-.59
543 IF REST=0 AND DIR=0 AND PV<0 THEN PV=PV+.59
544 IF ABS(PV)<.59 AND (DIR=0 OR DIR*PV<0) THEN PV=0
545 IF REST=0 AND DIR<>0 AND DIR*PV>=0 THEN PV=PV+DIR*.41:PSTILL=0
546 IF PV>2.2 THEN PV=2.2
547 IF PV<0-2.2 THEN PV=0-2.2
548 IF REST=0 THEN PX=PX+PV
560 IF PX<4 THEN PX=4:PV=0
570 IF PX>296 THEN PX=296:PV=0
580 IF REST=0 AND KEY_ACTIVE("SPACE") AND B=0 THEN B=1:BX=PX+10:BY=178:PLAY_SFX "SHOOT"
590 IF B=1 THEN BY=BY-2.6:DRAW_TEXTURE("/TAPE/GFX/GALACTIC_DEFENDER/BULLET.PNG",BX,BY,4,12)
595 GOSUB 1000
600 IF BY<11 THEN B=0:STREAK=0
605 HITD=0:IF DV=2 AND B=1 AND BX<DXD+24 AND BX+5>DXD AND BY<DYD+10 AND BY+6>DYD THEN HITD=1:B=0:DV=0:STREAK=STREAK+1:DPTS=(3-DVT)*20*LV:DPT=30:DPOPX=DXD:DPOPY=DYD
606 IF HITD=1 THEN SC=SC+DPTS:EX=27:EXX=DXD:EXY=DYD:PLAY_SFX "EXPLOSION"
610 FOR I=0 TO MAXI
620 IF B=0 OR AA(I)=0 THEN GOTO 650
630 IF BX<AX(I)+24 AND BX+5>AX(I) AND BY<AY(I)+10 AND BY+6>AY(I) THEN AA(I)=0:B=0:LEFT=LEFT-1:STREAK=STREAK+1:MULT=1+INT((STREAK-1)/3)
631 IF MULT>5 THEN MULT=5
632 IF DV=1 AND I=DIDX AND AA(I)=0 THEN DV=0
635 IF B=0 AND AA(I)=0 THEN SC=SC+(3-AK(I))*10*MULT*LV:EX=27:EXX=AX(I):EXY=AY(I):PLAY_SFX "EXPLOSION"
650 NEXT I
659 IF LEFT=0 AND INT(LV/5)*5=LV AND BOSS=0 AND DV=0 THEN BOSS=1:UFO=0:UMODE=0:UFB=0:BHP=16:UBX=-60:UBD=1:BTIMER=0:BOSSSTEP=63-5*(INT(LV/5)-1):BB=0:BB2=0:BB3=0:BB4=0:PLAY_SFX "UFO_SIREN":PLAY_MUSIC "DEFENDER_BOSS"
660 IF LEFT=0 AND BOSS<>1 AND DV=0 THEN GOTO 800
661 IF BOSS=1 AND BOSSSTEP<25 THEN BOSSSTEP=25
662 IF BOSS=1 THEN UBX=UBX+UBD*0.87
663 IF BOSS=1 AND UBX>260 THEN UBX=260:UBD=-1
664 IF BOSS=1 AND UBX<0 THEN UBX=0:UBD=1
665 IF BOSS=1 THEN BTIMER=BTIMER+1:IF BTIMER>BOSSSTEP AND BB=0 AND BB2=0 AND BB3=0 AND BB4=0 THEN BB=1:BBX=UBX+10:BBY=60:BB2=1:BBX2=UBX+28:BBY2=60:BB3=1:BBX3=UBX+46:BBY3=60:BTIMER=0:PLAY_SFX "SHOOT"
666 IF BOSS=1 AND B=1 AND BX<UBX+60 AND BX+5>UBX AND BY<61 AND BY+6>27 THEN B=0:BHP=BHP-1:PLAY_SFX "EXPLOSION"
667 IF BOSS=1 AND BHP<1 THEN BOSS=2:BB=0:BB2=0:BB3=0:SC=SC+500*LV:PLAY_SFX "LEVEL_CLEAR":PLAY_MUSIC "DEFENDER_MAIN"
668 IF BOSS=1 THEN U=INT(T/2)-INT(T/16)*8:DRAW_TEXTURE("UFO_SAUCER_"+STR$(U),UBX,27,60,34):FILL_RECT(UBX,63,60,3,"BLIP_RED"):FILL_RECT(UBX,63,60*BHP/16,3,"BLIP_GREEN")
669 IF BOSS=1 THEN GOTO 680
670 GOSUB 1500
680 IF BOSS=1 THEN GOTO 693
681 IF BT>0 THEN BT=BT-1
682 IF BT>0 OR (BB=1 AND BB2=1 AND BB3=1 AND BB4=1) THEN GOTO 693
683 BT=INT(RND(BMAX-BMIN))+BMIN:BC=INT(RND(COLS)):BR=ROWS-1
684 BI=BR*COLS+BC
685 IF BR<0 THEN GOTO 693
686 IF AA(BI)=0 THEN BR=BR-1:GOTO 684
687 IF BB=0 THEN BB=1:BBX=AX(BI)+10:BBY=AY(BI)+12:GOTO 693
688 IF BB2=0 THEN BB2=1:BBX2=AX(BI)+10:BBY2=AY(BI)+12:GOTO 693
689 IF BB3=0 THEN BB3=1:BBX3=AX(BI)+10:BBY3=AY(BI)+12:GOTO 693
690 IF BB4=0 THEN BB4=1:BBX4=AX(BI)+10:BBY4=AY(BI)+12:GOTO 693
693 IF BB=1 THEN BBY=BBY+BS:DRAW_TEXTURE("/TAPE/GFX/GALACTIC_DEFENDER/BULLET.PNG",BBX,BBY,4,12,"BLIP_ORANGE")
694 IF BB2=1 THEN BBY2=BBY2+BS:DRAW_TEXTURE("/TAPE/GFX/GALACTIC_DEFENDER/BULLET.PNG",BBX2,BBY2,4,12,"BLIP_ORANGE")
695 IF BB3=1 THEN BBY3=BBY3+BS:DRAW_TEXTURE("/TAPE/GFX/GALACTIC_DEFENDER/BULLET.PNG",BBX3,BBY3,4,12,"BLIP_ORANGE")
696 IF BB4=1 THEN BBY4=BBY4+BS:DRAW_TEXTURE("/TAPE/GFX/GALACTIC_DEFENDER/BULLET.PNG",BBX4,BBY4,4,12,"BLIP_ORANGE")
697 GOSUB 1000
698 IF UFB=1 THEN UFBY=UFBY+BS:DRAW_TEXTURE("/TAPE/GFX/GALACTIC_DEFENDER/BULLET.PNG",UFBX,UFBY,4,12,"BLIP_ORANGE")
699 TX=UFBX:TY=UFBY:Z=UFB:GOSUB 1430
700 IF HIT=1 AND Z=1 AND REST=0 THEN UFB=0:L=L-1:EX=27:EXX=PX:EXY=178:PLAY_SFX "EXPLOSION":REST=22
701 TX=BBX:TY=BBY:Z=BB:GOSUB 1430
702 IF HIT=1 AND Z=1 AND REST=0 THEN BB=0:L=L-1:PLAY_SFX "EXPLOSION":REST=22
703 TX=BBX2:TY=BBY2:Z=BB2:GOSUB 1430
704 IF HIT=1 AND Z=1 AND REST=0 THEN BB2=0:L=L-1:PLAY_SFX "EXPLOSION":REST=22
705 TX=BBX3:TY=BBY3:Z=BB3:GOSUB 1430
706 IF HIT=1 AND Z=1 AND REST=0 THEN BB3=0:L=L-1:PLAY_SFX "EXPLOSION":REST=22
707 TX=BBX4:TY=BBY4:Z=BB4:GOSUB 1430
708 IF HIT=1 AND Z=1 AND REST=0 THEN BB4=0:L=L-1:PLAY_SFX "EXPLOSION":REST=22
709 IF UFBY>198 THEN UFB=0
710 IF BBY>198 THEN BB=0
711 IF BBY2>198 THEN BB2=0
712 IF BBY3>198 THEN BB3=0
713 IF BBY4>198 THEN BB4=0
720 IF REST=0 THEN DRAW_TEXTURE("PLAYER_SHIP",PX,178,24,10)
725 DRAW_LINE(0,188,320,188,"BLIP_GREEN")
730 IF EX>0 THEN DRAW_TEXTURE("GALACTIC_EXPLOSION",EXX,EXY,24,13):EX=EX-1
731 IF DPT>0 THEN DRAW_NUMBER(DPTS,DPOPX,DPOPY-8,1,"BLIP_YELLOW"):DPT=DPT-1
735 T=T+1:IF T>29 THEN T=0
740 IF L<1 THEN GOTO 900
750 IF KEY_PRESSED("SPACE") AND B=0 AND START=0 AND REST=0 THEN B=1:BX=PX+10:BY=178:PLAY_SFX "SHOOT"
755 START=0:IF REST>0 THEN REST=REST-1
760 IF 1=1 THEN WAIT 0:GOTO 320
799 REM --- WAVE CLEAR ---
800 CLEAR("BLIP_BLACK"):PLAY_SFX "LEVEL_CLEAR"
810 DRAW_TEXT("WAVE CLEAR",160,63,2,"BLIP_CYAN","CENTER")
820 DRAW_TEXT("SCORE",160,91,1,"BLIP_WHITE","CENTER"):DRAW_NUMBER(SC,201,91,1,"BLIP_YELLOW")
830 IF KEY_PRESSED("SPACE")=0 THEN WAIT 0:GOTO 830
840 LV=LV+1:GOTO 200
899 REM --- GAME OVER ---
900 CLEAR("BLIP_BLACK"):PLAY_SFX "GAME_OVER"
910 DRAW_TEXT("GAME OVER",160,63,2,"BLIP_RED","CENTER")
920 DRAW_TEXT("SCORE",160,91,1,"BLIP_WHITE","CENTER"):DRAW_NUMBER(SC,201,91,1,"BLIP_YELLOW")
930 IF KEY_PRESSED("SPACE")=0 THEN WAIT 0:GOTO 930
940 GOTO 10
999 REM --- SHIELD DAMAGE - PLAYER SHOTS AND ENEMY BOMBS ---
1000 IF B=0 AND BB=0 AND BB2=0 AND BB3=0 AND BB4=0 AND UFB=0 THEN RETURN
1005 FOR S=0 TO 3
1010 SI=-1
1020 IF B=1 AND BX<SX(S)+32 AND BX+5>SX(S) AND BY<170 AND BY+6>158 THEN SHC=INT((BX+2.5-SX(S))/8):SR=INT((BY+3-158)/4):SI=S*12+SR*4+SHC
1030 IF SI>=0 AND SI<48 AND SHC>=0 AND SHC<4 AND SR>=0 AND SR<3 AND SH(SI)=1 AND B=1 THEN SH(SI)=0:B=0:STREAK=0
1040 SI=-1
1050 IF BB=1 AND BBX<SX(S)+32 AND BBX+5>SX(S) AND BBY<170 AND BBY+6>158 THEN SHC=INT((BBX+2.5-SX(S))/8):SR=INT((BBY+3-158)/4):SI=S*12+SR*4+SHC
1060 IF SI>=0 AND SI<48 AND SHC>=0 AND SHC<4 AND SR>=0 AND SR<3 AND SH(SI)=1 AND BB=1 THEN SH(SI)=0:BB=0
1070 SI=-1
1071 IF BB2=1 AND BBX2<SX(S)+32 AND BBX2+5>SX(S) AND BBY2<170 AND BBY2+6>158 THEN SHC=INT((BBX2+2.5-SX(S))/8):SR=INT((BBY2+3-158)/4):SI=S*12+SR*4+SHC
1072 IF SI>=0 AND SI<48 AND SHC>=0 AND SHC<4 AND SR>=0 AND SR<3 AND SH(SI)=1 AND BB2=1 THEN SH(SI)=0:BB2=0
1073 SI=-1
1074 IF BB3=1 AND BBX3<SX(S)+32 AND BBX3+5>SX(S) AND BBY3<170 AND BBY3+6>158 THEN SHC=INT((BBX3+2.5-SX(S))/8):SR=INT((BBY3+3-158)/4):SI=S*12+SR*4+SHC
1075 IF SI>=0 AND SI<48 AND SHC>=0 AND SHC<4 AND SR>=0 AND SR<3 AND SH(SI)=1 AND BB3=1 THEN SH(SI)=0:BB3=0
1076 SI=-1
1077 IF BB4=1 AND BBX4<SX(S)+32 AND BBX4+5>SX(S) AND BBY4<170 AND BBY4+6>158 THEN SHC=INT((BBX4+2.5-SX(S))/8):SR=INT((BBY4+3-158)/4):SI=S*12+SR*4+SHC
1078 IF SI>=0 AND SI<48 AND SHC>=0 AND SHC<4 AND SR>=0 AND SR<3 AND SH(SI)=1 AND BB4=1 THEN SH(SI)=0:BB4=0
1079 SI=-1
1080 IF UFB=1 AND UFBX<SX(S)+32 AND UFBX+5>SX(S) AND UFBY<170 AND UFBY+6>158 THEN SHC=INT((UFBX+2.5-SX(S))/8):SR=INT((UFBY+3-158)/4):SI=S*12+SR*4+SHC
1081 IF SI>=0 AND SI<48 AND SHC>=0 AND SHC<4 AND SR>=0 AND SR<3 AND SH(SI)=1 AND UFB=1 THEN SH(SI)=0:UFB=0
1085 NEXT S
1090 RETURN
1099 REM --- DIVER UPDATE - CHASE, DRAW, AND PLAYER COLLISION ---
1100 IF DV=2 THEN DXT=PX+12-DXD
1101 IF DV=2 AND DXT>0.67 THEN DXT=0.67
1102 IF DV=2 AND DXT<0-0.67 THEN DXT=0-0.67
1103 IF DV=2 THEN DXD=DXD+DXT:DYD=DYD+0.925:GOSUB 1200
1104 IF DV=1 THEN DTELL=DTELL-1
1105 IF DV=1 AND DTELL<1 THEN AA(DIDX)=0:LEFT=LEFT-1:DV=2:PLAY_SFX "DIVE"
1106 IF DV=2 AND DYD>170 AND DXD+20>PX+3 AND DXD+4<PX+21 THEN DV=0:L=L-1:REST=22:EX=27:EXX=PX:EXY=178:PLAY_SFX "EXPLOSION"
1107 IF DV=2 AND DYD>=178 THEN DV=0:EX=27:EXX=DXD:EXY=DYD:PLAY_SFX "EXPLOSION"
1108 IF DV<>0 THEN RETURN
1110 IF LEFT<6 THEN RETURN
1120 DIVCD=DIVCD-1
1130 IF DIVCD>0 THEN RETURN
1140 DIVCD=INT(RND(300))+420:DC=INT(RND(COLS)):DR=ROWS-1
1150 DIDX=DR*COLS+DC
1160 IF DR<0 THEN RETURN
1170 IF AA(DIDX)=1 THEN DV=1:DVT=AK(DIDX):DXD=AX(DIDX):DYD=AY(DIDX):DTELL=48:RETURN
1180 DR=DR-1:GOTO 1150
1199 REM --- DIVER IMPACT - REMOVE SHIELD BLOCKS ---
1200 FOR DS=0 TO 3
1210 FOR DRB=0 TO 2
1220 FOR DCB=0 TO 3
1230 SI=DS*12+DRB*4+DCB
1240 IF DV=2 AND SH(SI)=1 AND DXD+20>SX(DS)+DCB*8 AND DXD+4<SX(DS)+DCB*8+8 AND DYD+8>158+DRB*4 AND DYD+2<162+DRB*4 THEN SH(SI)=0
1250 NEXT DCB
1260 NEXT DRB
1270 NEXT DS
1280 RETURN
1299 REM --- UFO LASER - CLEAR ITS COLUMN AND AWARD ALIEN POINTS ---
1300 FOR LI=0 TO MAXI
1310 IF AA(LI)=1 AND AX(LI)<ULX+24 AND AX(LI)+24>ULX THEN AA(LI)=0:LEFT=LEFT-1:SC=SC+(3-AK(LI))*10*LV:EX=27:EXX=AX(LI):EXY=AY(LI)
1320 NEXT LI
1330 FOR LS=0 TO 3
1340 FOR LC=0 TO 3
1350 FOR LR=0 TO 2
1360 SI=LS*12+LR*4+LC
1370 IF SH(SI)=1 AND SX(LS)+LC*8<ULX+24 AND SX(LS)+LC*8+8>ULX THEN SH(SI)=0
1380 NEXT LR
1390 NEXT LC
1400 NEXT LS
1410 IF PX<ULX+24 AND PX+24>ULX THEN L=L-1:REST=216:EX=27:EXX=PX:EXY=178:BB=0:BB2=0:BB3=0:BB4=0:UFB=0:B=0:PLAY_SFX "EXPLOSION"
1420 RETURN
1428 REM INPUT: TX/TY IS THE ATTACK POSITION; OUTPUT: HIT IS 0 OR 1.
1429 REM --- PLAYER HIT TEST - USE THE TAPERED SHIP OUTLINE ---
1430 HIT=0:IF TY+6<178 OR TY>188 THEN RETURN
1440 HY=TY+6:IF HY>188 THEN HY=188
1450 HR=(HY-178)/10:HW=(1+HR*15)*0.75:IF HW<2 THEN HW=2
1460 IF ABS(TX+1.5-PX-12)<=HW+1.33 THEN HIT=1
1470 RETURN
1499 REM --- UFO UPDATE - PATROL, LASER, AND DELAYED BOMB ---
1500 IF UFO=0 THEN UT=UT+1
1510 IF UT>UM AND UFO=0 THEN UFO=1:UT=0:UM=INT(RND(360))+360:UD=1-2*INT(RND(2)):UX=-24:USTART=1:UFT=0:UFDROP=0:UFB=0
1520 IF USTART=1 AND UD=-1 THEN UX=320
1530 IF USTART=1 THEN USTART=0:PLAY_SFX "UFO_SIREN":ULTRY=1
1540 IF ULTRY=1 THEN ULTRY=0:IF ULUSED=0 AND RND(100)<35 THEN UMODE=1:ULUSED=1:UTR=240
1550 IF UFO=1 AND UMODE=0 THEN UX=UX+UD*0.9
1555 IF UFO=1 AND UMODE=0 THEN UFT=UFT+1
1560 IF UFO=1 AND UMODE=1 THEN UDX=PX-UX:IF ABS(UDX)>2.55 THEN UDX=2.55*UDX/ABS(UDX)
1565 IF UFO=1 AND UMODE=0 AND UFT>180 AND UFDROP=0 THEN UFDROP=1:UFB=1:UFBX=UX+10:UFBY=18
1570 IF UFO=1 AND UMODE=1 THEN UX=UX+UDX:UTR=UTR-1:UET=240-UTR:IF UTR<1 OR (UET>=108 AND ABS(PX-UX)<9 AND PSTILL>=24) THEN UMODE=2:UCH=114:PLAY_SFX "LASER_CHARGE"
1580 IF UFO=1 AND UMODE=2 THEN UCH=UCH-1:UP=1-UCH/114:FILL_GLOW_CIRCLE(UX+12,21,8+UP*16,COLOR(1,0.25+UP*0.5,0.15,0.6+UP*0.4)):DRAW_GLOW_LINE(UX+12,21,UX+12,188,COLOR(1,0.2,0.2,0.5+UP*0.4)):IF UCH<1 THEN UMODE=3:ULX=UX:UFIRE=24:PLAY_SFX "LASER_BLAST":GOSUB 1300
1590 IF UFO=1 AND UMODE=3 THEN UFIRE=UFIRE-1
1600 IF UFO=1 AND UMODE=3 AND UFIRE>17 THEN FILL_RECT(0,28,320,160,COLOR(1,1,1,0.18))
1610 IF UFO=1 AND UMODE=3 THEN DRAW_GLOW_LINE(ULX+6,21,ULX+6,188,COLOR(1,0.35,0.35,0.8)):DRAW_GLOW_LINE(ULX+12,21,ULX+12,188,COLOR(1,0.35,0.35,0.9)):DRAW_GLOW_LINE(ULX+18,21,ULX+18,188,COLOR(1,0.35,0.35,0.8)):DRAW_LINE_EX(ULX+9,21,ULX+9,188,4,"BLIP_WHITE"):DRAW_LINE_EX(ULX+15,21,ULX+15,188,4,"BLIP_WHITE")
1620 IF UFO=1 AND UMODE=3 AND UFIRE<1 THEN UFO=0:UMODE=0:UT=0:UM=INT(RND(360))+360:PLAY_SFX "EXPLOSION"
1630 IF UFO=1 THEN U=INT(T/2)-INT(T/16)*8:DRAW_TEXTURE("UFO_SAUCER_"+STR$(U),UX,13,24,7):IF UMODE=1 THEN DRAW_LINE(UX+12,20,PX+12,178,COLOR(1,0.3,0.3,0.18))
1640 IF UFO=1 AND UMODE=0 AND (UX>320 OR UX+24<0) THEN UFO=0:UFB=0:UT=0:UM=INT(RND(360))+360
1650 IF UFO=1 AND UMODE<>3 AND B=1 AND BX<UX+24 AND BX+5>UX AND BY<20 AND BY+6>13 THEN UFO=0:UMODE=0:UFB=0:UT=0:UM=INT(RND(360))+360:B=0:UPOP=INT(RND(6))*50+50:SC=SC+UPOP:DPTS=UPOP:DPT=90:DPOPX=UX:DPOPY=29:PLAY_SFX "EXPLOSION"
1660 RETURN
