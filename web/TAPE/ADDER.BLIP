1 REM ADDER - VIPERS IN A PIT. TRAILS STAY ALL ROUND; DIM GAPS LET YOU THROUGH.
2 REM GAME: ADDER
3 REM GREEN VIPER: A/D, OR THE ARROWS ALONE. PLAYER TWO: LEFT/RIGHT, J TO JOIN.
4 REM SCREENS: TITLE (THE CPUS PLAY), PLAY, OVER - EACH HAS AN UPDATE AND A DRAW.
5 REM A VIPER'S TRAIL IS PATH(SEAT,I,0/1/2): X, Y, AND THE GAP IT BELONGS TO, IF ANY.
10 REM --- SETUP ---
11 ASSETS$="/TAPE/ADDER/ASSETS/"
15 PIT_X=10:PIT_Y=40
20 PIT_W=620:PIT_H=350
25 SPEED=85:TURN_RATE=3.2
30 BODY_R=2:SAMPLE=2:START_SAMPLES=17
35 HOLE_SAMPLES=10:HOLE_EVERY=2.5
40 HOLE_POINTS=50:KILL_POINTS=100:ROUND_POINTS=250
45 MAX_SEATS=6:LIVES_START=3:FAST_ROUND=4
50 REM A CPU LOOKS 70 PIXELS AHEAD, AND WANTS 0.45 SECONDS OF ROOM WITH A MARGIN
55 LOOK=70:SAFE=SPEED*0.45*1.3
60 GRID=8
62 SAND$="#998A5C":GOLD$="#FFDB57"
65 LOAD_SEATS
70 LOAD_FAN
80 PLAY_MUSIC ASSETS$+"COIL.WAV"
85 START_DEMO
90 LAST_TIME=TIME()
100 REM --- MAIN LOOP - UPDATE THE SCREEN WE ARE ON, THEN DRAW IT ---
110 NOW=TIME()
111 DT=CLAMP(NOW-LAST_TIME,0,0.1)
112 LAST_TIME=NOW
120 READ_KEYS
130 IF STATE$="TITLE" THEN
131   UPDATE_TITLE
132 ELSEIF STATE$="PLAY" THEN
133   UPDATE_PLAY
134 ELSE
135   UPDATE_OVER
136 END IF
150 IF STATE$="TITLE" THEN
151   DRAW_TITLE
152 ELSEIF STATE$="PLAY" THEN
153   DRAW_PLAY
154 ELSE
155   DRAW_OVER
156 END IF
170 WAIT 0
180 GOTO 110
1000 REM --- TITLE - THREE CPUS PLAY A REAL PIT WHILE WE WAIT ---
1010 SUB UPDATE_TITLE
1020   STEP_WORLD
1030   IF FIRE THEN
1040     START_GAME 1
1050   ELSEIF JOIN THEN
1060     START_GAME 2
1070   END IF
1080 END SUB
1100 SUB DRAW_TITLE
1110   DRAW_WORLD
1120   FILL_RECT(0,56,640,84,"#0000008C")
1130   FILL_RECT(0,290,640,110,"#0000008C")
1140   DRAW_TEXT("ADDER",320,72,6,C(1),"CENTER","BLIP_BLACK")
1150   DRAW_TEXT(CONTROL_TEXT$("SPACE TO START","PRESS FIRE TO START","TAP TO START"),320,298,3,"BLIP_WHITE","CENTER")
1160   DRAW_TEXT(CONTROL_TEXT$("GREEN VIPER: A/D TURN","GREEN VIPER: STICK LEFT/RIGHT","GREEN VIPER: DRAG LEFT/RIGHT"),320,326,2,SAND$,"CENTER")
1170   DRAW_TEXT("GROWING TRAILS STAY ALL ROUND",320,344,2,SAND$,"CENTER")
1180   DRAW_TEXT("DIM GAPS ARE PASSABLE",320,362,2,GOLD$,"CENTER")
1190   DRAW_TEXT("P2: LEFT/RIGHT TURN, J TO JOIN",320,380,2,C(2),"CENTER")
1200 END SUB
2000 REM --- START - A GAME, A ROUND, AND A PLACE FOR EACH VIPER ---
2010 SUB START_DEMO
2020   DEMO=1
2030   NEW_WORLD 0,3
2040   STATE$="TITLE"
2050 END SUB
2100 SUB START_GAME(PEOPLE)
2110   DEMO=0
2120   NEW_WORLD PEOPLE,PEOPLE+1
2130   FX_CLEAR()
2140   PLAY_MUSIC ASSETS$+"COIL.WAV"
2150   STATE$="PLAY"
2160 END SUB
2200 REM PEOPLE TAKE THE FIRST SEATS; EVERY OTHER SEAT IS A CPU
2210 SUB NEW_WORLD(PEOPLE,COUNT)
2220   LOCAL S
2230   ROUND=1
2240   SEATS=COUNT
2250   WORLD_OVER=0
2260   FOR S=1 TO MAX_SEATS
2270     HUMAN(S)=(S<=PEOPLE)
2280     IF HUMAN(S) THEN LIFE(S)=LIVES_START ELSE LIFE(S)=1
2290     PTS(S)=0
2300   NEXT S
2310   START_ROUND
2320 END SUB
2400 REM A ROUND STARTS CLEAN: EVERY TRAIL GOES, AND EACH VIPER FINDS ROOM
2410 SUB START_ROUND
2420   LOCAL S,I,BACK
2430   EPOCH=EPOCH+1
2440   POINTS=0:HOLE_COUNT=0
2450   ROUND_WAIT=0:BANNER_TIME=0
2460   FOR S=1 TO SEATS
2470     IF NOT HUMAN(S) THEN LIFE(S)=1
2480     ALIVE(S)=(LIFE(S)>0)
2490     LENGTH(S)=0:TRAVEL(S)=0
2500     HOLE_WAIT(S)=HOLE_EVERY:GAP_LEFT(S)=0
2510     HOLES(S)=0
2520     IF ALIVE(S) THEN
2530       FIND_SPAWN S
2540       FOR I=1 TO START_SAMPLES
2550         BACK=(START_SAMPLES-I)*SAMPLE
2560         ADD_SAMPLE S,HEAD_X(S)-COS(ANGLE(S))*BACK,HEAD_Y(S)-SIN(ANGLE(S))*BACK,0
2570       NEXT I
2580     END IF
2590   NEXT S
2600 END SUB
2700 REM THE ROOMIEST OF SIXTY RANDOM SPOTS, OR THE FIRST WITH 64 PIXELS SPARE,
2701 REM FACING THE MIDDLE OF THE PIT
2710 SUB FIND_SPAWN(S)
2720   LOCAL TRY,X,Y,BEST
2730   BEST=-1
2740   FOR TRY=1 TO 60
2750     X=PIT_X+50+RND(PIT_W-100)
2760     Y=PIT_Y+50+RND(PIT_H-100)
2770     ROOM_AT X,Y,S
2780     IF ROOM>BEST THEN BEST=ROOM:HEAD_X(S)=X:HEAD_Y(S)=Y
2790     IF ROOM>64 THEN EXIT FOR
2800   NEXT TRY
2810   ANGLE(S)=ATAN2(PIT_Y+PIT_H/2-HEAD_Y(S),PIT_X+PIT_W/2-HEAD_X(S))
2820 END SUB
2900 SUB ROOM_AT(X,Y,S)
2910   LOCAL V,I
2920   ROOM=MIN(MIN(X-PIT_X,PIT_X+PIT_W-X),MIN(Y-PIT_Y,PIT_Y+PIT_H-Y))
2930   FOR V=1 TO S-1
2940     ROOM=MIN(ROOM,DISTANCE(X,Y,HEAD_X(V),HEAD_Y(V))-BODY_R)
2950     FOR I=1 TO LENGTH(V)
2960       ROOM=MIN(ROOM,DISTANCE(X,Y,PATH(V,I,0),PATH(V,I,1))-BODY_R)
2970     NEXT I
2980   NEXT V
2990 END SUB
3000 REM --- PLAY - PLAYER TWO CAN JOIN AT ANY TIME OUTSIDE A ROUND'S END ---
3010 SUB UPDATE_PLAY
3020   IF JOIN THEN JOIN_PLAYER_TWO
3030   STEP_WORLD
3040   IF WORLD_OVER THEN
3050     STATE$="OVER"
3060     WAIT_LEFT=2
3070   END IF
3080 END SUB
3100 REM PLAYER TWO TAKES OVER THE FIRST CPU, FROM ITS NEXT ROUND IF IT IS DOWN
3110 SUB JOIN_PLAYER_TWO
3120   IF WORLD_OVER OR ROUND_WAIT>0 OR SEATS<2 OR HUMAN(2) THEN EXIT SUB
3130   HUMAN(2)=1
3140   LIFE(2)=LIVES_START
3150 END SUB
3200 SUB DRAW_PLAY
3210   LOCAL WON,S
3220   DRAW_WORLD
3230   IF ROUND_WAIT>0 THEN
3240     FOR S=1 TO SEATS
3250       IF ALIVE(S) AND HUMAN(S) THEN WON=1
3260     NEXT S
3270     IF WON THEN DRAW_TEXT("YOU WIN",320,200,4,GOLD$,"CENTER") ELSE DRAW_TEXT("ROUND LOST",320,200,4,"BLIP_RED","CENTER")
3280   ELSEIF BANNER_TIME<1.6 THEN
3290     DRAW_TEXT("ROUND "+STR$(ROUND),320,200,4,COLOR(1,0.86,0.34,1-BANNER_TIME/1.6),"CENTER")
3300   END IF
3310   DRAW_HUD(PTS(1),LIFE(1))
3320 END SUB
4000 REM --- THE PIT - EVERY VIPER DECIDES, THEN THEY ALL MOVE AT ONCE ---
4010 SUB STEP_WORLD
4020   LOCAL S
4030   FX_UPDATE(DT)
4040   BANNER_TIME=BANNER_TIME+DT
4050   IF ROUND_WAIT>0 THEN
4060     ROUND_WAIT=MAX(0,ROUND_WAIT-DT)
4070     IF ROUND_WAIT=0 THEN NEXT_ROUND
4080     EXIT SUB
4090   END IF
4100   FOR S=1 TO SEATS
4110     MOVING(S)=ALIVE(S)
4120     IF ALIVE(S) THEN STEER_VIPER S
4130   NEXT S
4140   FOR S=1 TO SEATS
4150     IF MOVING(S) THEN PLAN_MOVE S
4160   NEXT S
4170   CHECK_HEAD_ON
4180   FOR S=1 TO SEATS
4190     IF MOVING(S) THEN RESOLVE_MOVE S
4200   NEXT S
4210   FOR S=1 TO SEATS
4220     IF MOVING(S) AND ALIVE(S) THEN GROW S
4230   NEXT S
4240   CHECK_ROUND
4250 END SUB
4300 SUB PLAN_MOVE(S)
4310   TICK_HOLE S
4320   ANGLE(S)=ANGLE(S)+CLAMP(TURN(S),-1,1)*TURN_RATE*DT
4330   FROM_X(S)=HEAD_X(S):FROM_Y(S)=HEAD_Y(S)
4340   TO_X(S)=HEAD_X(S)+COS(ANGLE(S))*SPEED*DT
4350   TO_Y(S)=HEAD_Y(S)+SIN(ANGLE(S))*SPEED*DT
4360   FIND_HIT S
4370 END SUB
4400 REM TWO HEADS THAT MEET THIS FRAME BOTH GO DOWN
4410 SUB CHECK_HEAD_ON
4420   LOCAL A,B,MEET
4430   FOR A=1 TO SEATS-1
4440     FOR B=A+1 TO SEATS
4450       IF MOVING(A) AND MOVING(B) THEN
4460         MEET=SEGMENT_CIRCLE_OVERLAP(FROM_X(A)-FROM_X(B),FROM_Y(A)-FROM_Y(B),TO_X(A)-TO_X(B),TO_Y(A)-TO_Y(B),0,0,BODY_R*2)
4470         IF MEET THEN HIT(A)=B:HIT(B)=A
4480       END IF
4490     NEXT B
4500   NEXT A
4510 END SUB
4600 SUB RESOLVE_MOVE(S)
4610   IF HIT(S)=-1 THEN
4620     ELIMINATE S,0
4630   ELSEIF HIT(S)>0 THEN
4640     ELIMINATE S,HIT(S)
4650   ELSEIF HIT_HOLE(S)>0 THEN
4660     GO_THROUGH S,HIT_HOLE(S)
4670   END IF
4680 END SUB
4700 REM A ROUND ENDS WITH ONE VIPER LEFT, OR WHEN EVERY PERSON IS DOWN
4710 SUB CHECK_ROUND
4720   LOCAL S,STANDING,WINNER,PEOPLE,PEOPLE_UP,LIVES_LEFT
4730   FOR S=1 TO SEATS
4740     IF ALIVE(S) THEN STANDING=STANDING+1:WINNER=S
4750     IF HUMAN(S) THEN PEOPLE=PEOPLE+1
4760     IF HUMAN(S) AND ALIVE(S) THEN PEOPLE_UP=PEOPLE_UP+1
4770     IF HUMAN(S) THEN LIVES_LEFT=LIVES_LEFT+LIFE(S)
4780   NEXT S
4790   IF PEOPLE>0 AND LIVES_LEFT=0 THEN WORLD_OVER=1:EXIT SUB
4800   IF SEATS<2 THEN EXIT SUB
4810   IF STANDING>1 AND (PEOPLE=0 OR PEOPLE_UP>0) THEN EXIT SUB
4820   IF STANDING=1 THEN
4830     PTS(WINNER)=PTS(WINNER)+ROUND_POINTS
4840     SOUND_EFFECT ASSETS$+"PIT.WAV"
4850   END IF
4860   ROUND_WAIT=2
4870 END SUB
4900 REM SCORES AND PEOPLE'S LIVES CARRY OVER; ONE MORE CPU JOINS, UP TO SIX
4910 SUB NEXT_ROUND
4920   ROUND=ROUND+1
4930   IF SEATS<MAX_SEATS THEN SEATS=SEATS+1
4940   START_ROUND
4950   IF ROUND=FAST_ROUND AND NOT DEMO THEN PLAY_MUSIC ASSETS$+"HUNT.WAV"
4960 END SUB
5000 REM --- STEERING - PEOPLE BY THEIR KEYS, CPUS BY LOOKING AHEAD ---
5010 SUB STEER_VIPER(S)
5020   IF HUMAN(S) THEN STEER_PERSON S ELSE STEER_CPU S
5030 END SUB
5100 REM BOTH KEYS AT ONCE CANCEL; ALONE, PLAYER ONE MAY USE THE ARROWS TOO
5110 SUB STEER_PERSON(S)
5120   LOCAL SOLO
5130   SOLO=NOT HUMAN(2)
5140   IF S=1 THEN
5150     TURN(1)=(KEY_ACTIVE("D") OR (SOLO AND KEY_ACTIVE("RIGHT")))-(KEY_ACTIVE("A") OR (SOLO AND KEY_ACTIVE("LEFT")))
5160   ELSE
5170     TURN(2)=KEY_ACTIVE("RIGHT")-KEY_ACTIVE("LEFT")
5180   END IF
5190 END SUB
5200 REM A CPU TRIES THIRTEEN HEADINGS; A CLEAR ONE BEATS CHASING A GAP
5210 SUB STEER_CPU(S)
5220   LOCAL F,OFF,DIRECTION,WORTH,BEST_ANY,ANY_OFF,BEST_SAFE,SAFE_OFF
5230   AIM_AT_GAP S
5240   CLEARANCE S,ANGLE(S)
5250   IF NOT WANT AND CLEAR>=LOOK-0.001 THEN TURN(S)=0:EXIT SUB
5260   BEST_ANY=-999999:BEST_SAFE=-999999
5270   FOR F=0 TO 12
5280     OFF=FAN(F)
5290     DIRECTION=ANGLE(S)+OFF
5300     CLEARANCE S,DIRECTION
5310     REM A LAZY TURN IS A CHEAP TURN
5320     WORTH=MIN(CLEAR,LOOK)-ABS(OFF)*4
5330     IF WANT THEN WORTH=WORTH-ABS(ANGLE_DIFF(DIRECTION,WANT_ANGLE))*40
5340     IF WORTH>BEST_ANY THEN BEST_ANY=WORTH:ANY_OFF=OFF
5350     IF CLEAR>=SAFE AND WORTH>BEST_SAFE THEN BEST_SAFE=WORTH:SAFE_OFF=OFF
5360   NEXT F
5370   IF BEST_SAFE>-999999 THEN OFF=SAFE_OFF ELSE OFF=ANY_OFF
5380   TURN(S)=CLAMP(OFF/0.5,-1,1)
5390 END SUB
5400 REM THE NEAREST UNSPENT GAP IN ANOTHER VIPER'S TRAIL, ONE PER TRAIL
5410 SUB AIM_AT_GAP(S)
5420   LOCAL V,G,D,NEAREST
5430   WANT=0
5440   NEAREST=999999
5450   FOR V=1 TO SEATS:SEEN(V)=0:NEXT V
5460   FOR G=1 TO HOLE_COUNT
5470     V=HOLE_OWNER(G)
5480     IF V<>S AND NOT HOLE_SPENT(G) AND NOT SEEN(V) THEN
5490       SEEN(V)=1
5500       D=DISTANCE(HEAD_X(S),HEAD_Y(S),HOLE_X(G),HOLE_Y(G))
5510       IF D<NEAREST THEN
5520         NEAREST=D
5530         WANT=1
5540         WANT_ANGLE=ATAN2(HOLE_Y(G)-HEAD_Y(S),HOLE_X(G)-HEAD_X(S))
5550       END IF
5560     END IF
5570   NEXT G
5580 END SUB
6000 REM --- TRAILS - A SAMPLE EVERY TWO PIXELS, FILED IN AN 8-PIXEL GRID ---
6010 SUB ADD_SAMPLE(S,X,Y,G)
6020   LOCAL I,CX,CY
6030   LENGTH(S)=LENGTH(S)+1
6040   I=LENGTH(S)
6050   PATH(S,I,0)=X:PATH(S,I,1)=Y:PATH(S,I,2)=G
6060   REM EACH GRID CELL KEEPS A LIST OF THE SAMPLES IN IT; A NEW EPOCH EMPTIES THEM ALL
6070   CX=INT(X/GRID):CY=INT(Y/GRID)
6080   IF CELL_EPOCH(CX,CY)<>EPOCH THEN CELL_FIRST(CX,CY)=0:CELL_EPOCH(CX,CY)=EPOCH
6090   POINTS=POINTS+1
6100   POINT_SEAT(POINTS)=S:POINT_INDEX(POINTS)=I
6110   POINT_NEXT(POINTS)=CELL_FIRST(CX,CY)
6120   CELL_FIRST(CX,CY)=POINTS
6130   IF G>0 THEN WIDEN_HOLE G
6140 END SUB
6200 REM THE TAIL NEVER MOVES; THE HEAD LAYS A SAMPLE FOR EVERY TWO PIXELS IT TRAVELS
6210 SUB GROW(S)
6220   LOCAL D,FIRST,K,ALONG,G
6230   D=DISTANCE(FROM_X(S),FROM_Y(S),TO_X(S),TO_Y(S))
6240   IF D<=0 THEN EXIT SUB
6250   FIRST=SAMPLE-TRAVEL(S)
6260   FOR K=0 TO INT((D-FIRST)/SAMPLE)
6270     ALONG=(FIRST+K*SAMPLE)/D
6280     G=0
6290     IF GAP_LEFT(S)>0 THEN
6300       IF GAP_LEFT(S)=HOLE_SAMPLES THEN START_HOLE S
6310       G=HOLE_NOW(S)
6320       GAP_LEFT(S)=GAP_LEFT(S)-1
6330     END IF
6340     ADD_SAMPLE S,LERP(FROM_X(S),TO_X(S),ALONG),LERP(FROM_Y(S),TO_Y(S),ALONG),G
6350   NEXT K
6360   TRAVEL(S)=WRAP(TRAVEL(S)+D,0,SAMPLE)
6370   HEAD_X(S)=TO_X(S):HEAD_Y(S)=TO_Y(S)
6380 END SUB
6400 REM EVERY TWO AND A HALF SECONDS A VIPER LEAVES A GAP TEN SAMPLES LONG
6410 SUB TICK_HOLE(S)
6420   HOLE_WAIT(S)=HOLE_WAIT(S)-DT
6430   IF HOLE_WAIT(S)<=0 AND GAP_LEFT(S)=0 THEN
6440     GAP_LEFT(S)=HOLE_SAMPLES
6450     HOLE_WAIT(S)=HOLE_WAIT(S)+HOLE_EVERY
6460   END IF
6470 END SUB
6500 SUB START_HOLE(S)
6510   HOLE_COUNT=HOLE_COUNT+1
6520   HOLE_NOW(S)=HOLE_COUNT
6530   HOLE_OWNER(HOLE_COUNT)=S:HOLE_SPENT(HOLE_COUNT)=0
6540   HOLE_FIRST(HOLE_COUNT)=LENGTH(S)+1
6545   HOLE_LEN(HOLE_COUNT)=0
6550   HOLES(S)=HOLES(S)+1
6560 END SUB
6600 REM A CPU AIMS AT THE MIDDLE OF A GAP, WHICH MOVES AS THE GAP GROWS
6610 SUB WIDEN_HOLE(G)
6620   LOCAL S,MIDDLE
6630   S=HOLE_OWNER(G)
6640   HOLE_LEN(G)=HOLE_LEN(G)+1
6650   MIDDLE=HOLE_FIRST(G)+INT((HOLE_LEN(G)-1)/2)
6660   HOLE_X(G)=PATH(S,MIDDLE,0)
6665   HOLE_Y(G)=PATH(S,MIDDLE,1)
6670 END SUB
7000 REM --- COLLISIONS - THE WALLS, THEN EVERY SAMPLE NEAR THE PATH ---
7010 REM A SOLID SAMPLE KILLS; A GAP ONLY COUNTS IF NOTHING SOLID IS IN THE WAY
7020 SUB FIND_HIT(S)
7030   LOCAL X0,Y0,X1,Y1,CX,CY,P,V,I
7040   HIT(S)=0:HIT_HOLE(S)=0
7050   X0=FROM_X(S):Y0=FROM_Y(S)
7060   X1=TO_X(S):Y1=TO_Y(S)
7070   IF NOT FNINSIDE(X1,Y1) THEN HIT(S)=-1:EXIT SUB
7080   FOR CX=INT((MIN(X0,X1)-BODY_R)/GRID) TO INT((MAX(X0,X1)+BODY_R)/GRID)
7090     FOR CY=INT((MIN(Y0,Y1)-BODY_R)/GRID) TO INT((MAX(Y0,Y1)+BODY_R)/GRID)
7100       P=FNFIRST_IN_CELL(CX,CY)
7110       WHILE P>0
7120         V=POINT_SEAT(P):I=POINT_INDEX(P)
7130         IF NOT FNSKIPPED(S,V,I) AND FNTOUCHES(V,I) THEN
7140           IF PATH(V,I,2)=0 THEN HIT(S)=V:EXIT SUB
7150           HIT_HOLE(S)=PATH(V,I,2)
7160         END IF
7170         P=POINT_NEXT(P)
7180       WEND
7190     NEXT CY
7200   NEXT CX
7210 END SUB
7300 REM HOW FAR A CPU CAN GO ALONG DIRECTION BEFORE A WALL OR A SOLID SAMPLE
7310 SUB CLEARANCE(S,DIRECTION)
7320   LOCAL X0,Y0,X1,Y1,CX,CY,P,V,I
7330   X0=HEAD_X(S):Y0=HEAD_Y(S)
7340   X1=X0+COS(DIRECTION)*LOOK
7345   Y1=Y0+SIN(DIRECTION)*LOOK
7350   WALL_SHARE X1-X0,Y1-Y0
7355   CLEAR=SHARE*LOOK
7360   FOR CX=INT((MIN(X0,X1)-BODY_R)/GRID) TO INT((MAX(X0,X1)+BODY_R)/GRID)
7370     FOR CY=INT((MIN(Y0,Y1)-BODY_R)/GRID) TO INT((MAX(Y0,Y1)+BODY_R)/GRID)
7380       P=FNFIRST_IN_CELL(CX,CY)
7390       WHILE P>0
7400         V=POINT_SEAT(P):I=POINT_INDEX(P)
7410         IF PATH(V,I,2)=0 AND NOT (V=S AND I>LENGTH(S)-4) AND FNTOUCHES(V,I) THEN
7420           CLEAR=MIN(CLEAR,DISTANCE(X0,Y0,PATH(V,I,0),PATH(V,I,1))-BODY_R)
7430         END IF
7440         P=POINT_NEXT(P)
7450       WEND
7460     NEXT CY
7470   NEXT CX
7480   CLEAR=MAX(0,CLEAR)
7490 END SUB
7500 DEF FNINSIDE(X,Y)=X>=PIT_X+BODY_R AND X<=PIT_X+PIT_W-BODY_R AND Y>=PIT_Y+BODY_R AND Y<=PIT_Y+PIT_H-BODY_R
7505 REM A CELL LEFT FROM AN EARLIER ROUND COUNTS AS EMPTY
7510 DEF FNFIRST_IN_CELL(CX,CY)=CELL_FIRST(CX,CY)*(CELL_EPOCH(CX,CY)=EPOCH)
7520 DEF FNTOUCHES(V,I)=SEGMENT_CIRCLE_OVERLAP(X0,Y0,X1,Y1,PATH(V,I,0),PATH(V,I,1),BODY_R)
7530 REM A VIPER CANNOT HIT ITS OWN NEWEST FOUR SAMPLES, NOR A MOVING HEAD ITS NEWEST
7540 DEF FNSKIPPED(S,V,I)=(V=S AND I>LENGTH(S)-4) OR (V<>S AND MOVING(V) AND I=LENGTH(V))
7600 REM HOW MUCH OF THE RAY FROM X0,Y0 FITS BEFORE THE NEAREST WALL, FROM 0 TO 1
7610 SUB WALL_SHARE(DX,DY)
7620   SHARE=1
7630   IF DX>0.0001 THEN SHARE=MIN(SHARE,(PIT_X+PIT_W-BODY_R-X0)/DX)
7640   IF DX<-0.0001 THEN SHARE=MIN(SHARE,(PIT_X+BODY_R-X0)/DX)
7650   IF DY>0.0001 THEN SHARE=MIN(SHARE,(PIT_Y+PIT_H-BODY_R-Y0)/DY)
7660   IF DY<-0.0001 THEN SHARE=MIN(SHARE,(PIT_Y+BODY_R-Y0)/DY)
7670   SHARE=CLAMP(SHARE,0,1)
7680 END SUB
8000 REM --- WHAT HAPPENS - A VIPER GOES DOWN, OR THREADS A GAP ---
8010 SUB ELIMINATE(S,KILLER)
8020   ALIVE(S)=0
8030   LIFE(S)=LIFE(S)-1
8040   FX_BURST(HEAD_X(S),HEAD_Y(S),10,100,C(S))
8050   SOUND_EFFECT ASSETS$+"GAME_OVER.WAV"
8060   IF KILLER>0 AND KILLER<>S THEN
8070     PTS(KILLER)=PTS(KILLER)+KILL_POINTS
8080     SOUND_EFFECT ASSETS$+"STRIKE.WAV"
8090   END IF
8100 END SUB
8200 REM A GAP PAYS ONCE, BUT STAYS PASSABLE
8210 SUB GO_THROUGH(S,G)
8220   LOCAL WON
8230   IF HOLE_SPENT(G) THEN EXIT SUB
8240   HOLE_SPENT(G)=1
8250   WON=HOLE_POINTS*ROUND
8260   PTS(S)=PTS(S)+WON
8270   FX_POPUP(TO_X(S),TO_Y(S)-14,"+"+STR$(WON),C(S))
8280   SOUND_EFFECT ASSETS$+"THROUGH.WAV"
8290 END SUB
8300 REM THE DEMO ON THE TITLE PLAYS SILENTLY
8310 SUB SOUND_EFFECT(NAME$)
8320   IF NOT DEMO THEN PLAY_SFX NAME$
8330 END SUB
8500 REM --- OVER - TWO SECONDS TO READ THE RESULT, THEN FIRE TO PLAY AGAIN ---
8510 SUB UPDATE_OVER
8520   WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
8530   IF WAIT_LEFT=0 AND FIRE THEN START_GAME 1+HUMAN(2)
8540 END SUB
8600 SUB DRAW_OVER
8610   CLEAR("BLIP_BLACK")
8620   DRAW_TEXT("GAME OVER",320,132,4,"BLIP_RED","CENTER")
8630   DRAW_TEXT("SCORE "+STR$(PTS(1)),320,176,3,C(1),"CENTER")
8640   DRAW_TEXT("ROUND "+STR$(ROUND)+"   LENGTH "+STR$(LENGTH(1)),320,236,2,SAND$,"CENTER")
8650   IF WAIT_LEFT=0 THEN DRAW_TEXT("PRESS FIRE TO PLAY AGAIN",320,290,2,"BLIP_WHITE","CENTER")
8660 END SUB
9000 REM --- DRAWING ---
9010 SUB DRAW_WORLD
9020   LOCAL S
9030   CLEAR("#110F0C")
9040   FILL_RECT(PIT_X-6,PIT_Y-6,PIT_W+12,PIT_H+12,"#6E5230")
9050   FILL_RECT(PIT_X,PIT_Y,PIT_W,PIT_H,"#17140F")
9060   FOR S=1 TO SEATS
9070     DRAW_VIPER S
9080   NEXT S
9090   FX_DRAW()
9100   DRAW_STANDINGS
9110 END SUB
9200 REM A GAP IS DRAWN IN THE VIPER'S OWN COLOUR, DIMMED
9210 SUB DRAW_VIPER(S)
9220   LOCAL X,Y,LABEL$
9230   DRAW_POLYLINE("PATH",S,LENGTH(S),BODY_R*2,C(S),GAP_C(S))
9240   IF NOT ALIVE(S) THEN EXIT SUB
9250   DRAW_LINE_EX(PATH(S,LENGTH(S),0),PATH(S,LENGTH(S),1),HEAD_X(S),HEAD_Y(S),BODY_R*2,C(S))
9260   DRAW_LINE_EX(HEAD_X(S)-COS(ANGLE(S))*6,HEAD_Y(S)-SIN(ANGLE(S))*6,HEAD_X(S),HEAD_Y(S),BODY_R*2+1,C(S))
9270   IF NOT HUMAN(S) THEN EXIT SUB
9280   IF S=1 THEN LABEL$="YOU" ELSE LABEL$="P2"
9290   X=CLAMP(HEAD_X(S)-10,PIT_X+2,PIT_X+PIT_W-24)
9300   Y=CLAMP(HEAD_Y(S)-16,PIT_Y+2,PIT_Y+PIT_H-4)
9310   DRAW_TEXT(LABEL$,X,Y,2,"BLIP_WHITE","LEFT","BLIP_BLACK")
9320 END SUB
9400 REM THE OTHER VIPERS' SCORES DOWN THE RIGHT; PLAYER ONE'S IS ON THE TOP BAR
9410 SUB DRAW_STANDINGS
9420   LOCAL S,Y,INK
9430   Y=PIT_Y+10
9440   FOR S=2 TO SEATS
9450     IF ALIVE(S) THEN INK=C(S) ELSE INK=COLOR(0.36,0.36,0.36)
9460     FILL_RECT(PIT_X+PIT_W-8,Y+2,5,10,INK)
9470     DRAW_TEXT(NAME$(S)+" "+STR$(PTS(S)),PIT_X+PIT_W-92,Y,2,INK,"LEFT","BLIP_BLACK")
9480     Y=Y+16
9490   NEXT S
9500 END SUB
9600 REM --- KEYS, SEATS AND THE CPU'S FAN OF HEADINGS ---
9610 SUB READ_KEYS
9620   FIRE=KEY_PRESSED("SPACE") OR KEY_PRESSED("ENTER")
9630   JOIN=KEY_PRESSED("J")
9640 END SUB
9700 SUB LOAD_SEATS
9710   LOCAL S,R,G,B
9720   RESTORE 9790
9730   FOR S=1 TO MAX_SEATS
9740     READ NAME$(S),R,G,B
9750     C(S)=COLOR(R,G,B)
9760     GAP_C(S)=COLOR(R*0.23,G*0.23,B*0.23)
9770   NEXT S
9780 END SUB
9790 DATA "P1", 0.62,0.73,0.28, "P2", 0.45,0.85,1, "C1", 0.78,0.55,1
9791 DATA "C2", 0.45,0.95,0.55, "C3", 0.95,0.45,0.35, "C4", 0.78,0.78,0.84
9800 REM STRAIGHT ON, THEN EVERY 14 DEGREES OUT TO A HARD TURN EITHER WAY
9810 SUB LOAD_FAN
9820   LOCAL F
9830   RESTORE 9880
9840   FOR F=0 TO 12
9850     READ FAN(F)
9860   NEXT F
9870 END SUB
9880 DATA 0, 0.25,-0.25, 0.5,-0.5, 0.75,-0.75, 1,-1, 1.25,-1.25, 1.5,-1.5
