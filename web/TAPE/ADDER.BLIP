1 REM FLOW: TITLE 10 -> NEW GAME 800 -> UPDATE 100 -> DRAW 500.
2 REM MODULES: ROUND SETUP 1100; TRAIL SAMPLES 1200; MOVEMENT 1300.
3 REM MODULES: SPATIAL COLLISIONS 1400; ELIMINATION 1500; CPU 2000.
4 REM STATE: PATH(SEAT,INDEX,0/1/2) STORES X, Y, AND A PERMANENT GAP ID.
5 REM GAME: ADDER
10 REM ADDER - TITLE AND ATTRACT SCENE
11 CANVAS(480,540):PLAY_MUSIC "ADDER_COIL":T=TIME():GOSUB 900
20 FILL_RECT(0,46,480,92,"#0000008C"):FILL_RECT(0,384,480,136,"#0000008C")
30 DRAW_TEXT("ADDER",96,62,6,COLOR(0.62,0.73,0.28),"LEFT","BLIP_BLACK")
40 DRAW_TEXT(CONTROL_TEXT$("SPACE TO START","PRESS FIRE TO START","TAP TO START"),240,404,3,"BLIP_WHITE","CENTER")
45 DRAW_TEXT(CONTROL_TEXT$("GREEN VIPER: A/D TURN","GREEN VIPER: STICK LEFT/RIGHT","GREEN VIPER: DRAG LEFT/RIGHT"),240,430,2,COLOR(0.60,0.52,0.36),"CENTER")
46 DRAW_TEXT("CONSTANT MOVEMENT",240,450,2,COLOR(0.60,0.52,0.36),"CENTER")
47 DRAW_TEXT("GROWING TRAILS STAY ALL ROUND",240,468,2,COLOR(0.60,0.52,0.36),"CENTER")
48 DRAW_TEXT("DIM GAPS ARE PASSABLE",240,486,2,COLOR(1,0.86,0.34),"CENTER")
50 DRAW_TEXT("P2: LEFT/RIGHT TURN, J TO JOIN",240,504,2,COLOR(0.45,0.85,1),"CENTER")
60 IF KEY_PRESSED("SPACE")=1 THEN MODE=1:GOTO 800
65 IF KEY_PRESSED("J")=1 THEN MODE=2:GOTO 800
70 WAIT 0:GOTO 10
99 REM --- FRAME - ELAPSED TIME, DROP-IN PLAYER TWO, AND ROUND WAIT ---
100 FRAME_NOW=TIME():DT=CLAMP(FRAME_NOW-LAST_TIME,0,0.1):LAST_TIME=FRAME_NOW
105 FX_UPDATE(DT)
110 IF ROUND_WAIT>0 THEN ROUND_WAIT=MAX(0,ROUND_WAIT-DT):IF ROUND_WAIT=0 THEN GOTO 650
115 IF ROUND_WAIT>0 THEN GOTO 500
120 IF MODE=1 AND KEY_PRESSED("J")=1 THEN MODE=2:HUMAN(2)=1:LIFE(2)=3
129 REM --- HUMAN STEERING - BOTH DIRECTIONS CANCEL EACH OTHER ---
130 TURN(1)=(KEY_ACTIVE("D") OR (MODE=1 AND KEY_ACTIVE("RIGHT")))-(KEY_ACTIVE("A") OR (MODE=1 AND KEY_ACTIVE("LEFT")))
140 TURN(2)=KEY_ACTIVE("RIGHT")-KEY_ACTIVE("LEFT")
150 FOR S=1 TO SEATS
160 IF ALIVE(S)=1 AND HUMAN(S)=0 THEN GOSUB 860
170 REM CHOOSE ALL STEERING BEFORE ANY HEAD MOVES, AS IN THE RUST UPDATE.
180 NEXT S
185 FOR S=1 TO SEATS
186 IF ALIVE(S)=1 THEN GOSUB 1300
187 NEXT S
189 REM --- A ROUND ENDS WITH ONE SURVIVOR; A RUN ENDS WITH NO HUMAN LIVES ---
190 HUMAN_LIVES=0:ALIVE_COUNT=0:WINNER=0
200 FOR S=1 TO SEATS
210 IF HUMAN(S)=1 THEN HUMAN_LIVES=HUMAN_LIVES+LIFE(S)
220 IF ALIVE(S)=1 THEN ALIVE_COUNT=ALIVE_COUNT+1:WINNER=S
230 NEXT S
240 SCORE=PTS(1):LIVES=LIFE(1)
250 IF HUMAN_LIVES=0 THEN GOTO 700
260 IF ALIVE_COUNT<=1 THEN GOTO 600
490 GOTO 500
499 REM --- DRAW - THE NATIVE PIT, ALL TRAILS, HEADS, AND STANDINGS ---
500 CANVAS(480,540):DRAW_TEXTURE("/TAPE/GFX/ADDER/PIT.PNG",0,0,480,540)
510 FOR S=1 TO SEATS
520 DRAW_POLYLINE("PATH",S,LENGTH(S),4,C(S),DIMMED(S))
530 IF ALIVE(S)=1 THEN DRAW_LINE_EX(PATH(S,LENGTH(S),0),PATH(S,LENGTH(S),1),HEAD_X(S),HEAD_Y(S),4,C(S))
540 IF ALIVE(S)=1 THEN DRAW_LINE_EX(HEAD_X(S)-COS(ANGLE(S))*6,HEAD_Y(S)-SIN(ANGLE(S))*6,HEAD_X(S),HEAD_Y(S),5,C(S))
550 IF ALIVE(S)=1 AND HUMAN(S)=1 THEN LABEL$="YOU":IF S=2 THEN LABEL$="P2"
551 IF ALIVE(S)=1 AND HUMAN(S)=1 THEN DRAW_TEXT(LABEL$,CLAMP(HEAD_X(S)-10,12,446),CLAMP(HEAD_Y(S)-16,40,526),2,"BLIP_WHITE","LEFT","BLIP_BLACK")
570 NEXT S
575 FX_DRAW()
576 FOR S=2 TO SEATS
577 INK=C(S):IF ALIVE(S)=0 THEN INK=COLOR(0.36,0.36,0.36)
578 DRAW_TEXT(NAME$(S)+" "+STR$(PTS(S)),378,48+(S-2)*16,2,INK,"LEFT","BLIP_BLACK"):FILL_RECT(462,50+(S-2)*16,5,10,INK)
579 NEXT S
580 DRAW_HUD(PTS(1),LIFE(1))
581 IF ROUND_WAIT=0 AND BANNER_TIME<1.6 THEN DRAW_TEXT("ROUND "+STR$(ROUND),240,284,4,COLOR(1,0.86,0.34,MIN(1,1-BANNER_TIME/1.6)),"CENTER")
582 IF ROUND_WAIT>0 THEN RESULT$="ROUND LOST":FOR S=1 TO SEATS:IF ALIVE(S)=1 AND HUMAN(S)=1 THEN RESULT$="YOU WIN"
583 IF ROUND_WAIT>0 THEN NEXT S:DRAW_TEXT(RESULT$,240,284,4,COLOR(1,0.86,0.34),"CENTER")
590 BANNER_TIME=BANNER_TIME+DT:WAIT 0:GOTO 100
599 REM --- ROUND REWARD - KEEP EVERY TRAIL UNTIL THE TWO-SECOND RESET ---
600 IF WINNER>0 THEN PTS(WINNER)=PTS(WINNER)+250:PLAY_SFX "ADDER/PIT"
610 ROUND_WAIT=2:GOTO 500
649 REM --- NEXT ROUND - CARRY SCORES AND HUMAN LIVES; ADD ONE CPU ---
650 ROUND=ROUND+1:SEATS=MIN(6,SEATS+1)
655 IF ROUND=4 THEN PLAY_MUSIC "ADDER_HUNT"
660 GOSUB 1100:GOTO 100
699 REM --- GAME OVER - SHOW THE RESULT BEFORE ACCEPTING A RESTART ---
700 GAME_STATE=2:OVER_AT=TIME()
710 CLEAR("BLIP_BLACK"):DRAW_TEXT("GAME OVER",240,204,4,"BLIP_RED","CENTER")
720 DRAW_TEXT("SCORE "+STR$(PTS(1)),240,248,3,C(1),"CENTER")
730 DRAW_TEXT("ROUND "+STR$(ROUND)+"   LENGTH "+STR$(LENGTH(1)),240,324,2,COLOR(0.60,0.52,0.36),"CENTER")
740 IF TIME()-OVER_AT>=2 THEN DRAW_TEXT("PRESS FIRE TO PLAY AGAIN",240,370,2,"BLIP_WHITE","CENTER")
750 IF TIME()-OVER_AT>=2 AND KEY_PRESSED("SPACE")=1 THEN GOTO 800
760 WAIT 0:GOTO 710
799 REM --- NEW GAME - SEATS, COLORS, THE CPU FAN, AND NATIVE RULE VALUES ---
800 GAME_STATE=1:SCORE=0:LIVES=3:ROUND=1:SEATS=2:FX_CLEAR()
805 FOR S=1 TO 6:HUMAN(S)=0:PTS(S)=0:LIFE(S)=1:NEXT S:HUMAN(1)=1:LIFE(1)=3
806 IF MODE=2 THEN HUMAN(2)=1:LIFE(2)=3:SEATS=3
810 C(1)=COLOR(0.62,0.73,0.28):C(2)=COLOR(0.45,0.85,1):C(3)=COLOR(0.78,0.55,1)
811 C(4)=COLOR(0.45,0.95,0.55):C(5)=COLOR(0.95,0.45,0.35):C(6)=COLOR(0.78,0.78,0.84)
812 DIMMED(1)=COLOR(0.1426,0.1679,0.0644):DIMMED(2)=COLOR(0.1035,0.1955,0.23):DIMMED(3)=COLOR(0.1794,0.1265,0.23)
813 DIMMED(4)=COLOR(0.1035,0.2185,0.1265):DIMMED(5)=COLOR(0.2185,0.1035,0.0805):DIMMED(6)=COLOR(0.1794,0.1794,0.1932)
814 NAME$(1)="P1":NAME$(2)="P2":NAME$(3)="C1":NAME$(4)="C2":NAME$(5)="C3":NAME$(6)="C4"
820 FAN(0)=0:FOR I=1 TO 6:FAN(I*2-1)=I*0.25:FAN(I*2)=0-I*0.25:NEXT I
830 PLAY_MUSIC "ADDER_COIL":GOSUB 1100:GOTO 100
859 REM --- CPU ENTRY - THE SAME THIRTEEN LOOK-AHEAD ANGLES AS RUST ---
860 GOSUB 2000:RETURN
899 REM --- TITLE ART - GENERATED PIT AND THREE MOVING VIPERS ---
900 DRAW_TEXTURE("/TAPE/GFX/ADDER/PIT.PNG",0,0,480,540)
905 REM TITLE VIPERS USE THE RUST SEAT COLORS AND FOUR-PIXEL TRAIL WIDTH.
910 FOR SEAT=0 TO 2:PHASE=T*(0.55+SEAT*0.07)+SEAT*2.1:CX=240:CY=250:RX=180-SEAT*45:RY=100-SEAT*23:C$="#9EBA47":IF SEAT=1 THEN C$="#73D9FF"
920 IF SEAT=2 THEN C$="#C78CFF"
930 FOR I=80 TO 1 STEP -1:A=PHASE-I*0.025:SX=CX+COS(A)*RX:SY=CY+SIN(A)*RY:TX=CX+COS(A+0.025)*RX:TY=CY+SIN(A+0.025)*RY:DRAW_LINE_EX(SX,SY,TX,TY,4,C$):NEXT I
940 FILL_CIRCLE(CX+COS(PHASE)*RX,CY+SIN(PHASE)*RY,2.5,C$):NEXT SEAT
950 DRAW_TEXT("P2 0",378,48,2,COLOR(0.45,0.85,1),"LEFT","BLIP_BLACK"):FILL_RECT(462,50,5,10,COLOR(0.45,0.85,1))
960 DRAW_TEXT("C1 0",378,64,2,COLOR(0.78,0.55,1),"LEFT","BLIP_BLACK"):FILL_RECT(462,66,5,10,COLOR(0.78,0.55,1))
999 RETURN
1099 REM --- ROUND SETUP - SPAWN CLEAR OF WALLS AND EVERY EARLIER TRAIL ---
1100 EPOCH=EPOCH+1:POINT_COUNT=0:GAP_COUNT=0:ROUND_WAIT=0:BANNER_TIME=0
1105 FOR S=1 TO SEATS
1110 ALIVE(S)=1:LENGTH(S)=0:TRAVEL(S)=0:HOLE_WAIT(S)=2.5:GAP_LEFT(S)=0:GAP_NOW(S)=0
1111 IF HUMAN(S)=1 AND LIFE(S)=0 THEN ALIVE(S)=0
1112 IF HUMAN(S)=0 THEN LIFE(S)=1
1120 BEST_ROOM=0-999:BEST_X=240:BEST_Y=284
1125 FOR TRY=1 TO 60
1130 SPAWN_X=60+RND(360):SPAWN_Y=88+RND(392):ROOM=MIN(SPAWN_X-10,470-SPAWN_X):ROOM=MIN(ROOM,MIN(SPAWN_Y-38,530-SPAWN_Y))
1140 FOR OTHER=1 TO S-1
1141 IF OTHER>=S THEN GOTO 1145
1142 ROOM=MIN(ROOM,DISTANCE(SPAWN_X,SPAWN_Y,HEAD_X(OTHER),HEAD_Y(OTHER))-2)
1143 FOR P=1 TO LENGTH(OTHER):IF LENGTH(OTHER)>0 THEN ROOM=MIN(ROOM,DISTANCE(SPAWN_X,SPAWN_Y,PATH(OTHER,P,0),PATH(OTHER,P,1))-2)
1144 NEXT P
1145 NEXT OTHER
1150 IF ROOM>BEST_ROOM THEN BEST_ROOM=ROOM:BEST_X=SPAWN_X:BEST_Y=SPAWN_Y
1155 IF ROOM>64 THEN TRY=60
1160 NEXT TRY
1165 HEAD_X(S)=BEST_X:HEAD_Y(S)=BEST_Y:ANGLE(S)=ATAN2(284-BEST_Y,240-BEST_X)
1170 FOR INITIAL=1 TO 17
1171 IF ALIVE(S)=1 THEN SAMPLE_X=BEST_X-COS(ANGLE(S))*(17-INITIAL)*2:SAMPLE_Y=BEST_Y-SIN(ANGLE(S))*(17-INITIAL)*2:SAMPLE_GAP=0:GOSUB 1200
1172 NEXT INITIAL
1180 NEXT S:LAST_TIME=TIME():RETURN
1199 REM --- APPEND A SAMPLE - WORLD POSITIONS AND GRID LINKS NEVER MOVE ---
1200 LENGTH(S)=LENGTH(S)+1:P_INDEX=LENGTH(S):POINT_COUNT=POINT_COUNT+1
1210 PATH(S,P_INDEX,0)=SAMPLE_X:PATH(S,P_INDEX,1)=SAMPLE_Y:PATH(S,P_INDEX,2)=SAMPLE_GAP
1220 CELL_X=INT(SAMPLE_X/8):CELL_Y=INT(SAMPLE_Y/8)
1230 IF CELL_EPOCH(CELL_X,CELL_Y)<>EPOCH THEN CELL_HEAD(CELL_X,CELL_Y)=0:CELL_EPOCH(CELL_X,CELL_Y)=EPOCH
1240 POINT_SEAT(POINT_COUNT)=S:POINT_INDEX(POINT_COUNT)=P_INDEX:POINT_NEXT(POINT_COUNT)=CELL_HEAD(CELL_X,CELL_Y):CELL_HEAD(CELL_X,CELL_Y)=POINT_COUNT
1250 RETURN
1299 REM --- CONTINUOUS MOVEMENT - 85 PIXELS/SECOND, 3.2 RADIANS/SECOND ---
1300 FROM_X=HEAD_X(S):FROM_Y=HEAD_Y(S):ANGLE(S)=ANGLE(S)+CLAMP(TURN(S),0-1,1)*3.2*DT
1305 STEP_DISTANCE=85*DT:TO_X=FROM_X+COS(ANGLE(S))*STEP_DISTANCE:TO_Y=FROM_Y+SIN(ANGLE(S))*STEP_DISTANCE
1310 QUERY_MODE=0:GOSUB 1400
1315 IF HIT_OWNER<>0 THEN GOSUB 1500:RETURN
1320 IF HIT_GAP>0 AND GAP_SPENT(HIT_GAP)=0 THEN GAP_SPENT(HIT_GAP)=1:PTS(S)=PTS(S)+50*ROUND:FX_POPUP(TO_X,TO_Y-14,"+"+STR$(50*ROUND),C(S)):PLAY_SFX "ADDER/THROUGH"
1325 HOLE_WAIT(S)=HOLE_WAIT(S)-DT
1326 IF HOLE_WAIT(S)<=0 AND GAP_LEFT(S)=0 THEN GAP_LEFT(S)=10:HOLE_WAIT(S)=HOLE_WAIT(S)+2.5
1330 SAMPLE_AT=2-TRAVEL(S)
1335 IF SAMPLE_AT>STEP_DISTANCE OR STEP_DISTANCE=0 THEN GOTO 1380
1340 SAMPLE_X=FROM_X+(TO_X-FROM_X)*SAMPLE_AT/STEP_DISTANCE:SAMPLE_Y=FROM_Y+(TO_Y-FROM_Y)*SAMPLE_AT/STEP_DISTANCE:SAMPLE_GAP=0
1345 IF GAP_LEFT(S)=10 THEN GAP_COUNT=GAP_COUNT+1:GAP_NOW(S)=GAP_COUNT:GAP_OWNER(GAP_COUNT)=S:GAP_SPENT(GAP_COUNT)=0:GAP_FIRST(GAP_COUNT)=LENGTH(S)+1:GAP_LENGTH(GAP_COUNT)=0
1350 IF GAP_LEFT(S)>0 THEN SAMPLE_GAP=GAP_NOW(S)
1360 GOSUB 1200
1361 IF SAMPLE_GAP>0 THEN GAP_LENGTH(SAMPLE_GAP)=GAP_LENGTH(SAMPLE_GAP)+1:CENTER_INDEX=GAP_FIRST(SAMPLE_GAP)+INT((GAP_LENGTH(SAMPLE_GAP)-1)/2):GAP_X(SAMPLE_GAP)=PATH(S,CENTER_INDEX,0):GAP_Y(SAMPLE_GAP)=PATH(S,CENTER_INDEX,1)
1365 IF GAP_LEFT(S)>0 THEN GAP_LEFT(S)=GAP_LEFT(S)-1
1370 SAMPLE_AT=SAMPLE_AT+2:GOTO 1335
1380 TRAVEL(S)=WRAP(TRAVEL(S)+STEP_DISTANCE,0,2):HEAD_X(S)=TO_X:HEAD_Y(S)=TO_Y:RETURN
1398 REM INPUT: S AND FROM/TO; OUTPUT: HIT_OWNER, HIT_GAP, AND CLEARANCE.
1399 REM --- SPATIAL QUERY - SOLID SAMPLES WIN OVER OVERLAPPING GAPS ---
1400 HIT_OWNER=0:HIT_GAP=0:CLEARANCE=DISTANCE(FROM_X,FROM_Y,TO_X,TO_Y)
1405 IF QUERY_MODE=0 AND (TO_X<12 OR TO_X>468 OR TO_Y<40 OR TO_Y>528) THEN HIT_OWNER=0-1:RETURN
1410 RAY_DX=TO_X-FROM_X:RAY_DY=TO_Y-FROM_Y:RAY_LENGTH=CLEARANCE
1411 IF QUERY_MODE=1 AND RAY_DX>0.0001 THEN CLEARANCE=MIN(CLEARANCE,(468-FROM_X)/RAY_DX*RAY_LENGTH)
1412 IF QUERY_MODE=1 AND RAY_DX<0-0.0001 THEN CLEARANCE=MIN(CLEARANCE,(12-FROM_X)/RAY_DX*RAY_LENGTH)
1413 IF QUERY_MODE=1 AND RAY_DY>0.0001 THEN CLEARANCE=MIN(CLEARANCE,(528-FROM_Y)/RAY_DY*RAY_LENGTH)
1414 IF QUERY_MODE=1 AND RAY_DY<0-0.0001 THEN CLEARANCE=MIN(CLEARANCE,(40-FROM_Y)/RAY_DY*RAY_LENGTH)
1420 FOR QUERY_X=INT((MIN(FROM_X,TO_X)-2)/8) TO INT((MAX(FROM_X,TO_X)+2)/8)
1430 FOR QUERY_Y=INT((MIN(FROM_Y,TO_Y)-2)/8) TO INT((MAX(FROM_Y,TO_Y)+2)/8)
1440 POINT=0:IF CELL_EPOCH(QUERY_X,QUERY_Y)=EPOCH THEN POINT=CELL_HEAD(QUERY_X,QUERY_Y)
1445 IF POINT=0 THEN GOTO 1470
1450 V=POINT_SEAT(POINT):P=POINT_INDEX(POINT)
1451 IF V=S AND P>LENGTH(S)-4 THEN GOTO 1465
1452 IF SEGMENT_CIRCLE_OVERLAP(FROM_X,FROM_Y,TO_X,TO_Y,PATH(V,P,0),PATH(V,P,1),2)=0 THEN GOTO 1465
1453 GAP=PATH(V,P,2)
1454 IF GAP=0 THEN HIT_OWNER=V:CLEARANCE=MIN(CLEARANCE,DISTANCE(FROM_X,FROM_Y,PATH(V,P,0),PATH(V,P,1))-2)
1455 IF GAP>0 THEN HIT_GAP=GAP
1465 POINT=POINT_NEXT(POINT):GOTO 1445
1470 NEXT QUERY_Y:NEXT QUERY_X
1480 CLEARANCE=MAX(0,CLEARANCE):RETURN
1499 REM --- ELIMINATION - KEEP THE BODY; AWARD A DIFFERENT OWNER 100 POINTS ---
1500 ALIVE(S)=0:LIFE(S)=LIFE(S)-1:FX_BURST(HEAD_X(S),HEAD_Y(S),10,100,C(S)):PLAY_SFX "ADDER/GAME_OVER"
1510 IF HIT_OWNER>0 AND HIT_OWNER<>S THEN PTS(HIT_OWNER)=PTS(HIT_OWNER)+100:PLAY_SFX "ADDER/STRIKE"
1520 RETURN
1999 REM --- CPU - SAFE HEADINGS BEFORE THE NEAREST UNSPENT GAP ---
2000 WANT_GAP=0:WANT_DISTANCE=999999
2005 FOR V=1 TO SEATS:FIRST_GAP(V)=0:NEXT V
2010 FOR G=1 TO GAP_COUNT
2011 IF GAP_COUNT>0 AND GAP_OWNER(G)<>S AND GAP_SPENT(G)=0 AND FIRST_GAP(GAP_OWNER(G))=0 THEN FIRST_GAP(GAP_OWNER(G))=1:GOSUB 2200
2020 NEXT G
2030 FROM_X=HEAD_X(S):FROM_Y=HEAD_Y(S):TO_X=FROM_X+COS(ANGLE(S))*70:TO_Y=FROM_Y+SIN(ANGLE(S))*70:QUERY_MODE=1:GOSUB 1400
2035 IF WANT_GAP=0 AND CLEARANCE>=69.999 THEN TURN(S)=0:RETURN
2040 BEST_ANY=0-999999:BEST_SAFE=0-999999:ANY_OFF=0:SAFE_OFF=0
2050 FOR FAN_INDEX=0 TO 12
2060 OFFSET=FAN(FAN_INDEX):DIRECTION=ANGLE(S)+OFFSET:TO_X=FROM_X+COS(DIRECTION)*70:TO_Y=FROM_Y+SIN(DIRECTION)*70:QUERY_MODE=1:GOSUB 1400
2070 AI_SCORE=MIN(70,CLEARANCE)-ABS(OFFSET)*4
2080 IF WANT_GAP=1 THEN AI_SCORE=AI_SCORE-ABS(ANGLE_DIFF(DIRECTION,WANT_ANGLE))*40
2090 IF AI_SCORE>BEST_ANY THEN BEST_ANY=AI_SCORE:ANY_OFF=OFFSET
2100 IF CLEARANCE>=49.725 AND AI_SCORE>BEST_SAFE THEN BEST_SAFE=AI_SCORE:SAFE_OFF=OFFSET
2110 NEXT FAN_INDEX
2120 OFFSET=ANY_OFF:IF BEST_SAFE>0-999999 THEN OFFSET=SAFE_OFF
2130 TURN(S)=CLAMP(OFFSET/0.5,0-1,1):RETURN
2199 REM --- CPU TARGET - WORLD POSITIONS STAY FIXED AFTER THE GAP IS LAID ---
2200 GAP_DISTANCE=DISTANCE(HEAD_X(S),HEAD_Y(S),GAP_X(G),GAP_Y(G))
2210 IF GAP_DISTANCE>=WANT_DISTANCE THEN RETURN
2220 WANT_DISTANCE=GAP_DISTANCE:WANT_GAP=1:WANT_ANGLE=ATAN2(GAP_Y(G)-HEAD_Y(S),GAP_X(G)-HEAD_X(S))
2240 RETURN
