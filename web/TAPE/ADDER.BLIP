10 PLAY_MUSIC "ADDER_COIL":T=T+0.016:GOSUB 900
20 DRAW_TEXT("ADDER",160,14,4,"BLIP_GREEN","CENTER")
30 DRAW_TEXT("TWIN VIPER PIT",160,47,2,"BLIP_CYAN","CENTER")
40 DRAW_TEXT("A/D OR ARROWS TO TURN",160,76,2,"BLIP_WHITE","CENTER")
50 DRAW_TEXT("SPACE TO START",160,99,2,"BLIP_YELLOW","CENTER"):DRAW_TEXT("J JOINS P2  ARROWS TURN",160,121,1,"BLIP_GRAY","CENTER")
60 IF KEY_PRESSED("SPACE")=1 THEN GOTO 800
70 WAIT 16:GOTO 10
100 CLEAR("BLIP_BLACK")
110 FILL_RECT(0,0,320,200,"#16120D")
111 FILL_RECT(78,25,4,169,"#664A26"):FILL_RECT(238,25,4,169,"#664A26")
112 FILL_RECT(78,25,164,5,"#664A26"):FILL_RECT(78,189,164,5,"#664A26")
113 FILL_RECT(82,30,156,159,"#211B13")
114 FOR DUST=1 TO 44:DX=83+DUST*29-INT(DUST*29/154)*154:DY=32+DUST*37-INT(DUST*37/155)*155:FILL_RECT(DX,DY,1,1,"#30271B"):NEXT DUST
120 FRAME=TIME/0.12:FOR SEGMENT=1 TO LENGTH
121 IX(SEGMENT)=BX(SEGMENT)*10+72:IY(SEGMENT)=BY(SEGMENT)*9+25:JX(SEGMENT)=CX(SEGMENT)*10+72:JY(SEGMENT)=CY(SEGMENT)*9+25
122 IF SEGMENT=1 THEN IX(SEGMENT)=IX(SEGMENT)+COS(ANGLE)*10*FRAME:IY(SEGMENT)=IY(SEGMENT)+SIN(ANGLE)*9*FRAME
123 IF SEGMENT=1 THEN JX(SEGMENT)=JX(SEGMENT)+COS(EANGLE)*10*FRAME:JY(SEGMENT)=JY(SEGMENT)+SIN(EANGLE)*9*FRAME
124 IF SEGMENT>1 THEN IX(SEGMENT)=IX(SEGMENT)+(BX(SEGMENT-1)-BX(SEGMENT))*10*FRAME:IY(SEGMENT)=IY(SEGMENT)+(BY(SEGMENT-1)-BY(SEGMENT))*9*FRAME
125 IF SEGMENT>1 THEN JX(SEGMENT)=JX(SEGMENT)+(CX(SEGMENT-1)-CX(SEGMENT))*10*FRAME:JY(SEGMENT)=JY(SEGMENT)+(CY(SEGMENT-1)-CY(SEGMENT))*9*FRAME
126 NEXT SEGMENT
127 FOR SEGMENT=1 TO LENGTH-1
130 IF H1(SEGMENT)=0 AND H1(SEGMENT+1)=0 THEN DRAW_LINE_EX(IX(SEGMENT),IY(SEGMENT),IX(SEGMENT+1),IY(SEGMENT+1),5,"#9FBA47")
131 IF H1(SEGMENT)=1 OR H1(SEGMENT+1)=1 THEN DRAW_LINE_EX(IX(SEGMENT),IY(SEGMENT),IX(SEGMENT+1),IY(SEGMENT+1),5,"#39421F")
132 IF H2(SEGMENT)=0 AND H2(SEGMENT+1)=0 AND MODE=1 THEN DRAW_LINE_EX(JX(SEGMENT),JY(SEGMENT),JX(SEGMENT+1),JY(SEGMENT+1),5,"#C78CFF")
133 IF H2(SEGMENT)=0 AND H2(SEGMENT+1)=0 AND MODE=2 THEN DRAW_LINE_EX(JX(SEGMENT),JY(SEGMENT),JX(SEGMENT+1),JY(SEGMENT+1),5,"#73D9FF")
134 IF H2(SEGMENT)=1 OR H2(SEGMENT+1)=1 THEN DRAW_LINE_EX(JX(SEGMENT),JY(SEGMENT),JX(SEGMENT+1),JY(SEGMENT+1),5,"#293D48")
140 NEXT SEGMENT
150 FOR SEGMENT=1 TO LENGTH
160 IF H1(SEGMENT)=0 THEN FILL_CIRCLE(IX(SEGMENT),IY(SEGMENT),2.7,"#9FBA47")
161 IF H1(SEGMENT)=1 THEN FILL_CIRCLE(IX(SEGMENT),IY(SEGMENT),2.7,"#39421F")
162 IF H2(SEGMENT)=0 AND MODE=1 THEN FILL_CIRCLE(JX(SEGMENT),JY(SEGMENT),2.7,"#C78CFF")
163 IF H2(SEGMENT)=0 AND MODE=2 THEN FILL_CIRCLE(JX(SEGMENT),JY(SEGMENT),2.7,"#73D9FF")
164 IF H2(SEGMENT)=1 THEN FILL_CIRCLE(JX(SEGMENT),JY(SEGMENT),2.7,"#293D48")
170 NEXT SEGMENT
180 DRAW_HUD(SCORE,LIVES)
181 DRAW_TEXT("YOU",IX(1)-7,IY(1)-7,1,"BLIP_WHITE","LEFT","BLIP_BLACK")
182 IF MODE=2 THEN DRAW_TEXT("P2",JX(1)-6,JY(1)-7,1,"BLIP_CYAN","LEFT","BLIP_BLACK")
183 IF MODE=2 THEN DRAW_TEXT("P2 JOINED",160,14,1,"BLIP_CYAN","CENTER")
190 IF (MODE=1 AND KEY_HELD("LEFT")=1) OR KEY_HELD("A")=1 THEN TURN=-1
195 IF MODE=1 AND KEY_PRESSED("J")=1 THEN MODE=2
200 IF (MODE=1 AND KEY_HELD("RIGHT")=1) OR KEY_HELD("D")=1 THEN TURN=1
210 TIME=TIME+0.016
220 IF TIME<0.12 THEN WAIT 16:GOTO 100
230 TIME=0
240 ANGLE=ANGLE+TURN*0.384
260 TURN=0
270 HX=BX(1):HY=BY(1):EX=CX(1):EY=CY(1)
280 HX=HX+COS(ANGLE)
290 HY=HY+SIN(ANGLE)
320 IF MODE=1 THEN GOSUB 860
321 IF MODE=2 AND KEY_HELD("LEFT")=1 THEN EDIR=EDIR-1
322 IF MODE=2 AND KEY_HELD("RIGHT")=1 THEN EDIR=EDIR+1
323 IF EDIR<0 THEN EDIR=3
324 IF EDIR>3 THEN EDIR=0
330 EANGLE=EDIR*1.5707963:EX=CX(1)+COS(EANGLE):EY=CY(1)+SIN(EANGLE)
350 IF HX<1 OR HX>16 OR HY<1 OR HY>18 THEN PLAYER_DIED=1:PLAY_SFX "ADDER/STRIKE":GOTO 600
360 IF SQR((HX-EX)*(HX-EX)+(HY-EY)*(HY-EY))<0.45 THEN PLAYER_DIED=1:PLAY_SFX "ADDER/STRIKE":GOTO 600
370 COLLISION=0:PLAYER_DIED=0
380 FOR SEGMENT=1 TO LENGTH
390 IF SEGMENT>1 AND H1(SEGMENT)=0 AND SQR((HX-BX(SEGMENT))*(HX-BX(SEGMENT))+(HY-BY(SEGMENT))*(HY-BY(SEGMENT)))<0.45 THEN COLLISION=1:PLAYER_DIED=1
400 IF H2(SEGMENT)=0 AND SQR((EX-CX(SEGMENT))*(EX-CX(SEGMENT))+(EY-CY(SEGMENT))*(EY-CY(SEGMENT)))<0.45 THEN COLLISION=1:PLAYER_DIED=0
405 IF H1(SEGMENT)=1 AND H1_SPENT(SEGMENT)=0 AND SQR((HX-BX(SEGMENT))*(HX-BX(SEGMENT))+(HY-BY(SEGMENT))*(HY-BY(SEGMENT)))<0.45 THEN SCORE=SCORE+50*ROUND:H1_SPENT(SEGMENT)=1:PLAY_SFX "ADDER/THROUGH"
411 IF H2(SEGMENT)=1 AND H2_SPENT(SEGMENT)=0 AND SQR((HX-CX(SEGMENT))*(HX-CX(SEGMENT))+(HY-CY(SEGMENT))*(HY-CY(SEGMENT)))<0.45 THEN SCORE=SCORE+50*ROUND:H2_SPENT(SEGMENT)=1:PLAY_SFX "ADDER/THROUGH"
412 IF H2(SEGMENT)=0 AND SQR((HX-CX(SEGMENT))*(HX-CX(SEGMENT))+(HY-CY(SEGMENT))*(HY-CY(SEGMENT)))<0.45 THEN COLLISION=1:PLAYER_DIED=1
413 IF H2(SEGMENT)=1 AND SQR((EX-CX(SEGMENT))*(EX-CX(SEGMENT))+(EY-CY(SEGMENT))*(EY-CY(SEGMENT)))<0.45 THEN H2_SPENT(SEGMENT)=1
414 IF H1(SEGMENT)=1 AND SQR((EX-BX(SEGMENT))*(EX-BX(SEGMENT))+(EY-BY(SEGMENT))*(EY-BY(SEGMENT)))<0.45 THEN H1_SPENT(SEGMENT)=1
415 IF H1(SEGMENT)=0 AND SQR((EX-BX(SEGMENT))*(EX-BX(SEGMENT))+(EY-BY(SEGMENT))*(EY-BY(SEGMENT)))<0.45 THEN COLLISION=1:PLAYER_DIED=0:SCORE=SCORE+100
416 NEXT SEGMENT
420 IF COLLISION=1 THEN PLAY_SFX "ADDER/STRIKE":GOTO 600
430 LENGTH=LENGTH+1:FOR SEGMENT=LENGTH TO 2 STEP -1
440 BX(SEGMENT)=BX(SEGMENT-1):BY(SEGMENT)=BY(SEGMENT-1):H1(SEGMENT)=H1(SEGMENT-1):H1_SPENT(SEGMENT)=H1_SPENT(SEGMENT-1)
450 CX(SEGMENT)=CX(SEGMENT-1):CY(SEGMENT)=CY(SEGMENT-1):H2(SEGMENT)=H2(SEGMENT-1):H2_SPENT(SEGMENT)=H2_SPENT(SEGMENT-1)
460 NEXT SEGMENT
470 BX(1)=HX:BY(1)=HY:CX(1)=EX:CY(1)=EY:H1(1)=0:H2(1)=0
475 HOLE_WAIT=HOLE_WAIT-1:IF HOLE_WAIT<1 AND HOLE_LEFT=0 THEN HOLE_LEFT=2:HOLE_WAIT=21
476 IF HOLE_LEFT>0 THEN H1(2)=1:H1_SPENT(2)=0:H2(2)=1:H2_SPENT(2)=0:HOLE_LEFT=HOLE_LEFT-1
480 IF EX<1 OR EX>16 OR EY<1 OR EY>18 THEN GOTO 600
490 WAIT 16:GOTO 100
600 IF PLAYER_DIED=1 THEN LIVES=LIVES-1
610 IF PLAYER_DIED=0 THEN SCORE=SCORE+250
620 PLAY_SFX "ADDER/PIT":CLEAR("BLIP_BLACK"):DRAW_TEXT("ROUND "+STR$(ROUND)+" COMPLETE",160,62,3,"BLIP_YELLOW","CENTER")
630 DRAW_HUD(SCORE,LIVES):WAIT 2000
640 IF LIVES<1 THEN GOTO 700
650 ROUND=ROUND+1:LENGTH=4:DIR=0:ANGLE=0:TURN=0:TIME=0:EDIR=2:EANGLE=3.1415926:HOLE_WAIT=21:HOLE_LEFT=0
655 IF ROUND=4 THEN PLAY_MUSIC "ADDER_HUNT"
660 GOTO 810
700 GAME_STATE=2
701 IF GAME_OVER_SOUND=0 THEN PLAY_SFX "ADDER/GAME_OVER":GAME_OVER_SOUND=1
710 CLEAR("BLIP_BLACK")
720 DRAW_TEXT("VIPER CRASHED",160,55,4,"BLIP_RED","CENTER")
730 DRAW_NUMBER(SCORE,TEXT_CX(STR$(SCORE),3),100,3,"BLIP_YELLOW")
740 DRAW_TEXT("SPACE TO TRY AGAIN",160,157,2,"BLIP_WHITE","CENTER")
750 IF KEY_PRESSED("SPACE")=1 THEN GOTO 800
760 WAIT 16:GOTO 700
800 GAME_STATE=1:SCORE=0:LIVES=3:ROUND=1:LENGTH=4:DIR=0:ANGLE=0:TURN=0:TIME=0:EDIR=2:EANGLE=3.1415926:MODE=1:HOLE_WAIT=21:HOLE_LEFT=0:GAME_OVER_SOUND=0:PLAY_MUSIC "ADDER_COIL"
805 HOLE_WAIT=21:HOLE_LEFT=0
806 IF ROUND>=4 THEN PLAY_MUSIC "ADDER_HUNT"
810 FOR SEGMENT=1 TO LENGTH
820 BX(SEGMENT)=4-SEGMENT+1:BY(SEGMENT)=10:H1(SEGMENT)=0:H1_SPENT(SEGMENT)=0
830 CX(SEGMENT)=13+SEGMENT-1:CY(SEGMENT)=10:H2(SEGMENT)=0:H2_SPENT(SEGMENT)=0
840 NEXT SEGMENT
850 GOTO 100
860 BEST_DIR=EDIR:BEST_SCORE=-999
861 FOR CHOICE=-1 TO 1
862 CANDIDATE=EDIR+CHOICE:IF CANDIDATE<0 THEN CANDIDATE=3
863 IF CANDIDATE>3 THEN CANDIDATE=0
864 CLEARANCE=6:COS_DIR=COS(CANDIDATE*1.5707963):SIN_DIR=SIN(CANDIDATE*1.5707963)
865 FOR SEGMENT=1 TO LENGTH
866 DX=BX(SEGMENT)-EX:DY=BY(SEGMENT)-EY
867 FORWARD=DX*COS_DIR+DY*SIN_DIR:SIDE=ABS(DY*COS_DIR-DX*SIN_DIR)
868 IF H1(SEGMENT)=0 AND FORWARD>0 AND FORWARD<6 AND SIDE<0.8 AND FORWARD-1<CLEARANCE THEN CLEARANCE=FORWARD-1
869 IF CLEARANCE<0 THEN CLEARANCE=0
870 DX=CX(SEGMENT)-EX:DY=CY(SEGMENT)-EY
871 FORWARD=DX*COS_DIR+DY*SIN_DIR:SIDE=ABS(DY*COS_DIR-DX*SIN_DIR)
872 IF SEGMENT>1 AND H2(SEGMENT)=0 AND FORWARD>0 AND FORWARD<6 AND SIDE<0.8 AND FORWARD-1<CLEARANCE THEN CLEARANCE=FORWARD-1
873 IF CLEARANCE<0 THEN CLEARANCE=0
874 NEXT SEGMENT
875 AI_SCORE=CLEARANCE*100-ABS(CHOICE)*4
876 IF AI_SCORE>BEST_SCORE THEN BEST_SCORE=AI_SCORE:BEST_DIR=CANDIDATE
877 NEXT CHOICE
878 EDIR=BEST_DIR:RETURN
900 FILL_RECT(0,0,320,200,"#16120D")
905 FOR DUST=1 TO 72:DX=25+DUST*37-INT(DUST*37/270)*270:DY=23+DUST*53-INT(DUST*53/166)*166:FILL_RECT(DX,DY,1,1,"#30271B"):NEXT DUST
910 FILL_RECT(0,18,320,5,"#664A26"):FILL_RECT(0,188,320,12,"#664A26")
920 FILL_RECT(0,23,8,165,"#664A26"):FILL_RECT(312,23,8,165,"#664A26")
930 FOR I=28 TO 1 STEP -1:A=T*0.55-I*0.055:SX=160+COS(A)*105:SY=161+SIN(A)*22:TX=160+COS(A+0.055)*105:TY=161+SIN(A+0.055)*22:DRAW_LINE_EX(SX,SY,TX,TY,4,"#9FBA47"):FILL_CIRCLE(SX,SY,2,"#9FBA47"):NEXT I
940 FILL_CIRCLE(160+COS(T*0.55)*105,161+SIN(T*0.55)*22,2.5,"#9FBA47")
950 FOR I=28 TO 1 STEP -1:A=T*0.43-I*0.055+2.1:SX=160+COS(A)*84:SY=161+SIN(A)*18:TX=160+COS(A+0.055)*84:TY=161+SIN(A+0.055)*18:DRAW_LINE_EX(SX,SY,TX,TY,4,"#C78CFF"):FILL_CIRCLE(SX,SY,2,"#C78CFF"):NEXT I
960 FILL_CIRCLE(160+COS(T*0.43+2.1)*84,161+SIN(T*0.43+2.1)*18,2.5,"#C78CFF")
970 FOR I=28 TO 1 STEP -1:A=T*0.62-I*0.055+4.2:SX=160+COS(A)*63:SY=161+SIN(A)*14:TX=160+COS(A+0.055)*63:TY=161+SIN(A+0.055)*14:DRAW_LINE_EX(SX,SY,TX,TY,4,"#73D9FF"):FILL_CIRCLE(SX,SY,2,"#73D9FF"):NEXT I
980 FILL_CIRCLE(160+COS(T*0.62+4.2)*63,161+SIN(T*0.62+4.2)*14,2.5,"#73D9FF")
999 RETURN
