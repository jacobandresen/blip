1 REM WARLOCK - A MAZE SHOOTER IN THE SPIRIT OF WIZARD OF WOR.
2 REM GAME: WARLOCK
3 REM DESCEND A RIVAL SORCERER'S TOWER, CLEARING EACH CHAMBER OF ITS MONSTERS AND
4 REM CLEANSING ITS CURSED RUNE STONES. CAST BOLTS DOWN THE CORRIDORS; CAST REVEAL
5 REM TO FLUSH OUT THE INVISIBLE WRAITHS, BUT MIND THE SPELLHOUNDS IT DRAWS TO
6 REM WHERE YOU STOOD. THE WARLOCK HIMSELF WAITS IN THE LAST CHAMBER. PRESS J TO
7 REM BRING A SECOND WIZARD INTO THE FIGHT.
10 REM --- SETUP ---
11 ASSETS$="/TAPE/WARLOCK/ASSETS/"
12 COLS=15:ROWS=13:CELL=20
13 BOARD_X=(640-COLS*CELL)/2:BOARD_Y=64
14 MAX_E=12:MAX_B=3:MAX_F=8
15 STEP_TIME=0.09:BOLT_RATE=0.16:REVEAL_CD=2.5
16 IMP_STEP=0.45:WRAITH_STEP=0.22:HOUND_HUNT=0.30:HOUND_WANDER=0.55:WRAITH_CHARGE=0.35
17 WRAITH_FLASH=0.22:TELL_TIME=0.9:GAR_CD=3.0
18 PLAY_MUSIC ASSETS$+"DUNGEON.WAV"
19 STATE$="TITLE"
20 LAST_TIME=TIME()
90 REM --- MAIN LOOP ---
100 NOW=TIME():DT=CLAMP(NOW-LAST_TIME,0.0001,0.1):LAST_TIME=NOW
110 READ_KEYS
120 IF STATE$="TITLE" THEN UPDATE_TITLE
130 IF STATE$="PLAY" THEN UPDATE_PLAY
140 IF STATE$="DEAD" THEN UPDATE_DEAD
150 IF STATE$="OVER" THEN UPDATE_OVER
160 IF STATE$="TITLE" THEN DRAW_TITLE
170 IF STATE$="PLAY" OR STATE$="DEAD" THEN DRAW_PLAY
180 IF STATE$="OVER" THEN DRAW_OVER
190 WAIT 0
200 GOTO 100

1000 REM --- TITLE ---
1010 SUB UPDATE_TITLE
1020  IF FIRE THEN START_GAME
1030 END SUB
1040 SUB DRAW_TITLE
1050  CLEAR("BLIP_BLACK")
1060  DRAW_TEXT("WARLOCK",320,88,6,"#D158ED","CENTER")
1070  DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE","PRESS FIRE","TAP TO START"),320,190,3,"BLIP_WHITE","CENTER")
1080  DRAW_TEXT(CONTROL_TEXT$("WASD MOVE  SPACE BOLT  Z REVEAL","STICK MOVE  A BOLT  B REVEAL","STICK MOVE  TAP BOLT"),320,230,2,"BLIP_GRAY","CENTER")
1090  DRAW_TEXT(CONTROL_TEXT$("J TO JOIN A SECOND WIZARD","2ND STATION JOINS WITH A","2ND PLAYER JOINS ON THE DECK"),320,258,2,"#F98C40","CENTER")
1100 END SUB

2000 REM --- START, JOIN, ROOM LOAD ---
2010 SUB START_GAME
2020  SCORE=0:ROOM=1:WINGS=0
2030  TWO_PLAYER=0:ALV(1)=1:ALV(2)=0:LIV(1)=3:LIV(2)=0
2040  FX_CLEAR()
2050  LOAD_ROOM
2060  STATE$="PLAY"
2070 END SUB
2080 SUB JOIN_TWO
2090  TWO_PLAYER=1:ALV(2)=1:LIV(2)=3
2100  PX(2)=PX(1):PY(2)=PY(1)
2110  FDX(2)=1:FDY(2)=0
2120  PRT(2)=2:MCK(2)=0:BCD(2)=0:RNG(2)=0:RCD(2)=0
2130  FX_RING(FNCX(PX(2)),FNCY(PY(2)),22,0.4,"#F98C40")
2140 END SUB
2150 SUB LOAD_ROOM
2160  LOCAL R,C,I,AI
2170  RESTORE 3900+(ROOM-1)*24
2180  READ SPX,SPY,EXITX,EXITY,NIMP,NWRA,NHOU,NGAR,NRUN,NGATE,NWARD
2190  FOR R=0 TO ROWS-1
2200   READ MROW$
2210   FOR C=0 TO COLS-1
2220    IF MID$(MROW$,C+1,1)="#" THEN WB(C,R)=1 ELSE WB(C,R)=0
2230   NEXT C
2240  NEXT R
2250  FOR I=1 TO MAX_E
2260   EX(I)=0:EY(I)=0:EA(I)=0:EK(I)=0:EDX(I)=0:EDY(I)=0:ET(I)=0
2270   EF(I)=0:EHUN(I)=0:HUNTX(I)=0:HUNTY(I)=0:GW(I)=0:GA(I)=0:ECH(I)=0:ELU(I)=0
2280  NEXT I
2290  EN=NIMP+NWRA+NHOU+NGAR
2300  AI=0
2310  FOR I=1 TO NIMP
2320   AI=AI+1:READ EX(AI),EY(AI)
2330   EK(AI)=1:EA(AI)=1:EDX(AI)=1:ET(AI)=RND(0.3)
2340  NEXT I
2350  FOR I=1 TO NWRA
2360   AI=AI+1:READ EX(AI),EY(AI)
2370   EK(AI)=2:EA(AI)=1:EF(AI)=RND(0.5):ET(AI)=RND(0.3)
2380  NEXT I
2390  FOR I=1 TO NHOU
2400   AI=AI+1:READ EX(AI),EY(AI)
2410   EK(AI)=3:EA(AI)=1:EDX(AI)=1:ET(AI)=RND(0.3)
2420  NEXT I
2430  FOR I=1 TO NGAR
2440   AI=AI+1:READ EX(AI),EY(AI)
2450   EK(AI)=4:EA(AI)=1:GA(AI)=RND(1.5):GW(AI)=0
2460  NEXT I
2470  FOR I=1 TO NRUN
2480   READ RX(I),RY(I):RC(I)=0
2490  NEXT I
2500  FOR I=1 TO NGATE
2510   READ GX1(I),GY1(I),GX2(I),GY2(I):GCD(I)=0
2520  NEXT I
2530  FOR I=1 TO NWARD
2540   READ WCX(I),WCY(I):WSEAL(I)=0
2550  NEXT I
2560  WLW=NWARD:WLC=0:WLS=0:WLT=0.9
2570  FOR I=1 TO MAX_B
2580   BA(I)=0:BX(I)=0:BY(I)=0:BDX(I)=1:BDY(I)=0:BT(I)=0
2590  NEXT I
2600  FOR I=1 TO MAX_F
2610   FEA(I)=0:FEX(I)=0:FEY(I)=0:FEDX(I)=1:FEDY(I)=0:FET(I)=0
2620  NEXT I
2630  EXIT_OPEN=0:GCD_T=0
2640  ALV(1)=1
2650  IF TWO_PLAYER THEN ALV(2)=1 ELSE ALV(2)=0
2660  PX(1)=SPX:PY(1)=SPY:FDX(1)=1:FDY(1)=0
2670  PX(2)=SPX:PY(2)=SPY:FDX(2)=1:FDY(2)=0
2680  PRT(1)=2:PRT(2)=2:MCK(1)=0:MCK(2)=0
2690  BCD(1)=0:BCD(2)=0:RNG(1)=0:RNG(2)=0:RCD(1)=0:RCD(2)=0
2700  BANNER_T=1.4:DIED_THIS_ROOM=0
2705  IF ROOM=6 THEN
2706   PLAY_MUSIC ASSETS$+"TOWER.WAV"
2707  ELSE
2708   PLAY_MUSIC ASSETS$+"DUNGEON.WAV"
2709  END IF
2710 END SUB

3000 REM --- ROOMS - SIX MAZES; THE WINGS REPEAT THEM ---
3900 DATA 1,1, 13,11, 2,0,0,0, 1,0,0
3901 DATA "###############"
3902 DATA "#.............#"
