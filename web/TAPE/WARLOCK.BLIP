4035 DATA 3,9, 11,9
4038 DATA 13,1, 13,11
4040 DATA 7,1, 7,11, 4,6, 10,6

4100 REM --- PLAY ---
4110 SUB UPDATE_PLAY
4120  IF TWO_PLAYER=0 THEN
4130   IF JP THEN JOIN_TWO
4140  ELSE
4150   IF ALV(2)=1 THEN
4160    IF JP OR (JH AND BCD(2)<=0) THEN FIRE_BOLT 2
4170    IF KP THEN CAST_REVEAL 2
4180   END IF
4190  END IF
4200  IF FIRE OR (FIRE_HOLD AND BCD(1)<=0) THEN FIRE_BOLT 1
4210  IF REV THEN CAST_REVEAL 1
4220  STEP_PLAYER 1
4230  IF TWO_PLAYER AND ALV(2)=1 THEN STEP_PLAYER 2
4240  UPDATE_ENEMIES
4250  UPDATE_BOLTS
4260  UPDATE_FIRES
4270  IF WLW>0 THEN UPDATE_WARLOCK
4280  BCD(1)=MAX(0,BCD(1)-DT):BCD(2)=MAX(0,BCD(2)-DT)
4290  RNG(1)=MAX(0,RNG(1)-DT):RNG(2)=MAX(0,RNG(2)-DT)
4300  RCD(1)=MAX(0,RCD(1)-DT):RCD(2)=MAX(0,RCD(2)-DT)
4310  PRT(1)=MAX(0,PRT(1)-DT):PRT(2)=MAX(0,PRT(2)-DT)
4320  GCD_T=MAX(0,GCD_T-DT)
4330  BANNER_T=MAX(0,BANNER_T-DT)
4340  FX_UPDATE(DT)
4350 END SUB

4360 SUB STEP_PLAYER(W)
4370  LOCAL NX,NY,MH,MV
4380  IF W=1 THEN MH=MOVEH:MV=MOVEV ELSE MH=M2H:MV=M2V
4390  IF MH=0 AND MV=0 THEN
4400   MCK(W)=0
4410   EXIT SUB
4420  END IF
4430  IF MH<>0 THEN
4440   FDX(W)=MH:FDY(W)=0
4450  ELSE
4460   FDX(W)=0:FDY(W)=MV
4470  END IF
4480  MCK(W)=MCK(W)+DT
4490  IF MCK(W)<STEP_TIME THEN EXIT SUB
4500  MCK(W)=0
4510  NX=PX(W)+FDX(W):NY=PY(W)+FDY(W)
4520  CHECK_BLOCK NX,NY
4530  IF NOT BLOCKED THEN
4540   PX(W)=NX:PY(W)=NY
4550  END IF
4560  CHECK_GATE W
4570  IF EXIT_OPEN AND PX(W)=EXITX AND PY(W)=EXITY THEN FINISH_CHAMBER
4580 END SUB

4590 SUB FIRE_BOLT(W)
4600  IF BCD(W)>0 THEN EXIT SUB
4610  FIND_SLOT
4620  IF SLOT=0 THEN EXIT SUB
4630  BCD(W)=BOLT_RATE
4640  BX(SLOT)=PX(W):BY(SLOT)=PY(W)
4650  BDX(SLOT)=FDX(W):BDY(SLOT)=FDY(W)
4660  IF BDX(SLOT)=0 AND BDY(SLOT)=0 THEN
4670   BDX(SLOT)=1:BDY(SLOT)=0
4680  END IF
4690  BA(SLOT)=1:BT(SLOT)=0
4700  PLAY_SFX ASSETS$+"BOLT.WAV"
4710 END SUB

4720 SUB CAST_REVEAL(W)
4730  LOCAL I
4740  IF RCD(W)>0 THEN EXIT SUB
4750  RCD(W)=REVEAL_CD:RNG(W)=0.55
4760  FX_RING(FNCX(PX(W)),FNCY(PY(W)),120,0.5,"#9FE5FF")
4770  PLAY_SFX ASSETS$+"REVEAL.WAV"
4780  FOR I=1 TO EN
4790   IF EA(I)=1 AND EK(I)=3 THEN
4800    EHUN(I)=1:HUNTX(I)=PX(W):HUNTY(I)=PY(W)
4810   END IF
4820  NEXT I
4830  FOR I=1 TO NRUN
4840   IF RC(I)=0 AND FN_NEAR(PX(W),PY(W),RX(I),RY(I)) THEN CLEANSE_RUNE I
4850  NEXT I
4860  CHECK_EXIT
4870 END SUB
4880 SUB CLEANSE_RUNE(I)
4890  RC(I)=1:SCORE=SCORE+150
4900  FX_RING(FNCX(RX(I)),FNCY(RY(I)),26,0.4,"#FFD959")
4910  FX_POPUP(FNCX(RX(I)),FNCY(RY(I))-10,"+150","#FFD959")
4920  PLAY_SFX ASSETS$+"CLEANSE.WAV"
4930 END SUB

4940 SUB UPDATE_BOLTS
4950  LOCAL I
4960  FOR I=1 TO MAX_B
4970   IF BA(I)=1 THEN STEP_ONE_BOLT I
4980  NEXT I
4990 END SUB
5000 SUB STEP_ONE_BOLT(I)
5010  LOCAL NX,NY,J
5020  BT(I)=BT(I)+DT
5030  IF BT(I)<0.05 THEN EXIT SUB
5040  BT(I)=0
5050  NX=BX(I)+BDX(I):NY=BY(I)+BDY(I)
5060  IF FNWALL(NX,NY) THEN
5070   BA(I)=0
5080   EXIT SUB
5090  END IF
5100  BX(I)=NX:BY(I)=NY
5110  FOR J=1 TO EN
5120   IF EA(J)=1 AND EX(J)=NX AND EY(J)=NY THEN
5130    WRAITH_VISIBLE J
5140    IF EK(J)<>2 OR WVIS=1 THEN
5150     BA(I)=0
5160     KILL_ENEMY J
5170     EXIT SUB
5180    END IF
5190   END IF
5200  NEXT J
5210  IF WLW>0 AND WLS=3 AND NX=WCX(WLC) AND NY=WCY(WLC) THEN
5220   BA(I)=0
5230   HIT_WARLOCK
5240  END IF
5250 END SUB

5260 REM --- ENEMIES ---
5270 SUB UPDATE_ENEMIES
5280  LOCAL I
5290  FOR I=1 TO EN
5300   IF EA(I)=1 THEN TICK_ENEMY I
5310  NEXT I
5320 END SUB
5330 SUB TICK_ENEMY(I)
5340  IF EK(I)=2 THEN
5350   EF(I)=EF(I)+DT
5360   IF EF(I)>=1.0 THEN EF(I)=EF(I)-1.0
5370  END IF
5380  IF EK(I)=4 THEN
5390   UPDATE_GARGOYLE I
5400   EXIT SUB
5410  END IF
5411  IF EK(I)=2 THEN
5412   WRAITH_VISIBLE I
5413   IF LUNGE AND ELU(I)=0 THEN ECH(I)=WRAITH_CHARGE
5414   ELU(I)=LUNGE
5415   IF ECH(I)>0 THEN ECH(I)=ECH(I)-DT
5416   IF ECH(I)>0 THEN EXIT SUB
5417  END IF
5420  ET(I)=ET(I)-DT
5430  IF ET(I)>0 THEN EXIT SUB
5440  ENEMY_STEP I
5450 END SUB
5460 SUB ENEMY_STEP(I)
5470  IF EK(I)=1 THEN
5480   STEP_IMP I
5490   ET(I)=IMP_STEP
5500  END IF
5510  IF EK(I)=2 THEN
5520   STEP_WRAITH I
5530   ET(I)=WRAITH_STEP
5540  END IF
5550  IF EK(I)=3 THEN STEP_HOUND I
5560 END SUB
5570 SUB STEP_IMP(I)
5580  STEP_WANDER I
5590 END SUB
5600 SUB STEP_WRAITH(I)
5610  WRAITH_VISIBLE I
5620  IF LUNGE THEN STEP_TOWARD I ELSE STEP_WANDER I
5630 END SUB
5640 SUB STEP_HOUND(I)
5650  IF EHUN(I)=1 THEN
5660   IF EX(I)=HUNTX(I) AND EY(I)=HUNTY(I) THEN
5670    EHUN(I)=0:ET(I)=HOUND_WANDER
5680    STEP_WANDER I
5690   ELSE
5700    ET(I)=HOUND_HUNT
5710    STEP_TO_POINT I,HUNTX(I),HUNTY(I)
5720   END IF
5730  ELSE
5740   ET(I)=HOUND_WANDER
5750   STEP_WANDER I
5760  END IF
5770 END SUB
5780 SUB STEP_WANDER(I)
5790  LOCAL NX,NY,N,D
5800  NX=EX(I)+EDX(I):NY=EY(I)+EDY(I)
5810  CHECK_IMP_OK NX,NY,I
5820  IF IMPOK THEN
5830   EX(I)=NX:EY(I)=NY
5840   CHECK_BUMP I
5850   EXIT SUB
5860  END IF
5870  FOR N=1 TO 16
5880   EDX(I)=0:EDY(I)=0
5890   D=INT(RND(4))
5900   IF D=0 THEN EDX(I)=-1
5910   IF D=1 THEN EDX(I)=1
5920   IF D=2 THEN EDY(I)=-1
5930   IF D=3 THEN EDY(I)=1
5940   CHECK_IMP_OK EX(I)+EDX(I),EY(I)+EDY(I),I
5950   IF IMPOK THEN
5960    EX(I)=EX(I)+EDX(I):EY(I)=EY(I)+EDY(I)
5970    CHECK_BUMP I
5980    EXIT SUB
5990   END IF
6000  NEXT N
6010 END SUB
6020 SUB STEP_TOWARD(I)
6030  NEAREST_WIZARD EX(I),EY(I)
6040  STEP_TO_POINT I,TWX,TWY
6050 END SUB
6060 SUB STEP_TO_POINT(I,TX,TY)
6070  LOCAL D,BEST,BD,NX,NY
6080  BEST=999:BD=-1
6090  FOR D=0 TO 3
6100   DIR_OF D
6110   NX=EX(I)+CDX:NY=EY(I)+CDY
6120   CHECK_IMP_OK NX,NY,I
6130   IF IMPOK THEN
6140    IF ABS(NX-TX)+ABS(NY-TY)<BEST THEN
6150     BEST=ABS(NX-TX)+ABS(NY-TY):BD=D
6160    END IF
6170   END IF
6180  NEXT D
6190  IF BD>=0 THEN
6200   DIR_OF BD
6210   EDX(I)=CDX:EDY(I)=CDY
6220   EX(I)=EX(I)+CDX:EY(I)=EY(I)+CDY
6230   CHECK_BUMP I
6240  END IF
6250 END SUB
6260 SUB CHECK_IMP_OK(C,R,ME)
6270  LOCAL J
6280  IMPOK=0
6290  IF FNWALL(C,R) THEN EXIT SUB
6300  IMPOK=1
6310  FOR J=1 TO EN
6320   IF J<>ME AND EA(J)=1 AND EX(J)=C AND EY(J)=R THEN IMPOK=0
6330  NEXT J
6340 END SUB
6350 SUB CHECK_BUMP(I)
6360  IF ALV(1)=1 AND EX(I)=PX(1) AND EY(I)=PY(1) THEN HURT_WIZARD 1
6370  IF ALV(2)=1 AND EX(I)=PX(2) AND EY(I)=PY(2) THEN HURT_WIZARD 2
6380 END SUB
6390 SUB UPDATE_GARGOYLE(I)
6400  IF GW(I)>0 THEN
6410   GW(I)=GW(I)-DT
6420   IF GW(I)<=0 THEN FIRE_GARGOYLE I
6430  ELSE
6440   GA(I)=GA(I)-DT
6450   IF GA(I)<=0 THEN GW(I)=TELL_TIME
6460  END IF
6470 END SUB
6480 SUB FIRE_GARGOYLE(I)
6490  FIND_FIRE_SLOT
6500  IF FSLOT=0 THEN
6510   GA(I)=GAR_CD
6520   EXIT SUB
6530  END IF
6540  NEAREST_WIZARD EX(I),EY(I)
6550  AIM_CARDINAL EX(I),EY(I),TWX,TWY
6560  FEX(FSLOT)=EX(I):FEY(FSLOT)=EY(I)
6570  FEDX(FSLOT)=ADX:FEDY(FSLOT)=ADY
6580  FEA(FSLOT)=1:FET(FSLOT)=0
6590  GA(I)=GAR_CD
6600  FX_BURST(FNCX(EX(I)),FNCY(EY(I)),6,60,"#FF7326")
6610 END SUB

6620 REM --- FIREBALLS ---
6630 SUB UPDATE_FIRES
6640  LOCAL I
6650  FOR I=1 TO MAX_F
6660   IF FEA(I)=1 THEN STEP_ONE_FIRE I
6670  NEXT I
6680 END SUB
6690 SUB STEP_ONE_FIRE(I)
6700  LOCAL NX,NY
6710  FET(I)=FET(I)+DT
6720  IF FET(I)<0.11 THEN EXIT SUB
6730  FET(I)=0
6740  NX=FEX(I)+FEDX(I):NY=FEY(I)+FEDY(I)
6750  IF FNWALL(NX,NY) THEN
6760   FEA(I)=0
6770   EXIT SUB
6780  END IF
6790  FEX(I)=NX:FEY(I)=NY
6800  IF ALV(1)=1 AND NX=PX(1) AND NY=PY(1) THEN
6810   FEA(I)=0
6820   HURT_WIZARD 1
6830   EXIT SUB
6840  END IF
6850  IF ALV(2)=1 AND NX=PX(2) AND NY=PY(2) THEN
6860   FEA(I)=0
6870   HURT_WIZARD 2
6880  END IF
6890 END SUB

6900 REM --- THE WARLOCK (ROOM 6) ---
6910 SUB UPDATE_WARLOCK
6920  WLT=WLT-DT
6930  IF WLS=0 THEN
6940   IF WLT<=0 THEN
6950    NEXT_CIRCLE
6960    WLS=1:WLT=0.9
6970   END IF
6980  END IF
6990  IF WLS=1 THEN
7000   IF WLT<=0 THEN WLS=2:WLT=0.12
7010  END IF
7020  IF WLS=2 THEN
7030   IF WLT<=0 THEN
7040    WARLOCK_CAST
7050    WLS=3:WLT=1.1
7060   END IF
7070  END IF
7080  IF WLS=3 THEN
7090   IF WLT<=0 THEN WLS=0:WLT=0.6
7100  END IF
7110 END SUB
7120 SUB WARLOCK_CAST
7130  FIND_FIRE_SLOT
7140  IF FSLOT=0 THEN EXIT SUB
7150  NEAREST_WIZARD WCX(WLC),WCY(WLC)
7160  AIM_CARDINAL WCX(WLC),WCY(WLC),TWX,TWY
7170  FEX(FSLOT)=WCX(WLC):FEY(FSLOT)=WCY(WLC)
7180  FEDX(FSLOT)=ADX:FEDY(FSLOT)=ADY
7190  FEA(FSLOT)=1:FET(FSLOT)=0
7200  PLAY_SFX ASSETS$+"WARLOCK.WAV"
7210 END SUB
7220 SUB NEXT_CIRCLE
7230  LOCAL N
7240  FOR N=1 TO 4
7250   WLC=WLC+1
7260   IF WLC>4 THEN WLC=1
7270   IF WSEAL(WLC)=0 THEN EXIT SUB
7280  NEXT N
7290 END SUB
7300 SUB HIT_WARLOCK
7310  WLW=WLW-1
7320  WSEAL(WLC)=1
7330  SCORE=SCORE+500
7340  FX_BURST(FNCX(WCX(WLC)),FNCY(WCY(WLC)),16,150,"#D158ED")
7350  FX_POPUP(FNCX(WCX(WLC)),FNCY(WCY(WLC))-10,"+500","#D158ED")
7360  PLAY_SFX ASSETS$+"WARD.WAV"
7370  IF WLW>0 THEN
7380   WLS=0:WLT=0.6
7390  ELSE
7400   CHECK_EXIT
7410  END IF
7420 END SUB

7430 REM --- RUNES, EXIT, GATES, CLEAR ---
7440 SUB CHECK_EXIT
7450  LOCAL I
7460  MONS_COUNT=0
7470  FOR I=1 TO EN
7480   IF EA(I)=1 THEN MONS_COUNT=MONS_COUNT+1
7490  NEXT I
7500  RUNES_COUNT=0
7510  FOR I=1 TO NRUN
7520   IF RC(I)=0 THEN RUNES_COUNT=RUNES_COUNT+1
7530  NEXT I
7540  IF MONS_COUNT=0 AND RUNES_COUNT=0 AND WLW=0 THEN EXIT_OPEN=1 ELSE EXIT_OPEN=0
7550 END SUB
7560 SUB CHECK_GATE(W)
7570  LOCAL I
7580  IF GCD_T>0 THEN EXIT SUB
7590  FOR I=1 TO NGATE
7600   IF PX(W)=GX1(I) AND PY(W)=GY1(I) THEN
7610    PX(W)=GX2(I):PY(W)=GY2(I):GCD_T=0.5
7620    FX_RING(FNCX(PX(W)),FNCY(PY(W)),30,0.4,"#66D9FF")
7630    EXIT SUB
7640   END IF
7650   IF PX(W)=GX2(I) AND PY(W)=GY2(I) THEN
7660    PX(W)=GX1(I):PY(W)=GY1(I):GCD_T=0.5
7670    FX_RING(FNCX(PX(W)),FNCY(PY(W)),30,0.4,"#66D9FF")
7680    EXIT SUB
7690   END IF
7700  NEXT I
7710 END SUB
7720 SUB FINISH_CHAMBER
7730  WINGS=WINGS+1
7740  IF NOT DIED_THIS_ROOM THEN SCORE=SCORE+1000
7750  PLAY_SFX ASSETS$+"CHAMBER.WAV"
7760  IF TWO_PLAYER THEN
7770   IF LIV(1)<=0 THEN LIV(1)=1
7780   IF LIV(2)<=0 THEN LIV(2)=1
7790  END IF
7800  ROOM=ROOM+1
7810  IF ROOM>6 THEN ROOM=1
7820  LOAD_ROOM
7830 END SUB

7840 REM --- LIVES, DEATH, OVER ---
7850 SUB HURT_WIZARD(W)
7860  IF PRT(W)>0 THEN EXIT SUB
7870  FX_BURST(FNCX(PX(W)),FNCY(PY(W)),14,140,"BLIP_RED")
7880  PLAY_SFX ASSETS$+"DEATH.WAV"
7890  LIV(W)=LIV(W)-1
7900  DIED_THIS_ROOM=1
7910  IF LIV(W)>0 THEN
7920   DEAD_W=W:STATE$="DEAD":WAIT_LEFT=1.2
7930  ELSE
7940   ALV(W)=0
7950   CHECK_GAMEOVER
7960  END IF
7970 END SUB
7980 SUB CHECK_GAMEOVER
7990  IF NOT ALV(1) AND NOT ALV(2) THEN
8000   STATE$="OVER"
8010   WAIT_LEFT=2
8020  END IF
8030 END SUB
8040 SUB UPDATE_DEAD
8050  FX_UPDATE(DT)
8060  WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
8070  IF WAIT_LEFT=0 THEN
8080   PX(DEAD_W)=SPX:PY(DEAD_W)=SPY
8090   FDX(DEAD_W)=1:FDY(DEAD_W)=0
8100   PRT(DEAD_W)=2
8110   STATE$="PLAY"
8120  END IF
8130 END SUB
8140 SUB UPDATE_OVER
8150  WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
8160  IF WAIT_LEFT=0 AND FIRE THEN START_GAME
8170 END SUB

8180 REM --- DRAWING ---
8190 SUB DRAW_PLAY
8200  DRAW_WORLD
8210  FX_DRAW()
8220  DRAW_HUD(SCORE,LIV(1)+LIV(2))
8230  CHECK_EXIT
8240  FILL_CIRCLE(9,40,4,"#FF5238")
8241  FILL_RECT(7,38,2,2,"BLIP_BLACK")
8242  FILL_RECT(11,38,2,2,"BLIP_BLACK")
8243  DRAW_TEXT(STR$(MONS_COUNT),16,34,2,"BLIP_WHITE","LEFT")
8244  DRAW_CIRCLE(34,40,4,"#8C33A6",1.5)
8245  FILL_CIRCLE(34,40,2,"#8C33A6")
8246  DRAW_TEXT(STR$(RUNES_COUNT),42,34,2,"BLIP_WHITE","LEFT")
8250  IF TWO_PLAYER THEN DRAW_TEXT("P1 "+STR$(LIV(1))+"  P2 "+STR$(LIV(2)),450,34,2,"BLIP_WHITE","LEFT")
8260  IF BANNER_T>0 THEN DRAW_TEXT("ROOM "+STR$(ROOM),320,180,4,"#D158ED","CENTER")
8270 END SUB
8280 SUB DRAW_WORLD
8290  LOCAL R,C,X,Y,I
8300  CLEAR("BLIP_BLACK")
8310  FOR R=0 TO ROWS-1
8320   FOR C=0 TO COLS-1
8330    X=BOARD_X+C*CELL:Y=BOARD_Y+R*CELL
8340    IF WB(C,R)=1 THEN
8350     FILL_RECT(X,Y,CELL,CELL,"#2E1C47")
8360     DRAW_LINE(X,Y,X+CELL,Y,"#452E66")
8370    ELSE
8380     FILL_RECT(X,Y,CELL,CELL,"#0F0A1C")
8390     DRAW_RECT(X,Y,CELL,CELL,"#1C1430")
8400    END IF
8410   NEXT C
8420  NEXT R
8430  FOR I=1 TO NGATE
8440   FILL_CIRCLE(FNCX(GX1(I)),FNCY(GY1(I)),7,"#66D9FF")
8450   FILL_CIRCLE(FNCX(GX2(I)),FNCY(GY2(I)),7,"#66D9FF")
8460  NEXT I
8470  FOR I=1 TO NRUN
8480   IF RC(I)=1 THEN
8490    FILL_GLOW_CIRCLE(FNCX(RX(I)),FNCY(RY(I)),7,"#FFD959")
8500    DRAW_CIRCLE(FNCX(RX(I)),FNCY(RY(I)),8,"#FFD959",2)
8510   ELSE
8520    DRAW_CIRCLE(FNCX(RX(I)),FNCY(RY(I)),7,"#8C33A6",1.5)
8530   END IF
8540  NEXT I
8550  IF EXIT_OPEN THEN
8560   FILL_GLOW_CIRCLE(FNCX(EXITX),FNCY(EXITY),9,"#80FF99")
8570  ELSE
8580   DRAW_CIRCLE(FNCX(EXITX),FNCY(EXITY),7,"#555555",1.5)
8590  END IF
8600  IF WLW>0 THEN DRAW_WARLOCK
8610  FOR I=1 TO EN
8620   IF EA(I)=1 THEN DRAW_ENEMY I
8630  NEXT I
8640  FOR I=1 TO MAX_B
8650   IF BA(I)=1 THEN FILL_GLOW_CIRCLE(FNCX(BX(I)),FNCY(BY(I)),5,"#FFE673")
8660  NEXT I
8670  FOR I=1 TO MAX_F
8680   IF FEA(I)=1 THEN FILL_GLOW_CIRCLE(FNCX(FEX(I)),FNCY(FEY(I)),6,"#FF7326")
8690  NEXT I
8700  IF ALV(1)=1 THEN DRAW_WIZARD 1
8710  IF ALV(2)=1 THEN DRAW_WIZARD 2
8720  IF RNG(1)>0 THEN DRAW_CIRCLE(FNCX(PX(1)),FNCY(PY(1)),20+140*(1-RNG(1)/0.55),"#9FE5FF",2)
8730  IF RNG(2)>0 AND ALV(2)=1 THEN DRAW_CIRCLE(FNCX(PX(2)),FNCY(PY(2)),20+140*(1-RNG(2)/0.55),"#9FE5FF",2)
8740 END SUB
8750 SUB DRAW_WIZARD(W)
8760  LOCAL X,Y,C
8770  X=FNCX(PX(W)):Y=FNCY(PY(W))
8780  IF W=1 THEN C="#33E6C7" ELSE C="#F98C40"
8790  IF PRT(W)>0 THEN DRAW_CIRCLE(X,Y,11,"#E6F2FF",2)
8800  FILL_CIRCLE(X,Y+2,7,C)
8810  FILL_CIRCLE(X,Y-9,4,"#1A5745")
8820  FILL_GLOW_CIRCLE(X,Y,3,"#9FE5FF")
8830 END SUB
8840 SUB DRAW_ENEMY(I)
8850  LOCAL X,Y
8860  X=FNCX(EX(I)):Y=FNCY(EY(I))
8870  IF EK(I)=2 THEN
8880   WRAITH_VISIBLE I
8890   IF WVIS=0 THEN EXIT SUB
8900  END IF
8910  IF EK(I)=1 THEN FILL_CIRCLE(X,Y,6,"#FF5238")
8920  IF EK(I)=2 THEN FILL_CIRCLE(X,Y,7,"#A6C7FF")
8930  IF EK(I)=3 THEN FILL_CIRCLE(X,Y,6,"#FFB34D")
8940  IF EK(I)=4 THEN
8950   IF GW(I)>0 THEN FILL_CIRCLE(X,Y-5,4,"#6BD16B") ELSE FILL_CIRCLE(X,Y,6,"#6BD16B")
8960  END IF
8970  FILL_RECT(X-2,Y-2,2,2,"BLIP_BLACK")
8980  FILL_RECT(X+1,Y-2,2,2,"BLIP_BLACK")
8990 END SUB
9000 SUB DRAW_WARLOCK
9010  LOCAL I,X,Y
9020  FOR I=1 TO 4
9030   X=FNCX(WCX(I)):Y=FNCY(WCY(I))
9040   IF WSEAL(I)=1 THEN
9050    DRAW_CIRCLE(X,Y,6,"#555555",1)
9060   ELSE
9070    DRAW_CIRCLE(X,Y,7,"#8C33A6",2)
9080   END IF
9090  NEXT I
9100  IF WLS>=1 THEN
9110   X=FNCX(WCX(WLC)):Y=FNCY(WCY(WLC))
9120   FILL_CIRCLE(X,Y+2,7,"#D158ED")
9130   FILL_RECT(X-2,Y-2,2,2,"BLIP_BLACK")
9140   FILL_RECT(X+1,Y-2,2,2,"BLIP_BLACK")
9150  END IF
9160 END SUB
9170 SUB DRAW_OVER
9180  CLEAR("BLIP_BLACK")
9190  DRAW_TEXT("GAME OVER",320,110,5,"BLIP_RED","CENTER")
9200  DRAW_TEXT("FINAL SCORE",320,180,2,"BLIP_GRAY","CENTER")
9210  DRAW_TEXT(STR$(SCORE),320,204,3,"BLIP_YELLOW","CENTER")
9220  DRAW_TEXT("WINGS CLEARED "+STR$(WINGS),320,240,2,"BLIP_GRAY","CENTER")
9230  IF WAIT_LEFT=0 THEN DRAW_TEXT(CONTROL_TEXT$("PRESS FIRE","PRESS FIRE","TAP"),320,300,2,"BLIP_WHITE","CENTER")
9240 END SUB

9250 REM --- INPUT AND HELPERS ---
9260 SUB READ_KEYS
9270  FIRE=KEY_PRESSED("SPACE") OR KEY_PRESSED("F")
9280  FIRE_HOLD=KEY_HELD("SPACE") OR KEY_HELD("F")
9290  REV=KEY_PRESSED("G") OR KEY_PRESSED("Z")
9300  JP=KEY_PRESSED("J"):JH=KEY_HELD("J")
9310  KP=KEY_PRESSED("K")
9320  MOVEH=0:MOVEV=0
9330  IF KEY_HELD("A") THEN MOVEH=-1
9340  IF KEY_HELD("D") THEN MOVEH=1
9350  IF KEY_HELD("W") THEN MOVEV=-1
9360  IF KEY_HELD("S") THEN MOVEV=1
9370  M2H=0:M2V=0
9380  IF KEY_HELD("LEFT") THEN M2H=-1
9390  IF KEY_HELD("RIGHT") THEN M2H=1
9400  IF KEY_HELD("UP") THEN M2V=-1
9410  IF KEY_HELD("DOWN") THEN M2V=1
9420  IF TWO_PLAYER=0 THEN
9430   IF M2H<>0 THEN MOVEH=M2H
9440   IF M2V<>0 THEN MOVEV=M2V
9450  END IF
9460 END SUB
9470 DEF FNCX(C)=BOARD_X+C*CELL+CELL/2
9480 DEF FNCY(R)=BOARD_Y+R*CELL+CELL/2
9490 DEF FNWALL(C,R)=C<0 OR C>=COLS OR R<0 OR R>=ROWS OR WB(C,R)=1
9500 DEF FN_NEAR(X1,Y1,X2,Y2)=ABS(X1-X2)<=1 AND ABS(Y1-Y2)<=1
9510 DEF FN_NEAR2(X1,Y1,X2,Y2)=ABS(X1-X2)+ABS(Y1-Y2)<=3
9520 SUB NEAREST_WIZARD(SX,SY)
9530  IF ALV(2)=0 THEN
9540   TWX=PX(1):TWY=PY(1)
9550   EXIT SUB
9560  END IF
9570  TWX=PX(2):TWY=PY(2)
9580  IF ALV(1)=1 AND ABS(SX-PX(1))+ABS(SY-PY(1))<ABS(SX-PX(2))+ABS(SY-PY(2)) THEN
9590   TWX=PX(1):TWY=PY(1)
9591  END IF
9592 END SUB
9600 SUB CHECK_BLOCK(C,R)
9610  LOCAL J
9620  BLOCKED=0
9630  IF FNWALL(C,R) THEN BLOCKED=1
9640  FOR J=1 TO EN
9650   IF EA(J)=1 AND EX(J)=C AND EY(J)=R THEN BLOCKED=1
9660  NEXT J
9670 END SUB
9680 SUB WRAITH_VISIBLE(I)
9690  LOCAL R
9700  WVIS=0:LUNGE=0
9710  IF EF(I)<WRAITH_FLASH THEN WVIS=1
9720  IF RNG(1)>0 OR RNG(2)>0 THEN WVIS=1
9730  IF FN_NEAR2(PX(1),PY(1),EX(I),EY(I)) THEN WVIS=1:LUNGE=1
9740  IF ALV(2)=1 AND FN_NEAR2(PX(2),PY(2),EX(I),EY(I)) THEN WVIS=1:LUNGE=1
9750  FOR R=1 TO NRUN
9760   IF RC(R)=1 AND FN_NEAR(EX(I),EY(I),RX(R),RY(R)) THEN WVIS=1
9770  NEXT R
9780 END SUB
9790 SUB DIR_OF(D)
9800  CDX=0:CDY=0
9810  IF D=0 THEN CDX=-1
9820  IF D=1 THEN CDX=1
9830  IF D=2 THEN CDY=-1
9840  IF D=3 THEN CDY=1
9850 END SUB
9860 SUB AIM_CARDINAL(SX,SY,TX,TY)
9870  LOCAL DX,DY
9880  DX=TX-SX:DY=TY-SY
9890  ADX=0:ADY=0
9900  IF ABS(DX)>=ABS(DY) THEN
9910   IF DX>0 THEN ADX=1
9920   IF DX<0 THEN ADX=-1
9930  ELSE
9940   IF DY>0 THEN ADY=1
9950   IF DY<0 THEN ADY=-1
9960  END IF
9970  IF ADX=0 AND ADY=0 THEN ADX=1
9980 END SUB
9990 SUB FIND_SLOT
10000  LOCAL I
10010  SLOT=0
10020  FOR I=1 TO MAX_B
10030   IF BA(I)=0 THEN SLOT=I
10040  NEXT I
10050 END SUB
10060 SUB FIND_FIRE_SLOT
10070  LOCAL I
10080  FSLOT=0
10090  FOR I=1 TO MAX_F
10100   IF FEA(I)=0 THEN FSLOT=I
10110  NEXT I
10120 END SUB
10130 SUB KILL_ENEMY(J)
10140  EA(J)=0
10150  IF EK(J)=1 THEN SCORE=SCORE+100
10160  IF EK(J)=2 THEN SCORE=SCORE+200
10170  IF EK(J)=3 THEN SCORE=SCORE+250
10180  IF EK(J)=4 THEN SCORE=SCORE+300
10190  FX_BURST(FNCX(EX(J)),FNCY(EY(J)),12,120,"#A6C7FF")
10200  FX_POPUP(FNCX(EX(J)),FNCY(EY(J))-10,"+100","#A6C7FF")
10210  PLAY_SFX ASSETS$+"KILL.WAV"
10220  CHECK_EXIT
10230 END SUB