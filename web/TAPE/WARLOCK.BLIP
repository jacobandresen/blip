3986 DATA 5,1, 9,1
3987 DATA 11,5
3990 DATA 7,5, 7,7
3991 DATA 1,11, 13,1
3996 DATA 1,1, 13,11, 1,0,0,2, 2,0,0
3997 DATA "###############"
3998 DATA "#....#...#....#"
3999 DATA "#.##.#.#.#.##.#"
4000 DATA "#.#......#.#..#"
4001 DATA "#.#.###.#.##..#"
4002 DATA "#...#...#..#..#"
