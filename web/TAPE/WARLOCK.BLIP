1 REM WARLOCK - A MAZE SHOOTER IN THE SPIRIT OF WIZARD OF WOR.
2 REM GAME: WARLOCK
3 REM DESCEND A RIVAL SORCERER'S TOWER, CLEARING EACH CHAMBER OF ITS MONSTERS AND
4 REM CLEANSING ITS CURSED RUNE STONES. CAST BOLTS DOWN THE CORRIDORS; CAST REVEAL
5 REM TO FLUSH OUT THE INVISIBLE WRAITHS, BUT MIND THE SPELLHOUNDS IT DRAWS TO
6 REM WHERE YOU STOOD. THE WARLOCK HIMSELF WAITS IN THE LAST CHAMBER. PRESS J TO
7 REM BRING A SECOND WIZARD INTO THE FIGHT.
10 REM --- SETUP ---
11 ASSETS$="/TAPE/WARLOCK/ASSETS/":SPR$=ASSETS$+"SPRITES.PNG":TIL$=ASSETS$+"TILES.PNG":SP=30
12 COLS=15:ROWS=13:CELL=24
13 BOARD_X=(640-COLS*CELL)/2:BOARD_Y=58
14 MAX_E=12:MAX_B=3:MAX_F=8
15 STEP_TIME=0.09:BOLT_RATE=0.16:REVEAL_CD=2.5
16 IMP_STEP=0.45:WRAITH_STEP=0.22:HOUND_HUNT=0.30:HOUND_WANDER=0.55:WRAITH_CHARGE=0.35
17 WRAITH_FLASH=0.22:TELL_TIME=0.9:GAR_CD=3.0
18 PLAY_MUSIC ASSETS$+"THEME.WAV"
19 STATE$="TITLE"
20 LAST_TIME=TIME()
21 GOLD$="#E6B84A":WIZARD_INK$(1)="#6FD3FF":WIZARD_INK$(2)="#FF9A5C"
22 REM THE SIX CHAMBERS OF THE TOWER, THEN THE DEEPER WINGS THAT REPEAT THEM
23 ROOM_NAME$(1)="THE UNDERCROFT":ROOM_NAME$(2)="THE BONE CRYPT":ROOM_NAME$(3)="THE KENNELS"
24 ROOM_NAME$(4)="THE HALL OF GATES":ROOM_NAME$(5)="THE GARGOYLE GALLERY":ROOM_NAME$(6)="THE WARLOCK'S SANCTUM"
25 ROOM_NAME$(7)="THE DEEP UNDERCROFT":ROOM_NAME$(8)="THE DROWNED CRYPT":ROOM_NAME$(9)="THE ASH KENNELS"
26 ROOM_NAME$(10)="THE SHIFTING HALL":ROOM_NAME$(11)="THE BURNING GALLERY":ROOM_NAME$(12)="THE LOWER SANCTUM"
90 REM --- MAIN LOOP ---
100 NOW=TIME():DT=CLAMP(NOW-LAST_TIME,0.0001,0.1):LAST_TIME=NOW
110 READ_KEYS
120 IF STATE$="TITLE" THEN UPDATE_TITLE
130 IF STATE$="PLAY" THEN UPDATE_PLAY
140 IF STATE$="DEAD" THEN UPDATE_DEAD
150 IF STATE$="OVER" THEN UPDATE_OVER
160 IF STATE$="TITLE" THEN DRAW_TITLE
170 IF STATE$="PLAY" OR STATE$="DEAD" THEN DRAW_PLAY
180 IF STATE$="OVER" THEN DRAW_OVER
190 WAIT 0
200 GOTO 100
1000 REM --- TITLE ---
1010 SUB UPDATE_TITLE
1015   REM J IS A TWO-PLAYER START
1020   IF JP THEN
1022     START_GAME
1024     JOIN_TWO
1026   ELSEIF FIRE THEN
1028     START_GAME
1029   END IF
1030 END SUB
1040 SUB DRAW_TITLE
1041   LOCAL T,F,K,A,B,X,Y,G
1042   T=TIME()
1043   CLEAR("#04050A")
1044   DRAW_TEXTURE(ASSETS$+"TITLE.PNG",142,0,356,400)
1045   F=0.85+0.15*SIN(T*9)
1046   FILL_GLOW_CIRCLE(370,180,6*F,"#FF9A3A")
1047   FILL_GLOW_CIRCLE(430,144,3,"#C070FF")
1048   FILL_GLOW_CIRCLE(443,144,3,"#C070FF")
1049   FILL_GLOW_CIRCLE(264,219,6+SIN(T*5),"#8FD0FF")
1050   FILL_GLOW_CIRCLE(234,259,2.5,"#8FD0FF")
1051   REM THE INSCRIPTION ROUND THE ARCH WAKES LETTER BY LETTER
1052   FOR K=0 TO 15
1053     A=3.30159+K*(2.48159/15)
1054     G=(T*0.35-INT(T*0.35))*22-3-K
1055     IF G>=0 AND G<3 THEN FILL_GLOW_CIRCLE(436+COS(A)*66,130+SIN(A)*66,4-G,"#B060FF")
1056   NEXT K
1057   REM HIS CIRCLE ON THE FLAGSTONES, TURNING
1058   FOR K=0 TO 23
1059     A=K/24*2*3.14159:B=(K+1)/24*2*3.14159
1060     DRAW_LINE(327+COS(A)*46,335+SIN(A)*11,327+COS(B)*46,335+SIN(B)*11,"#9A50E0")
1061     DRAW_LINE(327+COS(A)*29,335+SIN(A)*7,327+COS(B)*29,335+SIN(B)*7,"#6A30A0")
1062   NEXT K
1063   FOR K=0 TO 7
1064     A=K/8*2*3.14159+T*0.35
1065     FILL_GLOW_CIRCLE(327+COS(A)*42,335+SIN(A)*10,1.5,"#D0A0FF")
1066   NEXT K
1067   REM THE VOID IN HIS CLAWS, AND THE STAFF THAT ANSWERS IT
1068   FILL_GLOW_CIRCLE(284,222,9+SIN(T*3),"#8030D0")
1069   FILL_CIRCLE(284,222,5,"#050008")
1070   DRAW_CIRCLE(284,222,6,"#D0A0FF")
1071   IF (T*0.45-INT(T*0.45))<0.55 THEN
1072     X=264+20*(0.5+0.18*SIN(T*2.3)):Y=220
1073     DRAW_LINE(264,219,X,Y+RND(1)*4-2,"#A0E0FF")
1074     DRAW_LINE(284,222,X,Y+RND(1)*4-2,"#E0A0FF")
1075     FILL_GLOW_CIRCLE(X,Y,4,"#FFFFFF")
1076   END IF
1077   REM BLACK CANDLES ROUND THE CIRCLE, THE STONE ON HIS BREAST
1078   FILL_GLOW_CIRCLE(288,321,1.6+0.4*SIN(T*9+0),"#FFC060")
1079   FILL_GLOW_CIRCLE(367,321,1.6+0.4*SIN(T*9+1),"#FFC060")
1080   FILL_GLOW_CIRCLE(284,328,1.6+0.4*SIN(T*9+2),"#FFC060")
1081   FILL_GLOW_CIRCLE(327,336,1.6+0.4*SIN(T*9+3),"#FFC060")
1082   FILL_GLOW_CIRCLE(370,327,1.6+0.4*SIN(T*9+4),"#FFC060")
1083   FILL_GLOW_CIRCLE(436,225,2+ABS(SIN(T*2.1)),"#B050FF")
1084   DRAW_TEXT("WARLOCK",320,14,5,"#2A0A06","CENTER")
1085   DRAW_TEXT("WARLOCK",320,12,5,"#D9A84C","CENTER")
1086   IF INT(T*2) MOD 2=0 THEN DRAW_TEXT(FIRE_PROMPT$("TO START"),320,330,3,"BLIP_WHITE","CENTER","BLIP_BLACK")
1087   DRAW_TEXT(CONTROL_TEXT$("WASD MOVE  SPACE BOLT  Z REVEAL","PAD MOVES  A BOLT  B REVEAL","DRAG MOVES  TAP BOLT"),320,360,2,"BLIP_GRAY","CENTER")
1088   DRAW_TEXT(CONTROL_TEXT$("J TO JOIN A SECOND WIZARD","2ND STATION JOINS WITH A","2ND PLAYER JOINS ON THE DECK"),320,380,2,"#F98C40","CENTER")
1100 END SUB
2000 REM --- START, JOIN, ROOM LOAD ---
2010 SUB START_GAME
2020   SCORE=0:ROOM=1:WINGS=0
2030   TWO_PLAYER=0:WIZ_ALIVE(1)=1:WIZ_ALIVE(2)=0:WIZ_LIVES(1)=3:WIZ_LIVES(2)=0
2040   FX_CLEAR()
2050   LOAD_ROOM
2060   STATE$="PLAY"
2070 END SUB
2080 SUB JOIN_TWO
2090   TWO_PLAYER=1:WIZ_ALIVE(2)=1:WIZ_LIVES(2)=3
2100   WIZ_X(2)=WIZ_X(1):WIZ_Y(2)=WIZ_Y(1)
2110   FACE_X(2)=1:FACE_Y(2)=0
2120   SHIELD_LEFT(2)=2:STEP_CLOCK(2)=0:BOLT_COOL(2)=0:REVEAL_RING(2)=0:REVEAL_COOL(2)=0
2130   FX_RING(FNCX(WIZ_X(2)),FNCY(WIZ_Y(2)),22,0.4,"#F98C40")
2140 END SUB
2150 SUB LOAD_ROOM
2160   LOCAL R,C,I,AI
2170   RESTORE 3900+(ROOM-1)*24
2180   READ START_X,START_Y,EXITX,EXITY,NIMP,NWRA,NHOU,NGAR,NRUN,NGATE,NWARD
2190   FOR R=0 TO ROWS-1
2200     READ MROW$
2210     FOR C=0 TO COLS-1
2220       IF MID$(MROW$,C+1,1)="#" THEN WALL(C,R)=1 ELSE WALL(C,R)=0
2230     NEXT C
2240   NEXT R
2250   FOR I=1 TO MAX_E
2260     FOE_X(I)=0:FOE_Y(I)=0:FOE_ALIVE(I)=0:FOE_KIND(I)=0:FOE_DX(I)=0:FOE_DY(I)=0:FOE_CLOCK(I)=0
2270     WRAITH_PHASE(I)=0:FOE_HUNTING(I)=0:HUNT_X(I)=0:HUNT_Y(I)=0:GAR_WINDUP(I)=0:GAR_WAIT(I)=0:WRAITH_CHARGE_LEFT(I)=0:WRAITH_LUNGED(I)=0
2280   NEXT I
2290   FOES=NIMP+NWRA+NHOU+NGAR
2300   AI=0
2310   FOR I=1 TO NIMP
2320     AI=AI+1:READ FOE_X(AI),FOE_Y(AI)
2330     FOE_KIND(AI)=1:FOE_ALIVE(AI)=1:FOE_DX(AI)=1:FOE_CLOCK(AI)=RND(0.3)
2340   NEXT I
2350   FOR I=1 TO NWRA
2360     AI=AI+1:READ FOE_X(AI),FOE_Y(AI)
2370     FOE_KIND(AI)=2:FOE_ALIVE(AI)=1:WRAITH_PHASE(AI)=RND(0.5):FOE_CLOCK(AI)=RND(0.3)
2380   NEXT I
2390   FOR I=1 TO NHOU
2400     AI=AI+1:READ FOE_X(AI),FOE_Y(AI)
2410     FOE_KIND(AI)=3:FOE_ALIVE(AI)=1:FOE_DX(AI)=1:FOE_CLOCK(AI)=RND(0.3)
2420   NEXT I
2430   FOR I=1 TO NGAR
2440     AI=AI+1:READ FOE_X(AI),FOE_Y(AI)
2450     FOE_KIND(AI)=4:FOE_ALIVE(AI)=1:GAR_WAIT(AI)=RND(1.5):GAR_WINDUP(AI)=0
2460   NEXT I
2470   FOR I=1 TO NRUN
2480     READ RUNE_X(I),RUNE_Y(I):RUNE_CLEANSED(I)=0
2490   NEXT I
2500   FOR I=1 TO NGATE
2510     READ GATE_X1(I),GATE_Y1(I),GATE_X2(I),GATE_Y2(I):GATE_COOL(I)=0
2520   NEXT I
2530   FOR I=1 TO NWARD
2540     READ WARD_X(I),WARD_Y(I):WARD_SEALED(I)=0
2550   NEXT I
2560   WARDS_LEFT=NWARD:WARLOCK_WARD=0:WARLOCK_STAGE=0:WARLOCK_CLOCK=0.9
2570   FOR I=1 TO MAX_B
2580     BOLT_ON(I)=0:BOLT_X(I)=0:BOLT_Y(I)=0:BOLT_DX(I)=1:BOLT_DY(I)=0:BOLT_CLOCK(I)=0
2590   NEXT I
2600   FOR I=1 TO MAX_F
2610     FIREBALL_ON(I)=0:FIREBALL_X(I)=0:FIREBALL_Y(I)=0:FIREBALL_DX(I)=1:FIREBALL_DY(I)=0:FIREBALL_CLOCK(I)=0
2620   NEXT I
2630   EXIT_OPEN=0:GATE_WAIT=0
2640   WIZ_ALIVE(1)=1
2650   IF TWO_PLAYER THEN WIZ_ALIVE(2)=1 ELSE WIZ_ALIVE(2)=0
2660   WIZ_X(1)=START_X:WIZ_Y(1)=START_Y:FACE_X(1)=1:FACE_Y(1)=0
2670   WIZ_X(2)=START_X:WIZ_Y(2)=START_Y:FACE_X(2)=1:FACE_Y(2)=0
2680   SHIELD_LEFT(1)=2:SHIELD_LEFT(2)=2:STEP_CLOCK(1)=0:STEP_CLOCK(2)=0
2690   BOLT_COOL(1)=0:BOLT_COOL(2)=0:REVEAL_RING(1)=0:REVEAL_RING(2)=0:REVEAL_COOL(1)=0:REVEAL_COOL(2)=0
2700   BANNER_T=1.4:DIED_THIS_ROOM=0
2701   IF ROOM=6 THEN
2702     PLAY_MUSIC ASSETS$+"TOWER.WAV"
2703   ELSEIF WINGS>=6 THEN
2704     PLAY_MUSIC ASSETS$+"DEPTHS.WAV"
2705   ELSE
2706     PLAY_MUSIC ASSETS$+"DUNGEON.WAV"
2707   END IF
2710 END SUB
3000 REM --- ROOMS - SIX MAZES; THE WINGS REPEAT THEM ---
3900 DATA 1,1, 13,11, 2,0,0,0, 1,0,0
3901 DATA "###############"
3902 DATA "#.............#"
3903 DATA "#..##....##...#"
3904 DATA "#.............#"
3905 DATA "#....##.......#"
3906 DATA "#.........##..#"
3907 DATA "#.##.......##.#"
3908 DATA "#.........#...#"
3909 DATA "#...##........#"
3910 DATA "#.............#"
3911 DATA "#......##..##.#"
3912 DATA "#.............#"
3913 DATA "###############"
3914 DATA 5,5, 9,7
3918 DATA 7,6
3924 DATA 1,1, 13,11, 0,2,0,0, 2,0,0
3925 DATA "###############"
3926 DATA "#.............#"
3927 DATA "#.####.####...#"
3928 DATA "#....#....#...#"
3929 DATA "#....#....#...#"
3930 DATA "#.............#"
3931 DATA "#.####.####...#"
3932 DATA "#.............#"
3933 DATA "#...###.###...#"
3934 DATA "#.............#"
3935 DATA "#.............#"
3936 DATA "#.............#"
3937 DATA "###############"
3939 DATA 4,7, 9,3
3942 DATA 7,1, 7,7
3948 DATA 1,1, 13,11, 1,0,2,0, 2,0,0
3949 DATA "###############"
3950 DATA "#...###...###.#"
3951 DATA "#...#.....#...#"
3952 DATA "#...#..#..#...#"
3953 DATA "#.............#"
3954 DATA "#.##..##..###.#"
3955 DATA "#.............#"
3956 DATA "#.###....###..#"
3957 DATA "#.............#"
3958 DATA "#...##..##....#"
3959 DATA "#.............#"
3960 DATA "#.............#"
3961 DATA "###############"
3962 DATA 11,6
3964 DATA 7,1, 9,6
3966 DATA 7,4, 7,8
3972 DATA 1,1, 13,11, 2,1,0,0, 2,1,0
3973 DATA "###############"
3974 DATA "#.............#"
3975 DATA "#...###...###.#"
3976 DATA "#...#.....#...#"
3977 DATA "#...#.....#...#"
3978 DATA "#.............#"
3979 DATA "#...###...###.#"
3980 DATA "#.............#"
3981 DATA "#...#.....#...#"
3982 DATA "#...#.....#...#"
3983 DATA "#...###...###.#"
3984 DATA "#.............#"
3985 DATA "###############"
3986 DATA 5,1, 9,1
3987 DATA 11,5
3990 DATA 7,5, 7,7
3991 DATA 1,11, 13,1
3996 DATA 1,1, 13,11, 1,0,0,2, 2,0,0
3997 DATA "###############"
3998 DATA "#....#...#....#"
3999 DATA "#.##.#.#.#.##.#"
4000 DATA "#.#......#.#..#"
4001 DATA "#.#.###.#.##..#"
4002 DATA "#...#...#..#..#"
4003 DATA "#....###......#"
4004 DATA "#..#.#.#.#....#"
4005 DATA "#.##......#...#"
4006 DATA "#.#..#.#..#...#"
4007 DATA "#....#.#.#....#"
4008 DATA "#.............#"
4009 DATA "###############"
4010 DATA 3,5
4013 DATA 7,5, 7,8
4014 DATA 7,11, 7,1
4020 DATA 1,1, 7,11, 0,2,0,0, 2,0,4
4021 DATA "###############"
4022 DATA "#.............#"
4023 DATA "#.####..####..#"
4024 DATA "#.#........#..#"
4025 DATA "#.#..####..#..#"
4026 DATA "#.#..#..#..#..#"
4027 DATA "#.#..#..#..#..#"
4028 DATA "#..##....##...#"
4029 DATA "#...#..##.....#"
4030 DATA "#....#..#.....#"
4031 DATA "#.............#"
4032 DATA "#.............#"
4033 DATA "###############"
4035 DATA 3,9, 11,9
4038 DATA 13,1, 13,11
4040 DATA 7,1, 7,11, 4,6, 10,6
4100 REM --- PLAY ---
4110 SUB UPDATE_PLAY
4120   IF TWO_PLAYER=0 THEN
4130     IF JP THEN JOIN_TWO
4140   ELSE
4150     IF WIZ_ALIVE(2)=1 THEN
4160       IF JP OR (JH AND BOLT_COOL(2)<=0) THEN FIRE_BOLT 2
4170       IF KP THEN CAST_REVEAL 2
4180     END IF
4190   END IF
4200   IF FIRE OR (FIRE_HOLD AND BOLT_COOL(1)<=0) THEN FIRE_BOLT 1
4210   IF REV THEN CAST_REVEAL 1
4220   STEP_PLAYER 1
4230   IF TWO_PLAYER AND WIZ_ALIVE(2)=1 THEN STEP_PLAYER 2
4240   UPDATE_ENEMIES
4250   UPDATE_BOLTS
4260   UPDATE_FIRES
4270   IF WARDS_LEFT>0 THEN UPDATE_WARLOCK
4280   BOLT_COOL(1)=MAX(0,BOLT_COOL(1)-DT):BOLT_COOL(2)=MAX(0,BOLT_COOL(2)-DT)
4290   REVEAL_RING(1)=MAX(0,REVEAL_RING(1)-DT):REVEAL_RING(2)=MAX(0,REVEAL_RING(2)-DT)
4300   REVEAL_COOL(1)=MAX(0,REVEAL_COOL(1)-DT):REVEAL_COOL(2)=MAX(0,REVEAL_COOL(2)-DT)
4310   SHIELD_LEFT(1)=MAX(0,SHIELD_LEFT(1)-DT):SHIELD_LEFT(2)=MAX(0,SHIELD_LEFT(2)-DT)
4320   GATE_WAIT=MAX(0,GATE_WAIT-DT)
4330   BANNER_T=MAX(0,BANNER_T-DT)
4340   FX_UPDATE(DT)
4350 END SUB
4360 SUB STEP_PLAYER(W)
4370   LOCAL NX,NY,MH,MV
4380   IF W=1 THEN MH=MOVEH:MV=MOVEV ELSE MH=M2H:MV=M2V
4390   IF MH=0 AND MV=0 THEN
4400     STEP_CLOCK(W)=0
4410     EXIT SUB
4420   END IF
4430   IF MH<>0 THEN
4440     FACE_X(W)=MH:FACE_Y(W)=0
4450   ELSE
4460     FACE_X(W)=0:FACE_Y(W)=MV
4470   END IF
4480   STEP_CLOCK(W)=STEP_CLOCK(W)+DT
4490   IF STEP_CLOCK(W)<STEP_TIME THEN EXIT SUB
4500   STEP_CLOCK(W)=0
4510   NX=WIZ_X(W)+FACE_X(W):NY=WIZ_Y(W)+FACE_Y(W)
4520   CHECK_BLOCK NX,NY
4530   IF NOT BLOCKED THEN
4540     WIZ_X(W)=NX:WIZ_Y(W)=NY
4550   END IF
4560   CHECK_GATE W
4570   IF EXIT_OPEN AND WIZ_X(W)=EXITX AND WIZ_Y(W)=EXITY THEN FINISH_CHAMBER
4580 END SUB
4590 SUB FIRE_BOLT(W)
4600   IF BOLT_COOL(W)>0 THEN EXIT SUB
4610   FIND_SLOT
4620   IF SLOT=0 THEN EXIT SUB
4630   BOLT_COOL(W)=BOLT_RATE
4640   BOLT_X(SLOT)=WIZ_X(W):BOLT_Y(SLOT)=WIZ_Y(W)
4650   BOLT_DX(SLOT)=FACE_X(W):BOLT_DY(SLOT)=FACE_Y(W)
4660   IF BOLT_DX(SLOT)=0 AND BOLT_DY(SLOT)=0 THEN
4670     BOLT_DX(SLOT)=1:BOLT_DY(SLOT)=0
4680   END IF
4690   BOLT_ON(SLOT)=1:BOLT_CLOCK(SLOT)=0
4700   PLAY_SFX ASSETS$+"BOLT.WAV"
4710 END SUB
4720 SUB CAST_REVEAL(W)
4730   LOCAL I
4740   IF REVEAL_COOL(W)>0 THEN EXIT SUB
4750   REVEAL_COOL(W)=REVEAL_CD:REVEAL_RING(W)=0.55
4760   FX_RING(FNCX(WIZ_X(W)),FNCY(WIZ_Y(W)),120,0.5,"#9FE5FF")
4770   PLAY_SFX ASSETS$+"REVEAL.WAV"
4780   FOR I=1 TO FOES
4790     IF FOE_ALIVE(I)=1 AND FOE_KIND(I)=3 THEN
4800       FOE_HUNTING(I)=1:HUNT_X(I)=WIZ_X(W):HUNT_Y(I)=WIZ_Y(W)
4810     END IF
4820   NEXT I
4830   FOR I=1 TO NRUN
4840     IF RUNE_CLEANSED(I)=0 AND FN_NEAR(WIZ_X(W),WIZ_Y(W),RUNE_X(I),RUNE_Y(I)) THEN CLEANSE_RUNE I
4850   NEXT I
4860   CHECK_EXIT
4870 END SUB
4880 SUB CLEANSE_RUNE(I)
4890   RUNE_CLEANSED(I)=1:SCORE=SCORE+150
4900   FX_RING(FNCX(RUNE_X(I)),FNCY(RUNE_Y(I)),26,0.4,"#FFD959")
4910   FX_POPUP(FNCX(RUNE_X(I)),FNCY(RUNE_Y(I))-10,"+150","#FFD959")
4920   PLAY_SFX ASSETS$+"CLEANSE.WAV"
4930 END SUB
4940 SUB UPDATE_BOLTS
4950   LOCAL I
4960   FOR I=1 TO MAX_B
4970     IF BOLT_ON(I)=1 THEN STEP_ONE_BOLT I
4980   NEXT I
4990 END SUB
5000 SUB STEP_ONE_BOLT(I)
5010   LOCAL NX,NY,J
5020   BOLT_CLOCK(I)=BOLT_CLOCK(I)+DT
5030   IF BOLT_CLOCK(I)<0.05 THEN EXIT SUB
5040   BOLT_CLOCK(I)=0
5050   NX=BOLT_X(I)+BOLT_DX(I):NY=BOLT_Y(I)+BOLT_DY(I)
5060   IF FNWALL(NX,NY) THEN
5070     BOLT_ON(I)=0
5080     EXIT SUB
5090   END IF
5100   BOLT_X(I)=NX:BOLT_Y(I)=NY
5110   FOR J=1 TO FOES
5120     IF FOE_ALIVE(J)=1 AND FOE_X(J)=NX AND FOE_Y(J)=NY THEN
5130       WRAITH_VISIBLE J
5140       IF FOE_KIND(J)<>2 OR WVIS=1 THEN
5150         BOLT_ON(I)=0
5160         KILL_ENEMY J
5170         EXIT SUB
5180       END IF
5190     END IF
5200   NEXT J
5210   IF WARDS_LEFT>0 AND WARLOCK_STAGE=3 AND NX=WARD_X(WARLOCK_WARD) AND NY=WARD_Y(WARLOCK_WARD) THEN
5220     BOLT_ON(I)=0
5230     HIT_WARLOCK
5240   END IF
5250 END SUB
5260 REM --- ENEMIES ---
5270 SUB UPDATE_ENEMIES
5280   LOCAL I
5290   FOR I=1 TO FOES
5300     IF FOE_ALIVE(I)=1 THEN TICK_ENEMY I
5310   NEXT I
5320 END SUB
5330 SUB TICK_ENEMY(I)
5340   IF FOE_KIND(I)=2 THEN
5350     WRAITH_PHASE(I)=WRAITH_PHASE(I)+DT
5360     IF WRAITH_PHASE(I)>=1.0 THEN WRAITH_PHASE(I)=WRAITH_PHASE(I)-1.0
5370   END IF
5380   IF FOE_KIND(I)=4 THEN
5390     UPDATE_GARGOYLE I
5400     EXIT SUB
5410   END IF
5411   IF FOE_KIND(I)=2 THEN
5412     WRAITH_VISIBLE I
5413     IF LUNGE AND WRAITH_LUNGED(I)=0 THEN WRAITH_CHARGE_LEFT(I)=WRAITH_CHARGE
5414     WRAITH_LUNGED(I)=LUNGE
5415     IF WRAITH_CHARGE_LEFT(I)>0 THEN WRAITH_CHARGE_LEFT(I)=WRAITH_CHARGE_LEFT(I)-DT
5416     IF WRAITH_CHARGE_LEFT(I)>0 THEN EXIT SUB
5417   END IF
5420   FOE_CLOCK(I)=FOE_CLOCK(I)-DT
5430   IF FOE_CLOCK(I)>0 THEN EXIT SUB
5440   ENEMY_STEP I
5450 END SUB
5460 SUB ENEMY_STEP(I)
5470   IF FOE_KIND(I)=1 THEN
5480     STEP_IMP I
5490     FOE_CLOCK(I)=IMP_STEP
5500   END IF
5510   IF FOE_KIND(I)=2 THEN
5520     STEP_WRAITH I
5530     FOE_CLOCK(I)=WRAITH_STEP
5540   END IF
5550   IF FOE_KIND(I)=3 THEN STEP_HOUND I
5560 END SUB
5570 SUB STEP_IMP(I)
5580   STEP_WANDER I
5590 END SUB
5600 SUB STEP_WRAITH(I)
5610   WRAITH_VISIBLE I
5620   IF LUNGE THEN STEP_TOWARD I ELSE STEP_WANDER I
5630 END SUB
5640 SUB STEP_HOUND(I)
5650   IF FOE_HUNTING(I)=1 THEN
5660     IF FOE_X(I)=HUNT_X(I) AND FOE_Y(I)=HUNT_Y(I) THEN
5670       FOE_HUNTING(I)=0:FOE_CLOCK(I)=HOUND_WANDER
5680       STEP_WANDER I
5690     ELSE
5700       FOE_CLOCK(I)=HOUND_HUNT
5710       STEP_TO_POINT I,HUNT_X(I),HUNT_Y(I)
5720     END IF
5730   ELSE
5740     FOE_CLOCK(I)=HOUND_WANDER
5750     STEP_WANDER I
5760   END IF
5770 END SUB
5780 SUB STEP_WANDER(I)
5790   LOCAL NX,NY,N,D
5800   NX=FOE_X(I)+FOE_DX(I):NY=FOE_Y(I)+FOE_DY(I)
5810   CHECK_IMP_OK NX,NY,I
5820   IF IMPOK THEN
5830     FOE_X(I)=NX:FOE_Y(I)=NY
5840     CHECK_BUMP I
5850     EXIT SUB
5860   END IF
5870   FOR N=1 TO 16
5880     FOE_DX(I)=0:FOE_DY(I)=0
5890     D=INT(RND(4))
5900     IF D=0 THEN FOE_DX(I)=-1
5910     IF D=1 THEN FOE_DX(I)=1
5920     IF D=2 THEN FOE_DY(I)=-1
5930     IF D=3 THEN FOE_DY(I)=1
5940     CHECK_IMP_OK FOE_X(I)+FOE_DX(I),FOE_Y(I)+FOE_DY(I),I
5950     IF IMPOK THEN
5960       FOE_X(I)=FOE_X(I)+FOE_DX(I):FOE_Y(I)=FOE_Y(I)+FOE_DY(I)
5970       CHECK_BUMP I
5980       EXIT SUB
5990     END IF
6000   NEXT N
6010 END SUB
6020 SUB STEP_TOWARD(I)
6030   NEAREST_WIZARD FOE_X(I),FOE_Y(I)
6040   STEP_TO_POINT I,TWX,TWY
6050 END SUB
6060 SUB STEP_TO_POINT(I,TX,TY)
6070   LOCAL D,BEST,BD,NX,NY
6080   BEST=999:BD=-1
6090   FOR D=0 TO 3
6100     DIR_OF D
6110     NX=FOE_X(I)+CDX:NY=FOE_Y(I)+CDY
6120     CHECK_IMP_OK NX,NY,I
6130     IF IMPOK THEN
6140       IF ABS(NX-TX)+ABS(NY-TY)<BEST THEN
6150         BEST=ABS(NX-TX)+ABS(NY-TY):BD=D
6160       END IF
6170     END IF
6180   NEXT D
6190   IF BD>=0 THEN
6200     DIR_OF BD
6210     FOE_DX(I)=CDX:FOE_DY(I)=CDY
6220     FOE_X(I)=FOE_X(I)+CDX:FOE_Y(I)=FOE_Y(I)+CDY
6230     CHECK_BUMP I
6240   END IF
6250 END SUB
6260 SUB CHECK_IMP_OK(C,R,ME)
6270   LOCAL J
6280   IMPOK=0
6290   IF FNWALL(C,R) THEN EXIT SUB
6300   IMPOK=1
6310   FOR J=1 TO FOES
6320     IF J<>ME AND FOE_ALIVE(J)=1 AND FOE_X(J)=C AND FOE_Y(J)=R THEN IMPOK=0
6330   NEXT J
6340 END SUB
6350 SUB CHECK_BUMP(I)
6360   IF WIZ_ALIVE(1)=1 AND FOE_X(I)=WIZ_X(1) AND FOE_Y(I)=WIZ_Y(1) THEN HURT_WIZARD 1
6370   IF WIZ_ALIVE(2)=1 AND FOE_X(I)=WIZ_X(2) AND FOE_Y(I)=WIZ_Y(2) THEN HURT_WIZARD 2
6380 END SUB
6390 SUB UPDATE_GARGOYLE(I)
6400   IF GAR_WINDUP(I)>0 THEN
6410     GAR_WINDUP(I)=GAR_WINDUP(I)-DT
6420     IF GAR_WINDUP(I)<=0 THEN FIRE_GARGOYLE I
6430   ELSE
6440     GAR_WAIT(I)=GAR_WAIT(I)-DT
6450     IF GAR_WAIT(I)<=0 THEN GAR_WINDUP(I)=TELL_TIME
6460   END IF
6470 END SUB
6480 SUB FIRE_GARGOYLE(I)
6490   FIND_FIRE_SLOT
6500   IF FSLOT=0 THEN
6510     GAR_WAIT(I)=GAR_CD
6520     EXIT SUB
6530   END IF
6540   NEAREST_WIZARD FOE_X(I),FOE_Y(I)
6550   AIM_CARDINAL FOE_X(I),FOE_Y(I),TWX,TWY
6560   FIREBALL_X(FSLOT)=FOE_X(I):FIREBALL_Y(FSLOT)=FOE_Y(I)
6570   FIREBALL_DX(FSLOT)=ADX:FIREBALL_DY(FSLOT)=ADY
6580   FIREBALL_ON(FSLOT)=1:FIREBALL_CLOCK(FSLOT)=0
6590   GAR_WAIT(I)=GAR_CD
6600   FX_BURST(FNCX(FOE_X(I)),FNCY(FOE_Y(I)),6,60,"#FF7326")
6610 END SUB
6620 REM --- FIREBALLS ---
6630 SUB UPDATE_FIRES
6640   LOCAL I
6650   FOR I=1 TO MAX_F
6660     IF FIREBALL_ON(I)=1 THEN STEP_ONE_FIRE I
6670   NEXT I
6680 END SUB
6690 SUB STEP_ONE_FIRE(I)
6700   LOCAL NX,NY
6710   FIREBALL_CLOCK(I)=FIREBALL_CLOCK(I)+DT
6720   IF FIREBALL_CLOCK(I)<0.11 THEN EXIT SUB
6730   FIREBALL_CLOCK(I)=0
6740   NX=FIREBALL_X(I)+FIREBALL_DX(I):NY=FIREBALL_Y(I)+FIREBALL_DY(I)
6750   IF FNWALL(NX,NY) THEN
6760     FIREBALL_ON(I)=0
6770     EXIT SUB
6780   END IF
6790   FIREBALL_X(I)=NX:FIREBALL_Y(I)=NY
6800   IF WIZ_ALIVE(1)=1 AND NX=WIZ_X(1) AND NY=WIZ_Y(1) THEN
6810     FIREBALL_ON(I)=0
6820     HURT_WIZARD 1
6830     EXIT SUB
6840   END IF
6850   IF WIZ_ALIVE(2)=1 AND NX=WIZ_X(2) AND NY=WIZ_Y(2) THEN
6860     FIREBALL_ON(I)=0
6870     HURT_WIZARD 2
6880   END IF
6890 END SUB
6900 REM --- THE WARLOCK (ROOM 6) ---
6910 SUB UPDATE_WARLOCK
6920   WARLOCK_CLOCK=WARLOCK_CLOCK-DT
6930   IF WARLOCK_STAGE=0 THEN
6940     IF WARLOCK_CLOCK<=0 THEN
6950       NEXT_CIRCLE
6960       WARLOCK_STAGE=1:WARLOCK_CLOCK=0.9
6970     END IF
6980   END IF
6990   IF WARLOCK_STAGE=1 THEN
7000     IF WARLOCK_CLOCK<=0 THEN WARLOCK_STAGE=2:WARLOCK_CLOCK=0.12
7010   END IF
7020   IF WARLOCK_STAGE=2 THEN
7030     IF WARLOCK_CLOCK<=0 THEN
7040       WARLOCK_CAST
7050       WARLOCK_STAGE=3:WARLOCK_CLOCK=1.1
7060     END IF
7070   END IF
7080   IF WARLOCK_STAGE=3 THEN
7090     IF WARLOCK_CLOCK<=0 THEN WARLOCK_STAGE=0:WARLOCK_CLOCK=0.6
7100   END IF
7110 END SUB
7120 SUB WARLOCK_CAST
7130   FIND_FIRE_SLOT
7140   IF FSLOT=0 THEN EXIT SUB
7150   NEAREST_WIZARD WARD_X(WARLOCK_WARD),WARD_Y(WARLOCK_WARD)
7160   AIM_CARDINAL WARD_X(WARLOCK_WARD),WARD_Y(WARLOCK_WARD),TWX,TWY
7170   FIREBALL_X(FSLOT)=WARD_X(WARLOCK_WARD):FIREBALL_Y(FSLOT)=WARD_Y(WARLOCK_WARD)
7180   FIREBALL_DX(FSLOT)=ADX:FIREBALL_DY(FSLOT)=ADY
7190   FIREBALL_ON(FSLOT)=1:FIREBALL_CLOCK(FSLOT)=0
7200   PLAY_SFX ASSETS$+"WARLOCK.WAV"
7210 END SUB
7220 SUB NEXT_CIRCLE
7230   LOCAL N
7240   FOR N=1 TO 4
7250     WARLOCK_WARD=WARLOCK_WARD+1
7260     IF WARLOCK_WARD>4 THEN WARLOCK_WARD=1
7270     IF WARD_SEALED(WARLOCK_WARD)=0 THEN EXIT SUB
7280   NEXT N
7290 END SUB
7300 SUB HIT_WARLOCK
7310   WARDS_LEFT=WARDS_LEFT-1
7320   WARD_SEALED(WARLOCK_WARD)=1
7330   SCORE=SCORE+500
7340   FX_BURST(FNCX(WARD_X(WARLOCK_WARD)),FNCY(WARD_Y(WARLOCK_WARD)),16,150,"#D158ED")
7350   FX_POPUP(FNCX(WARD_X(WARLOCK_WARD)),FNCY(WARD_Y(WARLOCK_WARD))-10,"+500","#D158ED")
7360   PLAY_SFX ASSETS$+"WARD.WAV"
7370   IF WARDS_LEFT>0 THEN
7380     WARLOCK_STAGE=0:WARLOCK_CLOCK=0.6
7390   ELSE
7400     CHECK_EXIT
7410   END IF
7420 END SUB
7430 REM --- RUNES, EXIT, GATES, CLEAR ---
7440 SUB CHECK_EXIT
7450   LOCAL I
7460   MONS_COUNT=0
7470   FOR I=1 TO FOES
7480     IF FOE_ALIVE(I)=1 THEN MONS_COUNT=MONS_COUNT+1
7490   NEXT I
7500   RUNES_COUNT=0
7510   FOR I=1 TO NRUN
7520     IF RUNE_CLEANSED(I)=0 THEN RUNES_COUNT=RUNES_COUNT+1
7530   NEXT I
7540   IF MONS_COUNT=0 AND RUNES_COUNT=0 AND WARDS_LEFT=0 THEN EXIT_OPEN=1 ELSE EXIT_OPEN=0
7550 END SUB
7560 SUB CHECK_GATE(W)
7570   LOCAL I
7580   IF GATE_WAIT>0 THEN EXIT SUB
7590   FOR I=1 TO NGATE
7600     IF WIZ_X(W)=GATE_X1(I) AND WIZ_Y(W)=GATE_Y1(I) THEN
7610       WIZ_X(W)=GATE_X2(I):WIZ_Y(W)=GATE_Y2(I):GATE_WAIT=0.5
7620       FX_RING(FNCX(WIZ_X(W)),FNCY(WIZ_Y(W)),30,0.4,"#66D9FF")
7630       EXIT SUB
7640     END IF
7650     IF WIZ_X(W)=GATE_X2(I) AND WIZ_Y(W)=GATE_Y2(I) THEN
7660       WIZ_X(W)=GATE_X1(I):WIZ_Y(W)=GATE_Y1(I):GATE_WAIT=0.5
7670       FX_RING(FNCX(WIZ_X(W)),FNCY(WIZ_Y(W)),30,0.4,"#66D9FF")
7680       EXIT SUB
7690     END IF
7700   NEXT I
7710 END SUB
7720 SUB FINISH_CHAMBER
7730   WINGS=WINGS+1
7740   IF NOT DIED_THIS_ROOM THEN SCORE=SCORE+1000
7750   PLAY_SFX ASSETS$+"CHAMBER.WAV"
7760   IF TWO_PLAYER THEN
7770     IF WIZ_LIVES(1)<=0 THEN WIZ_LIVES(1)=1
7780     IF WIZ_LIVES(2)<=0 THEN WIZ_LIVES(2)=1
7790   END IF
7800   ROOM=ROOM+1
7810   IF ROOM>6 THEN ROOM=1
7820   LOAD_ROOM
7830 END SUB
7840 REM --- LIVES, DEATH, OVER ---
7850 SUB HURT_WIZARD(W)
7860   IF SHIELD_LEFT(W)>0 THEN EXIT SUB
7870   FX_BURST(FNCX(WIZ_X(W)),FNCY(WIZ_Y(W)),14,140,"BLIP_RED")
7880   PLAY_SFX ASSETS$+"DEATH.WAV"
7890   WIZ_LIVES(W)=WIZ_LIVES(W)-1
7900   DIED_THIS_ROOM=1
7910   IF WIZ_LIVES(W)>0 THEN
7920     DEAD_W=W:STATE$="DEAD":WAIT_LEFT=1.2
7930   ELSE
7940     WIZ_ALIVE(W)=0
7950     CHECK_GAMEOVER
7960   END IF
7970 END SUB
7980 SUB CHECK_GAMEOVER
7990   IF NOT WIZ_ALIVE(1) AND NOT WIZ_ALIVE(2) THEN
8000     STATE$="OVER"
8010     WAIT_LEFT=2
8020   END IF
8030 END SUB
8040 SUB UPDATE_DEAD
8050   FX_UPDATE(DT)
8060   WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
8070   IF WAIT_LEFT=0 THEN
8080     WIZ_X(DEAD_W)=START_X:WIZ_Y(DEAD_W)=START_Y
8090     FACE_X(DEAD_W)=1:FACE_Y(DEAD_W)=0
8100     SHIELD_LEFT(DEAD_W)=2
8110     STATE$="PLAY"
8120   END IF
8130 END SUB
8140 SUB UPDATE_OVER
8150   WAIT_LEFT=MAX(0,WAIT_LEFT-DT)
8160   IF WAIT_LEFT=0 AND FIRE THEN START_GAME
8170 END SUB
8180 REM --- DRAWING ---
8190 SUB DRAW_PLAY
8200   DRAW_WORLD
8210   FX_DRAW()
8220   DRAW_HUD(SCORE,WIZ_LIVES(1)+WIZ_LIVES(2))
8230   CHECK_EXIT
8240   DRAW_PANELS
8260   IF BANNER_T>0 THEN DRAW_TEXT("ROOM "+STR$(ROOM),320,180,4,"#D158ED","CENTER")
8270 END SUB
8280 SUB DRAW_WORLD
8290   LOCAL R,C,X,Y,I,T,F
8300   CLEAR("#050508")
8302   T=TIME()
8304   DRAW_TEXTURE(ASSETS$+"FLOOR.PNG",BOARD_X,BOARD_Y,COLS*CELL,ROWS*CELL)
8310   FOR R=0 TO ROWS-1
8320     FOR C=0 TO COLS-1
8330       X=BOARD_X+C*CELL:Y=BOARD_Y+R*CELL
8340       IF WALL(C,R)=1 THEN
8350         DRAW_TEXTURE(TIL$,X,Y,CELL,CELL,(C*3+R*5) MOD 3,8,1,2,0)
8355         IF R<ROWS-1 THEN
8356           IF WALL(C,R+1)=0 THEN
8357             DRAW_TEXTURE(TIL$,X,Y+CELL*0.53,CELL,CELL*0.47,96,32,32,15)
8358             FILL_RECT(X,Y+CELL*0.5,CELL,2,"#9E9EA8")
8359             IF (C*7+R*13) MOD 4=0 AND C>0 AND C<COLS-1 THEN
8360               F=0.85+0.15*SIN(T*9+C*3)
8361               FILL_GLOW_CIRCLE(X+CELL/2,Y+CELL*0.6,4*F,"#FF9A3A")
8362               FILL_CIRCLE(X+CELL/2,Y+CELL*0.6,1.5,"#FFF0C0")
8363             END IF
8364           END IF
8365         END IF
8370       END IF
8410     NEXT C
8420   NEXT R
8430   FOR I=1 TO NGATE
8440     DRAW_TEXTURE(SPR$,FNCX(GATE_X1(I))-SP/2,FNCY(GATE_Y1(I))-SP/2,SP,SP,7,8,4,9,T*0.6)
8450     DRAW_TEXTURE(SPR$,FNCX(GATE_X2(I))-SP/2,FNCY(GATE_Y2(I))-SP/2,SP,SP,7,8,4,9,T*0.6)
8460   NEXT I
8470   FOR I=1 TO NRUN
8480     IF RUNE_CLEANSED(I)=1 THEN
8490       FILL_GLOW_CIRCLE(FNCX(RUNE_X(I)),FNCY(RUNE_Y(I)),9,"#7A5A1A")
8500       DRAW_TEXTURE(SPR$,FNCX(RUNE_X(I))-SP/2,FNCY(RUNE_Y(I))-SP/2-2,SP,SP,4,8,4,9,0)
8510     ELSE
8520       DRAW_TEXTURE(SPR$,FNCX(RUNE_X(I))-SP/2,FNCY(RUNE_Y(I))-SP/2-2,SP,SP,3,8,4,9,0)
8530     END IF
8540   NEXT I
8550   IF EXIT_OPEN THEN
8560     DRAW_TEXTURE(SPR$,FNCX(EXITX)-CELL/2,FNCY(EXITY)-CELL/2,CELL,CELL,6,8,4,9,0)
8565     FILL_GLOW_CIRCLE(FNCX(EXITX),FNCY(EXITY),7,"#806030")
8570   ELSE
8580     DRAW_TEXTURE(SPR$,FNCX(EXITX)-CELL/2,FNCY(EXITY)-CELL/2,CELL,CELL,5,8,4,9,0)
8590   END IF
8600   IF WARDS_LEFT>0 THEN DRAW_WARLOCK
8610   FOR I=1 TO FOES
8620     IF FOE_ALIVE(I)=1 THEN DRAW_ENEMY I
8630   NEXT I
8640   FOR I=1 TO MAX_B
8645     IF BOLT_ON(I)=1 THEN
8650       FILL_GLOW_CIRCLE(FNCX(BOLT_X(I)),FNCY(BOLT_Y(I)),7,"#5C9CFF")
8655       FILL_CIRCLE(FNCX(BOLT_X(I)),FNCY(BOLT_Y(I)),2.5,"#FFFFFF")
8658     END IF
8660   NEXT I
8670   FOR I=1 TO MAX_F
8680     IF FIREBALL_ON(I)=1 THEN FILL_GLOW_CIRCLE(FNCX(FIREBALL_X(I)),FNCY(FIREBALL_Y(I)),7,"#FF7326")
8690   NEXT I
8700   IF WIZ_ALIVE(1)=1 THEN DRAW_WIZARD 1
8710   IF WIZ_ALIVE(2)=1 THEN DRAW_WIZARD 2
8720   IF REVEAL_RING(1)>0 THEN DRAW_CIRCLE(FNCX(WIZ_X(1)),FNCY(WIZ_Y(1)),20+160*(1-REVEAL_RING(1)/0.55),"#9FE5FF",3)
8730   IF REVEAL_RING(2)>0 AND WIZ_ALIVE(2)=1 THEN DRAW_CIRCLE(FNCX(WIZ_X(2)),FNCY(WIZ_Y(2)),20+160*(1-REVEAL_RING(2)/0.55),"#9FE5FF",3)
8740 END SUB
8750 SUB DRAW_WIZARD(W)
8760   LOCAL X,Y,COL,ROW,TX
8770   X=FNCX(WIZ_X(W)):Y=FNCY(WIZ_Y(W))
8780   ROW=W-1:COL=0:TX=7
8781   IF FACE_Y(W)<0 THEN COL=2:TX=-7
8782   IF FACE_X(W)>0 THEN COL=4
8783   IF FACE_X(W)<0 THEN ROW=6:COL=(W-1)*2:TX=-7
8790   IF SHIELD_LEFT(W)>0 THEN DRAW_CIRCLE(X,Y,15,"#E6F2FF",1.5)
8810   DRAW_TEXTURE(SPR$,X-SP/2,Y-SP/2-1,SP,SP,COL,8,ROW,9,0)
8820   FILL_GLOW_CIRCLE(X+TX,Y-11,3,"#9FE5FF")
8830 END SUB
8840 SUB DRAW_ENEMY(I)
8850   LOCAL X,Y,F,T
8860   X=FNCX(FOE_X(I)):Y=FNCY(FOE_Y(I)):T=TIME()
8870   IF FOE_KIND(I)=2 THEN
8880     WRAITH_VISIBLE I
8890     IF WVIS=0 THEN EXIT SUB
8900   END IF
8905   F=INT(T*8+I) MOD 2
8910   IF FOE_KIND(I)=1 THEN DRAW_TEXTURE(SPR$,X-SP/2,Y-SP/2,SP,SP,F,8,2,9,0)
8920   IF FOE_KIND(I)=2 THEN DRAW_TEXTURE(SPR$,X-SP/2,Y-SP/2-2,SP,SP,2+F,8,2,9,0)
8925   IF FOE_KIND(I)=2 THEN FILL_GLOW_CIRCLE(X,Y-6,3,"#8FF0FF")
8930   IF FOE_KIND(I)=3 AND FOE_DX(I)>=0 THEN DRAW_TEXTURE(SPR$,X-SP/2,Y-SP/2,SP,SP,4+(INT(T*9) MOD 3),8,2,9,0)
8935   IF FOE_KIND(I)=3 AND FOE_DX(I)<0 THEN DRAW_TEXTURE(SPR$,X-SP/2,Y-SP/2,SP,SP,4+(INT(T*9) MOD 3),8,6,9,0)
8940   IF FOE_KIND(I)=4 THEN
8950     IF GAR_WINDUP(I)>0 THEN
8955       DRAW_TEXTURE(SPR$,X-SP/2,Y-SP/2,SP,SP,2+F,8,3,9,0)
8960       FILL_GLOW_CIRCLE(X,Y-2,4+8*(1-GAR_WINDUP(I)/TELL_TIME),"#FF8A2A")
8965     ELSE
8970       DRAW_TEXTURE(SPR$,X-SP/2,Y-SP/2,SP,SP,F,8,3,9,0)
8975     END IF
8980   END IF
8990 END SUB
9000 SUB DRAW_WARLOCK
9010   LOCAL I,X,Y,K
9020   FOR I=1 TO 4
9030     X=FNCX(WARD_X(I)):Y=FNCY(WARD_Y(I))
9040     IF WARD_SEALED(I)=1 THEN
9050       DRAW_CIRCLE(X,Y,9,"#555555",1)
9060     ELSE
9070       DRAW_CIRCLE(X,Y,10,"#8C33A6",1.5)
9075       DRAW_CIRCLE(X,Y,6,"#8C33A6",1)
9080     END IF
9090   NEXT I
9100   IF WARLOCK_STAGE>=1 THEN
9110     X=FNCX(WARD_X(WARLOCK_WARD)):Y=FNCY(WARD_Y(WARLOCK_WARD))
9120     FILL_GLOW_CIRCLE(X,Y,10,"#6A2A90")
9130     K=4+(INT(TIME()*3) MOD 2)
9140     DRAW_TEXTURE(SPR$,X-SP/2,Y-SP/2-3,SP,SP,K,8,3,9,0)
9150   END IF
9160 END SUB
9170 SUB DRAW_OVER
9180   CLEAR("BLIP_BLACK")
9190   DRAW_GAME_OVER(SCORE,WAIT_LEFT=0,"WINGS CLEARED "+STR$(WINGS),"#D157F0","BLIP_YELLOW","BLIP_WHITE")
9240 END SUB
9250 REM --- INPUT AND HELPERS ---
9260 SUB READ_KEYS
9270   FIRE=KEY_PRESSED("SPACE") OR KEY_PRESSED("F")
9280   FIRE_HOLD=KEY_HELD("SPACE") OR KEY_HELD("F")
9290   REV=KEY_PRESSED("G") OR KEY_PRESSED("Z")
9300   JP=KEY_PRESSED("J"):JH=KEY_HELD("J")
9310   KP=KEY_PRESSED("K")
9320   MOVEH=0:MOVEV=0
9330   IF KEY_HELD("A") THEN MOVEH=-1
9340   IF KEY_HELD("D") THEN MOVEH=1
9350   IF KEY_HELD("W") THEN MOVEV=-1
9360   IF KEY_HELD("S") THEN MOVEV=1
9370   M2H=0:M2V=0
9380   IF KEY_HELD("LEFT") THEN M2H=-1
9390   IF KEY_HELD("RIGHT") THEN M2H=1
9400   IF KEY_HELD("UP") THEN M2V=-1
9410   IF KEY_HELD("DOWN") THEN M2V=1
9420   IF TWO_PLAYER=0 THEN
9430     IF M2H<>0 THEN MOVEH=M2H
9440     IF M2V<>0 THEN MOVEV=M2V
9450   END IF
9460 END SUB
9470 DEF FNCX(C)=BOARD_X+C*CELL+CELL/2
9480 DEF FNCY(R)=BOARD_Y+R*CELL+CELL/2
9490 DEF FNWALL(C,R)=C<0 OR C>=COLS OR R<0 OR R>=ROWS OR WALL(C,R)=1
9500 DEF FN_NEAR(X1,Y1,X2,Y2)=ABS(X1-X2)<=1 AND ABS(Y1-Y2)<=1
9510 DEF FN_NEAR2(X1,Y1,X2,Y2)=ABS(X1-X2)+ABS(Y1-Y2)<=3
9520 SUB NEAREST_WIZARD(SX,SY)
9530   IF WIZ_ALIVE(2)=0 THEN
9540     TWX=WIZ_X(1):TWY=WIZ_Y(1)
9550     EXIT SUB
9560   END IF
9570   TWX=WIZ_X(2):TWY=WIZ_Y(2)
9580   IF WIZ_ALIVE(1)=1 AND ABS(SX-WIZ_X(1))+ABS(SY-WIZ_Y(1))<ABS(SX-WIZ_X(2))+ABS(SY-WIZ_Y(2)) THEN
9590     TWX=WIZ_X(1):TWY=WIZ_Y(1)
9591   END IF
9592 END SUB
9600 SUB CHECK_BLOCK(C,R)
9610   LOCAL J
9620   BLOCKED=0
9630   IF FNWALL(C,R) THEN BLOCKED=1
9640   FOR J=1 TO FOES
9650     IF FOE_ALIVE(J)=1 AND FOE_X(J)=C AND FOE_Y(J)=R THEN BLOCKED=1
9660   NEXT J
9670 END SUB
9680 SUB WRAITH_VISIBLE(I)
9690   LOCAL R
9700   WVIS=0:LUNGE=0
9710   IF WRAITH_PHASE(I)<WRAITH_FLASH THEN WVIS=1
9720   IF REVEAL_RING(1)>0 OR REVEAL_RING(2)>0 THEN WVIS=1
9730   IF FN_NEAR2(WIZ_X(1),WIZ_Y(1),FOE_X(I),FOE_Y(I)) THEN WVIS=1:LUNGE=1
9740   IF WIZ_ALIVE(2)=1 AND FN_NEAR2(WIZ_X(2),WIZ_Y(2),FOE_X(I),FOE_Y(I)) THEN WVIS=1:LUNGE=1
9750   FOR R=1 TO NRUN
9760     IF RUNE_CLEANSED(R)=1 AND FN_NEAR(FOE_X(I),FOE_Y(I),RUNE_X(R),RUNE_Y(R)) THEN WVIS=1
9770   NEXT R
9780 END SUB
9790 SUB DIR_OF(D)
9800   CDX=0:CDY=0
9810   IF D=0 THEN CDX=-1
9820   IF D=1 THEN CDX=1
9830   IF D=2 THEN CDY=-1
9840   IF D=3 THEN CDY=1
9850 END SUB
9860 SUB AIM_CARDINAL(SX,SY,TX,TY)
9870   LOCAL DX,DY
9880   DX=TX-SX:DY=TY-SY
9890   ADX=0:ADY=0
9900   IF ABS(DX)>=ABS(DY) THEN
9910     IF DX>0 THEN ADX=1
9920     IF DX<0 THEN ADX=-1
9930   ELSE
9940     IF DY>0 THEN ADY=1
9950     IF DY<0 THEN ADY=-1
9960   END IF
9970   IF ADX=0 AND ADY=0 THEN ADX=1
9980 END SUB
9990 SUB FIND_SLOT
10000   LOCAL I
10010   SLOT=0
10020   FOR I=1 TO MAX_B
10030     IF BOLT_ON(I)=0 THEN SLOT=I
10040   NEXT I
10050 END SUB
10060 SUB FIND_FIRE_SLOT
10070   LOCAL I
10080   FSLOT=0
10090   FOR I=1 TO MAX_F
10100     IF FIREBALL_ON(I)=0 THEN FSLOT=I
10110   NEXT I
10120 END SUB
10130 SUB KILL_ENEMY(J)
10140   FOE_ALIVE(J)=0
10150   IF FOE_KIND(J)=1 THEN SCORE=SCORE+100
10160   IF FOE_KIND(J)=2 THEN SCORE=SCORE+200
10170   IF FOE_KIND(J)=3 THEN SCORE=SCORE+250
10180   IF FOE_KIND(J)=4 THEN SCORE=SCORE+300
10190   FX_BURST(FNCX(FOE_X(J)),FNCY(FOE_Y(J)),12,120,"#A6C7FF")
10200   FX_POPUP(FNCX(FOE_X(J)),FNCY(FOE_Y(J))-10,"+100","#A6C7FF")
10210   PLAY_SFX ASSETS$+"KILL.WAV"
10220   CHECK_EXIT
10230 END SUB
10300 REM --- PANELS - EACH WIZARD'S LIVES AND REVEAL, WHAT IS LEFT TO CLEAR, AND THE CHAMBER'S NAME ---
10310 SUB DRAW_PANELS
10320   LOCAL W,I,Y,INK$,GOAL$
10330   FILL_RECT(0,BOARD_Y,BOARD_X-8,ROWS*CELL,"#0B0A10")
10340   FILL_RECT(BOARD_X+COLS*CELL+8,BOARD_Y,640-BOARD_X-COLS*CELL-8,ROWS*CELL,"#0B0A10")
10350   FOR W=1 TO 1+TWO_PLAYER
10360     Y=BOARD_Y+18+(W-1)*120
10370     DRAW_TEXT("P"+STR$(W),BOARD_X/2,Y,2,WIZARD_INK$(W),"CENTER")
10380     FOR I=1 TO WIZ_LIVES(W)
10390       DRAW_TEXTURE(SPR$,BOARD_X/2-38+(I-1)*20,Y+18,24,24,0,8,W-1,9,0)
10400     NEXT I
10405     INK$="#4A5560"
10406     IF REVEAL_COOL(W)<=0 THEN INK$="#9FE5FF"
10410     DRAW_TEXT("REVEAL",BOARD_X/2,Y+54,2,INK$,"CENTER")
10420   NEXT W
10430   DRAW_TEXTURE(SPR$,540,BOARD_Y+14,30,30,0,8,2,9,0)
10440   DRAW_TEXT(STR$(MONS_COUNT),578,BOARD_Y+22,3,"BLIP_WHITE","LEFT")
10450   DRAW_TEXTURE(SPR$,540,BOARD_Y+58,30,30,3,8,4,9,0)
10460   DRAW_TEXT(STR$(RUNES_COUNT),578,BOARD_Y+66,3,"BLIP_WHITE","LEFT")
10470   GOAL$="EXIT OPEN"
10480   IF RUNES_COUNT>0 THEN GOAL$="CLEANSE"
10490   IF MONS_COUNT>0 THEN GOAL$="SLAY"
10500   DRAW_TEXT(GOAL$,570,BOARD_Y+110,2,GOLD$,"CENTER")
10510   DRAW_TEXT(ROOM_NAME$(ROOM+6*(WINGS>0)),320,BOARD_Y+ROWS*CELL+8,2,GOLD$,"CENTER")
10520 END SUB
