1 REM FLOW: SELECT 10 -> ROUND SETUP 810 -> PLAY 100 -> RESULT 700.
2 REM MODULES: STAGES 900; ROSTER 1490; PLAYER POSE 1590; LADDER 1850.
3 REM STATE: PICK SELECTS THE PLAYER; CPU_PICK SELECTS THE OPPONENT.
5 REM GAME: BRAWLER
10 REM BRAWLER - ROSTER SELECTION AND TITLE
11 PLAY_MUSIC "BRAWLER_ARENA":CLEAR("#100A18"):T=T+0.016
15 IF PICK=0 THEN PICK=1:CPU_COLOR$="#A3343B":RIVAL$="BRUTUS":NAME$(1)="RYUKA":NAME$(2)="BRUTUS":NAME$(3)="KESTREL":NAME$(4)="GIOTTO":NAME$(5)="TITIAN":NAME$(6)="VERMEER":NAME$(7)="BOSCH":NAME$(8)="WEBBER":NAME$(9)="GAMMA":NAME$(10)="ZENITH":SUIT$(1)="#EBEBF5":SUIT$(2)="#4D3342":SUIT$(3)="#40A6D9":SUIT$(4)="#704F2B":SUIT$(5)="#704F2B":SUIT$(6)="#704F2B":SUIT$(7)="#704F2B":SUIT$(8)="#3352C7":SUIT$(9)="#75479E":SUIT$(10)="#295CD6":TRIM$(1)="#D94040":TRIM$(2)="#F2BF33":TRIM$(3)="#F2F259":TRIM$(4)="#4080F2":TRIM$(5)="#E63833":TRIM$(6)="#9E5CD9":TRIM$(7)="#FA9424":TRIM$(8)="#DB2429":TRIM$(9)="#B885EB":TRIM$(10)="#DB2429":GOSUB 1490
16 PICK_WAIT=PICK_WAIT-1:IF PICK_WAIT<0 THEN PICK_WAIT=0
17 IF PICK_WAIT=0 AND (KEY_ACTIVE("LEFT")=1 OR KEY_ACTIVE("A")=1) THEN PICK=PICK-1:PICK_WAIT=10:IF PICK<1 THEN PICK=10
18 IF PICK_WAIT=0 AND (KEY_ACTIVE("RIGHT")=1 OR KEY_ACTIVE("D")=1) THEN PICK=PICK+1:PICK_WAIT=10:IF PICK>10 THEN PICK=1
19 PLAYER_SUIT$=SUIT$(PICK):PLAYER_TRIM$=TRIM$(PICK):PLAYER_MAXHP=MAXHP(PICK):PLAYER_SPEED=SPEED(PICK):PLAYER_POWER=POWER(PICK):PLAYER_REACH=REACH(PICK):PLAYER_JUMP=JUMP(PICK):PLAYER_SPECIAL=SPEC_KIND(PICK):PLAYER_SPECIAL_SPEED=SPEC_SPEED(PICK):GOSUB 1560:GOSUB 1500:GOSUB 1300
20 DRAW_TEXT("BRAWLER",160,24,5,"#FF4B83","CENTER","#210D2A")
30 DRAW_TEXT("CHOOSE "+NAME$(PICK),160,65,2,"BLIP_CYAN","CENTER")
35 DRAW_TEXT(SPEC_NAME$(PICK),160,84,2,TRIM$(PICK),"CENTER")
40 DRAW_TEXT("LEFT/RIGHT SELECT  UP/W JUMP",160,107,1,"BLIP_WHITE","CENTER")
45 DRAW_TEXT("ARROWS/WASD MOVE",160,119,1,"BLIP_WHITE","CENTER")
50 DRAW_TEXT("SPACE/F PUNCH  Z/G KICK  BOTH SPECIAL",160,186,1,"BLIP_YELLOW","CENTER")
60 IF KEY_ACTIVE("SPACE")=1 OR KEY_ACTIVE("F")=1 OR KEY_ACTIVE("G")=1 OR KEY_ACTIVE("Z")=1 THEN GOTO 75
70 WAIT 0:GOTO 10
75 IF MATCH_NO=0 THEN MATCH_NO=1:GOSUB 1850
76 GAME_STATE=1:PLAYER_ROUNDS=0:CPU_ROUNDS=0:GOTO 810
99 REM --- ROUND LOOP - TIMERS, INPUT, OPPONENT, AND HITS ---
100 CLEAR("#100A18"):T=T+0.016:ROUND_TIME=ROUND_TIME-0.016
101 IF BLOCK_FLASH>0 THEN BLOCK_FLASH=BLOCK_FLASH-1
102 IF PLAYER_HIT_FLASH>0 THEN PLAYER_HIT_FLASH=PLAYER_HIT_FLASH-1
103 IF CPU_FLASH>0 THEN CPU_FLASH=CPU_FLASH-1
105 GOSUB 900
120 P1_BAR=PLAYER_HP*100/PLAYER_MAXHP:CPU_BAR=CPU_HP*100/CPU_MAXHP
130 FILL_RECT(25,11,100,8,"#572A34"):FILL_RECT(195,11,100,8,"#572A34")
132 FILL_RECT(25+100-P1_BAR,11,P1_BAR,8,"BLIP_CYAN"):FILL_RECT(195,11,CPU_BAR,8,"BLIP_RED")
134 DRAW_RECT(24,10,102,10,"#8AD9D6"):DRAW_RECT(194,10,102,10,"#EA7778")
140 DRAW_TEXT(NAME$(PICK),25,27,1,"BLIP_CYAN","LEFT","BLIP_BLACK")
145 DRAW_TEXT(RIVAL$,270,27,1,"BLIP_RED","LEFT","BLIP_BLACK")
150 TIMER_VALUE=INT(ROUND_TIME+0.999):DRAW_RECT(147,9,26,14,"#27242A")
155 IF ROUND_TIME<=10 THEN DRAW_NUMBER(TIMER_VALUE,TEXT_CX(STR$(TIMER_VALUE),2),14,2,"BLIP_RED")
157 IF ROUND_TIME>10 THEN DRAW_NUMBER(TIMER_VALUE,TEXT_CX(STR$(TIMER_VALUE),2),14,2,"BLIP_WHITE")
165 DRAW_TEXT("MATCH "+STR$(MATCH_NO)+" / 9   ROUND "+STR$(PLAYER_ROUNDS+CPU_ROUNDS+1)+" / 3",160,40,1,"BLIP_GRAY","CENTER")
169 REM --- PLAYER MOVEMENT AND JUMP ---
170 IF (KEY_HELD("LEFT")=1 OR KEY_HELD("A")=1) AND PX>8 THEN PX=PX-PLAYER_SPEED
180 IF (KEY_HELD("RIGHT")=1 OR KEY_HELD("D")=1) AND PX<296 THEN PX=PX+PLAYER_SPEED
185 IF (KEY_PRESSED("UP")=1 OR KEY_PRESSED("W")=1) AND PY=117 THEN PVY=0-PLAYER_JUMP:PLAY_SFX "BRAWLER/WHOOSH"
186 PY=PY+PVY:PVY=PVY+0.29:IF PY>117 THEN PY=117:PVY=0
190 IF CX>PX+27 THEN CX=CX-CPU_SPEED
200 IF CX<PX+25 THEN CX=CX+CPU_SPEED
205 FILL_CAPSULE(PX-1,167,PX+23,167,2,2,"#00000066")
206 FILL_CAPSULE(CX-1,167,CX+23,167,2,2,"#00000066")
210 GOSUB 1590
240 FILL_CAPSULE(CX+8,CY+35,CX+5,CY+46,3,2,CPU_LEG$)
241 FILL_CAPSULE(CX+15,CY+35,CX+19,CY+46,3,2,CPU_LEG$)
242 FILL_CAPSULE(CX+4,CY+46,CX+1,CY+48,2,3,CPU_FOOT$)
243 FILL_CAPSULE(CX+19,CY+46,CX+23,CY+48,2,3,CPU_FOOT$)
244 FILL_CAPSULE(CX+5,CY+15,CX+16,CY+35,7,6,CPU_COLOR$)
245 DRAW_LINE(CX+6,CY+26,CX+15,CY+26,"#E6C293")
246 FILL_CIRCLE(CX+10,CY+7,7,CPU_SKIN$)
247 FILL_CIRCLE(CX+10,CY+3,7,CPU_HAIR$)
248 FILL_RECT(CX+4,CY+6,2,2,"BLIP_WHITE")
249 IF CPU_ATTACK>0 THEN FILL_CAPSULE(CX+5,CY+20,CX-12,CY+23,3,2,CPU_SKIN$)
250 IF CPU_ATTACK=0 THEN FILL_CAPSULE(CX+5,CY+20,CX-1,CY+25,3,2,CPU_SKIN$)
251 FILL_CAPSULE(CX+16,CY+20,CX+23,CY+29,3,2,CPU_SKIN$)
252 FILL_CIRCLE(CX+24,CY+29,3,CPU_SKIN$)
253 IF CPU_ATTACK>0 THEN FILL_CIRCLE(CX-14,CY+23,3,CPU_SKIN$)
254 IF CPU_FLASH>0 THEN FILL_GLOW_CIRCLE(CX+10,CY+23,9,"#FF5A50E0")
255 IF BLOCK_FLASH>0 THEN FILL_GLOW_CIRCLE((PX+CX)/2,PY+24,9,"#48DFFFF0"):FILL_CIRCLE((PX+CX)/2,PY+24,2,"BLIP_WHITE")
256 IF PLAYER_HIT_FLASH>0 THEN FILL_GLOW_CIRCLE((PX+CX)/2,PY+24,9,"#F04A5CF0")
329 REM --- ATTACK INPUT - BUFFER PUNCH, KICK, AND SPECIAL ---
330 PLAYER_WAIT=PLAYER_WAIT-1:CPU_WAIT=CPU_WAIT-1:ATTACK=ATTACK-1:PUNCH=0:KICK=0
331 IF PUNCH_BUFFER>0 THEN PUNCH_BUFFER=PUNCH_BUFFER-1
332 IF KICK_BUFFER>0 THEN KICK_BUFFER=KICK_BUFFER-1
333 IF KEY_PRESSED("SPACE")=1 OR KEY_PRESSED("F")=1 THEN PUNCH=1:PUNCH_BUFFER=6
334 IF KEY_PRESSED("BUTTON2")=1 OR KEY_PRESSED("G")=1 OR KEY_PRESSED("Z")=1 THEN KICK=1:KICK_BUFFER=6
335 HIT=0
336 IF (PUNCH=1 AND KICK_BUFFER>0 OR KICK=1 AND PUNCH_BUFFER>0) THEN PLAYER_WAIT=43:ATTACK=18:ATTACK_KIND=3:HIT=3:SPECIAL_ACTIVE=1:SPECIAL_TIME=0:SPECIAL_HIT=0:SPECIAL_FIRED=0:RUSH_ACTIVE=0:SPECIAL_X=PX+30:SPECIAL_Y=PY+24:PUNCH_BUFFER=0:KICK_BUFFER=0:PLAY_SFX "BRAWLER/WHOOSH"
337 IF SPECIAL_ACTIVE=1 THEN SPECIAL_TIME=SPECIAL_TIME+1
338 IF SPECIAL_ACTIVE=1 AND SPECIAL_TIME=11 AND SPECIAL_FIRED=0 THEN GOSUB 1540
339 IF SPECIAL_ACTIVE=1 AND SPECIAL_TIME>11 AND PLAYER_SPECIAL<>2 AND PLAYER_SPECIAL<>3 THEN SPECIAL_X=SPECIAL_X+PLAYER_SPECIAL_SPEED
340 IF HIT=0 AND PUNCH=1 AND PLAYER_WAIT<1 THEN PLAYER_WAIT=17:ATTACK=17:ATTACK_KIND=1:HIT_DONE=0:PLAY_SFX "BRAWLER/WHOOSH"
341 IF HIT=0 AND KICK=1 AND PLAYER_WAIT<1 THEN PLAYER_WAIT=19:ATTACK=19:ATTACK_KIND=2:HIT_DONE=0:PLAY_SFX "BRAWLER/SWING"
342 IF SPECIAL_ACTIVE=1 AND SPECIAL_TIME>11 AND PLAYER_SPECIAL<>2 AND PLAYER_SPECIAL<>3 AND SPECIAL_X>CX-5 THEN SPECIAL_ACTIVE=0:SPECIAL_HIT=1:CPU_HP=CPU_HP-16*PLAYER_POWER:CPU_FLASH=12:PLAY_SFX "BRAWLER/HIT_HEAVY":IF PLAYER_SPECIAL=5 THEN CPU_WAIT=CPU_WAIT+24
343 IF (SPECIAL_ACTIVE=1 AND SPECIAL_X>318) OR (RUSH_ACTIVE=1 AND SPECIAL_TIME>32) OR (SPECIAL_ACTIVE=1 AND PLAYER_SPECIAL=3 AND SPECIAL_TIME>31) THEN SPECIAL_ACTIVE=0:RUSH_ACTIVE=0
344 IF RUSH_ACTIVE=1 AND SPECIAL_TIME>11 THEN PX=PX+6.4:IF ABS(CX-PX)<30 AND SPECIAL_HIT=0 THEN CPU_HP=CPU_HP-16*PLAYER_POWER:CPU_FLASH=12:SPECIAL_HIT=1:PLAY_SFX "BRAWLER/HIT_HEAVY"
345 IF ATTACK_KIND=1 AND ATTACK<=12 AND ATTACK>=10 AND HIT_DONE=0 AND ABS(CX-PX)<43*PLAYER_REACH THEN CPU_HP=CPU_HP-5*PLAYER_POWER:CPU_FLASH=7:HIT_DONE=1:PLAY_SFX "BRAWLER/HIT_LIGHT"
346 IF ATTACK_KIND=2 AND ATTACK<=13 AND ATTACK>=11 AND HIT_DONE=0 AND ABS(CX-PX)<52*PLAYER_REACH THEN CPU_HP=CPU_HP-7*PLAYER_POWER:CPU_FLASH=7:HIT_DONE=1:PLAY_SFX "BRAWLER/HIT_HEAVY"
347 IF CPU_ATTACK>0 THEN CPU_ATTACK=CPU_ATTACK-1
348 IF CPU_ATTACK=1 THEN CPU_ATTACK=0:CPU_HIT=1
349 IF SPECIAL_ACTIVE=1 AND PLAYER_SPECIAL=3 AND SPECIAL_TIME>11 THEN PX=PX+4.6:IF ABS(CX-PX)<36 AND SPECIAL_HIT=0 THEN CPU_HP=CPU_HP-16*PLAYER_POWER:CPU_FLASH=12:SPECIAL_HIT=1:PLAY_SFX "BRAWLER/HIT_HEAVY"
350 IF CPU_ATTACK=0 AND CPU_HIT=0 AND ABS(CX-PX)<27 AND CPU_WAIT<1 AND PY>108 THEN CPU_ATTACK=6:PLAY_SFX "BRAWLER/WHOOSH"
351 IF CPU_HIT=1 AND ABS(CX-PX)<27 AND PY>108 AND (KEY_HELD("DOWN")=1 OR KEY_HELD("S")=1) THEN CPU_HIT=0:CPU_WAIT=17:BLOCK_FLASH=10:PLAY_SFX "BRAWLER/BLOCK"
352 IF CPU_HIT=1 THEN CPU_HIT=0:CPU_WAIT=17:IF ABS(CX-PX)<27 AND PY>108 THEN PLAYER_HP=PLAYER_HP-5*CPU_POWER:PLAYER_HIT_FLASH=10:PLAY_SFX "BRAWLER/HIT_LIGHT2"
360 IF PLAYER_HP<1 OR CPU_HP<1 OR ROUND_TIME<=0 THEN GOTO 700
370 WAIT 0:GOTO 100
699 REM --- ROUND RESULT - SCORE AND ADVANCE ---
700 CLEAR("#100A18")
705 IF RESULT_SET=0 AND PLAYER_HP>CPU_HP THEN PLAYER_ROUNDS=PLAYER_ROUNDS+1:RESULT_SET=1:PLAY_SFX "BRAWLER/BELL"
706 IF RESULT_SET=0 AND CPU_HP>PLAYER_HP THEN CPU_ROUNDS=CPU_ROUNDS+1:RESULT_SET=1:PLAY_SFX "BRAWLER/KO"
707 IF RESULT_SET=0 AND PLAYER_HP=CPU_HP THEN PLAYER_ROUNDS=PLAYER_ROUNDS+1:CPU_ROUNDS=CPU_ROUNDS+1:RESULT_SET=1:PLAY_SFX "BRAWLER/BELL"
708 IF ROUND_TIME<=0 AND PLAYER_HP>0 AND CPU_HP>0 THEN DRAW_TEXT("TIME UP",160,34,2,"BLIP_YELLOW","CENTER")
710 IF PLAYER_ROUNDS>=2 AND MATCH_NO<9 THEN DRAW_TEXT("FIGHT WON",160,58,4,"BLIP_YELLOW","CENTER")
715 IF PLAYER_ROUNDS>=2 AND MATCH_NO=9 THEN DRAW_TEXT("CHAMPION!",160,58,4,"BLIP_YELLOW","CENTER")
720 IF CPU_ROUNDS>=2 THEN DRAW_TEXT("MATCH LOST",160,58,4,"BLIP_RED","CENTER")
730 IF PLAYER_ROUNDS<2 AND CPU_ROUNDS<2 THEN DRAW_TEXT("ROUND "+STR$(PLAYER_ROUNDS+CPU_ROUNDS)+" COMPLETE",160,58,3,"BLIP_CYAN","CENTER")
740 DRAW_TEXT("YOU "+STR$(PLAYER_ROUNDS)+"   RIVAL "+STR$(CPU_ROUNDS),160,108,2,"BLIP_WHITE","CENTER")
750 IF PLAYER_ROUNDS<2 AND CPU_ROUNDS<2 THEN DRAW_TEXT("SPACE FOR NEXT ROUND",160,154,2,"BLIP_WHITE","CENTER")
755 IF PLAYER_ROUNDS>=2 AND MATCH_NO<9 THEN DRAW_TEXT("SPACE FOR NEXT FIGHT",160,154,2,"BLIP_WHITE","CENTER")
756 IF PLAYER_ROUNDS>=2 AND MATCH_NO=9 THEN DRAW_TEXT("SPACE FOR A NEW RUN",160,154,2,"BLIP_WHITE","CENTER")
757 IF CPU_ROUNDS>=2 THEN DRAW_TEXT("SPACE TO RETRY FIGHT",160,154,2,"BLIP_WHITE","CENTER")
760 IF (KEY_PRESSED("SPACE")=1 OR KEY_PRESSED("F")=1 OR KEY_PRESSED("G")=1 OR KEY_PRESSED("Z")=1) AND PLAYER_ROUNDS<2 AND CPU_ROUNDS<2 THEN GOTO 810
770 IF (KEY_PRESSED("SPACE")=1 OR KEY_PRESSED("F")=1 OR KEY_PRESSED("G")=1 OR KEY_PRESSED("Z")=1) AND PLAYER_ROUNDS>=2 AND MATCH_NO<9 THEN MATCH_NO=MATCH_NO+1:PLAYER_ROUNDS=0:CPU_ROUNDS=0:GOTO 810
775 IF (KEY_PRESSED("SPACE")=1 OR KEY_PRESSED("F")=1 OR KEY_PRESSED("G")=1 OR KEY_PRESSED("Z")=1) AND CPU_ROUNDS>=2 THEN PLAYER_ROUNDS=0:CPU_ROUNDS=0:GOTO 810
776 IF (KEY_PRESSED("SPACE")=1 OR KEY_PRESSED("F")=1 OR KEY_PRESSED("G")=1 OR KEY_PRESSED("Z")=1) AND MATCH_NO=9 AND PLAYER_ROUNDS>=2 THEN GOTO 800
780 WAIT 0:GOTO 700
800 GAME_STATE=1:MATCH_NO=1:PLAYER_ROUNDS=0:CPU_ROUNDS=0:GOSUB 1850:GOTO 810
809 REM --- ROUND SETUP - HEALTH, POSITIONS, AND ATTACK STATE ---
810 GOSUB 1500:PLAYER_HP=PLAYER_MAXHP:CPU_HP=CPU_MAXHP:PX=70:CX=232:PY=117:CY=117:PVY=0:PLAYER_WAIT=0:CPU_WAIT=25:CPU_ATTACK=0:CPU_HIT=0:ATTACK=0:ATTACK_KIND=0:HIT_DONE=1:PUNCH_BUFFER=0:KICK_BUFFER=0:BLOCK_FLASH=0:PLAYER_HIT_FLASH=0:CPU_FLASH=0:RESULT_SET=0:ROUND_TIME=45:SPECIAL_ACTIVE=0:SPECIAL_TIME=0:SPECIAL_HIT=0:SPECIAL_FIRED=0:RUSH_ACTIVE=0
820 GOTO 100
899 REM --- STAGE ROUTER - SELECT THE OPPONENT HOME ---
900 STAGE=HOME(CPU_PICK)
905 IF STAGE=1 THEN GOSUB 1000
910 IF STAGE=2 THEN GOSUB 1100
915 IF STAGE=3 THEN GOSUB 1200
920 IF STAGE=4 THEN GOSUB 2000
925 IF STAGE=5 THEN GOSUB 2040
930 IF STAGE=6 THEN GOSUB 2080
935 IF STAGE=7 THEN GOSUB 2120
940 RETURN
