62110 DATA "REGENT",116,112,1.16,1.02,0.96,2,"VIOLET CRUSH","ARMOURED CHARGE",3,1,"#B8BDD6",178,147,135,2.8,1.2,0
62120 DATA "KITE",98,202,0.98,1.12,1.16,3,"SPIRAL DIVE","AIRBORNE DIVE KICK",3,1,"#CC3352",196,143,135,6.4,0.9,0
62130 DATA "AURELIA",116,88,1.20,0.94,0.86,2,"BRONZE BREAKER","HEAVY ARMOUR BREAK",1,1.08,"#FAC257",180,160,149,2.7,1.24,0
62140 DATA "MACK",108,142,1.05,1,1.02,5,"YO! HOMIES!","LOWRIDER DRIVE-BY",8,1,"#C71F29",176,143,134,4.8,1.04,0
63000 DATA "THE DOCKS","DOCK"
63010 DATA "MOONLIT TEMPLE","TEMPLE"
63020 DATA "THE AIR BASE","AIRBASE"
63030 DATA "THE BATH HOUSE","BATHHOUSE"
63040 DATA "RIVER VILLAGE","VILLAGE"
63050 DATA "CRYSTAL FORTRESS","FORTRESS"
63060 DATA "QUEENS ROOFTOP","ROOFTOP"
63070 DATA "THE HOOD","HOOD"
64000 SUB DRAW_LOW_RIDER(P)
64010   LOCAL W,U,V,D,I,ANGLE,DX,RX,ROLL,SKIN$,CLOTH$,S
64020   W=WHO(P):D=DRIVEBY_FACING(P)
64030   DRIVEBY_POSITION P
64040   U=CAR_X:V=CAR_Y
64045   IF DRIVEBY_T(P)<DRIVEBY_ARRIVE THEN ROLL=DRIVEBY_T(P)/60*16 ELSE ROLL=DRIVEBY_ARRIVE/60*16
64046   IF DRIVEBY_T(P)>=DRIVEBY_DEPART THEN ROLL=DRIVEBY_ARRIVE/60*16+(DRIVEBY_T(P)-DRIVEBY_DEPART)/60*16
64060   FILL_RECT(U-64,V-17,128,24,"#4D121F")
64070   FILL_RECT(U-35,V-34,70,19,"#4D121F")
64080   FILL_RECT(U-31,V-31,28,13,"#6BAEB3")
64090   FILL_RECT(U+3,V-31,31,13,"#6BAEB3")
64100   FOR I=1 TO 3
64110     IF I=1 THEN DX=-22:SKIN$="#633D2E"
64120     IF I=2 THEN DX=11:SKIN$="#8F5C40":CLOTH$="#8F6636"
64130     IF I=3 THEN DX=27:SKIN$="#633D2E":CLOTH$="#24405C"
64135     IF I=1 THEN CLOTH$="#73232E"
64136     FILL_RECT(U+DX-5,V-23,10,8,"#12141F")
64137     FILL_RECT(U+DX-4,V-22,8,6,CLOTH$)
64138     DRAW_LINE_EX(U+DX-3,V-20,U+DX+3,V-18,1,"#C7C4AD")
64150     FILL_CIRCLE(U+DX,V-26,3.6,SKIN$)
64160     FILL_RECT(U+DX-4,V-30,8,2,"#12141F")
64170     IF I=2 THEN FILL_RECT(U+DX-3.5,V-26,7,1.6,"#C7C4AD") ELSE FILL_RECT(U+DX-3.5,V-26,7,1.6,"#D11F32")
64180     FILL_RECT(U+DX+D,V-27,1,1,"BLIP_WHITE")
64185     IF I>1 THEN DRAW_LINE_EX(U+DX,V-22,U+DX+D*9,V-21,2,"#12141F")
64186     IF I>1 THEN DRAW_LINE_EX(U+DX+D*7,V-22,U+DX+D*14,V-22,1,"#C7C4AD")
64190   NEXT I
64200   DRAW_LINE_EX(U-33,V-32,U-1,V-32,1,"#C7C4AD")
64210   DRAW_LINE_EX(U+1,V-32,U+36,V-32,1,"#C7C4AD")
64220   DRAW_LINE_EX(U-33,V-17,U-1,V-17,1,"#C7C4AD")
64230   DRAW_LINE_EX(U+1,V-17,U+36,V-17,1,"#C7C4AD")
64240   DRAW_LINE_EX(U-5,V-15,U-5,V+1,1,"#17131A")
64250   DRAW_LINE_EX(U+34,V-15,U+34,V+1,1,"#17131A")
64260   DRAW_LINE_EX(U-55,V-4,U+51,V-4,2,"#F2B347")
64270   FOR I=0 TO 1
64280     RX=U-38+I*77
64290     FILL_CIRCLE(RX,V+5,12,"#12141F")
64300     FILL_CIRCLE(RX,V+5,6,"#C7C4AD")
64310     FILL_CIRCLE(RX,V+5,2,"#BF2938")
64320     FOR A=0 TO 3
64330       ANGLE=ROLL+A*1.5708
64340       DRAW_LINE_EX(RX,V+5,RX+COS(ANGLE)*4.4,V+5+SIN(ANGLE)*4.4,1,"#12141F")
64350     NEXT A
64360   NEXT I
64370   FILL_RECT(U-D*59,V-12,5,5,"#FF3428")
64375   FILL_GLOW_CIRCLE(U+D*59,V-10,9,"#FFC75980")
64380   FILL_RECT(U+D*57,V-12,6,4,"#FFC759")
64382   DRAW_LINE_EX(U+D*54,V-10,U+D*54,V-3,3,"#12141F")
64383   DRAW_LINE_EX(U+D*54,V-9,U+D*60,V-9,1,"#C7C4AD")
64384   DRAW_LINE_EX(U+D*54,V-7,U+D*60,V-7,1,"#C7C4AD")
64385   DRAW_LINE_EX(U+D*54,V-5,U+D*60,V-5,1,"#C7C4AD")
64386   DRAW_LINE_EX(U+D*53,V-3,U+D*66,V-3,3,"#C7C4AD")
64390   FOR S=1 TO 3
64400     IF SHOT_AT(P,S)>0 AND DRIVEBY_T(P)-SHOT_AT(P,S)<7 THEN
64410       FILL_GLOW_CIRCLE(U+D*39,V-23,14,"#FFAD40E6")
64420       DRAW_LINE_EX(U+D*39,V-23,U+D*57,V-23,4,"BLIP_WHITE")
64430     END IF
64435   NEXT S
64437 END SUB
64440 SUB DRIVEBY_POSITION(P)
64450   LOCAL STOP_X,D
64460   D=DRIVEBY_FACING(P)
64470   STOP_X=CLAMP(DRIVEBY_START_X(P)-D*130,90,550)
64480   IF DRIVEBY_T(P)<DRIVEBY_ARRIVE THEN
64481     CAR_X=STOP_X-D*150*(1-DRIVEBY_T(P)/DRIVEBY_ARRIVE)
64482   ELSEIF DRIVEBY_T(P)<DRIVEBY_DEPART THEN
64483     CAR_X=STOP_X
64484   ELSE
64485     CAR_X=STOP_X+D*520*(DRIVEBY_T(P)-DRIVEBY_DEPART)/60
64486   END IF
64490   IF DRIVEBY_T(P)<DRIVEBY_ARRIVE THEN
64491     CAR_Y=FLOOR_Y-35+SIN(DRIVEBY_T(P)/60*10.5)*1.8
64492   ELSEIF DRIVEBY_T(P)<DRIVEBY_DEPART THEN
64493     CAR_Y=FLOOR_Y-35+SIN((DRIVEBY_T(P)-DRIVEBY_ARRIVE)/60*10.5)*6.5
64494   ELSE
64495     CAR_Y=FLOOR_Y-35+SIN((DRIVEBY_T(P)-DRIVEBY_ARRIVE)/60*10.5)*MAX(2,6.5-(DRIVEBY_T(P)-DRIVEBY_DEPART)/60*4)
64496   END IF
64500 END SUB
