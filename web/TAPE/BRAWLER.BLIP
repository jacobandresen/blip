11310 DATA "BRUTUS",120,0.8,1.28,0.88,4.6, 2,6.67,"BULL RUSH",1, "#4D3342","#F2BF33","#BD8057","#33241F"
11320 DATA "KESTREL",108,1.36,0.96,1.12,5.82, 3,4.6,"TALON KICK",3, "#40A6D9","#F2F259","#E6BD99","#8C6B2E"
11330 DATA "GIOTTO",88,1.83,1,1.12,6.76, 6,8,"SHURIKEN",4, "#704F2B","#4080F2","#70AD4D","#704F2B"
11340 DATA "TITIAN",96,1.67,1.1,1.06,6.5, 2,6.67,"SHELL RAM",4, "#704F2B","#E63833","#70AD4D","#704F2B"
11350 DATA "VERMEER",94,1.96,1.05,1.15,6.86, 3,4.6,"RISING KICK",4, "#704F2B","#9E5CD9","#70AD4D","#704F2B"
11360 DATA "BOSCH",86,2.08,0.92,1.12,7.18, 7,5.4,"PIZZA TOSS",4, "#704F2B","#FA9424","#70AD4D","#704F2B"
11370 DATA "WEBBER",90,2.5,0.92,1.08,6.24, 5,6.67,"WEB SHOT",7, "#3352C7","#DB2429","#DB2429","#1A1A1F"
11380 DATA "GAMMA",92,0.7,1.8,0.82,4.68, 2,6.67,"RAMPAGE",5, "#75479E","#B885EB","#61A342","#1A1A1F"
11390 DATA "ZENITH",200,2.75,3,1,5.2, 4,12,"LASER VISION",6, "#295CD6","#DB2429","#E6B894","#14141A"
