1 REM BRAWLER - FIFTEEN FIGHTERS, FOURTEEN MATCHES, TWO ROUNDS TO WIN.
2 REM GAME: BRAWLER
3 REM MOVE WITH ARROWS/WASD. UP JUMPS; BACK GUARDS; DOWN CROUCHES.
4 REM F/SPACE PUNCH, G/Z KICK. TOWARD HITS HIGH; BOTH BUTTONS USE THE SPECIAL.
5 REM DOWN + PUNCH IS THE RISING UPPERCUT; DOWN + KICK SWEEPS.
6 REM THE ROSTER, MOVE NAMES AND FRAME DATA FOLLOW THE RUST EDITION.
7 REM PICTURES ARE CAPTURED FROM ITS OWN FIGHTER RIG AND EIGHT STAGES.
8 REM ONE FIXED STEP IS ONE FRAME AT 60 HZ.
10 REM --- SETUP ---
11 ASSETS$="/TAPE/BRAWLER/ASSETS/"
12 FLOOR_Y=330
13 WALL_MARGIN=46
14 ROUND_SECS=45
15 FIGHTERS=15:RUNGS=14
16 LOAD_ROSTER
17 LOAD_MOVES
18 PICK=1
19 PICK2=15
20 MODE=1
21 LOCKED(1)=0
22 LOCKED(2)=0
23 STATE$="TITLE"
24 LAST_TIME=TIME()
25 FX_CLEAR
26 TITLE_LEFT(1)=4
27 TITLE_LEFT(2)=3
28 TITLE_LEFT(3)=2
29 TITLE_LEFT(4)=1
30 TITLE_LEFT(5)=7
31 TITLE_LEFT(6)=8
32 TITLE_RIGHT(1)=5
33 TITLE_RIGHT(2)=6
34 TITLE_RIGHT(3)=4
35 TITLE_RIGHT(4)=7
36 TITLE_RIGHT(5)=3
37 TITLE_RIGHT(6)=8
38 DRIVEBY_ARRIVE=23
39 DRIVEBY_FIRST=56
40 DRIVEBY_GAP=15
41 DRIVEBY_DEPART=102
42 DRIVEBY_TOTAL=183
80 PLAY_MUSIC ASSETS$+"WALKOUT.WAV"
100 REM --- MAIN LOOP - UPDATE THE CURRENT SCREEN, THEN DRAW ONE WHOLE PICTURE ---
110 NOW=TIME()
120 DT=CLAMP(NOW-LAST_TIME,0.0001,0.1)
130 LAST_TIME=NOW
140 READ_KEYS
150 FX_UPDATE DT
160 IF STATE$="TITLE" THEN
170   UPDATE_TITLE
175 ELSEIF STATE$="SELECT" THEN
176   UPDATE_SELECT
180 ELSEIF STATE$="PLAY" THEN
190   UPDATE_PLAY
200 ELSEIF STATE$="ROUND" THEN
210   UPDATE_ROUND
220 ELSE
230   UPDATE_OVER
240 END IF
250 IF STATE$="TITLE" THEN
260   DRAW_TITLE
265 ELSEIF STATE$="SELECT" THEN
266   DRAW_SELECT
270 ELSE
280   DRAW_PLAY
290   IF STATE$="ROUND" OR STATE$="OVER" THEN DRAW_RESULT
300 END IF
310 WAIT 0
320 GOTO 110
700 REM --- TITLE - START ENTERS SELECTION; A FRESH PRESS CONFIRMS THE FIGHTER ---
710 SUB UPDATE_TITLE
720   IF KEY_PRESSED("UP") OR KEY_PRESSED("W") THEN MODE=1
725   IF KEY_PRESSED("DOWN") OR KEY_PRESSED("S") THEN MODE=2
730   IF NOT FIRE_HELD(1) THEN MENU_ARMED(1)=1
740   IF MENU_ARMED(1) AND (PUNCH(1) OR KICK(1)) THEN
750     STATE$="SELECT"
760     LOCKED(1)=0:LOCKED(2)=0
765     MENU_ARMED(1)=0:MENU_ARMED(2)=0
770   END IF
780   PUNCH(1)=0:KICK(1)=0
785 END SUB
790 SUB DRAW_TITLE
800   LOCAL I,W,V,U,TURN,ROW,CELL,T,ANG,A,K,X0,M,AT,INK$
801   TURN=INT(NOW/4)
802   U=NOW-TURN*4
803   W=TURN MOD FIGHTERS+1
804   V=(W+6) MOD FIGHTERS+1
805   DRAW_STAGE 2
806   FILL_RECT(0,0,640,FLOOR_Y,"#08051BBB")
807   FOR I=0 TO 13
808     ANG=I*6.283/14+NOW*0.12
809     FOR K=-2 TO 2
810       A=ANG+K*0.035
811       DRAW_LINE_EX(320+COS(A)*60,68+SIN(A)*26,320+COS(A)*520,68+SIN(A)*520,9,"#FF295C0D")
812     NEXT K
813   NEXT I
814   FILL_GLOW_CIRCLE(320,68,150,"#FF285C12")
815   DRAW_TEXT("BRAWLER",320,22,9,"#FF3F68","CENTER","#42182C")
816   DRAW_TEXT("BRAWLER",320,21,9,"#FFF4E8","CENTER","#FF3F68")
817   DRAW_TEXT("FIFTEEN FIGHTERS   ONE CHAMPION",320,100,2,"#75F3FF","CENTER")
818   X0=73
819   FOR I=1 TO FIGHTERS
820     IF I=W OR I=V THEN FILL_GLOW_CIRCLE(X0+(I-1)*38,140,21,TRIM$(I)+"88")
821     DRAW_TEXTURE(ASSETS$+"PORTRAITS.PNG",X0+(I-1)*38-14,126,28,28,(I-1)*30,0,30,30)
822   NEXT I
823   ROW=0
824   CELL=INT(NOW*IDLE_RATE(W)*6/6.283) MOD 6
825   M=TITLE_LEFT((W-1) MOD 6+1)
826   AT=0.55+((W-1) MOD 4)*0.08
827   IF U>=AT AND U<AT+(STARTUP(M)+ACTIVE(M)+RECOVERY(M))/60 THEN
828     ROW=POSE_ROW(M)
829     T=(U-AT)*60
830     CELL=MIN(2,INT(T*3/STARTUP(M)))
831     IF T>=STARTUP(M) THEN CELL=3
832     IF T>=STARTUP(M)+ACTIVE(M) THEN CELL=4+MIN(1,INT((T-STARTUP(M)-ACTIVE(M))*2/RECOVERY(M)))
833   END IF
834   IF U>=2.9 THEN ROW=6
835   IF U>=2.9 THEN CELL=MIN(5,INT((U-2.9)*60/14.4))
836   DRAW_BODY 66,340,W,1,ROW,CELL
837   ROW=0
838   CELL=INT(NOW*IDLE_RATE(V)*6/6.283) MOD 6
839   M=TITLE_RIGHT((V-1) MOD 6+1)
840   AT=1.55+((V-1) MOD 4)*0.08
841   IF U>=AT AND U<AT+(STARTUP(M)+ACTIVE(M)+RECOVERY(M))/60 THEN
842     ROW=POSE_ROW(M)
843     T=(U-AT)*60
844     CELL=MIN(2,INT(T*3/STARTUP(M)))
845     IF T>=STARTUP(M) THEN CELL=3
846     IF T>=STARTUP(M)+ACTIVE(M) THEN CELL=4+MIN(1,INT((T-STARTUP(M)-ACTIVE(M))*2/RECOVERY(M)))
847   END IF
848   IF U>=2.9 THEN ROW=6
849   IF U>=2.9 THEN CELL=MIN(5,INT((U-2.9)*60/14.4))
850   DRAW_BODY 574,340,V,-1,ROW,CELL
851   INK$="#6B4D75"
852   IF MODE=1 THEN INK$="#FFE080"
853   DRAW_TEXT("1 PLAYER",320,176,3,INK$,"CENTER","BLIP_BLACK")
854   INK$="#6B4D75"
855   IF MODE=2 THEN INK$="#FFE080"
856   DRAW_TEXT("2 PLAYERS",320,208,3,INK$,"CENTER","BLIP_BLACK")
857   DRAW_TEXT("P1  ARROWS / WASD   F PUNCH   G KICK",320,250,2,"#F1D8DA","CENTER")
858   DRAW_TEXT("P2  ARROWS   J PUNCH   K KICK",320,272,2,"#72717D","CENTER")
859   IF MODE=2 THEN DRAW_TEXT("P2  ARROWS   J PUNCH   K KICK",320,272,2,"#BFC4D5","CENTER")
860   DRAW_TEXT("TOWARD HITS HIGH   BOTH IS SPECIAL",320,298,2,"#BFC4D5","CENTER")
861   DRAW_TEXT("PRESS F OR SPACE TO CHOOSE",320,348,3,"#FFF0A0","CENTER","#42182C")
862   DRAW_TEXT("UP / DOWN CHOOSE    F OR SPACE START",320,378,2,"#BFC4D5","CENTER")
870 END SUB
910 REM --- MENUS ---
911 SUB UPDATE_SELECT
912   LOCAL P,STEP
913   FOR P=1 TO MODE
914     CHOOSE_WAIT(P)=MAX(0,CHOOSE_WAIT(P)-DT)
915     IF P=1 THEN STEP=MOVE(1) ELSE STEP=MOVE(2)
916     IF STEP=0 THEN
917       IF P=1 THEN
918         IF LOW(1) OR KEY_PRESSED("DOWN") OR KEY_PRESSED("S") THEN STEP=8
919         IF JUMPING(1) THEN STEP=-8
920       ELSE
921         IF LOW(2) OR KEY_PRESSED("DOWN") THEN STEP=8
922         IF JUMPING(2) THEN STEP=-8
923       END IF
924     END IF
925     IF STEP<>0 AND CHOOSE_WAIT(P)=0 AND NOT LOCKED(P) THEN
926       MOVE_PICK P,STEP
927       CHOOSE_WAIT(P)=0.17
928       PLAY_SFX ASSETS$+"TICK.WAV"
929     END IF
930     IF NOT FIRE_HELD(P) THEN MENU_ARMED(P)=1
931     IF MENU_ARMED(P) AND NOT LOCKED(P) AND (PUNCH(P) OR KICK(P)) THEN
932       LOCKED(P)=1:MENU_ARMED(P)=0
933       IF MODE=2 AND P=1 AND PICK=PICK2 AND NOT LOCKED(2) THEN MOVE_PICK 2,1
934       IF MODE=2 AND P=2 AND PICK=PICK2 AND NOT LOCKED(1) THEN MOVE_PICK 1,1
935       PLAY_SFX ASSETS$+"TICK.WAV"
936     END IF
937     PUNCH(P)=0:KICK(P)=0:JUMPING(P)=0
938   NEXT P
939   IF MODE=1 AND LOCKED(1) THEN START_GAME
940   IF MODE=2 AND LOCKED(1) AND LOCKED(2) THEN START_GAME
941 END SUB
942 SUB MOVE_PICK(P,STEP)
943   LOCAL W,I
944   IF P=1 THEN W=PICK ELSE W=PICK2
945   W=(W+FIGHTERS+STEP-1) MOD FIGHTERS+1
946   IF MODE=2 AND LOCKED(3-P) THEN
947     IF P=1 AND W=PICK2 THEN W=(W+FIGHTERS) MOD FIGHTERS+1
948     IF P=2 AND W=PICK THEN W=(W+FIGHTERS) MOD FIGHTERS+1
949   END IF
950   IF P=1 THEN PICK=W ELSE PICK2=W
951 END SUB
1030 SUB DRAW_SELECT
1040   LOCAL I,CX,CY,INK$,TEXT$,POWER_TEXT$,POWER_TENTH
1045   IF MODE=2 THEN
1046     DRAW_SELECT_VERSUS
1047     EXIT SUB
1048   END IF
1050   DRAW_TEXTURE(ASSETS$+"STAGE_"+STR$(HOME(PICK))+".PNG",0,-94,640,400)
1060   FILL_RECT(0,0,640,250,"#080B1B70")
1065   FILL_RECT(0,250,640,150,"#080B1BE8")
1070   DRAW_TEXT("CHOOSE YOUR FIGHTER",320,20,3,"#E6DC32","CENTER","#42182C")
1080   FILL_RECT(298,100,268,136,"#080B1BD8")
1090   DRAW_TEXT(NAME$(PICK),306,112,3,TRIM$(PICK))
1100   DRAW_TEXT(SPECIAL_NAME$(PICK),306,146,2,"#D0D1D8")
1105   IF LEN(POWER_DESC$(PICK))>21 THEN DRAW_TEXT(POWER_DESC$(PICK),306,162,1,TRIM$(PICK)) ELSE DRAW_TEXT(POWER_DESC$(PICK),306,162,2,TRIM$(PICK))
1107   DRAW_TEXT(STAGE_NAME$(HOME(PICK)),306,178,2,"#9298AA")
1108   DRAW_TEXT("PWR",306,194,2,"#D0D1D8")
1109   FILL_RECT(352,196,60*MIN(1.25,POWER(PICK)/1.45),8,TRIM$(PICK))
1110   DRAW_RECT(352,196,60,8,"#686A78")
1111   POWER_TENTH=INT(POWER(PICK)*10+0.499999)
1112   POWER_TEXT$=STR$(INT(POWER_TENTH/10))+"."+STR$(POWER_TENTH MOD 10)
1113   DRAW_TEXT(POWER_TEXT$+"X",436,194,2,"#D0D1D8")
1114   DRAW_TEXT("SPD",306,208,2,"#D0D1D8")
1115   FILL_RECT(352,210,60*MIN(1.25,WALK(PICK)/250),8,TRIM$(PICK))
1116   DRAW_RECT(352,210,60,8,"#686A78")
1117   DRAW_TEXT(STR$(WALK(PICK)),436,208,2,"#D0D1D8")
1118   DRAW_TEXT("HP",306,222,2,"#D0D1D8")
1119   FILL_RECT(352,224,60*MIN(1.25,MAX_HP(PICK)/130),8,TRIM$(PICK))
1120   DRAW_RECT(352,224,60,8,"#686A78")
1121   DRAW_TEXT(STR$(MAX_HP(PICK)),436,222,2,"#D0D1D8")
1122   DRAW_BODY 214,236,PICK,1,0,INT(NOW*IDLE_RATE(PICK)*6/6.283) MOD 6
1140   FOR I=1 TO FIGHTERS
1150     CX=10+((I-1) MOD 8)*78
1160     CY=250+INT((I-1)/8)*48
1170     INK$="#55556D":TEXT$="#9298AA"
1180     IF I=PICK THEN INK$=TRIM$(PICK)
1185     IF I=PICK THEN TEXT$="BLIP_WHITE"
1190     FILL_RECT(CX,CY,74,44,"#252638")
1200     DRAW_TEXTURE(ASSETS$+"PORTRAITS.PNG",CX+22,CY+1,30,30,(I-1)*30,0,30,30)
1205     FILL_RECT(CX,CY+29,74,15,"#12131D")
1208     DRAW_TEXT(NAME$(I),CX+37,CY+30,1,TEXT$,"CENTER")
1210     DRAW_RECT(CX,CY,74,44,INK$)
1230   NEXT I
1240   DRAW_TEXT("BACK GUARDS   BOTH BUTTONS: SPECIAL",320,348,2,"#D0D1D8","CENTER")
1250   DRAW_TEXT(CONTROL_TEXT$("ARROWS CHOOSE  F OR SPACE START","PRESS FIRE TO START","PRESS PUNCH TO START"),320,374,2,"BLIP_WHITE","CENTER")
1251 END SUB
1260 SUB START_GAME
1270   SCORE=0
1280   IF MODE=1 THEN
1290     BUILD_LADDER:OPPONENT_INDEX=1
1300   ELSE
1310     OPPONENT_INDEX=0
1320   END IF
1330   START_MATCH
1340 END SUB
1350 SUB START_MATCH
1360   ROUNDS(1)=0:ROUNDS(2)=0
1370   WHO(1)=PICK
1380   IF MODE=2 THEN WHO(2)=PICK2 ELSE WHO(2)=LADDER(OPPONENT_INDEX)
1390   STAGE=HOME(WHO(2))
1392   PLAY_MUSIC ASSETS$+THEME$(STAGE)+".WAV"
1394   START_ROUND
1398 END SUB
1400 SUB START_ROUND
1410   LOCAL P,S
1420   FOR P=1 TO 2
1425     DRIVEBY_ACTIVE(P)=0:DRIVEBY_T(P)=0:DRIVEBY_SHOTS(P)=0
1426     ALT_KICK(P)=0:STUMBLE_T(P)=0:STUMBLE_ROLL(P)=0
1430     X(P)=180+(P-1)*280
1440     Y(P)=FLOOR_Y:VY(P)=0
1450     FACING(P)=3-2*P
1460     HEALTH(P)=MAX_HP(WHO(P))
1470     GHOST(P)=HEALTH(P)
1480     ACT$(P)="IDLE":T(P)=0
1490     STUN(P)=0:MV(P)=0
1500     HIT_DONE(P)=1
1510     FOR S=1 TO 3
1511       SHOT(P,S)=0
1512       SHOT_AT(P,S)=0
1513       SHOT_SPEED(P,S)=0
1514     NEXT S
1515     BURST(P)=0:BURST_WAIT(P)=0
1520     PUNCH_BUFFER(P)=0
1530     KICK_BUFFER(P)=0
1540     BUFFER_T(P)=0
1550     PUNCH(P)=0:KICK(P)=0
1560     JUMPING(P)=0
1565     MOVE(P)=0:LOW(P)=0:GUARD(P)=0
1570   NEXT P
1580   CLOCK=ROUND_SECS
1590   INTRO=75:HITSTOP=0
1600   CPU_DELAY=24
1610   STEP_CLOCK=0
1620   RESULT_WAIT=0
1630   BANNER$="":BANNER_T=0
1640   STATE$="PLAY"
1650   PLAY_SFX ASSETS$+"BELL.WAV"
1660 END SUB
1670 REM --- THE LADDER
1680 EVERY OTHER FIGHTER, WITH GAMMA AND ZENITH LAST ---
1690 SUB BUILD_LADDER
1700   LOCAL I
1710   FOR I=1 TO RUNGS
1720     RING(I)=(PICK+I-1) MOD FIGHTERS+1
1730   NEXT I
1740   FOR I=1 TO FIGHTERS
1750     USED(I)=0
1760   NEXT I
1770   FINALS=2
1780   IF PICK=9 OR PICK=10 THEN FINALS=1
1790   LADDER_DONE=0
1800   PLACE 1
1810 END SUB
1820 SUB PLACE(DEPTH)
1830   LOCAL K,W
1840   IF DEPTH>RUNGS THEN
1850     LADDER_DONE=1
1860     EXIT SUB
1870   END IF
1880   FOR K=1 TO RUNGS
1890     W=RING(K)
1900     FITS=NOT USED(W)
1910     IF DEPTH<=RUNGS-FINALS AND (W=9 OR W=10) THEN FITS=0
1920     IF DEPTH>RUNGS-FINALS AND PICK=9 AND W<>10 THEN FITS=0
1930     IF DEPTH>RUNGS-FINALS AND PICK=10 AND W<>9 THEN FITS=0
1940     IF DEPTH=RUNGS-1 AND PICK<>9 AND PICK<>10 AND W<>9 THEN FITS=0
1950     IF DEPTH=RUNGS AND PICK<>9 AND PICK<>10 AND W<>10 THEN FITS=0
1960     IF DEPTH>1 THEN
1970       IF HOME(W)=HOME(LADDER(DEPTH-1)) THEN FITS=0
1980     END IF
1990     IF FITS THEN
2000       LADDER(DEPTH)=W
2010       USED(W)=1
2020       PLACE DEPTH+1
2030       IF LADDER_DONE THEN EXIT SUB
2040       USED(W)=0
2050     END IF
2060   NEXT K
2070 END SUB
2210 REM --- FIGHT - BOTH FIGHTERS USE THE SAME PHYSICS, MOVES AND HITS ---
2220 SUB UPDATE_PLAY
2230   STEP_CLOCK=STEP_CLOCK+DT
2240   WHILE STEP_CLOCK>=1/60 AND STATE$="PLAY"
2250     STEP_CLOCK=STEP_CLOCK-1/60
2260     STEP_FIGHT
2270   WEND
2280 END SUB
2290 SUB STEP_FIGHT
2300   LOCAL P,S
2310   BANNER_T=MAX(0,BANNER_T-1)
2320   IF HITSTOP>0 THEN
2330     HITSTOP=HITSTOP-1
2340     EXIT SUB
2350   END IF
2360   IF INTRO>0 THEN
2370     INTRO=INTRO-1
2380     PUNCH(1)=0:KICK(1)=0
2385     PUNCH(2)=0:KICK(2)=0
2390     JUMPING(1)=0:JUMPING(2)=0
2400     EXIT SUB
2410   END IF
2420   CLOCK=CLOCK-1/60
2430   IF MODE=1 THEN UPDATE_CPU
2440   FOR P=1 TO 2
2450     ADVANCE P
2460   NEXT P
2462   FOR P=1 TO 2
2464     UPDATE_DRIVEBY P
2466   NEXT P
2470   PUSH_APART
2480   FOR P=1 TO 2
2490     IF ACT$(P)<>"ATTACK" THEN FACING(P)=SGN(X(3-P)-X(P))
2500   NEXT P
2510   FOR P=1 TO 2
2520     QUEUED(P)=0
2530   NEXT P
2540   FOR P=1 TO 2
2550     UPDATE_ATTACK P
2560     FOR S=1 TO 3
2561       UPDATE_BOLT P,S
2562     NEXT S
2570     PUNCH(P)=0:KICK(P)=0
2580     JUMPING(P)=0
2590   NEXT P
2600   FOR P=1 TO 2
2610     IF QUEUED(P)>0 THEN HURT_FIGHTER P,3-P,QUEUED(P),HIT_Y(P)
2620   NEXT P
2630   IF HEALTH(1)<=0 OR HEALTH(2)<=0 OR CLOCK<=0 THEN END_ROUND
2640 END SUB
2650 SUB ADVANCE(P)
2660   LOCAL W,CHOICE,TOWARD
2670   W=WHO(P)
2680   T(P)=T(P)+1
2681   STUMBLE_T(P)=MAX(0,STUMBLE_T(P)-1)
2690   STUN(P)=MAX(0,STUN(P)-1)
2700   GHOST(P)=MAX(HEALTH(P),GHOST(P)-MAX_HP(WHO(P))/120)
2710   IF Y(P)<FLOOR_Y OR VY(P)<0 THEN
2720     VY(P)=VY(P)+1500/3600
2730     Y(P)=MIN(FLOOR_Y,Y(P)+VY(P))
2740     X(P)=X(P)+VX(P)
2750     IF Y(P)=FLOOR_Y THEN
2760       VY(P)=0:VX(P)=0
2770       FX_BURST X(P),FLOOR_Y,5,0.25,"#D0B486"
2780     END IF
2790   END IF
2800   BUFFER_T(P)=MAX(0,BUFFER_T(P)-1)
2810   PUNCH_BUFFER(P)=MAX(0,PUNCH_BUFFER(P)-1)
2820   KICK_BUFFER(P)=MAX(0,KICK_BUFFER(P)-1)
2830   IF PUNCH(P) THEN PUNCH_BUFFER(P)=10
2840   IF KICK(P) THEN KICK_BUFFER(P)=10
2850   CHOICE=0
2860   TOWARD=MOVE(P)*FACING(P)>0
2870   IF PUNCH_BUFFER(P)>0 AND KICK_BUFFER(P)>0 THEN
2880     CHOICE=5
2890   ELSE
2900     IF PUNCH(P) THEN CHOICE=1+TOWARD
2910     IF KICK(P) THEN CHOICE=3+TOWARD
2920     IF LOW(P) AND PUNCH(P) THEN CHOICE=8
2930     IF LOW(P) AND KICK(P) THEN CHOICE=7
2940     IF Y(P)<FLOOR_Y AND KICK(P) THEN CHOICE=6
2950   END IF
2960   IF CHOICE>0 THEN
2970     BUFFERED(P)=CHOICE
2980     BUFFER_T(P)=10
2990   END IF
3000   IF Y(P)=FLOOR_Y AND ACT$(P)="ATTACK" THEN
3010     X(P)=X(P)+VX(P)
3020     VX(P)=VX(P)*0.9
3030   END IF
3040   IF STUN(P)>0 THEN EXIT SUB
3050   IF ACT$(P)="HITSTUN" OR ACT$(P)="BLOCK" OR ACT$(P)="KNOCKDOWN" THEN ACT$(P)="IDLE"
3060   IF ACT$(P)="ATTACK" AND T(P)<=5 AND BUFFERED(P)=5 AND BUFFER_T(P)>0 THEN START_ATTACK P,5
3070   IF ACT$(P)<>"ATTACK" AND BUFFER_T(P)>0 THEN START_ATTACK P,BUFFERED(P)
3080   IF ACT$(P)="ATTACK" THEN EXIT SUB
3090   IF Y(P)<FLOOR_Y THEN
3100     ACT$(P)="AIR"
3110     EXIT SUB
3120   END IF
3130   ACT$(P)="IDLE"
3140   IF LOW(P) THEN
3150     ACT$(P)="CROUCH"
3160     EXIT SUB
3170   END IF
3180   IF JUMPING(P) THEN
3190     VY(P)=-10*JUMP_SCALE(W)
3200     VX(P)=MOVE(P)*3
3210     ACT$(P)="AIR"
3220     PLAY_SFX ASSETS$+"WHOOSH.WAV"
3230   ELSEIF MOVE(P)<>0 THEN
3240     X(P)=X(P)+MOVE(P)*WALK(W)/60
3250     ACT$(P)="WALK"
3260   END IF
3270   X(P)=CLAMP(X(P),WALL_MARGIN,640-WALL_MARGIN)
3280 END SUB
3290 SUB PUSH_APART
3300   LOCAL GAP,NEED,DIR,MID,P
3310   FOR P=1 TO 2
3320     X(P)=CLAMP(X(P),WALL_MARGIN,640-WALL_MARGIN)
3330   NEXT P
3340   GAP=ABS(X(2)-X(1))
3350   NEED=15*(SIZE(WHO(1))+SIZE(WHO(2)))
3360   IF GAP>=NEED OR ABS(Y(1)-Y(2))>=65 THEN EXIT SUB
3370   DIR=SGN(X(2)-X(1))
3380   IF DIR=0 THEN DIR=1
3390   MID=CLAMP((X(1)+X(2))/2,WALL_MARGIN+NEED/2,640-WALL_MARGIN-NEED/2)
3400   X(1)=MID-DIR*NEED/2
3410   X(2)=MID+DIR*NEED/2
3420 END SUB
3430 REM --- MOVES - STARTUP, ACTIVE AND RECOVERY ARE READ FROM ONE TABLE ---
3440 SUB START_ATTACK(P,CHOICE)
3450   MV(P)=CHOICE
3460   BUFFER_T(P)=0
3470   ACT$(P)="ATTACK"
3480   T(P)=0:HIT_DONE(P)=0
3485   BURST(P)=0
3486   BURST_WAIT(P)=0
3487   IF CHOICE=5 AND SPECIAL_KIND(WHO(P))=5 THEN HIT_DONE(P)=1
3488   IF CHOICE=4 THEN ALT_KICK(P)=1-ALT_KICK(P)
3489   STUMBLE_ROLL(P)=(STUMBLE_ROLL(P)*5+3) MOD 17
3490   IF CHOICE=5 AND SPECIAL_KIND(WHO(P))=5 AND NOT DRIVEBY_ACTIVE(P) THEN DRIVEBY_ACTIVE(P)=1:DRIVEBY_T(P)=0:DRIVEBY_SHOTS(P)=0:DRIVEBY_START_X(P)=X(P):DRIVEBY_FACING(P)=FACING(P)
3500   IF CHOICE=5 THEN PUNCH_BUFFER(P)=0
3510   IF CHOICE=5 THEN KICK_BUFFER(P)=0
3520   IF Y(P)=FLOOR_Y AND SIZE(WHO(P))<1 THEN VX(P)=FACING(P)*(1-SIZE(WHO(P)))*520/60
3530   PLAY_SFX ASSETS$+"WHOOSH.WAV"
3539 END SUB
3540 SUB UPDATE_ATTACK(P)
3550   LOCAL M,W,D,RANGE,HEIGHT,KIND,TOTAL
3560   IF ACT$(P)<>"ATTACK" THEN EXIT SUB
3570   M=MV(P):W=WHO(P)
3580   TOTAL=STARTUP(M)+ACTIVE(M)+RECOVERY(M)
3585   IF M=5 AND SPECIAL_KIND(W)=5 THEN TOTAL=DRIVEBY_TOTAL
3590   IF T(P)>=TOTAL THEN
3591     IF HIT_DONE(P)=0 AND STUMBLE_ROLL(P)<4 THEN STUMBLE_T(P)=18
3592     ACT$(P)="IDLE":T(P)=0
3593     BURST(P)=0
3600     IF Y(P)=FLOOR_Y THEN VX(P)=0
3610     EXIT SUB
3620   END IF
3630   IF T(P)<STARTUP(M) THEN EXIT SUB
3640   IF M=8 AND T(P)=STARTUP(M) AND Y(P)=FLOOR_Y THEN VY(P)=-5.8
3650   IF M=5 THEN
3660     KIND=SPECIAL_KIND(W)
3670     IF KIND=5 THEN EXIT SUB
3680     IF KIND=1 OR KIND=4 THEN
3690       IF NOT HIT_DONE(P) AND NOT SHOT(P,1) THEN LAUNCH_BOLT P
3700       EXIT SUB
3705     END IF
3710     IF T(P)=STARTUP(M) AND KIND=2 THEN VX(P)=FACING(P)*430/60
3720     IF T(P)=STARTUP(M) AND KIND=3 THEN
3730       VY(P)=-8.2
3740       VX(P)=FACING(P)*2.5
3750     END IF
3760   END IF
3770   IF T(P)>=STARTUP(M)+ACTIVE(M) OR HIT_DONE(P) THEN EXIT SUB
3780   D=3-P
3790   RANGE=REACH(M)*ARM_REACH(W)*SIZE(W)+15*(SIZE(W)+SIZE(WHO(D)))
3800   HEIGHT=Y(P)-MOVE_HEIGHT(M)*SIZE(W)
3810   IF M=5 AND SPECIAL_KIND(W)=3 THEN HEIGHT=Y(D)-65*SIZE(WHO(D))
3820   IF (X(D)-X(P))*FACING(P)<=0 THEN EXIT SUB
3830   IF ACT$(D)="KNOCKDOWN" THEN EXIT SUB
3840   IF ABS(X(D)-X(P))>RANGE THEN EXIT SUB
3850   IF HEIGHT<Y(D)-120*SIZE(WHO(D)) OR HEIGHT>Y(D) THEN EXIT SUB
3860   IF LOW(D) AND HEIGHT<Y(D)-74*SIZE(WHO(D)) THEN EXIT SUB
3870   HIT_DONE(P)=1
3880   QUEUED(P)=M
3890   HIT_Y(P)=HEIGHT
3900 END SUB
3910 SUB HURT_FIGHTER(P,D,M,HEIGHT)
3920   LOCAL DAMAGE,BLOCKED,W,INK$
3930   W=WHO(P)
3940   BLOCKED=GUARD(D) AND Y(D)=FLOOR_Y AND ACT$(D)<>"HITSTUN" AND ACT$(D)<>"ATTACK"
3950   IF LEVEL(M)=2 AND LOW(D) THEN BLOCKED=0
3960   IF LEVEL(M)=1 AND NOT LOW(D) THEN BLOCKED=0
3970   SPARK_X=(X(P)+X(D))/2
3980   SPARK_Y=HEIGHT
3990   SPARK_T=12
4000   IF BLOCKED THEN
4010     ACT$(D)="BLOCK"
4020     STUN(D)=BLOCKSTUN(M)
4030     HITSTOP=MAX(HITSTOP,3)
4040     INK$="#70DDFF"
4050     PLAY_SFX ASSETS$+"BLOCK.WAV"
4060   ELSE
4070     DAMAGE=MAX(1,INT(DAMAGE(M)*POWER(W)))
4075     IF M=5 AND SPECIAL_KIND(W)=5 THEN DAMAGE=MAX(1,INT(DAMAGE/3))
4080     IF SIZE(W)<1 AND SIZE(WHO(D))<1 THEN DAMAGE=MAX(1,INT(DAMAGE*0.7))
4090     IF ACT$(D)="ATTACK" AND T(D)<STARTUP(MV(D)) THEN
4100       DAMAGE=INT(DAMAGE*1.2)
4110       BANNER$="COUNTER!":BANNER_T=35
4120     END IF
4130     HEALTH(D)=MAX(0,HEALTH(D)-DAMAGE)
4140     ACT$(D)="HITSTUN"
4150     VX(D)=0
4160     STUN(D)=HITSTUN(M)
4170     IF (M=5 AND SPECIAL_KIND(W)<>5) OR M=7 OR M=8 THEN
4180       ACT$(D)="KNOCKDOWN"
4190       STUN(D)=69
4200       VY(D)=MIN(VY(D),-3)
4210     END IF
4220     T(D)=0
4230     HITSTOP=MAX(HITSTOP,5+2*(DAMAGE>=13))
4240     INK$="#FFE38A"
4250     IF P=1 THEN SCORE=SCORE+DAMAGE*100
4260     IF M=5 OR M=4 OR M=7 OR M=8 THEN
4270       PLAY_SFX ASSETS$+"HIT_HEAVY.WAV"
4280     ELSE
4290       PLAY_SFX ASSETS$+"HIT_LIGHT.WAV"
4300     END IF
4310   END IF
4320   X(D)=CLAMP(X(D)+FACING(P)*(5+6*(NOT BLOCKED)),WALL_MARGIN,640-WALL_MARGIN)
4330   FX_BURST SPARK_X,SPARK_Y,9,0.25,INK$
4340   FX_RING SPARK_X,SPARK_Y,6,0.22,INK$
4350   SPARK_COLOR$=INK$
4360 END SUB
4370 REM --- SPECIALS - THE SAME PROJECTILE AND RUSH RULES FOR BOTH FIGHTERS ---
4380 SUB LAUNCH_BOLT(P)
4385   LOCAL S
4390   FOR S=1 TO 3
4391     IF NOT SHOT(P,S) THEN EXIT FOR
4392   NEXT S
4393   IF S>3 THEN EXIT SUB
4395   SHOT(P,S)=1
4396   HIT_DONE(P)=1
4400   SHOT_FACE(P,S)=FACING(P)
4410   IF SPECIAL_KIND(WHO(P))=5 THEN
4411     DRIVEBY_POSITION P
4412     SHOT_FACE(P,S)=DRIVEBY_FACING(P)
4413     SHOT_X(P,S)=CAR_X+DRIVEBY_FACING(P)*39
4414     SHOT_Y(P,S)=CAR_Y-22+((DRIVEBY_SHOTS(P) MOD 3)-1)*5
4415     SHOT_SPEED(P,S)=520/60
4416     SHOT_AT(P,S)=DRIVEBY_T(P)
4417     DRIVEBY_SHOTS(P)=DRIVEBY_SHOTS(P)+1
4420   ELSE
4421     SHOT_X(P,S)=X(P)+FACING(P)*30
4422     SHOT_Y(P,S)=Y(P)-54*SIZE(WHO(P))
4423     SHOT_SPEED(P,S)=8
4424     SHOT_AT(P,S)=0
4425   END IF
4430   PLAY_SFX ASSETS$+"PROJECTILE.WAV"
4440 END SUB
4441 SUB UPDATE_DRIVEBY(P)
4442   IF NOT DRIVEBY_ACTIVE(P) THEN EXIT SUB
4443   DRIVEBY_T(P)=DRIVEBY_T(P)+1
4444   IF DRIVEBY_T(P)=DRIVEBY_ARRIVE THEN BANNER$=SPECIAL_NAME$(WHO(P)):BANNER_T=45:PLAY_SFX ASSETS$+"WHOOSH.WAV"
4445   IF DRIVEBY_SHOTS(P)<3 AND DRIVEBY_T(P)>=DRIVEBY_FIRST+DRIVEBY_SHOTS(P)*DRIVEBY_GAP THEN LAUNCH_BOLT P
4446   IF DRIVEBY_T(P)>=DRIVEBY_TOTAL THEN DRIVEBY_ACTIVE(P)=0
4449 END SUB
4450 SUB UPDATE_BOLT(P,S)
4460   LOCAL D
4470   IF NOT SHOT(P,S) THEN EXIT SUB
4480   D=3-P
4490   SHOT_X(P,S)=SHOT_X(P,S)+SHOT_FACE(P,S)*SHOT_SPEED(P,S)
4500   IF SHOT_X(P,S)<0 OR SHOT_X(P,S)>640 THEN
4510     SHOT(P,S)=0
4520     EXIT SUB
4530   END IF
4540   IF ABS(SHOT_X(P,S)-X(D))>18*SIZE(WHO(D))+10 THEN EXIT SUB
4550   IF ACT$(D)="KNOCKDOWN" THEN EXIT SUB
4560   IF SHOT_Y(P,S)<Y(D)-120*SIZE(WHO(D)) OR SHOT_Y(P,S)>Y(D) THEN EXIT SUB
4570   IF LOW(D) AND SHOT_Y(P,S)<Y(D)-74*SIZE(WHO(D)) THEN EXIT SUB
4580   QUEUED(P)=5
4590   HIT_Y(P)=SHOT_Y(P,S)
4600   SHOT(P,S)=0
4610 END SUB
4620 REM --- CPU - SPACING, DEFENCE AND COMMITTED ATTACKS, WITH TIME TO REACT ---
4630 SUB UPDATE_CPU
4640   LOCAL D,R,IN_RANGE
4650   MOVE(2)=0:LOW(2)=0
4660   GUARD(2)=0
4670   PUNCH(2)=0:KICK(2)=0
4680   JUMPING(2)=0
4690   IF ACT$(2)="BLOCK" AND STUN(2)>0 THEN
4700     GUARD(2)=1
4710     LOW(2)=LAST_LOW
4720     EXIT SUB
4730   END IF
4740   IF STUN(2)>0 OR ACT$(2)="ATTACK" THEN EXIT SUB
4750   D=ABS(X(1)-X(2))
4760   CPU_DELAY=MAX(0,CPU_DELAY-1)
4770   IF ACT$(1)="ATTACK" AND D<145 AND CPU_DELAY>4 THEN
4780     GUARD(2)=1
4790     LOW(2)=LEVEL(MV(1))<>2
4800     LAST_LOW=LOW(2)
4810     EXIT SUB
4820   END IF
4830   IN_RANGE=58*ARM_REACH(WHO(2))*SIZE(WHO(2))+15*SIZE(WHO(1))
4840   IF D>IN_RANGE THEN MOVE(2)=SGN(X(1)-X(2))
4850   IF CPU_DELAY>0 THEN EXIT SUB
4860   CPU_TURN=CPU_TURN+1
4870   R=SCATTER(CPU_TURN,WHO(2)*97+OPPONENT_INDEX)
4880   CPU_DELAY=18+INT((1-R)*16)-MIN(8,OPPONENT_INDEX)
4890   IF D>150 THEN
4900     IF R>0.65 THEN
4910       PUNCH(2)=1:KICK(2)=1
4920     ELSEIF R<0.18 THEN
4930       JUMPING(2)=1
4940     END IF
4950   ELSEIF D<=IN_RANGE+12 THEN
4960     IF R<0.35 THEN PUNCH(2)=1 ELSE KICK(2)=1
4970     IF R>0.82 THEN
4980       PUNCH(2)=1
4990       KICK(2)=1
5000     END IF
5010     IF R>0.35 AND R<0.55 THEN LOW(2)=1
5020     IF R>0.55 AND R<0.82 THEN MOVE(2)=FACING(2)
5030   END IF
5040 END SUB
5050 REM --- ROUNDS ---
5060 SUB END_ROUND
5070   LOCAL P,S
5080   WINNER=0
5090   IF HEALTH(1)>HEALTH(2) THEN WINNER=1
5100   IF HEALTH(2)>HEALTH(1) THEN WINNER=2
5110   IF WINNER>0 THEN ROUNDS(WINNER)=ROUNDS(WINNER)+1
5120   IF WINNER=0 THEN
5130     ROUNDS(1)=ROUNDS(1)+1
5140     ROUNDS(2)=ROUNDS(2)+1
5150   END IF
5160   FOR P=1 TO 2
5170     ACT$(P)="KNOCKDOWN"
5180     Y(P)=FLOOR_Y
5190     T(P)=0
5200     IF P=WINNER THEN ACT$(P)="VICTORY"
5205     DRIVEBY_ACTIVE(P)=0
5210     FOR S=1 TO 3
5211       SHOT(P,S)=0
5212     NEXT S
5220   NEXT P
5230   STATE$="ROUND"
5240   IF ROUNDS(1)>=2 OR ROUNDS(2)>=2 THEN STATE$="OVER"
5250   RESULT_WAIT=1.2
5260   PUNCH(1)=0:KICK(1)=0
5265   PUNCH(2)=0:KICK(2)=0
5270   PLAY_SFX ASSETS$+"KO.WAV"
5280 END SUB
5290 SUB UPDATE_RESULT
5300   LOCAL P
5310   FOR P=1 TO 2
5320     T(P)=MIN(72,T(P)+DT*60)
5330   NEXT P
5340 END SUB
5350 SUB UPDATE_ROUND
5360   UPDATE_RESULT
5370   RESULT_WAIT=MAX(0,RESULT_WAIT-DT)
5380   IF RESULT_WAIT=0 AND (PUNCH(1) OR KICK(1) OR (MODE=2 AND (PUNCH(2) OR KICK(2)))) THEN START_ROUND
5390   PUNCH(1)=0:KICK(1)=0
5395   PUNCH(2)=0:KICK(2)=0
5400 END SUB
5410 SUB UPDATE_OVER
5420   UPDATE_RESULT
5430   RESULT_WAIT=MAX(0,RESULT_WAIT-DT)
5440   IF MODE=2 THEN
5450     IF RESULT_WAIT=0 AND (PUNCH(1) OR KICK(1) OR PUNCH(2) OR KICK(2)) THEN
5460       STATE$="TITLE":MODE=1
5465       PICK=1:PICK2=15
5470       LOCKED(1)=0:LOCKED(2)=0
5480       PLAY_MUSIC ASSETS$+"WALKOUT.WAV"
5490     END IF
5500   ELSEIF RESULT_WAIT=0 AND (PUNCH(1) OR KICK(1)) THEN
5510     IF ROUNDS(2)>=2 THEN
5520       STATE$="TITLE"
5521       PLAY_MUSIC ASSETS$+"WALKOUT.WAV"
5530     ELSEIF OPPONENT_INDEX<RUNGS THEN
5540       OPPONENT_INDEX=OPPONENT_INDEX+1
5545       START_MATCH
5550     ELSE
5560       STATE$="TITLE"
5561       PLAY_MUSIC ASSETS$+"WALKOUT.WAV"
5565     END IF
5566   END IF
5567   PUNCH(1)=0:KICK(1)=0
5568   PUNCH(2)=0:KICK(2)=0
5570 END SUB
5580 SUB DRAW_ROUND
5590   DRAW_PLAY
5600   DRAW_RESULT
5610 END SUB
5620 SUB DRAW_OVER
5630   DRAW_ROUND
5640 END SUB
5650 REM --- STAGE, FIGHTERS AND EFFECTS ---
5660 SUB DRAW_STAGE(S)
5670   LOCAL I,U,V
5680   DRAW_TEXTURE(ASSETS$+"STAGE_"+STR$(S)+".PNG",0,0,640,400)
5690   IF S=2 THEN
5700     FOR I=0 TO 7
5710       U=(I*89+NOW*9) MOD 640
5720       V=(I*53+NOW*24) MOD 320
5730       FILL_RECT(U+SIN(NOW+I)*10,V,3,2,"#F9B1BC")
5740     NEXT I
5750   END IF
5760   IF S=5 THEN
5770     FOR I=0 TO 7
5780       U=SCATTER(I,34)*640+SIN(NOW+I)*12
5790       V=200+SCATTER(I,98)*90+COS(NOW+I)*6
5800       IF SIN(NOW*2+I)>0 THEN FILL_CIRCLE(U,V,1.5,"#ECFF8A")
5810     NEXT I
5820   END IF
5830 END SUB
5840 SUB DRAW_PLAY
5850   LOCAL P,S,ROW,CELL,W,PHASE
5860   DRAW_STAGE STAGE
5865   FOR P=1 TO 2
5866     IF DRIVEBY_ACTIVE(P) THEN DRAW_LOW_RIDER P
5867   NEXT P
5870   FOR P=1 TO 2
5880     W=WHO(P)
5890     DRAW_SHADOW P
5900     ROW=0
5910     CELL=INT(NOW*IDLE_RATE(W)*6/6.283) MOD 6
5920     IF ACT$(P)="WALK" THEN
5930       PHASE=INT(X(P)*FACING(P)/(6*SIZE(W))) MOD 12
5940       ROW=1
5950       IF PHASE>=6 THEN ROW=17
5960       CELL=PHASE MOD 6
5970     END IF
5980     IF ACT$(P)="CROUCH" THEN ROW=2
5990     IF ACT$(P)="BLOCK" THEN ROW=3
6000     IF ACT$(P)="HITSTUN" THEN
6010       ROW=4
6020       CELL=MIN(5,INT(T(P)/4))
6030     END IF
6040     IF ACT$(P)="KNOCKDOWN" THEN
6050       ROW=5:CELL=0
6060       IF T(P)>=3 THEN CELL=1
6070       IF T(P)>=6 THEN CELL=2
6080       IF T(P)>=10 THEN CELL=3
6090       IF T(P)>=14 THEN CELL=4
6100       IF T(P)>=19 THEN CELL=5
6110       IF STATE$="PLAY" AND T(P)>=51 THEN
6120         ROW=16
6130         CELL=CLAMP(INT((T(P)-51)/3),0,5)
6140       END IF
6150     END IF
6160     IF ACT$(P)="VICTORY" THEN
6170       ROW=6
6180       CELL=MIN(5,INT(T(P)/14.4))
6190     END IF
6200     IF ACT$(P)="AIR" THEN
6210       ROW=12
6220       CELL=CLAMP(INT((VY(P)*60+600)/200),0,5)
6230     END IF
6240     IF ACT$(P)="ATTACK" THEN
6250       ROW=POSE_ROW(MV(P))
6251       IF ALT_KICK(P)=1 AND MV(P)=4 THEN ROW=18
6260       CELL=MIN(2,INT(T(P)*3/STARTUP(MV(P))))
6270       IF T(P)>=STARTUP(MV(P)) THEN CELL=3
6280       IF T(P)>=STARTUP(MV(P))+ACTIVE(MV(P)) THEN CELL=4+MIN(1,INT((T(P)-STARTUP(MV(P))-ACTIVE(MV(P)))*2/RECOVERY(MV(P))))
6290     END IF
6300     IF WHO(P)=12 AND ACT$(P)="ATTACK" AND MV(P)=5 THEN
6310       FILL_GLOW_CIRCLE(X(P),Y(P)-60,44,"#A738EF88")
6320     END IF
6329     IF STUMBLE_T(P)>0 AND ACT$(P)="IDLE" THEN ROW=4:CELL=MIN(5,INT((18-STUMBLE_T(P))*6/18))
6330     DRAW_BODY X(P),Y(P),W,FACING(P),ROW,CELL
6340     FOR S=1 TO 3
6341       IF SHOT(P,S) THEN DRAW_BOLT P,S
6342     NEXT S
6350   NEXT P
6360   FX_DRAW
6370   IF SPARK_T>0 THEN
6380     SPARK_T=MAX(0,SPARK_T-DT*60)
6390     DRAW_LINE_EX(SPARK_X-14,SPARK_Y,SPARK_X+14,SPARK_Y,2,SPARK_COLOR$)
6400     DRAW_LINE_EX(SPARK_X,SPARK_Y-14,SPARK_X,SPARK_Y+14,2,SPARK_COLOR$)
6410     FILL_CIRCLE(SPARK_X,SPARK_Y,3,"BLIP_WHITE")
6420   END IF
6430   DRAW_HUD
6440   IF INTRO>20 THEN
6445     IF MODE=1 THEN DRAW_TEXT("FIGHT "+STR$(OPPONENT_INDEX)+" OF "+STR$(RUNGS),320,100,2,"BLIP_WHITE","CENTER","BLIP_BLACK")
6450     DRAW_TEXT("ROUND "+STR$(ROUNDS(1)+ROUNDS(2)+1),320,128,4,"#FFE08A","CENTER","BLIP_BLACK")
6460   ELSEIF INTRO>0 THEN
6470     DRAW_TEXT("FIGHT!",320,128,6,"#FF744E","CENTER","BLIP_BLACK")
6480   END IF
6490   IF BANNER_T>0 THEN DRAW_TEXT(BANNER$,320,108,2,"BLIP_YELLOW","CENTER","BLIP_BLACK")
6500 END SUB
6510 SUB DRAW_SHADOW(P)
6520   LOCAL ROW,K,HALF,LIFT,W
6530   W=WHO(P)
6540   LIFT=CLAMP((FLOOR_Y-Y(P))/120,0,1)
6550   FOR ROW=0 TO 9
6560     K=(ROW+0.5)/5-1
6570     HALF=30*BULK(W)*SIZE(W)*(1-0.45*LIFT)*SQR(1-K*K)
6580     FILL_RECT(X(P)-HALF,FLOOR_Y-4+ROW,HALF*2,1,COLOR(0,0,0,0.34*(1-0.4*LIFT)))
6590   NEXT ROW
6600 END SUB
6610 SUB DRAW_BODY(CX,CY,W,FACE,ROW,CELL)
6620   DRAW_TEXTURE(ASSETS$+NAME$(W)+".PNG",CX-CELL_W(W)/2,CY-FEET(W),CELL_W(W)*FACE,CELL_H(W),CELL*CELL_W(W),ROW*CELL_H(W),CELL_W(W),CELL_H(W))
6630 END SUB
6640 SUB DRAW_BOLT(P,S)
6650   LOCAL W,U,V,A,I
6660   W=WHO(P)
6670   U=SHOT_X(P,S):V=SHOT_Y(P,S)
6680   IF W=7 THEN
6690     FILL_CIRCLE(U,V,10,"#D79636")
6700     FILL_CIRCLE(U,V,7,"#FFE091")
6710     FOR I=0 TO 2
6720       A=NOW*14+I*2.094
6730       FILL_CIRCLE(U+COS(A)*4,V+SIN(A)*4,2,"#C83E36")
6740     NEXT I
6750   ELSEIF W=4 THEN
6760     FOR I=0 TO 3
6770       A=NOW*18+I*1.571
6780       DRAW_LINE_EX(U,V,U+COS(A)*13,V+SIN(A)*13,3,"#D8F5FF")
6790     NEXT I
6800   ELSEIF W=8 THEN
6810     DRAW_CIRCLE(U,V,10,"BLIP_WHITE",1)
6820     DRAW_LINE(U-14,V,U+14,V,"BLIP_WHITE")
6830     DRAW_LINE(U,V-14,U,V+14,"BLIP_WHITE")
6840   ELSEIF SPECIAL_KIND(W)=4 THEN
6850     DRAW_LINE_EX(U-SHOT_FACE(P,S)*42,V,U,V,7,"#FF3B49")
6860     DRAW_LINE_EX(U-SHOT_FACE(P,S)*42,V,U,V,2,"BLIP_WHITE")
6865   ELSEIF W=15 THEN
6866     FILL_GLOW_CIRCLE(U,V,8,"#FFAE4080")
6867     DRAW_LINE_EX(U-SHOT_FACE(P,S)*27,V,U,V,8,"#FFA838")
6868     FILL_RECT(U-3.5,V-1.5,7,3,"BLIP_WHITE")
6870   ELSE
6880     FILL_GLOW_CIRCLE(U,V,17,"#48D7FFA0")
6890     FILL_CAPSULE(U-SHOT_FACE(P,S)*18,V,U,V,3,8,"#76E4FF")
6900     FILL_CIRCLE(U,V,5,"BLIP_WHITE")
6910   END IF
6920 END SUB
6930 REM --- HUD - HEALTH DRAINS TOWARD THE CLOCK, WITH A DELAYED DAMAGE BAR ---
6940 SUB DRAW_HUD
6950   LOCAL P,U,H,G,I,NX,PX,W,R,B,V,MOOD,INK$,TIME_INK$
6960   FOR P=1 TO 2
6970     W=WHO(P)
6980     U=50+(P-1)*306
6990     H=MAX(0,HEALTH(P))/MAX_HP(W)*234
7000     G=GHOST(P)/MAX_HP(W)*234
7010     R=0.95:V=0.85:B=0.20
7020     IF HEALTH(P)<MAX_HP(W)*0.45 THEN V=0.55:B=0.15
7030     IF HEALTH(P)<MAX_HP(W)*0.20 THEN V=0.25:B=0.20
7040     INK$=COLOR(R,V,B)
7050     FILL_RECT(U-2,20,238,20,"#19191F")
7060     FILL_RECT(U,22,234,16,"#590F0F")
7070     NX=U
7080     IF P=1 THEN
7090       FILL_RECT(U+234-G,22,G,16,"#FFEBD8")
7100       NX=U+234-H
7110     ELSE
7120       FILL_RECT(U,22,G,16,"#FFEBD8")
7130     END IF
7140     FILL_RECT(NX,22,H,16,INK$)
7150     FILL_RECT(NX,22,H,3,COLOR(LERP(R,1,0.45),LERP(V,1,0.45),LERP(B,1,0.45)))
7160     FILL_RECT(NX,34,H,4,COLOR(R*0.78,V*0.78,B*0.78))
7170     DRAW_RECT(U,22,234,16,"#CCCCD9")
7180     NX=U
7190     IF P=2 THEN NX=590-LEN(NAME$(W))*12
7200     DRAW_TEXT(NAME$(W),NX,44,2,"BLIP_WHITE","LEFT","BLIP_BLACK")
7205     IF MODE=1 AND P=1 THEN DRAW_TEXT(STR$(SCORE),50,64,2,"#F5D788","LEFT","BLIP_BLACK")
7210     PX=16+(P-1)*578
7220     MOOD=0
7230     IF GHOST(P)>HEALTH(P)+0.5 OR HEALTH(P)=0 THEN MOOD=1
7240     FILL_RECT(PX-2,13,34,34,"#16131C")
7250     DRAW_TEXTURE(ASSETS$+"PORTRAITS.PNG",PX,15,30*(3-2*P),30,(W-1)*30,MOOD*30,30,30)
7260     DRAW_RECT(PX,15,30,30,TRIM$(W))
7270     FOR I=1 TO 2
7280       IF P=1 THEN PX=U+224-(I-1)*14 ELSE PX=U+10+(I-1)*14
7290       FILL_CIRCLE(PX,48,5.5,"#16131C")
7300       INK$="#404047"
7310       IF I<=ROUNDS(P) THEN INK$="BLIP_YELLOW"
7320       FILL_CIRCLE(PX,48,4,INK$)
7330     NEXT I
7340   NEXT P
7345   TIME_INK$="BLIP_WHITE"
7346   IF CLOCK<=10 THEN TIME_INK$="#FF594D"
7350   DRAW_TEXT(STR$(MAX(0,INT(CLOCK+0.99))),320,18,4,TIME_INK$,"CENTER","BLIP_BLACK")
7359   FILL_RECT(320-LEN(STAGE_NAME$(STAGE))*6-5,60,LEN(STAGE_NAME$(STAGE))*12+10,20,"#14131DBF")
7360   DRAW_TEXT(STAGE_NAME$(STAGE),320,64,2,"BLIP_WHITE","CENTER","BLIP_BLACK")
7390 END SUB
7400 SUB DRAW_RESULT
7410   LOCAL HEAD$,NEXT$,INK$
7420   HEAD$="DRAW GAME":INK$="BLIP_WHITE"
7430   IF WINNER=1 THEN
7440     HEAD$="YOU WIN"
7441     IF MODE=2 THEN HEAD$="PLAYER 1 WINS"
7450     INK$="#FFE080"
7460   END IF
7470   IF WINNER=2 THEN HEAD$=NAME$(WHO(2))+" WINS"
7471   IF MODE=2 AND WINNER=2 THEN HEAD$="PLAYER 2 WINS"
7480   IF MODE=1 AND STATE$="OVER" AND ROUNDS(1)>=2 AND OPPONENT_INDEX=RUNGS THEN HEAD$="CHAMPION!"
7490   FILL_RECT(0,98,640,76,"#101222C0")
7500   DRAW_TEXT(HEAD$,320,112,5,INK$,"CENTER","BLIP_BLACK")
7510   IF CLOCK<=0 THEN DRAW_TEXT("TIME UP",320,178,2,"BLIP_YELLOW","CENTER","BLIP_BLACK")
7520   IF RESULT_WAIT=0 THEN
7530     NEXT$="PUNCH FOR NEXT ROUND"
7540     IF STATE$="OVER" THEN NEXT$="PUNCH FOR NEXT BOUT"
7541     IF MODE=2 THEN NEXT$="PUNCH OR KICK TO RETURN"
7550     IF MODE=1 AND STATE$="OVER" AND ROUNDS(2)>=2 THEN NEXT$="PUNCH TO CHOOSE AGAIN"
7560     DRAW_TEXT(NEXT$,320,352,2,"BLIP_WHITE","CENTER","BLIP_BLACK")
7570   END IF
7580 END SUB
7590 REM --- TABLES - THE ROSTER AND MOVE_DATA FROM RUST, IN THE SAME ORDER ---
7600 SUB LOAD_MOVES
7610   LOCAL M
7620   RESTORE 61000
7630   FOR M=1 TO 8
7640     READ MOVE_NAME$(M),STARTUP(M),ACTIVE(M),RECOVERY(M),DAMAGE(M)
7650     READ HITSTUN(M),BLOCKSTUN(M),REACH(M),MOVE_HEIGHT(M),LEVEL(M),POSE_ROW(M)
7660   NEXT M
7670 END SUB
7680 SUB LOAD_ROSTER
7690   LOCAL W
7700   RESTORE 62000
7710   FOR W=1 TO FIGHTERS
7720     READ NAME$(W),MAX_HP(W),WALK(W),POWER(W),ARM_REACH(W),JUMP_SCALE(W)
7730     READ SPECIAL_KIND(W),SPECIAL_NAME$(W),POWER_DESC$(W),HOME(W),SIZE(W),TRIM$(W)
7740     READ CELL_W(W),CELL_H(W),FEET(W),IDLE_RATE(W),BULK(W),BOSS(W)
7750   NEXT W
7760   RESTORE 63000
7770   FOR W=1 TO 8
7780     READ STAGE_NAME$(W),THEME$(W)
7790   NEXT W
7800 END SUB
8000 REM --- INPUT - LATCH PRESSES UNTIL THE NEXT SIMULATION STEP ---
8010 SUB READ_KEYS
8020   FIRE_HELD(1)=KEY_ACTIVE("F") OR KEY_ACTIVE("SPACE") OR KEY_ACTIVE("G") OR KEY_ACTIVE("Z") OR KEY_ACTIVE("BUTTON2")
8030   FIRE_HELD(2)=KEY_ACTIVE("J") OR KEY_ACTIVE("K")
8040   IF MODE=2 AND (STATE$="SELECT" OR STATE$="PLAY" OR STATE$="ROUND" OR STATE$="OVER") THEN
8050     MOVE(1)=KEY_ACTIVE("D")-KEY_ACTIVE("A")
8060     LOW(1)=KEY_ACTIVE("S")
8070     JUMPING(1)=JUMPING(1) OR KEY_PRESSED("W")
8080     PUNCH(1)=PUNCH(1) OR KEY_PRESSED("F") OR KEY_PRESSED("SPACE")
8090     KICK(1)=KICK(1) OR KEY_PRESSED("G") OR KEY_PRESSED("Z")
8100     MOVE(2)=KEY_ACTIVE("RIGHT")-KEY_ACTIVE("LEFT")
8110     LOW(2)=KEY_ACTIVE("DOWN")
8120     JUMPING(2)=JUMPING(2) OR KEY_PRESSED("UP")
8130     PUNCH(2)=PUNCH(2) OR KEY_PRESSED("J")
8140     KICK(2)=KICK(2) OR KEY_PRESSED("K")
8150     GUARD(1)=MOVE(1)*FACING(1)<0
8155     GUARD(2)=MOVE(2)*FACING(2)<0
8160   ELSE
8170     LEFT=KEY_ACTIVE("LEFT") OR KEY_ACTIVE("A")
8180     RIGHT=KEY_ACTIVE("RIGHT") OR KEY_ACTIVE("D")
8200     JUMPING(1)=JUMPING(1) OR KEY_PRESSED("UP") OR KEY_PRESSED("W")
8210     PUNCH(1)=PUNCH(1) OR KEY_PRESSED("SPACE") OR KEY_PRESSED("F")
8220     KICK(1)=KICK(1) OR KEY_PRESSED("BUTTON2") OR KEY_PRESSED("G") OR KEY_PRESSED("Z")
8230     MOVE(1)=RIGHT-LEFT
8240     LOW(1)=KEY_ACTIVE("DOWN") OR KEY_ACTIVE("S")
8250     MOVE(2)=0
8260     GUARD(1)=MOVE(1)*FACING(1)<0
8270   END IF
8280 END SUB
12600 SUB DRAW_SELECT_VERSUS
12610   LOCAL I,CX,CY,INK$,TEXT$,LIT1,LIT2
12620   DRAW_TEXTURE(ASSETS$+"STAGE_"+STR$(HOME(PICK2))+".PNG",0,-94,640,400)
12630   FILL_RECT(0,0,640,250,"#080B1B70")
12640   FILL_RECT(0,250,640,150,"#080B1BE8")
12650   DRAW_TEXT("CHOOSE YOUR FIGHTERS",320,20,3,"#E6DC32","CENTER","#42182C")
12660   DRAW_BODY 84,236,PICK,1,0,INT(NOW*IDLE_RATE(PICK)*6/6.283) MOD 6
12670   DRAW_BODY 556,236,PICK2,-1,0,INT(NOW*IDLE_RATE(PICK2)*6/6.283) MOD 6
12680   DRAW_VERSUS_INFO PICK,164,1
12690   DRAW_VERSUS_INFO PICK2,356,2
12700   FOR I=1 TO FIGHTERS
12710     CX=10+((I-1) MOD 8)*78
12715     CY=250+INT((I-1)/8)*48
12720     INK$="#55556D":TEXT$="#9298AA"
12730     IF I=PICK THEN INK$="#FF5959"
12735     IF I=PICK THEN TEXT$="BLIP_WHITE"
12740     IF I=PICK2 THEN INK$="#66B8FF"
12745     IF I=PICK2 THEN TEXT$="BLIP_WHITE"
12750     IF I=PICK AND I=PICK2 THEN INK$="BLIP_WHITE"
12760     FILL_RECT(CX,CY,74,44,"#252638")
12770     DRAW_TEXTURE(ASSETS$+"PORTRAITS.PNG",CX+22,CY+1,30,30,(I-1)*30,0,30,30)
12780     FILL_RECT(CX,CY+29,74,15,"#12131D")
12790     DRAW_TEXT(NAME$(I),CX+37,CY+30,1,TEXT$,"CENTER")
12800     DRAW_RECT(CX,CY,74,44,INK$)
12810   NEXT I
12815   LIT1=0.45+0.55*MAX(0,SIN(NOW*5))
12819   LIT2=LIT1
12820   DRAW_TEXT("BACK GUARDS   BOTH BUTTONS: SPECIAL",320,348,2,"#D0D1D8","CENTER")
12822   IF LOCKED(1) THEN LIT1=1
12823   IF LOCKED(2) THEN LIT2=1
12830   IF LOCKED(1) THEN DRAW_TEXT("P1 READY",164,82,2,COLOR(1,0.35,0.35,LIT1),"CENTER") ELSE DRAW_TEXT("P1",164,82,2,COLOR(1,0.35,0.35,LIT1),"CENTER")
12840   IF LOCKED(2) THEN DRAW_TEXT("P2 READY",356,82,2,COLOR(0.40,0.72,1,LIT2),"CENTER") ELSE DRAW_TEXT("P2",356,82,2,COLOR(0.40,0.72,1,LIT2),"CENTER")
12850   IF LOCKED(1) AND LOCKED(2) THEN DRAW_TEXT("FIGHT!",320,374,2,"BLIP_WHITE","CENTER") ELSE DRAW_TEXT("PRESS TO LOCK IN",320,374,2,"BLIP_WHITE","CENTER")
12860 END SUB
12900 SUB DRAW_VERSUS_INFO(W,TX,P)
12910   LOCAL POWER_TEXT$,POWER_TENTH,SIZE
12920   FILL_RECT(TX-8,100,184,136,"#080B1BD8")
12930   DRAW_TEXT(NAME$(W),TX,112,2,TRIM$(W))
12940   SIZE=2
12945   IF LEN(SPECIAL_NAME$(W))>14 THEN SIZE=1
12950   DRAW_TEXT(SPECIAL_NAME$(W),TX,146,SIZE,"#D0D1D8")
12960   SIZE=2
12965   IF LEN(POWER_DESC$(W))>14 THEN SIZE=1
12970   DRAW_TEXT(POWER_DESC$(W),TX,162,SIZE,TRIM$(W))
12980   SIZE=2
12985   IF LEN(STAGE_NAME$(HOME(W)))>14 THEN SIZE=1
12990   DRAW_TEXT(STAGE_NAME$(HOME(W)),TX,178,SIZE,"#9298AA")
13000   DRAW_TEXT("PWR",TX,194,2,"#D0D1D8")
13010   FILL_RECT(TX+46,196,60*MIN(1.25,POWER(W)/1.45),8,TRIM$(W))
13020   DRAW_RECT(TX+46,196,60,8,"#686A78")
13030   POWER_TENTH=INT(POWER(W)*10+0.499999)
13040   POWER_TEXT$=STR$(INT(POWER_TENTH/10))+"."+STR$(POWER_TENTH MOD 10)
13050   DRAW_TEXT(POWER_TEXT$+"X",TX+130,194,2,"#D0D1D8")
13060   DRAW_TEXT("SPD",TX,208,2,"#D0D1D8")
13070   FILL_RECT(TX+46,210,60*MIN(1.25,WALK(W)/250),8,TRIM$(W))
13080   DRAW_RECT(TX+46,210,60,8,"#686A78")
13090   DRAW_TEXT(STR$(WALK(W)),TX+130,208,2,"#D0D1D8")
13100   DRAW_TEXT("HP",TX,222,2,"#D0D1D8")
13110   FILL_RECT(TX+46,224,60*MIN(1.25,MAX_HP(W)/130),8,TRIM$(W))
13120   DRAW_RECT(TX+46,224,60,8,"#686A78")
13130   DRAW_TEXT(STR$(MAX_HP(W)),TX+130,222,2,"#D0D1D8")
13140 END SUB
