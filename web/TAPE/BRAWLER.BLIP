1 REM BRAWLER - PICK A FIGHTER AND WIN NINE MATCHES, BEST OF THREE ROUNDS EACH.
2 REM GAME: BRAWLER
3 REM ARROWS OR WASD MOVE, UP JUMPS, DOWN GUARDS. SPACE/F PUNCHES, Z/G KICKS,
4 REM AND PUNCH WITH KICK TOGETHER IS YOUR FIGHTER'S SPECIAL MOVE.
5 REM SCREENS: TITLE (CHOOSE A FIGHTER), PLAY (THE FIGHT), ROUND (WHO TOOK IT), OVER
6 REM (WHO TOOK THE MATCH). EACH SCREEN HAS AN UPDATE AND A DRAW.
7 REM THE FIGHT RUNS IN STEPS OF 1/60 SECOND, SO EVERY MOVE IS COUNTED IN STEPS.
10 REM --- SETUP ---
11 ASSETS$="/TAPE/BRAWLER/ASSETS/"
15 GROUND=330:STAND_Y=234
20 LEFT_WALL=36:RIGHT_WALL=604
25 ROUND_SECONDS=45:MATCHES=9
30 LOAD_ROSTER
35 PICK=1
80 PLAY_MUSIC ASSETS$+"DOCK.WAV"
85 STATE$="TITLE"
90 LAST_TIME=TIME()
100 REM --- MAIN LOOP - UPDATE THE SCREEN WE ARE ON, THEN DRAW IT ---
110 NOW=TIME()
111 DT=CLAMP(NOW-LAST_TIME,0.0001,0.1)
112 LAST_TIME=NOW
120 READ_KEYS
130 IF STATE$="TITLE" THEN
131   UPDATE_TITLE
132 ELSEIF STATE$="PLAY" THEN
133   UPDATE_PLAY
134 ELSEIF STATE$="ROUND" THEN
135   UPDATE_ROUND
136 ELSE
137   UPDATE_OVER
138 END IF
150 IF STATE$="TITLE" THEN
151   DRAW_TITLE
152 ELSEIF STATE$="PLAY" THEN
153   DRAW_PLAY
154 ELSEIF STATE$="ROUND" THEN
155   DRAW_ROUND
156 ELSE
157   DRAW_OVER
158 END IF
170 WAIT 0
180 GOTO 110
1000 REM --- TITLE - LEFT AND RIGHT CHOOSE A FIGHTER; ANY ATTACK BUTTON STARTS ---
1010 SUB UPDATE_TITLE
1020   CHOOSE_WAIT=MAX(0,CHOOSE_WAIT-DT)
1030   IF CHOOSE_WAIT=0 AND (HOLD_LEFT OR HOLD_RIGHT) THEN
1032     IF HOLD_LEFT THEN PICK=(PICK+8) MOD 10+1 ELSE PICK=PICK MOD 10+1
1034     CHOOSE_WAIT=0.17
1036   END IF
1050   IF PUNCH_HELD OR KICK_HELD THEN START_GAME
1060 END SUB
1100 SUB DRAW_TITLE
1110   LOCAL T,K,A
1120   T=TIME()
1130   CLEAR("#100A18")
1140   FILL_RECT(0,232,640,168,"#21152B")
1150   DRAW_LINE(0,232,640,232,"#59384B")
1160   REM SIX SPOTLIGHTS SWEEP SLOWLY ROUND THE ARENA
1170   FOR K=0 TO 5
1180     A=T*0.12+K*0.8
1190     DRAW_LINE_EX(320+COS(A)*100,100+SIN(A)*44,320+COS(A)*460,100+SIN(A)*460,4,"#60304A80")
1200   NEXT K
1205   DRAW_SHADOW 166
1210   DRAW_FIGHTER 166,STAND_Y-ABS(SIN(T*2.4))*4,PICK,1,0,0
1215   DRAW_SHADOW 486
1220   DRAW_FIGHTER 486,STAND_Y-ABS(SIN(T*2.4+1.6))*4,2,-1,0,0
1230   DRAW_TEXT("BRAWLER",320,30,6,"#FF4B83","CENTER","#210D2A")
1240   DRAW_TEXT("CHOOSE "+NAME$(PICK),320,112,3,"BLIP_CYAN","CENTER")
1250   DRAW_TEXT(SPECIAL_NAME$(PICK),320,146,2,TRIM$(PICK),"CENTER")
1260   DRAW_TEXT(CONTROL_TEXT$("LEFT/RIGHT CHOOSE, UP JUMPS","STICK CHOOSES, UP JUMPS","DRAG TO CHOOSE"),320,178,2,"BLIP_WHITE","CENTER")
1270   DRAW_TEXT("SPACE/F PUNCH  Z/G KICK  BOTH SPECIAL",320,372,2,"BLIP_YELLOW","CENTER")
1280 END SUB
2000 REM --- START - A RUN OF NINE MATCHES, EACH MATCH, AND EACH ROUND ---
2010 SUB START_GAME
2020   BUILD_LADDER
2030   MATCH=1
2040   START_MATCH
2050 END SUB
2100 SUB START_MATCH
2110   YOUR_ROUNDS=0:RIVAL_ROUNDS=0
2120   START_ROUND
2130 END SUB
2200 SUB START_ROUND
2210   RIVAL=LADDER(MATCH)
2220   YOUR_HP=MAX_HP(PICK):RIVAL_HP=MAX_HP(RIVAL)
2230   YOU_X=160:RIVAL_X=484
2240   YOU_Y=STAND_Y:YOU_VY=0
2250   YOUR_WAIT=0:RIVAL_WAIT=25
2260   ATTACK=0:ATTACK_KIND=0:LANDED=1
2270   PUNCH_BUFFER=0:KICK_BUFFER=0
2280   RIVAL_WINDUP=0
2290   SPECIAL=0:RUSH=0
2300   BLOCK_FLASH=0:HURT_FLASH=0:RIVAL_FLASH=0
2310   ROUND_TIME=ROUND_SECONDS
2320   STEP_CLOCK=0
2330   STATE$="PLAY"
2340 END SUB
2400 REM THE NINE OPPONENTS: EVERYONE BUT YOU, NEVER TWO IN A ROW FROM THE SAME
2401 REM STAGE, WITH GAMMA THEN ZENITH (THE GIANT, THEN THE INVINCIBLE) LAST
2410 SUB BUILD_LADDER
2420   LOCAL I
2430   FOR I=1 TO 9
2440     RING(I)=(PICK+I-1) MOD 10+1
2450   NEXT I
2460   FOR I=1 TO 10:USED(I)=0:NEXT I
2470   IF PICK=9 OR PICK=10 THEN FINALS=1 ELSE FINALS=2
2480   LADDER_DONE=0
2490   PLACE 1
2500 END SUB
2600 REM TRY EACH OPPONENT IN TURN FOR RUNG DEPTH; BACK OFF IF THE REST WILL NOT FIT
2610 SUB PLACE(DEPTH)
2620   LOCAL K,WHO
2630   IF DEPTH>MATCHES THEN LADDER_DONE=1:EXIT SUB
2640   FOR K=1 TO 9
2650     WHO=RING(K)
2660     CHECK_RUNG DEPTH,WHO
2670     IF FITS THEN
2680       LADDER(DEPTH)=WHO
2690       USED(WHO)=1
2700       PLACE DEPTH+1
2710       IF LADDER_DONE THEN EXIT SUB
2720       USED(WHO)=0
2730     END IF
2740   NEXT K
2750 END SUB
2800 SUB CHECK_RUNG(DEPTH,WHO)
2810   FITS=NOT USED(WHO)
2820   IF DEPTH<=MATCHES-FINALS AND (WHO=9 OR WHO=10) THEN FITS=0
2830   IF DEPTH>MATCHES-FINALS AND PICK=9 AND WHO<>10 THEN FITS=0
2840   IF DEPTH>MATCHES-FINALS AND PICK=10 AND WHO<>9 THEN FITS=0
2850   IF DEPTH=8 AND PICK<9 AND WHO<>9 THEN FITS=0
2860   IF DEPTH=9 AND PICK<9 AND WHO<>10 THEN FITS=0
2870   IF DEPTH>1 THEN
2880     IF HOME(WHO)=HOME(LADDER(DEPTH-1)) THEN FITS=0
2890   END IF
2900 END SUB
3000 REM --- FIGHT - THE CLOCK RUNS ON REAL TIME; THE FIGHTERS MOVE IN FIXED STEPS ---
3010 SUB UPDATE_PLAY
3020   ROUND_TIME=ROUND_TIME-DT
3030   STEP_CLOCK=STEP_CLOCK+DT
3040   WHILE STEP_CLOCK>=1/60
3050     STEP_CLOCK=STEP_CLOCK-1/60
3060     STEP_FIGHT
3070   WEND
3080   IF YOUR_HP<1 OR RIVAL_HP<1 OR ROUND_TIME<=0 THEN END_ROUND
3090 END SUB
3100 SUB STEP_FIGHT
3110   BLOCK_FLASH=MAX(0,BLOCK_FLASH-1)
3120   HURT_FLASH=MAX(0,HURT_FLASH-1)
3130   RIVAL_FLASH=MAX(0,RIVAL_FLASH-1)
3140   MOVE_YOU
3150   YOUR_ATTACKS
3160   MOVE_RIVAL
3170   RIVAL_ATTACKS
3180 END SUB
3200 SUB MOVE_YOU
3210   IF HOLD_LEFT AND YOU_X>LEFT_WALL THEN YOU_X=YOU_X-2*SPEED(PICK)
3220   IF HOLD_RIGHT AND YOU_X<RIGHT_WALL THEN YOU_X=YOU_X+2*SPEED(PICK)
3230   IF JUMP_PRESSED AND YOU_Y=STAND_Y THEN
3240     YOU_VY=-2*JUMP(PICK)
3250     PLAY_SFX ASSETS$+"WHOOSH.WAV"
3260   END IF
3270   YOU_Y=YOU_Y+YOU_VY
3280   YOU_VY=YOU_VY+0.58
3290   IF YOU_Y>STAND_Y THEN YOU_Y=STAND_Y:YOU_VY=0
3300 END SUB
3400 REM A PUNCH OR KICK PRESSED WITHIN SIX STEPS OF THE OTHER IS THE SPECIAL MOVE
3410 SUB YOUR_ATTACKS
3420   YOUR_WAIT=YOUR_WAIT-1
3430   ATTACK=ATTACK-1
3440   PUNCH_BUFFER=MAX(0,PUNCH_BUFFER-1)
3450   KICK_BUFFER=MAX(0,KICK_BUFFER-1)
3460   IF PUNCH_PRESSED THEN PUNCH_BUFFER=6
3470   IF KICK_PRESSED THEN KICK_BUFFER=6
3480   IF (PUNCH_PRESSED AND KICK_BUFFER>0) OR (KICK_PRESSED AND PUNCH_BUFFER>0) THEN
3490     START_SPECIAL
3500   ELSEIF PUNCH_PRESSED AND YOUR_WAIT<1 THEN
3510     START_ATTACK 1,17,ASSETS$+"WHOOSH.WAV"
3520   ELSEIF KICK_PRESSED AND YOUR_WAIT<1 THEN
3530     START_ATTACK 2,19,ASSETS$+"SWING.WAV"
3540   END IF
3550   REM A PUNCH LANDS FIVE TO SEVEN STEPS IN, A KICK SIX TO EIGHT, ONCE
3560   IF ATTACK_KIND=1 AND ATTACK<=12 AND ATTACK>=10 THEN STRIKE 86*REACH(PICK),5,ASSETS$+"HIT_LIGHT.WAV"
3570   IF ATTACK_KIND=2 AND ATTACK<=13 AND ATTACK>=11 THEN STRIKE 104*REACH(PICK),7,ASSETS$+"HIT_HEAVY.WAV"
3580   IF SPECIAL THEN MOVE_SPECIAL
3590 END SUB
3600 SUB START_ATTACK(KIND,STEPS,SOUND$)
3610   ATTACK_KIND=KIND
3620   ATTACK=STEPS:YOUR_WAIT=STEPS
3630   LANDED=0
3640   PLAY_SFX SOUND$
3650 END SUB
3700 SUB STRIKE(REACH,DAMAGE,SOUND$)
3710   IF LANDED OR ABS(RIVAL_X-YOU_X)>=REACH THEN EXIT SUB
3720   RIVAL_HP=RIVAL_HP-DAMAGE*POWER(PICK)
3730   RIVAL_FLASH=7
3740   LANDED=1
3750   PLAY_SFX SOUND$
3760 END SUB
3800 REM --- SPECIAL MOVES - ELEVEN STEPS TO WIND UP, THEN EACH FIGHTER'S OWN ---
3810 REM 1 CHI BOLT, 2 BULL RUSH, 3 TALON KICK, 4 LASER, 5 WEB, 6 SHURIKEN, 7 PIZZA
3820 SUB START_SPECIAL
3830   YOUR_WAIT=43
3840   ATTACK=18:ATTACK_KIND=3
3850   SPECIAL=1:SPECIAL_TIME=0:SPECIAL_HIT=0
3860   SHOT_X=YOU_X+40:SHOT_Y=YOU_Y+48
3870   PUNCH_BUFFER=0:KICK_BUFFER=0
3880   PLAY_SFX ASSETS$+"WHOOSH.WAV"
3890 END SUB
3900 SUB MOVE_SPECIAL
3910   LOCAL KIND
3920   KIND=SPECIAL_KIND(PICK)
3930   SPECIAL_TIME=SPECIAL_TIME+1
3940   IF SPECIAL_TIME=11 AND KIND=3 THEN YOU_VY=-2*JUMP(PICK)*0.82
3950   IF SPECIAL_TIME=11 AND KIND<>2 AND KIND<>3 THEN SHOT_X=YOU_X+40
3960   IF SPECIAL_TIME<=11 THEN EXIT SUB
3970   IF KIND=2 THEN
3980     YOU_X=YOU_X+12.8
3990     IF ABS(RIVAL_X-YOU_X)<60 THEN SPECIAL_LANDS
4000     IF SPECIAL_TIME>32 THEN SPECIAL=0
4010   ELSEIF KIND=3 THEN
4020     YOU_X=YOU_X+9.2
4030     IF ABS(RIVAL_X-YOU_X)<72 THEN SPECIAL_LANDS
4040     IF SPECIAL_TIME>31 THEN SPECIAL=0
4050   ELSE
4060     SHOT_X=SHOT_X+2*SPECIAL_SPEED(PICK)
4070     IF SHOT_X>RIVAL_X-30 THEN
4072       SPECIAL_LANDS
4074       SPECIAL=0
4076     END IF
4080     IF SHOT_X>636 THEN SPECIAL=0
4090   END IF
4100   YOU_X=CLAMP(YOU_X,LEFT_WALL,RIGHT_WALL)
4110 END SUB
4200 REM A SPECIAL LANDS ONCE, FOR SIXTEEN TIMES YOUR POWER; THE WEB ALSO HOLDS THE RIVAL
4210 SUB SPECIAL_LANDS
4220   IF SPECIAL_HIT THEN EXIT SUB
4230   SPECIAL_HIT=1
4240   RIVAL_HP=RIVAL_HP-16*POWER(PICK)
4250   RIVAL_FLASH=12
4260   PLAY_SFX ASSETS$+"HIT_HEAVY.WAV"
4270   IF SPECIAL_KIND(PICK)=5 THEN RIVAL_WAIT=RIVAL_WAIT+24
4280 END SUB
4400 REM --- THE RIVAL - IT KEEPS JUST IN REACH, WINDS UP FOR SIX STEPS, THEN STRIKES ---
4410 SUB MOVE_RIVAL
4420   IF RIVAL_X>YOU_X+54 THEN RIVAL_X=RIVAL_X-2*SPEED(RIVAL)
4430   IF RIVAL_X<YOU_X+50 THEN RIVAL_X=RIVAL_X+2*SPEED(RIVAL)
4440   RIVAL_X=CLAMP(RIVAL_X,LEFT_WALL,RIGHT_WALL)
4450 END SUB
4500 SUB RIVAL_ATTACKS
4510   LOCAL IN_REACH
4520   RIVAL_WAIT=RIVAL_WAIT-1
4530   IN_REACH=ABS(RIVAL_X-YOU_X)<54 AND YOU_Y>216
4540   IF RIVAL_WINDUP>0 THEN
4550     RIVAL_WINDUP=RIVAL_WINDUP-1
4560     IF RIVAL_WINDUP=0 THEN RIVAL_STRIKES IN_REACH
4570   ELSEIF IN_REACH AND RIVAL_WAIT<1 THEN
4580     RIVAL_WINDUP=6
4590     PLAY_SFX ASSETS$+"WHOOSH.WAV"
4600   END IF
4610 END SUB
4700 REM DOWN GUARDS: A BLOCKED BLOW DOES NO DAMAGE AT ALL
4710 SUB RIVAL_STRIKES(IN_REACH)
4720   RIVAL_WAIT=17
4730   IF NOT IN_REACH THEN EXIT SUB
4740   IF GUARD THEN
4750     BLOCK_FLASH=10
4760     PLAY_SFX ASSETS$+"BLOCK.WAV"
4770   ELSE
4780     YOUR_HP=YOUR_HP-5*POWER(RIVAL)
4790     HURT_FLASH=10
4800     PLAY_SFX ASSETS$+"HIT_LIGHT2.WAV"
4810   END IF
4820 END SUB
5000 REM --- ROUND AND OVER - TWO ROUNDS WIN A MATCH; A DRAWN ROUND COUNTS FOR BOTH ---
5010 SUB END_ROUND
5020   IF YOUR_HP>=RIVAL_HP THEN YOUR_ROUNDS=YOUR_ROUNDS+1
5030   IF RIVAL_HP>=YOUR_HP THEN RIVAL_ROUNDS=RIVAL_ROUNDS+1
5040   IF YOUR_HP<RIVAL_HP THEN
5050     PLAY_SFX ASSETS$+"KO.WAV"
5060   ELSE
5070     PLAY_SFX ASSETS$+"BELL.WAV"
5080   END IF
5090   TIME_UP=ROUND_TIME<=0 AND YOUR_HP>0 AND RIVAL_HP>0
5100   IF YOUR_ROUNDS>=2 OR RIVAL_ROUNDS>=2 THEN STATE$="OVER" ELSE STATE$="ROUND"
5110 END SUB
5200 SUB UPDATE_ROUND
5210   IF PUNCH_PRESSED OR KICK_PRESSED THEN START_ROUND
5220 END SUB
5300 SUB DRAW_ROUND
5310   LOCAL ROUND$
5320   ROUND$="ROUND "+STR$(YOUR_ROUNDS+RIVAL_ROUNDS)+" COMPLETE"
5330   SHOW_RESULT ROUND$,"BLIP_CYAN","FOR THE NEXT ROUND"
5340 END SUB
5400 REM A WON MATCH MOVES UP THE LADDER; A LOST ONE IS FOUGHT AGAIN
5410 SUB UPDATE_OVER
5420   IF NOT (PUNCH_PRESSED OR KICK_PRESSED) THEN EXIT SUB
5430   IF RIVAL_ROUNDS>=2 THEN
5440     START_MATCH
5450   ELSEIF MATCH<MATCHES THEN
5460     MATCH=MATCH+1
5470     START_MATCH
5480   ELSE
5490     START_GAME
5500   END IF
5510 END SUB
5600 SUB DRAW_OVER
5610   IF RIVAL_ROUNDS>=2 THEN
5620     SHOW_RESULT "MATCH LOST","BLIP_RED","TO RETRY THE FIGHT"
5630   ELSEIF MATCH<MATCHES THEN
5640     SHOW_RESULT "FIGHT WON","BLIP_YELLOW","FOR THE NEXT FIGHT"
5650   ELSE
5660     SHOW_RESULT "CHAMPION!","BLIP_YELLOW","FOR A NEW RUN"
5670   END IF
5680 END SUB
5700 SUB SHOW_RESULT(HEADLINE$,INK$,NEXT$)
5710   LOCAL SCORE$,PRESS$
5720   CLEAR("#100A18")
5730   IF TIME_UP THEN DRAW_TEXT("TIME UP",320,68,3,"BLIP_YELLOW","CENTER")
5740   DRAW_TEXT(HEADLINE$,320,116,5,INK$,"CENTER")
5750   SCORE$="YOU "+STR$(YOUR_ROUNDS)+"   "+NAME$(RIVAL)+" "+STR$(RIVAL_ROUNDS)
5760   DRAW_TEXT(SCORE$,320,216,3,"BLIP_WHITE","CENTER")
5770   PRESS$=CONTROL_TEXT$("PUNCH ","FIRE ","TAP ")
5780   DRAW_TEXT(PRESS$+NEXT$,320,308,2,"BLIP_GRAY","CENTER")
5790 END SUB
6000 REM --- DRAWING THE FIGHT ---
6010 SUB DRAW_PLAY
6020   DRAW_STAGE HOME(RIVAL)
6030   DRAW_SHADOW YOU_X
6040   DRAW_SHADOW RIVAL_X
6050   DRAW_FIGHTER RIVAL_X,STAND_Y,RIVAL,-1,4*(RIVAL_WINDUP>0),0
6060   DRAW_FIGHTER YOU_X,YOU_Y,PICK,1,ATTACK_KIND*(ATTACK>0),GUARD
6070   IF SPECIAL THEN DRAW_SPECIAL
6080   IF RIVAL_FLASH>0 THEN FILL_GLOW_CIRCLE(RIVAL_X,STAND_Y+46,18,"#FF5A50E0")
6090   IF BLOCK_FLASH>0 THEN
6100     FILL_GLOW_CIRCLE((YOU_X+RIVAL_X)/2,YOU_Y+48,18,"#48DFFFF0")
6110     FILL_CIRCLE((YOU_X+RIVAL_X)/2,YOU_Y+48,4,"BLIP_WHITE")
6120   END IF
6130   IF HURT_FLASH>0 THEN FILL_GLOW_CIRCLE((YOU_X+RIVAL_X)/2,YOU_Y+48,18,"#F04A5CF0")
6140   DRAW_BARS
6150 END SUB
6200 REM HEALTH EMPTIES TOWARD THE MIDDLE; THE CLOCK TURNS RED FOR ITS LAST TEN SECONDS
6210 SUB DRAW_BARS
6220   LOCAL YOURS,THEIRS,CLOCK
6230   YOURS=MAX(0,YOUR_HP)*200/MAX_HP(PICK)
6240   THEIRS=MAX(0,RIVAL_HP)*200/MAX_HP(RIVAL)
6250   FILL_RECT(50,22,200,16,"#572A34")
6260   FILL_RECT(390,22,200,16,"#572A34")
6270   FILL_RECT(250-YOURS,22,YOURS,16,"BLIP_CYAN")
6280   FILL_RECT(390,22,THEIRS,16,"BLIP_RED")
6290   DRAW_RECT(48,20,204,20,"#8AD9D6")
6300   DRAW_RECT(388,20,204,20,"#EA7778")
6310   DRAW_TEXT(NAME$(PICK),50,46,2,"BLIP_CYAN","LEFT","BLIP_BLACK")
6320   DRAW_TEXT(NAME$(RIVAL),590-LEN(NAME$(RIVAL))*12,46,2,"BLIP_RED","LEFT","BLIP_BLACK")
6330   CLOCK=MAX(0,INT(ROUND_TIME+0.999))
6340   DRAW_RECT(292,16,56,30,"#27242A")
6350   IF ROUND_TIME<=10 THEN DRAW_TEXT(STR$(CLOCK),320,20,3,"BLIP_RED","CENTER") ELSE DRAW_TEXT(STR$(CLOCK),320,20,3,"BLIP_WHITE","CENTER")
6360   DRAW_TEXT("MATCH "+STR$(MATCH)+"/9   ROUND "+STR$(YOUR_ROUNDS+RIVAL_ROUNDS+1),320,72,2,"BLIP_GRAY","CENTER","BLIP_BLACK")
6370 END SUB
6400 SUB DRAW_SHADOW(X)
6410   FILL_CAPSULE(X-22,GROUND+4,X+26,GROUND+4,4,4,"#00000066")
6420 END SUB
6500 SUB DRAW_SPECIAL
6510   LOCAL KIND
6520   KIND=SPECIAL_KIND(PICK)
6530   IF SPECIAL_TIME<=11 OR KIND=2 OR KIND=3 THEN EXIT SUB
6540   IF KIND=1 OR KIND=6 THEN
6550     FILL_GLOW_CIRCLE(SHOT_X,SHOT_Y,16,"#53DDF2C0")
6560     FILL_CIRCLE(SHOT_X,SHOT_Y,6,"BLIP_WHITE")
6570   ELSEIF KIND=7 THEN
6580     FILL_GLOW_CIRCLE(SHOT_X,SHOT_Y,18,"#F5B542B0")
6590     FILL_CIRCLE(SHOT_X,SHOT_Y,10,"#F0D18A")
6600   ELSEIF KIND=5 THEN
6610     DRAW_LINE_EX(SHOT_X-14,SHOT_Y-14,SHOT_X+14,SHOT_Y+14,3,"BLIP_WHITE")
6620     DRAW_LINE_EX(SHOT_X-14,SHOT_Y+14,SHOT_X+14,SHOT_Y-14,3,"BLIP_WHITE")
6630     FILL_CIRCLE(SHOT_X,SHOT_Y,4,"BLIP_CYAN")
6640   ELSE
6650     DRAW_LINE_EX(YOU_X+24,YOU_Y+46,SHOT_X,SHOT_Y,10,"#FF3322B0")
6660     DRAW_LINE_EX(YOU_X+24,YOU_Y+46,SHOT_X,SHOT_Y,4,"BLIP_WHITE")
6670   END IF
6680 END SUB
7000 REM --- A FIGHTER - DRAWN FROM THE MIDDLE OF ITS HEAD DOWN, TURNED TO FACE THE OTHER.
7001 REM POSE: 0 STANDING, 1 PUNCH, 2 KICK, 3 SPECIAL, 4 WINDING UP. GUARD RAISES THE ARMS.
7010 SUB DRAW_FIGHTER(X,Y,WHO,FACE,POSE,GUARDING)
7020   LOCAL TURTLE
7030   FIGHTER_COLORS WHO
7040   TURTLE=(WHO>=4 AND WHO<=7)
7050   IF WHO=10 THEN LIMB X,Y,FACE,-7,17,-17,44,5,8,TRIM$(WHO)
7060   LIMB X,Y,FACE,-2,35,-5,46,3,2,LEG$
7070   LIMB X,Y,FACE,5,35,9,46,3,2,LEG$
7080   LIMB X,Y,FACE,-6,46,-9,48,2,3,FOOT$
7090   LIMB X,Y,FACE,9,46,13,48,2,3,FOOT$
7100   IF TURTLE THEN
7110     LIMB X,Y,FACE,-6,20,-6,34,8,8,"#65472F"
7120     LIMB X,Y,FACE,-7,21,-7,33,5,5,"#9A6B39"
7130   END IF
7140   LIMB X,Y,FACE,-5,15,6,35,7,6,BODY$
7150   LIMB X,Y,FACE,-4,26,5,26,1,1,BELT$
7160   IF WHO=1 THEN
7170     LIMB X,Y,FACE,-6,16,2,25,1,1,"#BDBDCB"
7180     LIMB X,Y,FACE,6,16,2,25,1,1,"#BDBDCB"
7190   END IF
7200   FILL_CIRCLE(X,Y+14,14,SKIN$(WHO))
7210   IF TURTLE THEN
7220     FILL_RECT(X-14,Y+10,28,8,TRIM$(WHO))
7230   ELSE
7240     FILL_CIRCLE(X,Y+6,14,HAIR$(WHO))
7250     IF WHO=1 THEN DRAW_HEADBAND X,Y,FACE
7260     IF WHO=8 THEN DRAW_MASK X,Y,FACE
7270   END IF
7280   FILL_RECT(X+FACE*8-2,Y+12,4,4,"BLIP_WHITE")
7290   DRAW_ARMS X,Y,FACE,POSE,GUARDING
7300 END SUB
7400 REM A LIMB FROM (X1,Y1) TO (X2,Y2) IN THE FIGHTER'S OWN SMALL UNITS, TWICE SIZE ON SCREEN
7410 SUB LIMB(X,Y,FACE,X1,Y1,X2,Y2,R1,R2,INK$)
7420   FILL_CAPSULE(X+FACE*X1*2,Y+Y1*2,X+FACE*X2*2,Y+Y2*2,R1*2,R2*2,INK$)
7430 END SUB
7500 SUB DRAW_ARMS(X,Y,FACE,POSE,GUARDING)
7510   IF GUARDING THEN
7520     LIMB X,Y,FACE,-5,20,5,27,3,2,ARM$
7530     LIMB X,Y,FACE,6,20,-1,27,3,2,ARM$
7540     LIMB X,Y,FACE,-1,27,-1,27,3,3,HAND$
7550   ELSEIF POSE=1 OR POSE=4 THEN
7560     LIMB X,Y,FACE,-5,20,-11,29,3,2,ARM$
7570     LIMB X,Y,FACE,6,22,21,21,3,2,HAND$
7580     IF POSE=1 THEN FILL_GLOW_CIRCLE(X+FACE*46,Y+42,10,"#70D7F1A0")
7590   ELSE
7600     LIMB X,Y,FACE,-5,20,-11,29,3,2,ARM$
7610     LIMB X,Y,FACE,6,20,13,25,3,2,ARM$
7620     LIMB X,Y,FACE,14,25,14,25,3,3,HAND$
7630   END IF
7640   IF POSE=2 THEN
7650     LIMB X,Y,FACE,4,34,21,39,4,2,SKIN$(WHO)
7660     LIMB X,Y,FACE,21,39,27,39,2,3,TRIM$(WHO)
7670   END IF
7680   IF POSE=3 AND SPECIAL_KIND(WHO)=3 THEN
7690     LIMB X,Y,FACE,4,34,24,23,4,2,TRIM$(WHO)
7700     FILL_GLOW_CIRCLE(X+FACE*50,Y+44,14,"#E9D866B0")
7710   ELSEIF POSE=3 AND SPECIAL_KIND(WHO)<>2 THEN
7720     FILL_GLOW_CIRCLE(X+FACE*26,Y+48,16,"#70D7F1A0")
7730   END IF
7740 END SUB
7800 SUB DRAW_HEADBAND(X,Y,FACE)
7810   FILL_RECT(X-14,Y+8,28,4,TRIM$(1))
7820   DRAW_LINE_EX(X-FACE*14,Y+10,X-FACE*28,Y+18,2,TRIM$(1))
7830 END SUB
7900 SUB DRAW_MASK(X,Y,FACE)
7910   FILL_CIRCLE(X,Y+14,14,TRIM$(8))
7920   DRAW_LINE_EX(X-12,Y+6,X+10,Y+22,2,"#40131D")
7930   DRAW_LINE_EX(X-8,Y+24,X+8,Y+2,2,"#40131D")
7940 END SUB
8000 REM EACH FIGHTER'S CLOTHES: MOST WEAR THEIR SUIT; THE TURTLES ARE BARE-LEGGED IN A
8001 REM PLASTRON; BRUTUS AND GAMMA ARE BARE-CHESTED
8010 SUB FIGHTER_COLORS(WHO)
8020   BODY$=SUIT$(WHO):LEG$=SUIT$(WHO)
8030   ARM$=SKIN$(WHO):HAND$=SKIN$(WHO)
8040   FOOT$=TRIM$(WHO):BELT$=TRIM$(WHO)
8050   IF WHO=2 OR WHO=9 THEN BODY$=SKIN$(WHO)
8060   IF WHO>=4 AND WHO<=7 THEN
8062     BODY$="#C8AD65"
8064     LEG$=SKIN$(WHO):FOOT$=SKIN$(WHO)
8066   END IF
8070   IF WHO=1 THEN FOOT$=SKIN$(WHO):BELT$="#211F26"
8080   IF WHO=2 THEN FOOT$="#28232B"
8090   IF WHO=8 THEN
8092     BODY$=TRIM$(WHO):HAND$=TRIM$(WHO)
8094     ARM$=SUIT$(WHO)
8096   END IF
8100   IF WHO=3 OR WHO=10 THEN ARM$=SUIT$(WHO)
8110   IF WHO=10 THEN HAND$=TRIM$(WHO)
8120   IF WHO=9 THEN LEG$=SKIN$(WHO):FOOT$=SKIN$(WHO)
8130 END SUB
8500 REM --- STAGES - EACH RIVAL FIGHTS AT HOME ---
8510 SUB DRAW_STAGE(STAGE)
8520   LOCAL T
8530   T=TIME()
8540   IF STAGE=1 THEN DRAW_SUNSET_ROOFS T
8550   IF STAGE=2 THEN DRAW_MOONLIT_TEMPLE T
8560   IF STAGE=3 THEN DRAW_CITY_STREET T
8570   IF STAGE=4 THEN DRAW_GALLERY T
8580   IF STAGE=5 THEN DRAW_GARDEN T
8590   IF STAGE=6 THEN DRAW_ICE_FIELD T
8600   IF STAGE=7 THEN DRAW_SKYLINE T
8610 END SUB
8700 REM A SKY FADING IN TEN BANDS FROM ONE COLOUR AT THE TOP TO ANOTHER LOWER DOWN
8710 SUB DRAW_SKY(R0,G0,B0,R1,G1,B1)
8720   LOCAL I,K
8730   FOR I=0 TO 9
8740     K=I/9
8750     FILL_RECT(0,I*34,640,35,COLOR(LERP(R0,R1,K),LERP(G0,G1,K),LERP(B0,B1,K)))
8760   NEXT I
8770 END SUB
8800 REM THE FLOOR DARKENS TOWARD THE FRONT, UNDER A LIT EDGE, WITH BOARDS IN PERSPECTIVE
8810 SUB DRAW_FLOOR(R,G,B,FADE,EDGE$,SEAM$)
8820   LOCAL I
8830   FOR I=0 TO 8
8840     FILL_RECT(0,GROUND+I*8,640,10,COLOR(R*(1-FADE*I),G*(1-FADE*I),B*(1-FADE*I)))
8850   NEXT I
8860   DRAW_LINE_EX(0,GROUND,640,GROUND,2,EDGE$)
8870   FOR I=0 TO 16
8880     DRAW_LINE(I*40,GROUND+2,I*40+12,400,SEAM$)
8890   NEXT I
8900 END SUB
9000 SUB DRAW_SUNSET_ROOFS(T)
9010   LOCAL I
9020   DRAW_SKY 0.30,0.08,0.14,0.65,0.28,0.36
9030   FILL_CIRCLE(528,104,44,"#FFB45C")
9040   FILL_RECT(0,164,640,166,"#34465A")
9050   FOR I=0 TO 8
9060     FILL_RECT(I*80,184+SIN(I*1.7+T)*6,48,4,"#6D8290")
9070   NEXT I
9080   FILL_RECT(48,110,84,54,"#342A35")
9090   FILL_RECT(42,100,96,14,"#211D2A")
9100   FILL_RECT(534,124,84,40,"#3D2930")
9110   FILL_RECT(526,112,100,16,"#211D2A")
9120   DRAW_LINE_EX(164,164,164,94,2,"#171B28")
9130   DRAW_LINE_EX(164,96,222,164,2,"#171B28")
9140   DRAW_FLOOR 0.35,0.25,0.19,0.08,"#E9A55C","#4E3B32"
9150 END SUB
9200 SUB DRAW_MOONLIT_TEMPLE(T)
9210   LOCAL I
9220   FILL_RECT(0,0,640,344,"#111322")
9230   FILL_CIRCLE(528,76,34,"#D7D8C8")
9240   FILL_CIRCLE(540,66,34,"#111322")
9250   FILL_RECT(52,146,536,184,"#352B3D")
9260   FILL_RECT(78,124,484,22,"#694754")
9270   FILL_RECT(100,102,440,22,"#7B5261")
9280   FILL_RECT(120,88,400,14,"#D09A77")
9290   FOR I=0 TO 5
9300     FILL_RECT(116+I*84,148,18,182,"#B97872")
9310     FILL_RECT(122+I*84,148,6,182,"#E4AD87")
9320   NEXT I
9330   FILL_RECT(266,202,108,128,"#171625")
9340   REM BLOSSOM DRIFTS DOWN THROUGH THE NIGHT
9350   FOR I=0 TO 10
9360     FILL_RECT(I*58+SIN(T*1.8+I)*18,(T*34+I*62) MOD 330,4,8,"#F0A6B4")
9370   NEXT I
9380   DRAW_FLOOR 0.27,0.24,0.30,0.07,"#C79589","#45404B"
9390 END SUB
9400 SUB DRAW_CITY_STREET(T)
9410   LOCAL I,BOB
9420   DRAW_SKY 0.20,0.36,0.56,0.56,0.76,0.90
9430   FILL_RECT(0,198,640,132,"#777B7B")
9440   FILL_RECT(36,134,224,94,"#59636A")
9450   FILL_RECT(50,144,196,80,"#AAB0AA")
9460   FILL_RECT(392,162,214,66,"#66737A")
9470   FILL_RECT(408,174,182,54,"#B6B8AD")
9480   FOR I=0 TO 5
9490     BOB=SIN(T*1.3+I)*10
9500     FILL_RECT(I*128+28,60+BOB,52,6,"#F1F1E4")
9510     FILL_RECT(I*128+58,52+BOB,38,6,"#F1F1E4")
9520   NEXT I
9530   DRAW_FLOOR 0.39,0.40,0.42,0.06,"#E2E2D3","#51585D"
9540 END SUB
9600 SUB DRAW_GALLERY(T)
9610   LOCAL I
9620   DRAW_SKY 0.20,0.12,0.22,0.55,0.36,0.40
9630   FILL_RECT(0,56,640,12,"#443126")
9640   FILL_RECT(36,72,568,182,"#E1D3B1")
9650   DRAW_RECT(36,72,568,182,"#61432C")
9660   FILL_RECT(64,100,512,116,"#82AFC8")
9670   FILL_CIRCLE(494,144,36,"#E64A3D")
9680   FOR I=0 TO 11
9690     FILL_RECT(164+I*26,178-ABS(6-I)*10,26,14,"#D7E5E7")
9700   NEXT I
9710   FOR I=0 TO 3
9720     FILL_CIRCLE(68+I*164,290+SIN(T*1.2+I)*4,24,"#F5E2B8")
9730     FILL_RECT(56+I*164,310,24,20,"#C47C55")
9740   NEXT I
9750   DRAW_FLOOR 0.60,0.43,0.27,0.07,"#E5C99A","#6A4A32"
9760 END SUB
9800 SUB DRAW_GARDEN(T)
9810   LOCAL I
9820   DRAW_SKY 0.27,0.52,0.44,0.58,0.82,0.60
9830   FOR I=0 TO 13
9840     FILL_CIRCLE(I*54,198+SIN(I*1.4)*10,44,"#375A39")
9850     FILL_RECT(I*54-24,198,48,106,"#375A39")
9860   NEXT I
9870   FILL_RECT(0,252,640,78,"#637B58")
9880   FILL_RECT(68,182,228,72,"#745234")
9890   FILL_RECT(50,168,264,18,"#473322")
9900   FOR I=0 TO 5
9910     FILL_RECT(64+I*46,140+ABS(3-I)*10,50,18,"#8A6A3B")
9920   NEXT I
9930   FOR I=0 TO 11
9940     FILL_RECT(I*58+SIN(T+I)*16,278+I*4,36,4,"#A3BA83")
9950   NEXT I
9960   DRAW_FLOOR 0.39,0.32,0.20,0.06,"#B69A6C","#594733"
9970 END SUB
10000 SUB DRAW_ICE_FIELD(T)
10010   LOCAL I,TOP
10020   DRAW_SKY 0.03,0.06,0.17,0.13,0.26,0.45
10030   FOR I=0 TO 31
10040     FILL_RECT(SCATTER(I,241)*640,SCATTER(I,83)*174,4,4,"#D5F4F2")
10050   NEXT I
10060   REM THE AURORA RIPPLES
10070   FOR I=0 TO 5
10080     FILL_RECT(0,I*16+70,640,10,COLOR(0.08,0.32+0.04*SIN(T+I),0.28+0.03*SIN(T+I)))
10090   NEXT I
10100   FOR I=0 TO 8
10110     TOP=224-ABS(4-I)*16
10120     FILL_RECT(I*84,TOP,56,108,"#567A99")
10130     FILL_RECT(I*84+12,TOP,16,100,"#B4DDE8")
10140   NEXT I
10150   FILL_RECT(0,270,640,60,"#CDE4E9")
10160   FILL_RECT(0,270,640,6,"#F1FFFF")
10170   DRAW_FLOOR 0.70,0.80,0.87,0.035,"#F0FFFF","#9BBBCB"
10180 END SUB
10200 SUB DRAW_SKYLINE(T)
10210   LOCAL I,H
10220   DRAW_SKY 0.16,0.13,0.32,0.64,0.47,0.48
10230   FILL_CIRCLE(116,188,40,"#FFE2A2")
10240   FILL_RECT(0,230,640,32,"#443B50")
10250   FOR I=0 TO 15
10260     H=50+SCATTER(I,5)*106
10270     FILL_RECT(I*42,230-H,36,H,"#30283C")
10280   NEXT I
10290   FOR I=0 TO 9
10300     FILL_RECT(I*66,226-SCATTER(I,7)*94,6,6,"#FFD978")
10310   NEXT I
10320   FILL_RECT(0,290,640,40,"#563C42")
10330   FILL_RECT(0,290,640,8,"#D18A68")
10340   DRAW_FLOOR 0.34,0.27,0.30,0.07,"#D89A73","#54444A"
10350 END SUB
11000 REM --- KEYS AND THE ROSTER ---
11010 SUB READ_KEYS
11020   HOLD_LEFT=KEY_ACTIVE("LEFT") OR KEY_ACTIVE("A")
11030   HOLD_RIGHT=KEY_ACTIVE("RIGHT") OR KEY_ACTIVE("D")
11040   JUMP_PRESSED=KEY_PRESSED("UP") OR KEY_PRESSED("W")
11050   GUARD=KEY_HELD("DOWN") OR KEY_HELD("S")
11060   PUNCH_PRESSED=KEY_PRESSED("SPACE") OR KEY_PRESSED("F")
11070   KICK_PRESSED=KEY_PRESSED("BUTTON2") OR KEY_PRESSED("G") OR KEY_PRESSED("Z")
11080   PUNCH_HELD=KEY_ACTIVE("SPACE") OR KEY_ACTIVE("F")
11090   KICK_HELD=KEY_ACTIVE("G") OR KEY_ACTIVE("Z")
11100 END SUB
11200 REM EACH FIGHTER: NAME, HEALTH, SPEED, POWER, REACH, JUMP, SPECIAL KIND, ITS SPEED
11201 REM AND NAME, HOME STAGE, THEN SUIT, TRIM, SKIN AND HAIR COLOURS
11210 SUB LOAD_ROSTER
11220   LOCAL W
11230   RESTORE 11300
11240   FOR W=1 TO 10
11250     READ NAME$(W),MAX_HP(W),SPEED(W),POWER(W),REACH(W),JUMP(W)
11260     READ SPECIAL_KIND(W),SPECIAL_SPEED(W),SPECIAL_NAME$(W),HOME(W)
11270     READ SUIT$(W),TRIM$(W),SKIN$(W),HAIR$(W)
11280   NEXT W
11290 END SUB
