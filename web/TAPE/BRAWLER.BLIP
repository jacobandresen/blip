1488 REM ALL ROSTER ARRAYS USE THE SAME CHARACTER INDEX, 1 TO 10.
1489 REM --- ROSTER DATA - HEALTH, SPEED, REACH, COLORS, AND SPECIALS ---
1490 MAXHP(1)=100:MAXHP(2)=120:MAXHP(3)=108:MAXHP(4)=88:MAXHP(5)=96:MAXHP(6)=94:MAXHP(7)=86:MAXHP(8)=90:MAXHP(9)=92:MAXHP(10)=200
1491 SKIN$(1)="#D9AD85":SKIN$(2)="#BD8057":SKIN$(3)="#E6BD99":SKIN$(4)="#70AD4D":SKIN$(5)="#70AD4D":SKIN$(6)="#70AD4D":SKIN$(7)="#70AD4D":SKIN$(8)="#DB2429":SKIN$(9)="#61A342":SKIN$(10)="#E6B894":HAIR$(1)="#3D291F":HAIR$(2)="#33241F":HAIR$(3)="#8C6B2E":HAIR$(4)="#704F2B":HAIR$(5)="#704F2B":HAIR$(6)="#704F2B":HAIR$(7)="#704F2B":HAIR$(8)="#1A1A1F":HAIR$(9)="#1A1A1F":HAIR$(10)="#14141A"
1492 HOME(1)=2:HOME(2)=1:HOME(3)=3:HOME(4)=4:HOME(5)=4:HOME(6)=4:HOME(7)=4:HOME(8)=7:HOME(9)=5:HOME(10)=6
1493 SPEED(1)=1.1:SPEED(2)=0.8:SPEED(3)=1.36:SPEED(4)=1.83:SPEED(5)=1.67:SPEED(6)=1.96:SPEED(7)=2.08:SPEED(8)=2.5:SPEED(9)=0.7:SPEED(10)=2.75
1494 POWER(1)=1:POWER(2)=1.28:POWER(3)=0.96:POWER(4)=1:POWER(5)=1.1:POWER(6)=1.05:POWER(7)=0.92:POWER(8)=0.92:POWER(9)=1.8:POWER(10)=3
1496 REACH(1)=1:REACH(2)=0.88:REACH(3)=1.12:REACH(4)=1.12:REACH(5)=1.06:REACH(6)=1.15:REACH(7)=1.12:REACH(8)=1.08:REACH(9)=0.82:REACH(10)=1
1498 JUMP(1)=5.2:JUMP(2)=4.6:JUMP(3)=5.82:JUMP(4)=6.76:JUMP(5)=6.5:JUMP(6)=6.86:JUMP(7)=7.18:JUMP(8)=6.24:JUMP(9)=4.68:JUMP(10)=5.2:SPEC_KIND(1)=1:SPEC_KIND(2)=2:SPEC_KIND(3)=3:SPEC_KIND(4)=6:SPEC_KIND(5)=2:SPEC_KIND(6)=3:SPEC_KIND(7)=7:SPEC_KIND(8)=5:SPEC_KIND(9)=2:SPEC_KIND(10)=4:SPEC_SPEED(1)=6.67:SPEC_SPEED(2)=6.67:SPEC_SPEED(3)=4.6:SPEC_SPEED(4)=8:SPEC_SPEED(5)=6.67:SPEC_SPEED(6)=4.6:SPEC_SPEED(7)=5.4:SPEC_SPEED(8)=6.67:SPEC_SPEED(9)=6.67:SPEC_SPEED(10)=12:SPEC_NAME$(1)="CHI BOLT":SPEC_NAME$(2)="BULL RUSH":SPEC_NAME$(3)="TALON KICK":SPEC_NAME$(4)="SHURIKEN":SPEC_NAME$(5)="SHELL RAM":SPEC_NAME$(6)="RISING KICK":SPEC_NAME$(7)="PIZZA TOSS":SPEC_NAME$(8)="WEB SHOT":SPEC_NAME$(9)="RAMPAGE":SPEC_NAME$(10)="LASER VISION":RETURN
1499 REM --- OPPONENT SETUP - READ THE CURRENT LADDER SEAT ---
1500 ROUND_NO=PLAYER_ROUNDS+CPU_ROUNDS:IF MATCH_NO<1 THEN CPU_PICK=2
1505 IF MATCH_NO>=1 THEN CPU_PICK=LADDER(MATCH_NO)
1510 RIVAL$=NAME$(CPU_PICK):CPU_MAXHP=MAXHP(CPU_PICK):CPU_SPEED=SPEED(CPU_PICK):CPU_POWER=POWER(CPU_PICK):CPU_REACH=REACH(CPU_PICK):CPU_COLOR$=SUIT$(CPU_PICK):CPU_LEG$=SUIT$(CPU_PICK):CPU_SKIN$=SKIN$(CPU_PICK):CPU_HAIR$=HAIR$(CPU_PICK):CPU_FOOT$=TRIM$(CPU_PICK)
1515 IF CPU_PICK>=4 AND CPU_PICK<=7 THEN CPU_COLOR$="#C8AD65":CPU_LEG$=CPU_SKIN$:CPU_FOOT$=CPU_SKIN$
1530 RETURN
1539 REM --- START THE SELECTED SPECIAL MOVE ---
1540 SPECIAL_FIRED=1
1541 IF PLAYER_SPECIAL=2 THEN RUSH_ACTIVE=1
1542 IF PLAYER_SPECIAL<>2 AND PLAYER_SPECIAL<>3 THEN SPECIAL_X=PX+30
1543 IF PLAYER_SPECIAL=3 THEN PVY=0-PLAYER_JUMP*0.82
1544 RETURN
1549 REM --- PLAYER DETAILS - MASKS, SHELLS, AND ACCESSORIES ---
1550 IF PICK=1 THEN FILL_RECT(PX+3,PY+4,14,2,PLAYER_TRIM$):DRAW_LINE_EX(PX+3,PY+5,PX-4,PY+9,1,PLAYER_TRIM$)
1551 IF PICK=8 THEN FILL_CIRCLE(PX+10,PY+7,7,PLAYER_TRIM$):DRAW_LINE(PX+4,PY+3,PX+15,PY+11,"#40131D"):DRAW_LINE(PX+6,PY+12,PX+14,PY+1,"#40131D")
1552 RETURN
1559 REM --- PLAYER PALETTE - SKIN, HAIR, CLOTHES, AND TRIM ---
1560 PLAYER_SKIN$=SKIN$(PICK):PLAYER_HAIR$=HAIR$(PICK):PLAYER_BODY$=PLAYER_SUIT$:PLAYER_LEG$=PLAYER_SUIT$:PLAYER_ARM$=PLAYER_SKIN$:PLAYER_HAND$=PLAYER_SKIN$:PLAYER_FOOT$=PLAYER_TRIM$:PLAYER_BELT$=PLAYER_TRIM$
1561 IF PICK=2 OR PICK=9 THEN PLAYER_BODY$=PLAYER_SKIN$
1562 IF PICK>=4 AND PICK<=7 THEN PLAYER_BODY$="#C8AD65":PLAYER_LEG$=PLAYER_SKIN$:PLAYER_FOOT$=PLAYER_SKIN$
1563 IF PICK=1 THEN PLAYER_FOOT$=PLAYER_SKIN$:PLAYER_BELT$="#211F26"
1564 IF PICK=2 THEN PLAYER_FOOT$="#28232B"
1565 IF PICK=8 THEN PLAYER_BODY$=PLAYER_TRIM$:PLAYER_ARM$=PLAYER_SUIT$:PLAYER_HAND$=PLAYER_TRIM$
1566 IF PICK=3 OR PICK=10 THEN PLAYER_ARM$=PLAYER_SUIT$
1567 IF PICK=10 THEN PLAYER_HAND$=PLAYER_TRIM$
1568 IF PICK=9 THEN PLAYER_LEG$=PLAYER_SKIN$:PLAYER_FOOT$=PLAYER_SKIN$
1569 RETURN
1588 REM INPUT: PX/PY IS THE POSE ORIGIN; THE CURRENT PLAYER PALETTE IS USED.
1589 REM --- PLAYER POSE - BODY PARTS AND ATTACK LIMBS ---
1590 IF PICK=10 THEN FILL_CAPSULE(PX+3,PY+17,PX-7,PY+44,5,8,PLAYER_TRIM$)
1600 FILL_CAPSULE(PX+8,PY+35,PX+5,PY+46,3,2,PLAYER_LEG$)
1610 FILL_CAPSULE(PX+15,PY+35,PX+19,PY+46,3,2,PLAYER_LEG$)
1620 FILL_CAPSULE(PX+4,PY+46,PX+1,PY+48,2,3,PLAYER_FOOT$)
1630 FILL_CAPSULE(PX+19,PY+46,PX+23,PY+48,2,3,PLAYER_FOOT$):IF PICK>=4 AND PICK<=7 THEN FILL_CAPSULE(PX+4,PY+20,PX+4,PY+34,8,8,"#65472F"):FILL_CAPSULE(PX+3,PY+21,PX+3,PY+33,5,5,"#9A6B39")
1640 FILL_CAPSULE(PX+5,PY+15,PX+16,PY+35,7,6,PLAYER_BODY$)
1650 DRAW_LINE(PX+6,PY+26,PX+15,PY+26,PLAYER_BELT$):IF PICK=1 THEN DRAW_LINE(PX+4,PY+16,PX+12,PY+25,"#BDBDCB"):DRAW_LINE(PX+16,PY+16,PX+12,PY+25,"#BDBDCB")
1660 IF PICK>=4 AND PICK<=7 THEN FILL_CIRCLE(PX+10,PY+7,7,PLAYER_SKIN$)
1670 IF PICK>=4 AND PICK<=7 THEN FILL_RECT(PX+3,PY+5,14,4,PLAYER_TRIM$)
1680 IF PICK<4 OR PICK>7 THEN FILL_CIRCLE(PX+10,PY+7,7,PLAYER_SKIN$)
1690 IF PICK<4 OR PICK>7 THEN FILL_CIRCLE(PX+10,PY+3,7,PLAYER_HAIR$):GOSUB 1550
1700 FILL_RECT(PX+14,PY+6,2,2,"BLIP_WHITE")
1710 IF KEY_HELD("DOWN")=1 OR KEY_HELD("S")=1 THEN FILL_CAPSULE(PX+5,PY+20,PX+15,PY+27,3,2,PLAYER_ARM$)
1720 IF KEY_HELD("DOWN")=0 AND KEY_HELD("S")=0 THEN FILL_CAPSULE(PX+5,PY+20,PX-1,PY+29,3,2,PLAYER_ARM$)
1730 IF KEY_HELD("DOWN")=1 OR KEY_HELD("S")=1 THEN FILL_CAPSULE(PX+16,PY+20,PX+9,PY+27,3,2,PLAYER_ARM$):FILL_CIRCLE(PX+9,PY+27,3,PLAYER_HAND$)
1740 IF KEY_HELD("DOWN")=0 AND KEY_HELD("S")=0 THEN FILL_CAPSULE(PX+16,PY+20,PX+23,PY+25,3,2,PLAYER_ARM$):FILL_CIRCLE(PX+24,PY+25,3,PLAYER_HAND$)
1750 IF ATTACK_KIND=1 AND ATTACK>0 THEN FILL_CAPSULE(PX+16,PY+22,PX+31,PY+21,3,2,PLAYER_HAND$):FILL_GLOW_CIRCLE(PX+33,PY+21,5,"#70D7F1A0")
1760 IF ATTACK_KIND=2 AND ATTACK>0 THEN FILL_CAPSULE(PX+14,PY+34,PX+31,PY+39,4,2,PLAYER_SKIN$):FILL_CAPSULE(PX+31,PY+39,PX+37,PY+39,2,3,PLAYER_TRIM$)
1770 IF ATTACK_KIND=3 AND ATTACK>0 AND (PLAYER_SPECIAL=1 OR PLAYER_SPECIAL=4 OR PLAYER_SPECIAL=5 OR PLAYER_SPECIAL=6 OR PLAYER_SPECIAL=7) THEN FILL_GLOW_CIRCLE(PX+23,PY+24,8,"#70D7F1A0")
1780 IF ATTACK_KIND=3 AND ATTACK>0 AND PLAYER_SPECIAL=3 THEN FILL_CAPSULE(PX+14,PY+34,PX+34,PY+23,4,2,PLAYER_TRIM$):FILL_GLOW_CIRCLE(PX+35,PY+22,7,"#E9D866B0")
1790 IF SPECIAL_ACTIVE=1 AND (PLAYER_SPECIAL=1 OR PLAYER_SPECIAL=6) THEN FILL_GLOW_CIRCLE(SPECIAL_X,SPECIAL_Y,8,"#53DDF2C0"):FILL_CIRCLE(SPECIAL_X,SPECIAL_Y,3,"BLIP_WHITE")
1800 IF SPECIAL_ACTIVE=1 AND PLAYER_SPECIAL=7 THEN FILL_GLOW_CIRCLE(SPECIAL_X,SPECIAL_Y,9,"#F5B542B0"):FILL_CIRCLE(SPECIAL_X,SPECIAL_Y,5,"#F0D18A")
1810 IF SPECIAL_ACTIVE=1 AND PLAYER_SPECIAL=5 THEN DRAW_LINE_EX(SPECIAL_X-7,SPECIAL_Y-7,SPECIAL_X+7,SPECIAL_Y+7,2,"BLIP_WHITE"):DRAW_LINE_EX(SPECIAL_X-7,SPECIAL_Y+7,SPECIAL_X+7,SPECIAL_Y-7,2,"BLIP_WHITE"):FILL_CIRCLE(SPECIAL_X,SPECIAL_Y,2,"BLIP_CYAN")
1820 IF SPECIAL_ACTIVE=1 AND PLAYER_SPECIAL=4 THEN DRAW_LINE_EX(PX+22,PY+23,SPECIAL_X,SPECIAL_Y,5,"#FF3322B0"):DRAW_LINE_EX(PX+22,PY+23,SPECIAL_X,SPECIAL_Y,2,"BLIP_WHITE")
1830 RETURN
1849 REM --- LADDER - BUILD NINE OPPONENTS FROM THE SELECTED ROSTER ---
1850 FOR I=1 TO 9:RING(I)=PICK+I:IF RING(I)>10 THEN RING(I)=RING(I)-10
1855 NEXT I
1860 FOR I=1 TO 10:USED(I)=0:NEXT I
1865 FINAL_COUNT=2:IF PICK=9 OR PICK=10 THEN FINAL_COUNT=1
1870 EARLY=9-FINAL_COUNT:DEPTH=1:NEXT_CANDIDATE(1)=1
1875 IF DEPTH>9 THEN GOTO 1940
1880 CANDIDATE=NEXT_CANDIDATE(DEPTH):IF CANDIDATE>9 THEN GOTO 1925
1885 WHO=RING(CANDIDATE):NEXT_CANDIDATE(DEPTH)=CANDIDATE+1
1890 IF DEPTH<=EARLY AND (WHO=9 OR WHO=10) THEN GOTO 1880
1895 IF DEPTH>EARLY AND PICK=9 AND WHO<>10 THEN GOTO 1880
1900 IF DEPTH>EARLY AND PICK=10 AND WHO<>9 THEN GOTO 1880
1905 IF DEPTH=8 AND PICK<>9 AND PICK<>10 AND WHO<>9 THEN GOTO 1880
1910 IF DEPTH=9 AND PICK<>9 AND PICK<>10 AND WHO<>10 THEN GOTO 1880
1915 IF USED(WHO)=1 THEN GOTO 1880
1920 IF DEPTH=1 THEN GOTO 1935
1922 IF HOME(WHO)=HOME(LADDER(DEPTH-1)) THEN GOTO 1880
1923 GOTO 1935
1925 IF DEPTH=1 THEN GOTO 1940
1930 DEPTH=DEPTH-1:WHO=LADDER(DEPTH):USED(WHO)=0:GOTO 1875
1935 LADDER(DEPTH)=WHO:USED(WHO)=1:DEPTH=DEPTH+1:NEXT_CANDIDATE(DEPTH)=1:GOTO 1875
1940 RETURN
1999 REM --- STAGE ART - GALLERY ---
2000 FOR I=0 TO 9:FILL_RECT(0,I*18,320,19,COLOR(0.20+0.35*I/9,0.12+0.24*I/9,0.22+0.18*I/9)):NEXT I
2005 FILL_RECT(0,28,320,6,"#443126"):FILL_RECT(18,36,284,91,"#E1D3B1"):DRAW_RECT(18,36,284,91,"#61432C")
2010 FILL_RECT(32,50,256,58,"#82AFC8"):FILL_CIRCLE(247,72,18,"#E64A3D")
2015 FOR I=0 TO 11:FILL_RECT(82+I*13,89-ABS(6-I)*5,13,7,"#D7E5E7"):NEXT I
2020 FOR I=0 TO 3:FILL_CIRCLE(34+I*82,145+SIN(T*1.2+I)*2,12,"#F5E2B8"):FILL_RECT(28+I*82,155,12,10,"#C47C55"):NEXT I
2025 FOR I=0 TO 8:FILL_RECT(0,165+I*4,320,5,COLOR(0.60-0.04*I,0.43-0.03*I,0.27-0.02*I)):NEXT I
2030 DRAW_LINE(0,165,320,165,"#E5C99A"):FOR I=0 TO 16:DRAW_LINE(I*20,166,I*20+6,200,"#6A4A32"):NEXT I:RETURN
2039 REM --- STAGE ART - GARDEN ---
2040 FOR I=0 TO 9:FILL_RECT(0,I*18,320,19,COLOR(0.27+0.31*I/9,0.52+0.30*I/9,0.44+0.16*I/9)):NEXT I
2045 FOR I=0 TO 13:FILL_CIRCLE(I*27,99+SIN(I*1.4)*5,22,"#375A39"):FILL_RECT(I*27-12,99,24,53,"#375A39"):NEXT I
2050 FILL_RECT(0,126,320,39,"#637B58"):FILL_RECT(34,91,114,36,"#745234"):FILL_RECT(25,84,132,9,"#473322")
2055 FOR I=0 TO 5:FILL_RECT(32+I*23,70+ABS(3-I)*5,25,9,"#8A6A3B"):NEXT I
2060 FOR I=0 TO 11:FILL_RECT(I*29+SIN(T+I)*8,139+I*2,18,2,"#A3BA83"):NEXT I
2065 FOR I=0 TO 8:FILL_RECT(0,165+I*4,320,5,COLOR(0.39-0.025*I,0.32-0.02*I,0.20-0.015*I)):NEXT I
2070 DRAW_LINE(0,165,320,165,"#B69A6C"):FOR I=0 TO 16:DRAW_LINE(I*20,166,I*20+6,200,"#594733"):NEXT I:RETURN
2079 REM --- STAGE ART - NIGHT SKY ---
2080 FOR I=0 TO 9:FILL_RECT(0,I*18,320,19,COLOR(0.03+0.10*I/9,0.06+0.20*I/9,0.17+0.28*I/9)):NEXT I
2085 FOR I=0 TO 31:FILL_RECT(SCATTER(I,241)*320,SCATTER(I,83)*87,2,2,"#D5F4F2"):NEXT I
2090 FOR I=0 TO 5:FILL_RECT(0,I*8+35,320,5,COLOR(0.08,0.32+0.04*SIN(T+I),0.28+0.03*SIN(T+I))):NEXT I
2095 FOR I=0 TO 8:FILL_RECT(I*42,112-ABS(4-I)*8,28,54,"#567A99"):FILL_RECT(I*42+6,112-ABS(4-I)*8,8,50,"#B4DDE8"):NEXT I
2100 FILL_RECT(0,135,320,30,"#CDE4E9"):FILL_RECT(0,135,320,3,"#F1FFFF")
2105 FOR I=0 TO 8:FILL_RECT(0,165+I*4,320,5,COLOR(0.70-0.03*I,0.80-0.025*I,0.87-0.02*I)):NEXT I
2110 DRAW_LINE(0,165,320,165,"#F0FFFF"):FOR I=0 TO 16:DRAW_LINE(I*20,166,I*20+6,200,"#9BBBCB"):NEXT I:RETURN
2119 REM --- STAGE ART - SKYLINE ---
2120 FOR I=0 TO 9:FILL_RECT(0,I*18,320,19,COLOR(0.16+0.48*I/9,0.13+0.34*I/9,0.32+0.16*I/9)):NEXT I
2125 FILL_CIRCLE(58,94,20,"#FFE2A2"):FILL_RECT(0,115,320,16,"#443B50")
2130 FOR I=0 TO 15:H=25+SCATTER(I,5)*53:FILL_RECT(I*21,115-H,18,H,"#30283C"):NEXT I
2135 FOR I=0 TO 9:FILL_RECT(I*33,113-SCATTER(I,7)*47,3,3,"#FFD978"):NEXT I
2140 FILL_RECT(0,145,320,20,"#563C42"):FILL_RECT(0,145,320,4,"#D18A68")
2145 FOR I=0 TO 8:FILL_RECT(0,165+I*4,320,5,COLOR(0.34-0.025*I,0.27-0.02*I,0.30-0.018*I)):NEXT I
2150 DRAW_LINE(0,165,320,165,"#D89A73"):FOR I=0 TO 16:DRAW_LINE(I*20,166,I*20+6,200,"#54444A"):NEXT I:RETURN
