1 REM PROCEDURES, FUNCTIONS, BLOCK IF AND MOD - EACH CHECK THAT FAILS JUMPS TO A MISSING LINE AND STOPS THE RUN
10 X=5:I=99:CALL ADDTO(2,3):IF R<>5 OR X<>5 THEN GOTO 9001
20 FACT 5:IF F<>120 THEN GOTO 9002
30 IF I<>99 THEN GOTO 9003
40 CALL FIRST_OVER(3):IF R<>4 OR I<>99 THEN GOTO 9004
50 N$="":GREET("ADA"):IF N$<>"HI ADA" THEN GOTO 9005
60 IF 1=1 THEN CALL ADDTO(10,20):R=R+1
70 IF R<>31 THEN GOTO 9006
80 COUNT=0:FOR K=1 TO 3:BUMP:NEXT K:IF COUNT<>3 OR K<>4 THEN GOTO 9007
90 CALL VIA_GOSUB:IF G<>7 THEN GOTO 9008
95 IF 7 MOD 3<>1 OR -1 MOD 8<>7 OR 1+10 MOD 4*2<>5 THEN GOTO 9009
96 IF 1=2 THEN E=1 ELSE E=2:E=E+1
97 IF E<>3 THEN 9010 ELSE IF 2>1 THEN E=4
98 IF E<>4 THEN GOTO 9011
99 PICK 1:IF P$<>"ONE" THEN GOTO 9012
100 PICK 2:IF P$<>"TWO" THEN GOTO 9013
101 PICK 3:IF P$<>"MANY" THEN GOTO 9014
102 PICK 4:IF P$<>"MANY OUTER" THEN GOTO 9015
103 IF "A THEN B"<>"A THEN B" THEN GOTO 9016
104 DEF FNSQUARE(N)=N*N
105 DEF FNNEAR(AX,BX)=ABS(AX-BX)<=R
106 N=7:R=2:IF FNSQUARE(3)<>9 OR N<>7 OR FNSQUARE(FNSQUARE(2))<>16 THEN GOTO 9017
107 IF NOT FNNEAR(5,6) OR FNNEAR(1,9) THEN GOTO 9018
110 PRINT "PROCEDURES OK":END
200 SUB ADDTO(X,Y) STATIC
210 R=X+Y
220 END SUB
300 SUB FACT(N)
310 IF N<=1 THEN F=1:EXIT SUB
320 FACT N-1:F=F*N
330 END SUB
400 SUB FIRST_OVER(LIMIT)
410 LOCAL I
420 FOR I=1 TO 10:IF I>LIMIT THEN R=I:EXIT SUB
430 NEXT I
440 END SUB
500 SUB GREET(WHO$):N$="HI "+WHO$:END SUB
600 SUB BUMP:COUNT=COUNT+1:END SUB
700 SUB VIA_GOSUB
710 GOSUB 750:END SUB
750 G=7:RETURN
800 SUB PICK(N)
810 IF N=1 THEN
820   P$="ONE"
830 ELSEIF N=2 THEN
840   P$="TWO"
850 ELSE
860   P$="MANY"
870   IF N>3 THEN
880     P$=P$+" OUTER"
890   END IF
900 END IF
910 END SUB
